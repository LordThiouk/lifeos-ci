+    public function approveAll($id) {
+        $driver = Driver::with('vehicle')->findOrFail($id);
+
+        $hasDocument = !empty($driver->driver_data);
+        $hasVehicle  = $driver->vehicle && !blank($driver->vehicle->form_data);
+
+        if (!$hasDocument || !$hasVehicle) {
+            $notify[] = ['error', 'Driver document and vehicle information must be complete before one-step approval'];
+            return back()->withNotify($notify);
+        }
+
+        $alreadyVerified = $driver->dv == Status::VERIFIED && $driver->vv == Status::VERIFIED;
+
+        $driver->dv = Status::VERIFIED;
+        $driver->vv = Status::VERIFIED;
+        $driver->save();
+
+        if (!$alreadyVerified) {
+            $this->sendDriverApprovedSms($driver);
+        }
+
+        $notify[] = ['success', 'Driver approved successfully'];
+        return back()->withNotify($notify);
+    }
