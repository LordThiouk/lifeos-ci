# Antenly — local development stack.
#
# One command to bring up the full infra described by docs/PRD.md, one command
# to take it down. See docs/dev-stack.md for the details.

SHELL := /bin/bash
COMPOSE ?= docker compose

.DEFAULT_GOAL := help
.PHONY: help up down reset migrate test logs ps

help: ## Show this help
	@grep -E '^[a-z-]+:.*## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*## "}; {printf "  %-8s %s\n", $$1, $$2}'

up: ## Start the stack and wait for every healthcheck
	$(COMPOSE) up -d --wait --wait-timeout 180

down: ## Stop the stack (volumes are kept)
	$(COMPOSE) down

reset: ## Stop the stack and delete its volumes (destructive)
	$(COMPOSE) down -v

migrate: ## Apply Postgres and ClickHouse migrations, create the evidence bucket
	./scripts/migrate.sh

test: up migrate ## Run the API test suite against the running stack
	cd api && ANTENLY_DEV_STACK=1 uv run pytest -q

ps: ## Show container state
	$(COMPOSE) ps

logs: ## Follow the logs of every service
	$(COMPOSE) logs -f
