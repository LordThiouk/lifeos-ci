#!/usr/bin/env bash
# Apply the SQL migrations to the running local stack.
#
# Idempotent: a migration that is already recorded with the same checksum is
# skipped, and a modified migration is a hard error instead of a silent re-run.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

COMPOSE=${COMPOSE:-docker compose}
POSTGRES_SERVICE=${POSTGRES_SERVICE:-postgres}
CLICKHOUSE_SERVICE=${CLICKHOUSE_SERVICE:-clickhouse}
S3_SERVICE=${S3_SERVICE:-seaweedfs}
S3_BUCKET=${S3_BUCKET:-antenly-evidence}

die() {
    printf 'migrate: %s\n' "$*" >&2
    exit 1
}

if command -v sha256sum >/dev/null 2>&1; then
    checksum() { sha256sum "$1" | awk '{print $1}'; }
else
    checksum() { shasum -a 256 "$1" | awk '{print $1}'; }
fi

$COMPOSE exec -T "$POSTGRES_SERVICE" true >/dev/null 2>&1 ||
    die "postgres is not running — run 'make up' first"
$COMPOSE exec -T "$CLICKHOUSE_SERVICE" true >/dev/null 2>&1 ||
    die "clickhouse is not running — run 'make up' first"

pg_query() {
    $COMPOSE exec -T -e QUERY="$1" "$POSTGRES_SERVICE" sh -ec \
        'psql -v ON_ERROR_STOP=1 -qAt -U "$POSTGRES_USER" -d "$POSTGRES_DB" -c "$QUERY"'
}

ch_query() {
    $COMPOSE exec -T -e QUERY="$1" "$CLICKHOUSE_SERVICE" sh -ec \
        'clickhouse-client --user "$CLICKHOUSE_USER" --password "$CLICKHOUSE_PASSWORD" --database "$CLICKHOUSE_DB" --query "$QUERY"'
}

pg_query "CREATE TABLE IF NOT EXISTS schema_migrations (
    version text PRIMARY KEY,
    checksum text NOT NULL,
    applied_at timestamptz NOT NULL DEFAULT now()
)" >/dev/null

printf 'Postgres\n'
for file in migrations/postgres/*.sql; do
    [ -e "$file" ] || continue
    version=$(basename "$file")
    sum=$(checksum "$file")
    applied=$(pg_query "SELECT checksum FROM schema_migrations WHERE version = '$version'")
    if [ -n "$applied" ]; then
        [ "$applied" = "$sum" ] ||
            die "postgres migration $version changed after it was applied — run 'make reset'"
        printf '  %-24s already applied\n' "$version"
        continue
    fi
    printf '  %-24s applying\n' "$version"
    {
        cat "$file"
        printf "\nINSERT INTO schema_migrations (version, checksum) VALUES ('%s', '%s');\n" "$version" "$sum"
    } | $COMPOSE exec -T "$POSTGRES_SERVICE" sh -ec \
        'psql -v ON_ERROR_STOP=1 -q -1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" -f -'
done

ch_query "CREATE TABLE IF NOT EXISTS schema_migrations (
    version String,
    checksum String,
    applied_at DateTime DEFAULT now()
) ENGINE = MergeTree ORDER BY version" >/dev/null

printf 'ClickHouse\n'
for file in migrations/clickhouse/*.sql; do
    [ -e "$file" ] || continue
    version=$(basename "$file")
    sum=$(checksum "$file")
    applied=$(ch_query "SELECT checksum FROM schema_migrations WHERE version = '$version' FORMAT TSV")
    if [ -n "$applied" ]; then
        [ "$applied" = "$sum" ] ||
            die "clickhouse migration $version changed after it was applied — run 'make reset'"
        printf '  %-24s already applied\n' "$version"
        continue
    fi
    printf '  %-24s applying\n' "$version"
    {
        cat "$file"
        printf "\nINSERT INTO schema_migrations (version, checksum) VALUES ('%s', '%s');\n" "$version" "$sum"
    } | $COMPOSE exec -T "$CLICKHOUSE_SERVICE" sh -ec \
        'clickhouse-client --user "$CLICKHOUSE_USER" --password "$CLICKHOUSE_PASSWORD" --database "$CLICKHOUSE_DB" --multiquery'
done

# The evidence bucket is part of the schema contract: FR-11 stores every
# evidence bundle under it. Idempotent by design (creating an existing bucket
# succeeds).
$COMPOSE exec -T -e BUCKET="$S3_BUCKET" "$S3_SERVICE" sh -ec \
    'printf "s3.bucket.create -name %s\n" "$BUCKET" | weed shell -master=localhost:9333 >/dev/null'

printf 'Done: schemas up to date, bucket %s present.\n' "$S3_BUCKET"

