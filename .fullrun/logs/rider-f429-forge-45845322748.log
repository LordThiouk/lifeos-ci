$ cat core/tests/Feature/Admin/DriverApprovedSmsTest.php
<?php

namespace Tests\Feature\Admin;

use App\Constants\Status;
use App\Models\Admin;
use App\Models\Driver;
use App\Models\Vehicle;
use App\Notify\Sms;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use Spatie\Permission\Models\Permission;
use Tests\TestCase;

/**
 * ISA 2026-11-22-galass-lot-client — ISC-11, ISC-11.1, ISC-11.2, ISC-11.3.
 */
class DriverApprovedSmsTest extends TestCase
{
    protected function setUp(): void
    {
        parent::setUp();

        config([
            'database.default'                     => 'sqlite',
            'database.connections.sqlite.database' => ':memory:',
        ]);
        DB::purge('sqlite');
        DB::reconnect('sqlite');

        $this->bootstrapTables();
    }

    public function test_sends_one_sms_on_validation(): void
    {
        [$admin, $driver] = $this->seedAdminAndDriver(['dv' => Status::PENDING, 'vv' => Status::PENDING]);
        $this->seedVehicle($driver->id);

        $sms = $this->mockSmsCapture();
        $sms->shouldReceive('send')->once();

        $this->actingAs($admin, 'admin')
            ->post(route('admin.driver.approve.all', $driver->id))
            ->assertRedirect();

        $this->assertStringContainsString('221770000001', $sms->capturedTo ?? $driver->dial_code . $driver->mobile);
    }

    public function test_noSms_when_refused_or_already_validated(): void
    {
        [$admin, $incomplete] = $this->seedAdminAndDriver(['dv' => Status::PENDING, 'vv' => Status::PENDING], 'driver1', '770000001');
        $sms = $this->mockSmsCapture();
        $sms->shouldNotReceive('send');

        $this->actingAs($admin, 'admin')
            ->post(route('admin.driver.approve.all', $incomplete->id))
            ->assertRedirect();

        $already = Driver::create([
            'firstname' => 'Done', 'lastname' => 'Driver', 'username' => 'driver2', 'email' => 'd2@example.com',
            'country_code' => 'SN', 'mobile' => '770000002', 'dial_code' => '221', 'password' => bcrypt('password'),
            'status' => Status::USER_ACTIVE, 'dv' => Status::VERIFIED, 'vv' => Status::VERIFIED, 'ev' => 1, 'sv' => 1,
            'driver_data' => json_decode(json_encode([['name' => 'nid', 'type' => 'text', 'value' => '1']])),
        ]);
        $this->seedVehicle($already->id);

        $this->actingAs($admin, 'admin')
            ->post(route('admin.driver.approve.all', $already->id))
            ->assertRedirect();
    }

    public function test_text_is_short_and_has_no_sensitive_data(): void
    {
        [$admin, $driver] = $this->seedAdminAndDriver(['dv' => Status::PENDING, 'vv' => Status::PENDING]);
        $this->seedVehicle($driver->id);

        $captured = new \stdClass();
        $captured->message = null;
        $sms = $this->mockSmsCapture($captured);
        $sms->shouldReceive('send')->once();

        $this->actingAs($admin, 'admin')
            ->post(route('admin.driver.approve.all', $driver->id))
            ->assertRedirect();

        $this->assertNotNull($captured->message);
        $this->assertLessThanOrEqual(160, mb_strlen($captured->message));
        $this->assertStringNotContainsStringIgnoringCase('solde', $captured->message);
        $this->assertStringNotContainsStringIgnoringCase('balance', $captured->message);
        $this->assertStringNotContainsStringIgnoringCase('piece', $captured->message);
        $this->assertStringNotContainsStringIgnoringCase('document', $captured->message);
    }

    public function test_gatewayDown_does_not_block_validation(): void
    {
        [$admin, $driver] = $this->seedAdminAndDriver(['dv' => Status::PENDING, 'vv' => Status::PENDING]);
        $this->seedVehicle($driver->id);

        \Illuminate\Support\Facades\Log::spy();

        $sms = $this->mockSmsCapture();
        $sms->shouldReceive('send')->once()->andThrow(new \RuntimeException('gateway down'));

        $this->actingAs($admin, 'admin')
            ->post(route('admin.driver.approve.all', $driver->id))
            ->assertRedirect();

        $driver->refresh();
        $this->assertSame(Status::VERIFIED, (int) $driver->dv);
        $this->assertSame(Status::VERIFIED, (int) $driver->vv);
        \Illuminate\Support\Facades\Log::shouldHaveReceived('error')->atLeast()->once();
    }

    private function seedAdminAndDriver(array $driverOverrides = [], string $username = 'driver1', string $mobile = '770000001'): array
    {
        $perm = Permission::firstOrCreate(['name' => 'update drivers', 'guard_name' => 'admin']);
        $admin = Admin::firstOrCreate(['email' => 'admin@example.com'], [
            'name' => 'Admin', 'username' => 'admin', 'password' => bcrypt('password'),
        ]);
        if (!$admin->hasPermissionTo($perm)) {
            $admin->givePermissionTo($perm);
        }

        $driver = Driver::create(array_merge([
            'firstname' => 'Test', 'lastname' => 'Driver', 'username' => $username, 'email' => $username . '@example.com',
            'country_code' => 'SN', 'mobile' => $mobile, 'dial_code' => '221', 'password' => bcrypt('password'),
            'status' => Status::USER_ACTIVE, 'dv' => Status::PENDING, 'vv' => Status::PENDING, 'ev' => 1, 'sv' => 1,
            'driver_data' => json_decode(json_encode([['name' => 'nid', 'type' => 'text', 'value' => '123']])),
        ], $driverOverrides));

        return [$admin, $driver];
    }

    private function seedVehicle(int $driverId): void
    {
        Vehicle::create([
            'driver_id' => $driverId, 'vehicle_number' => 'DK-001-AA', 'service_id' => 1,
            'brand_id' => 1, 'model_id' => 1, 'color_id' => 1, 'year_id' => 1,
            'form_data' => json_decode(json_encode([['name' => 'carte_grise', 'type' => 'text', 'value' => 'CG123']])),
        ]);
    }

    private function mockSmsCapture(?\stdClass $captured = null)
    {
        $captured = $captured ?? new \stdClass();
        $mock = \Mockery::mock(Sms::class)->makePartial();
        $mock->shouldReceive('prevConfiguration')->andReturnUsing(function () use ($mock, $captured) {
            $mock->mobile = $mock->user->mobileNumber ?? ($mock->user->dial_code . $mock->user->mobile);
            $captured->to = $mock->mobile;
        });
        $mock->shouldReceive('getMessage')->andReturnUsing(function () use ($captured) {
            $captured->message = 'Votre compte chauffeur Galass a ete valide. Vous pouvez accepter des courses.';
            return $captured->message;
        });
        $this->app->instance(Sms::class, $mock);
        return $mock;
    }

    private function bootstrapTables(): void
    {
        Schema::create('admins', function (Blueprint $table) {
            $table->id(); $table->string('name'); $table->string('username')->unique();
            $table->string('email')->unique(); $table->string('password'); $table->string('image')->nullable();
            $table->rememberToken(); $table->timestamps();
        });
        Schema::create('permissions', function (Blueprint $table) { $table->bigIncrements('id'); $table->string('name'); $table->string('guard_name'); $table->timestamps(); $table->unique(['name','guard_name']); });
        Schema::create('roles', function (Blueprint $table) { $table->bigIncrements('id'); $table->string('name'); $table->string('guard_name'); $table->timestamps(); $table->unique(['name','guard_name']); });
        Schema::create('model_has_permissions', function (Blueprint $table) { $table->unsignedBigInteger('permission_id'); $table->string('model_type'); $table->unsignedBigInteger('model_id'); $table->index(['model_id','model_type']); $table->primary(['permission_id','model_id','model_type']); });
        Schema::create('model_has_roles', function (Blueprint $table) { $table->unsignedBigInteger('role_id'); $table->string('model_type'); $table->unsignedBigInteger('model_id'); $table->index(['model_id','model_type']); $table->primary(['role_id','model_id','model_type']); });
        Schema::create('role_has_permissions', function (Blueprint $table) { $table->unsignedBigInteger('permission_id'); $table->unsignedBigInteger('role_id'); $table->primary(['permission_id','role_id']); });
        Schema::create('drivers', function (Blueprint $table) {
            $table->id(); $table->string('firstname')->nullable(); $table->string('lastname')->nullable();
            $table->string('username')->nullable(); $table->string('email')->nullable(); $table->string('country_code',10)->nullable();
            $table->string('mobile',40)->nullable(); $table->string('dial_code',10)->nullable(); $table->string('password')->nullable();
            $table->tinyInteger('status')->default(1); $table->tinyInteger('dv')->default(0); $table->tinyInteger('vv')->default(0);
            $table->tinyInteger('ev')->default(1); $table->tinyInteger('sv')->default(1); $table->text('driver_data')->nullable();
            $table->unsignedBigInteger('service_id')->nullable(); $table->timestamps();
        });
        Schema::create('vehicles', function (Blueprint $table) {
            $table->id(); $table->unsignedBigInteger('driver_id'); $table->string('vehicle_number')->nullable();
            $table->unsignedBigInteger('service_id')->nullable(); $table->unsignedBigInteger('brand_id')->nullable();
            $table->unsignedBigInteger('model_id')->nullable(); $table->unsignedBigInteger('color_id')->nullable();
            $table->unsignedBigInteger('year_id')->nullable(); $table->text('form_data')->nullable(); $table->timestamps();
        });
        Schema::create('notification_templates', function (Blueprint $table) {
            $table->id(); $table->string('act')->nullable(); $table->string('name')->nullable(); $table->string('subject')->nullable();
            $table->text('email_body')->nullable(); $table->text('sms_body')->nullable(); $table->text('push_body')->nullable();
            $table->text('shortcodes')->nullable(); $table->tinyInteger('email_status')->default(1); $table->tinyInteger('sms_status')->default(1);
            $table->tinyInteger('push_status')->default(1); $table->timestamps();
        });
        Schema::create('notification_logs', function (Blueprint $table) {
            $table->id(); $table->unsignedBigInteger('user_id')->nullable(); $table->unsignedBigInteger('driver_id')->nullable();
            $table->string('notification_type')->nullable(); $table->string('sender')->nullable(); $table->string('sent_from')->nullable();
            $table->string('sent_to')->nullable(); $table->string('subject')->nullable(); $table->text('message')->nullable();
            $table->string('image')->nullable(); $table->timestamps();
        });
        Schema::create('admin_notifications', function (Blueprint $table) {
            $table->id(); $table->unsignedBigInteger('user_id')->default(0); $table->unsignedBigInteger('driver_id')->default(0);
            $table->string('title')->nullable(); $table->string('click_url')->nullable(); $table->tinyInteger('is_read')->default(0); $table->timestamps();
        });
        Schema::create('general_settings', function (Blueprint $table) {
            $table->id(); $table->string('site_name')->default('Galass'); $table->string('cur_text')->default('XOF'); $table->string('cur_sym')->default('F');
            $table->tinyInteger('sn')->default(1); $table->text('sms_config')->nullable(); $table->text('global_shortcodes')->nullable(); $table->timestamps();
        });
        DB::table('general_settings')->insert(['id'=>1,'site_name'=>'Galass','cur_text'=>'XOF','cur_sym'=>'F','sn'=>1,'sms_config'=>json_encode(['name'=>'infobip']),'global_shortcodes'=>json_encode([]),'created_at'=>now(),'updated_at'=>now()]);
        DB::table('notification_templates')->insert(['act'=>'DRIVER_APPROVE_ALL','name'=>'Driver Approved','subject'=>'Validation chauffeur','sms_body'=>'Votre compte chauffeur Galass a ete valide. Vous pouvez accepter des courses.','email_body'=>'Votre compte chauffeur Galass a ete valide.','push_body'=>'Votre compte chauffeur Galass a ete valide.','shortcodes'=>json_encode(['fullname'=>'Driver name']),'sms_status'=>1,'email_status'=>1,'push_status'=>1,'created_at'=>now(),'updated_at'=>now()]);
    }
}

