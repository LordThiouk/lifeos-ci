1	import 'package:galass_driver/data/model/global/ride/ride_model.dart';
     2	
     3	/// Applies `STOP_COMPLETED` Pusher payloads onto an in-memory [RideModel].
     4	class MultistopStopSync {
     5	  MultistopStopSync._();
     6	
     7	  static void applyStopCompletedPayload(
     8	    RideModel ride,
     9	    Map<String, dynamic> payload,
    10	  ) {
    11	    final nestedRide = payload['ride'];
    12	    if (nestedRide is Map) {
    13	      final nestedMap = Map<String, dynamic>.from(nestedRide);
    14	      final nestedId = nestedMap['id']?.toString();
    15	      final currentId = ride.id?.toString();
    16	      final idMatches = nestedId != null &&
    17	          nestedId.isNotEmpty &&
    18	          nestedId != 'null' &&
    19	          currentId != null &&
    20	          currentId.isNotEmpty &&
    21	          nestedId == currentId;
    22	
    23	      if (idMatches) {
    24	        final parsed = RideModel.fromJson(nestedMap);
    25	        // Reject empty/null stops replace — would unlock END via !hasStops.
    26	        if (parsed.stops != null && parsed.stops!.isNotEmpty) {
    27	          ride.stops = parsed.stops;
    28	          return;
    29	        }
    30	      }
    31	      // Mismatched id / empty stops: fall through to stop_id mark (if any).
    32	    }
    33	
    34	    final stopId = payload['stop_id']?.toString();
    35	    if (stopId == null || stopId.isEmpty || ride.stops == null) {
    36	      return;
    37	    }
    38	
    39	    for (final stop in ride.stops!) {
    40	      if (stop.id == stopId) {
    41	        stop.completedAt =
    42	            payload['completed_at']?.toString() ?? DateTime.now().toUtc().toIso8601String();
    43	        break;
    44	      }
    45	    }
    46	  }
    47	}

