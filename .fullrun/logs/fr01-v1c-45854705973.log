   297	  Future<void> completeStop(String rideId) async {
   298	    // A second tap while the first request is in flight must not POST again
   299	    // (the second one would hit an already-advanced timeline).
   300	    if (isCompleteStopBtnLoading) {
   301	      logLine('complete-stop ignored: request already in flight (ride=$rideId)');
   302	      return;
   303	    }
   304	    if (!ride.canConfirmStop) {
   305	      logLine('complete-stop ignored: no pending stop (ride=$rideId)');
   306	      return;
   307	    }
   308	    completeStopError = null;
   309	    isCompleteStopBtnLoading = true;
   310	    update();
   311	    try {
   312	      LastPing? ping;
   313	      try {
   314	        ping = await readLastPing();
   315	      } catch (_) {}
   316	      logLine(
   317	        completeStopRequestLine(
   318	          rideId: rideId,
   319	          stop: ride.pendingStops.isEmpty ? null : ride.pendingStops.first,
   320	          pendingCount: ride.pendingStops.length,
   321	          ping: ping,
   322	          now: DateTime.now(),
   323	        ),
   324	      );
   325	      ResponseModel responseModel = await repo.completeStop(id: rideId);
   326	      final reply = ServerRejection.from(responseModel);
   327	      if (responseModel.statusCode == 200) {
   328	        AuthorizationResponseModel model = AuthorizationResponseModel.fromJson(
   329	          (responseModel.responseJson),
   330	        );
   331	        if (model.status == MyStrings.success) {
   332	          logLine(
   333	            'complete-stop response: http=200 remark=${reply.remark} outcome=accepted ride=$rideId',
   334	          );
   335	          await getRideDetails(rideId, shouldLoading: false);
   336	          update();
   337	        } else {
   338	          final reasons = model.message ?? [MyStrings.somethingWentWrong];
   339	          completeStopError = reasons.join(' ');
   340	          logLine(
   341	            'complete-stop response: http=200 remark=${reply.remark} outcome=refused message=$completeStopError',
   342	          );
   343	          showCompleteStopError(reasons);
   344	        }
   345	      } else {
   346	        completeStopError = reply.text;
   347	        logLine(
   348	          'complete-stop response: http=${responseModel.statusCode} remark=${reply.remark} '
   349	          'outcome=rejected message=${reply.text}',
   350	        );
   351	        showCompleteStopError(reply.messages);
   352	      }
   353	    } catch (e) {
   354	      logLine('complete-stop response: outcome=error exception=$e');
   355	      completeStopError = MyStrings.somethingWentWrong;
   356	      showCompleteStopError([MyStrings.somethingWentWrong]);
   357	    }
   358	    isCompleteStopBtnLoading = false;
   359	    update();
   360	  }
