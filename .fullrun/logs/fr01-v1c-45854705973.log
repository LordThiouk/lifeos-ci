   759	    final String pickupLng = ride.pickupLongitude ?? "";
   760	    final String destLat = ride.destinationLatitude ?? "";
   761	    final String destLng = ride.destinationLongitude ?? "";
   762	
   763	    String url = "";
   764	
   765	    if (ride.status == AppStatus.RIDE_RUNNING) {
   766	      // ✅ Get driver's current location
   767	      Position position = await MyUtils.getCurrentLocationPosition();
   768	
   769	      final String driverLat = position.latitude.toString();
   770	      final String driverLng = position.longitude.toString();
   771	
   772	      // Navigate from driver current → destination
   773	      url = "https://www.google.com/maps/dir/?api=1&origin=$driverLat,$driverLng&destination=$destLat,$destLng&travelmode=driving";
   774	    } else {
   775	      // Navigate from pickup → destination
   776	      url = "https://www.google.com/maps/dir/?api=1&origin=$pickupLat,$pickupLng&destination=$destLat,$destLng&travelmode=driving";
   777	    }
   778	
   779	    final Uri uri = Uri.parse(url);
   780	
   781	    if (await canLaunchUrl(uri)) {
   782	      await launchUrl(uri, mode: LaunchMode.externalApplication);
   783	    } else {
   784	      throw 'Could not open Google Maps.';
   785	    }
