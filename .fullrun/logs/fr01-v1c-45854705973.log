1	class RideStopModel {
     2	  static const int maxCountPerRide = 25;
     3	
     4	  String? id;
     5	  String? sequence;
     6	  String? latitude;
     7	  String? longitude;
     8	  String? locationLabel;
     9	  String? zoneId;
    10	  String? completedAt;
    11	
    12	  RideStopModel({
    13	    this.id,
    14	    this.sequence,
    15	    this.latitude,
    16	    this.longitude,
    17	    this.locationLabel,
    18	    this.zoneId,
    19	    this.completedAt,
    20	  });
    21	
    22	  factory RideStopModel.fromJson(Map<String, dynamic> json) => RideStopModel(
    23	        id: json['id']?.toString(),
    24	        sequence: json['sequence']?.toString(),
    25	        latitude: json['latitude']?.toString(),
    26	        longitude: json['longitude']?.toString(),
    27	        locationLabel: json['location_label']?.toString(),
    28	        zoneId: json['zone_id']?.toString(),
    29	        completedAt: json['completed_at']?.toString(),
    30	      );
    31	
    32	  Map<String, dynamic> toJson() => {
    33	        'id': id,
    34	        'sequence': sequence,
    35	        'latitude': latitude,
    36	        'longitude': longitude,
    37	        'location_label': locationLabel,
    38	        'zone_id': zoneId,
    39	        'completed_at': completedAt,
    40	      };
    41	
    42	  bool get isCompleted {
    43	    final value = completedAt;
    44	    return value != null && value.isNotEmpty && value != 'null';
    45	  }
    46	
    47	  static bool isValidCoordinates(double lat, double lng) {
    48	    if (lat == 0 && lng == 0) {
    49	      return false;
    50	    }
    51	    if (lat < -90 || lat > 90) {
    52	      return false;
    53	    }
    54	    if (lng < -180 || lng > 180) {
    55	      return false;
    56	    }
    57	    return true;
    58	  }
    59	
    60	  ({double lat, double lng})? parsedCoordinates() {
    61	    final lat = double.tryParse(latitude ?? '');
    62	    final lng = double.tryParse(longitude ?? '');
    63	    if (lat == null || lng == null) {
    64	      return null;
    65	    }
    66	    if (!isValidCoordinates(lat, lng)) {
    67	      return null;
    68	    }
    69	    return (lat: lat, lng: lng);
    70	  }
    71	}

