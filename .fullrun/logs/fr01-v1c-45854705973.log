    45	
    46	    for (final mechanism in ['rKv', 'trParams']) {
    47	      for (final form in ['at', 'curly']) {
    48	        test('mechanism=$mechanism form=$form covers every source token', () {
    49	          for (final token in tokens) {
    50	            String probe;
    51	            switch ((mechanism, form)) {
    52	              case ('rKv', 'at'):
    53	                probe = 'X @$token Z'.rKv({token: 'V'});
    54	              case ('rKv', 'curly'):
    55	                probe = 'X {$token} Z'.rKv({token: 'V'});
    56	              case ('trParams', 'at'):
    57	                probe = 'X @$token Z'.trParams({token: 'V'});
    58	              default:
    59	                // GetX trParams only replaces the @$key form; the curly form
    60	                // is rKv's job (see const comment in my_strings.dart).
    61	                continue;
    62	            }
    63	            expect(
    64	              probe.contains(form == 'at' ? '@$token' : '{$token}'),
    65	              isFalse,
    66	              reason: 'token "$token" survives $mechanism/$form "$probe"',
    67	            );
    68	            expect(probe, contains('V'), reason: 'token "$token" substituted');
    69	          }
    70	        });
    71	      }
    72	    }
