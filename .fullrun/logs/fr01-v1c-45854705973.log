   115	  /// Targets map navigation to [RideModel] current_leg (pending stop or final dest).
   116	  void loadMapForRide(RideModel tRide) {
   117	    pickupLatLng = LatLng(
   118	      StringConverter.formatDouble(
   119	        tRide.pickupLatitude.toString(),
   120	        precision: 16,
   121	      ),
   122	      StringConverter.formatDouble(
   123	        tRide.pickupLongitude.toString(),
   124	        precision: 16,
   125	      ),
   126	    );
   127	    destinationLatLng = LatLng(
   128	      StringConverter.formatDouble(
   129	        tRide.destinationLatitude.toString(),
   130	        precision: 16,
   131	      ),
   132	      StringConverter.formatDouble(
   133	        tRide.destinationLongitude.toString(),
   134	        precision: 16,
   135	      ),
   136	    );
   137	
   138	    LatLng? currentLeg;
   139	    final intermediateStops = <LatLng>[];
   140	    if (tRide.hasStops) {
   141	      final next = tRide.nextLegCoordinates();
   142	      if (next != null) {
   143	        currentLeg = LatLng(next.lat, next.lng);
   144	      }
   145	      for (final stop in tRide.stops!) {
   146	        if (stop.isCompleted) {
   147	          continue;
   148	        }
   149	        final coords = stop.parsedCoordinates();
   150	        if (coords == null) {
   151	          continue;
   152	        }
   153	        final point = LatLng(coords.lat, coords.lng);
   154	        if (currentLeg != null &&
   155	            point.latitude == currentLeg.latitude &&
   156	            point.longitude == currentLeg.longitude) {
   157	          continue;
   158	        }
   159	        intermediateStops.add(point);
   160	      }
   161	    }
   162	
   163	    mapController.setStopMarkers(RideStopProgress.listFromRide(tRide));
   164	    mapController.loadMap(
   165	      pickup: pickupLatLng,
   166	      destination: destinationLatLng,
   167	      intermediateStops: intermediateStops,
   168	      currentLeg: currentLeg,
   169	    );
   170	  }
