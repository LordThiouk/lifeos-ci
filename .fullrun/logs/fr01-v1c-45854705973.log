   149	///
   150	/// False positives are filtered:
   151	///  - tokens must be surrounded by placeholder context (start/quote/space/
   152	///    punctuation), so `support-ompay@domain`-style and regex literals
   153	///    (`]+@[a-z]`) are not read as tokens;
   154	///  - email addresses (`x@y.z`) are excluded outright.
   155	Set<String> _deriveTokensFromSource() {
   156	  final source =
   157	      File('lib/core/utils/my_strings.dart').readAsStringSync();
   158	  final at = RegExp(r'@[a-zA-Z][a-zA-Z0-9]*');
   159	  final curly = RegExp(r'\{[a-zA-Z][a-zA-Z0-9]*\}');
   160	  final email = RegExp(r'[\w.-]+@[\w.-]+\.\w+');
   161	
   162	  var scanned = source.replaceAll(RegExp(r'//[^\n]*'), '');
   163	  final emailMatches = email.allMatches(scanned);
   164	  for (final m in emailMatches) {
   165	    scanned = scanned.replaceRange(m.start, m.end, ' ');
   166	  }
   167	
   168	  final tokens = <String>{};
   169	  for (final m in at.allMatches(scanned)) {
   170	    final i = m.start;
   171	    final prev = i > 0 ? scanned.substring(i - 1, i) : ' ';
   172	    // Skip regex-literal contexts (e.g. `]+@[a-z]`) and mid-word '@'.
   173	    if (_isWordChar(prev) || prev == '.' || prev == ']' || prev == '[') {
   174	      continue;
   175	    }
   176	    tokens.add(m[0]!.substring(1));
   177	  }
   178	  for (final m in curly.allMatches(scanned)) {
   179	    final t = m[0]!.substring(1, m[0]!.length - 1);
   180	    tokens.add(t);
   181	  }
   182	  return tokens;
   183	}
   184	
   185	bool _isWordChar(String c) =>
   186	    RegExp(r'[a-zA-Z0-9"]').hasMatch(c);

