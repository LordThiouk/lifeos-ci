1	import 'package:galass_driver/data/model/global/ride/ride_model.dart';
     2	import 'package:galass_driver/data/model/global/ride/ride_stop_model.dart';
     3	
     4	/// Merges a ride parsed from a Pusher event into the ride currently displayed.
     5	///
     6	/// A ride event may ship a *partial* ride: applying it with
     7	/// `RideDetailsController.updateRide` replaces the ride wholesale, so every
     8	/// field the payload does not carry is lost from the driver screen. This class
     9	/// keeps the event as the source of truth for what it does carry and preserves
    10	/// what it does not:
    11	///
    12	/// - a missing/empty `stops` list keeps the known multistop timeline (and the
    13	///   locally known `completedAt` of its escales) — an empty list must never
    14	///   unlock END by erasing a timeline;
    15	/// - a non-empty `stops` list is merged escale by escale, never swapped in
    16	///   wholesale: a payload that carries stop 1 as *not* completed must not erase
    17	///   a `completed_at` the driver just wrote locally, otherwise CONFIRM STOP
    18	///   re-opens (double POST) and END re-locks (F5);
    19	/// - a null identity keeps the known passenger;
    20	/// - an unknown id (`null`, `""`, `"null"`, `"-1"`, `"0"`) inherits the current
    21	///   ride id, so a payload without `ride.id` never replaces `ride.id` with the
    22	///   string `RideModel.fromJson` produces, which every later API call would use.
    23	///
    24	/// State is never carried across two different rides.
    25	class RideEventMerge {
    26	  RideEventMerge._();
    27	
    28	  /// Returns the ride to apply. [event] is mutated in place and returned.
    29	  static RideModel applyEvent({
    30	    required RideModel? current,
    31	    required RideModel event,
    32	  }) {
    33	    if (current == null) {
    34	      return event;
    35	    }
    36	
    37	    // The incoming id is unknown: keep the id already on screen.
    38	    if (_normalizedId(event.id) == null && _normalizedId(current.id) != null) {
    39	      event.id = current.id;
    40	    }
    41	
    42	    if (!_sameOrUnknownRide(current, event)) {
    43	      return event;
    44	    }
    45	
    46	    final eventStops = event.stops;
    47	    if (eventStops == null || eventStops.isEmpty) {
    48	      if (current.hasStops) {
    49	        event.stops = current.stops;
    50	      }
    51	    } else {
    52	      event.stops = _mergeStops(
    53	        local: current.stops ?? const <RideStopModel>[],
    54	        incoming: eventStops,
    55	      );
    56	    }
    57	    if (event.user == null && current.user != null) {
    58	      event.user = current.user;
    59	    }
    60	    return event;
    61	  }
    62	
    63	  /// Fuses an incoming timeline into the known one, escale by escale.
    64	  ///
    65	  /// The event wins on every field it carries (a later `completed_at` included).
    66	  /// It loses on the one thing it cannot prove: an absent `completed_at` is not
    67	  /// evidence that the escale is pending again — the driver's CONFIRM STOP may
    68	  /// not have round-tripped yet.
    69	  static List<RideStopModel> _mergeStops({
    70	    required List<RideStopModel> local,
    71	    required List<RideStopModel> incoming,
    72	  }) {
    73	    final localHasCompleted = local.any((stop) => stop.isCompleted);
    74	    if (localHasCompleted && !_sameTimeline(local, incoming)) {
    75	      // A different, completed-free timeline cannot be proven newer than a local
    76	      // completion (out-of-order event): keeping the known escales is the only
    77	      // choice that cannot re-open CONFIRM STOP or re-lock END.
    78	      return local;
    79	    }
    80	    final merged = <RideStopModel>[];
    81	    for (final stop in incoming) {
    82	      final known = _localStopFor(local, stop);
    83	      if (known != null) {
    84	        _fillMissingFields(stop: stop, known: known);
    85	        if (!stop.isCompleted && known.isCompleted) {
    86	          stop.completedAt = known.completedAt;
    87	        }
    88	      }
    89	      merged.add(stop);
    90	    }
    91	    return merged;
    92	  }
    93	
    94	  /// Same timeline = same length and the same identifier at every position
    95	  /// (`id` when both sides carry one, `sequence` otherwise).
    96	  static bool _sameTimeline(
    97	    List<RideStopModel> local,
    98	    List<RideStopModel> incoming,
    99	  ) {
   100	    if (local.length != incoming.length) {
   101	      return false;
   102	    }
   103	    for (var i = 0; i < local.length; i++) {
   104	      final known = local[i];
   105	      final event = incoming[i];
   106	      final knownId = _stopKey(known.id);
   107	      final eventId = _stopKey(event.id);
   108	      if (knownId != null && eventId != null) {
   109	        if (knownId != eventId) {
   110	          return false;
   111	        }
   112	        continue;
   113	      }
   114	      final knownSeq = _stopKey(known.sequence);
   115	      final eventSeq = _stopKey(event.sequence);
   116	      if (knownSeq != null && eventSeq != null) {
   117	        if (knownSeq != eventSeq) {
   118	          return false;
   119	        }
   120	        continue;
   121	      }
   122	      return false;
   123	    }
   124	    return true;
   125	  }
   126	
   127	  static RideStopModel? _localStopFor(
   128	    List<RideStopModel> local,
   129	    RideStopModel incoming,
   130	  ) {
   131	    final id = _stopKey(incoming.id);
   132	    if (id != null) {
   133	      for (final stop in local) {
   134	        if (_stopKey(stop.id) == id) {
   135	          return stop;
   136	        }
   137	      }
   138	    }
   139	    final sequence = _stopKey(incoming.sequence);
   140	    if (sequence != null) {
   141	      for (final stop in local) {
   142	        if (_stopKey(stop.sequence) == sequence) {
   143	          return stop;
   144	        }
   145	      }
   146	    }
   147	    return null;
   148	  }
   149	
   150	  /// Per-field fallback: a payload that omits a field keeps the known one.
   151	  static void _fillMissingFields({
   152	    required RideStopModel stop,
   153	    required RideStopModel known,
   154	  }) {
   155	    stop.id ??= known.id;
   156	    stop.sequence ??= known.sequence;
   157	    stop.latitude ??= known.latitude;
   158	    stop.longitude ??= known.longitude;
   159	    stop.locationLabel ??= known.locationLabel;
   160	    stop.zoneId ??= known.zoneId;
   161	  }
   162	
   163	  static String? _stopKey(String? raw) {
   164	    final value = raw?.trim();
   165	    if (value == null || value.isEmpty || value == 'null') {
   166	      return null;
   167	    }
   168	    return value;
   169	  }
   170	
   171	  /// Never carry stops/identity across two different rides.
   172	  static bool _sameOrUnknownRide(RideModel current, RideModel event) {
   173	    final currentId = _normalizedId(current.id);
   174	    final eventId = _normalizedId(event.id);
   175	    if (currentId == null || eventId == null) {
   176	      return true;
   177	    }
   178	    return currentId == eventId;
   179	  }
   180	
   181	  /// `-1`/`0` are [RideDetailsController.ride]'s initial placeholder, so they
   182	  /// read as "unknown" exactly like `-1`/`0`/`"null"` do in
   183	  /// `RideMessageController.normalizeRideId`.
   184	  static String? _normalizedId(String? raw) {
   185	    final value = raw?.trim();
   186	    if (value == null ||
   187	        value.isEmpty ||
   188	        value == '-1' ||
   189	        value == '0' ||
   190	        value == 'null') {
   191	      return null;
   192	    }
   193	    return value;
   194	  }
   195	}
