import 'dart:io';

import 'package:galass_driver/data/model/global/response_model/response_model.dart';
import 'package:galass_driver/data/services/api_client.dart';
import 'package:shared_preferences/shared_preferences.dart';

class RecordingApiClient extends ApiClient {
  RecordingApiClient({required super.sharedPreferences});

  String? lastUri;
  String? lastMethod;
  Map<String, dynamic>? lastParams;
  bool? lastPassHeader;
  bool? lastSkipAuthSideEffects;
  bool? lastRedactSensitiveLogs;

  /// Empty = no Sanctum session (FCM must not POST).
  String sanctumToken = 'test-sanctum-token';

  /// ISC-PN-17 — track that FCM forced memory load via initToken().
  bool initTokenCalled = false;

  ResponseModel responseToReturn = ResponseModel(
    true,
    'ok',
    200,
    <String, dynamic>{},
  );

  ResponseModel multipartResponseToReturn = ResponseModel(
    true,
    'ok',
    200,
    <String, dynamic>{'status': 'success', 'message': <String>['ok']},
  );

  String? lastMultipartUri;
  String? lastMultipartMethod;
  Map<String, dynamic>? lastMultipartFields;
  Map<String, File>? lastMultipartFiles;
  bool? lastMultipartPassHeader;

  @override
  Future<String> getToken() async => sanctumToken;

  @override
  Future<void> initToken() async {
    initTokenCalled = true;
    token = sanctumToken;
    tokenType = 'Bearer';
  }

  @override
  Future<ResponseModel> request(
    String uri,
    String method,
    Map<String, dynamic>? params, {
    bool passHeader = false,
    bool isOnlyAcceptType = false,
    bool skipAuthSideEffects = false,
    bool redactSensitiveLogs = false,
  }) async {
    lastUri = uri;
    lastMethod = method;
    lastParams = params;
    lastPassHeader = passHeader;
    lastSkipAuthSideEffects = skipAuthSideEffects;
    lastRedactSensitiveLogs = redactSensitiveLogs;
    return responseToReturn;
  }

  @override
  Future<ResponseModel> multipartRequest(
    String uri,
    String method,
    Map<String, dynamic>? fields, {
    required Map<String, File> files,
    bool passHeader = false,
  }) async {
    lastMultipartUri = uri;
    lastMultipartMethod = method;
    lastMultipartFields = fields;
    lastMultipartFiles = files;
    lastMultipartPassHeader = passHeader;
    return multipartResponseToReturn;
  }
}

/// Secure-storage miss: getToken() always '', but initToken fills [token].
class MemoryAfterInitRecordingApiClient extends RecordingApiClient {
  MemoryAfterInitRecordingApiClient({required super.sharedPreferences});

  static const fixtureSanctum = 'bearer-xyz';

  @override
  Future<String> getToken() async => '';

  @override
  Future<void> initToken() async {
    initTokenCalled = true;
    token = fixtureSanctum;
    tokenType = 'Bearer';
  }
}

