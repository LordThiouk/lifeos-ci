   113	
   114	  bool get hasStops => stops != null && stops!.isNotEmpty;
   115	
   116	  Iterable<RideStopModel> get pendingStops =>
   117	      stops?.where((stop) => !stop.isCompleted) ?? const [];
   118	
   119	  bool get allStopsAcknowledged => !hasStops || pendingStops.isEmpty;
   120	
   121	  /// END course autorisé (destination finale seulement si escales ack).
   122	  bool get canEndRide => allStopsAcknowledged;
   123	
   124	  bool get canConfirmStop => hasStops && pendingStops.isNotEmpty;
   125	
   126	  /// Prochaine cible navigation : première escale pending, sinon destination.
   127	  ({double lat, double lng})? nextLegCoordinates() {
   128	    if (!hasStops) {
   129	      return null;
   130	    }
   131	    final pending = pendingStops.toList();
   132	    if (pending.isNotEmpty) {
   133	      return pending.first.parsedCoordinates();
   134	    }
   135	    final destLat = double.tryParse(destinationLatitude ?? '');
   136	    final destLng = double.tryParse(destinationLongitude ?? '');
   137	    if (destLat == null || destLng == null) {
   138	      return null;
   139	    }
   140	    if (!RideStopModel.isValidCoordinates(destLat, destLng)) {
   141	      return null;
   142	    }
   143	    return (lat: destLat, lng: destLng);
   144	  }
   145	
   146	  static List<RideStopModel>? parseStops(dynamic raw) {
   147	    if (raw == null) {
   148	      return null;
   149	    }
   150	    if (raw is! List) {
   151	      return null;
   152	    }
   153	    if (raw.isEmpty) {
   154	      return <RideStopModel>[];
   155	    }
   156	    final parsed = raw
   157	        .whereType<Map>()
   158	        .map((item) => RideStopModel.fromJson(Map<String, dynamic>.from(item)))
   159	        .toList();
   160	    parsed.sort(
   161	      (a, b) => (int.tryParse(a.sequence ?? '0') ?? 0)
   162	          .compareTo(int.tryParse(b.sequence ?? '0') ?? 0),
   163	    );
   164	    if (parsed.length > RideStopModel.maxCountPerRide) {
   165	      return parsed.sublist(0, RideStopModel.maxCountPerRide);
   166	    }
   167	    return parsed;
   168	  }
   169	
   170	  static GlobalUser? _parseRideUser(Map<String, dynamic> json) {
   171	    final raw = json['user'] ?? json['rider'] ?? json['User'];
   172	    if (raw is Map<String, dynamic>) {
   173	      return GlobalUser.fromJson(raw);
   174	    }
   175	    if (raw is Map) {
   176	      return GlobalUser.fromJson(Map<String, dynamic>.from(raw));
   177	    }
   178	    return null;
   179	  }
