import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:galass_driver/core/utils/app_status.dart';
import 'package:galass_driver/core/utils/my_color.dart';
import 'package:galass_driver/core/utils/my_strings.dart';
import 'package:galass_driver/data/controller/map/ride_map_controller.dart';
import 'package:galass_driver/data/controller/ride/ride_details/ride_details_controller.dart';
import 'package:galass_driver/data/model/global/response_model/response_model.dart';
import 'package:galass_driver/data/model/global/ride/ride_model.dart';
import 'package:galass_driver/data/model/global/ride/ride_stop_model.dart';
import 'package:galass_driver/data/repo/polyline/polyline_repo.dart';
import 'package:galass_driver/data/repo/ride/ride_repo.dart';
import 'package:galass_driver/data/services/api_client.dart';
import 'package:galass_driver/presentation/components/buttons/rounded_button.dart';
import 'package:galass_driver/presentation/screens/ride_details/widgets/ride_details_bottom_sheet_widget.dart';
import 'package:get/get.dart';
import 'package:google_maps_flutter/google_maps_flutter.dart';
import 'package:shared_preferences/shared_preferences.dart';

import '../helpers/recording_api_client.dart';

/// No HTTP: the CTA contract is the widget tree, never a response.
class _NoopRideRepo extends RideRepo {
  _NoopRideRepo({required super.apiClient});

  @override
  Future<ResponseModel> getRideDetails(String id) async =>
      ResponseModel(true, 'ok', 200, <String, dynamic>{});
}

/// No GoogleMap platform view in the test host.
class _NoopMap extends RideMapController {
  _NoopMap({required super.polylineRepo});

  @override
  void loadMap({
    required LatLng pickup,
    required LatLng destination,
    List<LatLng> intermediateStops = const <LatLng>[],
    LatLng? currentLeg,
  }) {}

  @override
  Future<void> setCustomMarkerIcon({bool? isRunning}) async {}
}

RideModel _rideWithStops({required int completed}) => RideModel(
      id: '42',
      status: AppStatus.RIDE_RUNNING,
      pickupLocation: 'Plateau, Dakar',
      destination: 'Aéroport AIBD, Diass',
      distance: '38.4',
      duration: '52',
      amount: '12500',
      stops: List<RideStopModel>.generate(3, (index) {
        final sequence = index + 1;
        return RideStopModel(
          id: '$sequence',
          sequence: '$sequence',
          latitude: '14.70$sequence',
          longitude: '-17.44$sequence',
          locationLabel: 'Arrêt $sequence',
          completedAt:
              index < completed ? '2026-11-23 09:1$sequence:00' : null,
        );
      }),
    );

RideModel _rideWithStatus(String status) => RideModel(
      id: '77',
      status: status,
      pickupLocation: 'Plateau, Dakar',
      destination: 'Aéroport AIBD, Diass',
      distance: '38.4',
      duration: '52',
      amount: '12500',
    );

Future<RideDetailsController> _createController() async {
  Get.testMode = true;
  Get.reset();
  SharedPreferences.setMockInitialValues(<String, Object>{});
  final prefs = await SharedPreferences.getInstance();
  final apiClient = RecordingApiClient(sharedPreferences: prefs);
  Get.put<ApiClient>(apiClient);
  final controller = Get.put<RideDetailsController>(
    RideDetailsController(
      repo: _NoopRideRepo(apiClient: apiClient),
      mapController: _NoopMap(
        polylineRepo: PolylineRepo(apiClient: apiClient),
      ),
    ),
  );
  controller.currency = 'FCFA';
  controller.userImageUrl = '';
  controller.isLoading = false;
  return controller;
}

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  late RideDetailsController controller;

  Future<void> pumpSheet(WidgetTester tester, RideModel ride) async {
    controller.ride = ride;
    await tester.pumpWidget(
      GetMaterialApp(
        home: Scaffold(
          body: Align(
            alignment: Alignment.bottomCenter,
            child: SizedBox(
              height: 560,
              child: RideDetailsBottomSheetWidget(
                scrollController: ScrollController(),
                draggableScrollableController: DraggableScrollableController(),
              ),
            ),
          ),
        ),
      ),
    );
    await tester.pump(const Duration(milliseconds: 100));
    await tester.pump(const Duration(milliseconds: 100));
  }

  group('RideModel multistop end gate', () {
    test('canEndRide true when no stops', () {
      final ride = RideModel(id: '1');
      expect(ride.canEndRide, isTrue);
      expect(ride.canConfirmStop, isFalse);
    });

    test('canEndRide false while a stop is pending', () {
      final ride = RideModel(
        id: '1',
        stops: [
          RideStopModel(
            id: '10',
            sequence: '1',
            latitude: '14.7',
            longitude: '-17.4',
            completedAt: null,
          ),
        ],
      );
      expect(ride.canEndRide, isFalse);
      expect(ride.canConfirmStop, isTrue);
    });

    test('canEndRide true when all stops completed', () {
      final ride = RideModel(
        id: '1',
        stops: [
          RideStopModel(
            id: '10',
            sequence: '1',
            latitude: '14.7',
            longitude: '-17.4',
            completedAt: '2026-10-07T00:00:00Z',
          ),
        ],
      );
      expect(ride.canEndRide, isTrue);
      expect(ride.canConfirmStop, isFalse);
    });
  });

  group('ISC-F5-12 — une seule action principale par état', () {
    setUp(() async {
      controller = await _createController();
    });

    tearDown(Get.reset);

    testWidgets('escale(s) pending → « Confirmer l\'arrêt » seul',
        (tester) async {
      await pumpSheet(tester, _rideWithStops(completed: 1));

      final confirm = find.byKey(const Key('driver_confirm_stop_cta'));
      final end = find.byKey(const Key('driver_end_ride_cta'));
      expect(confirm, findsOneWidget);
      expect(end, findsNothing);
      expect(tester.widget<RoundedButton>(confirm).isDisabled, isFalse);
      // Falsifier ISC-F5-12: deux CTA actionnables simultanément.
      expect(find.byType(RoundedButton), findsOneWidget);
    });

    testWidgets('dernier arrêt → « Terminer la course » seul, style actif',
        (tester) async {
      await pumpSheet(tester, _rideWithStops(completed: 3));

      final confirm = find.byKey(const Key('driver_confirm_stop_cta'));
      final end = find.byKey(const Key('driver_end_ride_cta'));
      expect(confirm, findsNothing);
      expect(end, findsOneWidget);

      final endButton = tester.widget<RoundedButton>(end);
      expect(endButton.isDisabled, isFalse);
      // Style distinct de la couleur primaire (pas seulement l'opacité 0.6).
      expect(endButton.bgColor, MyColor.greenSuccessColor);
      expect(endButton.bgColor, isNot(MyColor.getPrimaryColor()));
      expect(find.byType(RoundedButton), findsOneWidget);
    });

    testWidgets('course single-stop (sans stops[]) → « Terminer la course » seul, style legacy',
        (tester) async {
      await pumpSheet(
        tester,
        RideModel(
          id: '43',
          status: AppStatus.RIDE_RUNNING,
          pickupLocation: 'Plateau, Dakar',
          destination: 'Aéroport AIBD, Diass',
          distance: '38.4',
          duration: '52',
          amount: '12500',
        ),
      );

      expect(find.byKey(const Key('driver_confirm_stop_cta')), findsNothing);
      final end = find.byKey(const Key('driver_end_ride_cta'));
      expect(end, findsOneWidget);
      final endButton = tester.widget<RoundedButton>(end);
      expect(endButton.isDisabled, isFalse);
      // Backward compatible: sans stops[], le CTA garde sa couleur historique.
      expect(endButton.bgColor, isNull);
      expect(find.byType(RoundedButton), findsOneWidget);
    });
  });

  group('ISC-F5-13 — « Annuler la course » reste une action danger', () {
    setUp(() async {
      controller = await _createController();
    });

    tearDown(Get.reset);

    testWidgets('quel que soit l\'état, un CTA Annuler rendu est en danger',
        (tester) async {
      const statuses = <String>[
        AppStatus.RIDE_PENDING,
        AppStatus.RIDE_ACTIVE,
        AppStatus.RIDE_RUNNING,
        AppStatus.RIDE_PAYMENT_REQUESTED,
        AppStatus.RIDE_COMPLETED,
        AppStatus.RIDE_CANCELED,
      ];
      final statesWithCancel = <String>[];

      for (final status in statuses) {
        await pumpSheet(tester, _rideWithStatus(status));
        final cancel = find.byKey(const Key('driver_cancel_ride_cta'));
        if (cancel.evaluate().isEmpty) continue;
        statesWithCancel.add(status);
        final button = tester.widget<RoundedButton>(cancel);
        // Falsifier ISC-F5-13: un Annuler rendu dans une autre couleur.
        expect(button.bgColor, MyColor.redCancelTextColor,
            reason: 'statut $status');
        expect(button.text, MyStrings.cancelRide);
      }

      // Garde-fou: le test doit réellement voir le CTA au moins une fois.
      expect(statesWithCancel, isNotEmpty);
      expect(statesWithCancel, contains(AppStatus.RIDE_ACTIVE));
    });

    testWidgets('RIDE_ACTIVE — danger ≠ couleur du CTA principal',
        (tester) async {
      await pumpSheet(tester, _rideWithStatus(AppStatus.RIDE_ACTIVE));

      final cancel = find.byKey(const Key('driver_cancel_ride_cta'));
      final primary = find.byKey(const Key('driver_pickup_passenger_cta'));
      expect(cancel, findsOneWidget);
      expect(primary, findsOneWidget);

      final cancelButton = tester.widget<RoundedButton>(cancel);
      final primaryButton = tester.widget<RoundedButton>(primary);
      final cancelBg = cancelButton.bgColor;
      final primaryBg = primaryButton.bgColor ?? MyColor.primaryButtonColor;

      expect(cancelBg, MyColor.redCancelTextColor);
      expect(cancelBg, isNot(primaryBg));
      expect(primaryBg, isNot(MyColor.redCancelTextColor));
    });
  });
}

