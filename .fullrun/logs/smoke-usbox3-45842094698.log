#!/usr/bin/env python3
"""Static check of the Rider Android toolchain against the compatibility windows
read from flutter_tools/lib/src/android/gradle_utils.dart (local Flutter 3.35.6)
plus the official AGP/KGP matrices."""
import re, sys

def v(s):
    return tuple(int(x) for x in s.split('.'))

def within(x, lo, hi, inclusive_max=False):
    x, lo, hi = v(x), v(lo), v(hi)
    return lo <= x <= hi if inclusive_max else lo <= x < hi

ok = True
def check(label, cond, detail):
    global ok
    print(('PASS' if cond else 'FAIL'), '-', label, '|', detail)
    ok = ok and cond

wrap = open('android/gradle/wrapper/gradle-wrapper.properties').read()
m = re.search(r'gradle-([0-9.]+)-all\.zip', wrap)
gradle = m.group(1) if m else None
settings = open('android/settings.gradle.kts').read()
agp = re.search(r'com\.android\.application"\) version "([0-9.]+)"', settings).group(1)
kgp = re.search(r'org\.jetbrains\.kotlin\.android"\) version "([0-9.]+)"', settings).group(1)
gms = re.search(r'google-services"\) version\("([0-9.]+)"\)', settings).group(1)
crash = re.search(r'crashlytics"\) version\("([0-9.]+)"\)', settings).group(1)

print(f'detected: gradle={gradle} agp={agp} kgp={kgp} gms={gms} crashlytics={crash}')

# flutter validateGradleAndAgp: AGP 8.11.0-8.11.99 -> Gradle >= 8.13 (max = maxKnown)
check('validateGradleAndAgp (AGP 8.11 -> Gradle >=8.13)',
      within(agp, '8.11.0', '8.11.99', True) and within(gradle, '8.13', '100.0', True),
      f'AGP {agp} / Gradle {gradle}')

# flutter validateGradleAndKGP: KGP 2.2.20-2.2.29 -> 7.6.3 <= Gradle < 8.14.99
check('validateGradleAndKGP (KGP 2.2.20 -> Gradle 7.6.3..<8.14.99)',
      within(kgp, '2.2.20', '2.2.29', True) and within(gradle, '7.6.3', '8.14.99'),
      f'KGP {kgp} / Gradle {gradle}')

# flutter validateAgpAndKgp: KGP 2.2.20-2.2.29 -> 7.3.1 <= AGP < 8.12
check('validateAgpAndKgp (KGP 2.2.20 -> AGP 7.3.1..<8.12)',
      within(kgp, '2.2.20', '2.2.29', True) and within(agp, '7.3.1', '8.12'),
      f'KGP {kgp} / AGP {agp}')

# official AGP 8.11 matrix: min Gradle 8.13, max API 36
check('AGP 8.11 min Gradle 8.13', within(gradle, '8.13', '100.0', True), f'Gradle {gradle}')
app = open('android/app/build.gradle.kts').read()
compile_sdk = re.search(r'compileSdk = (\d+)', app).group(1)
check('AGP 8.11 max API 36 >= compileSdk', int(compile_sdk) <= 36, f'compileSdk {compile_sdk}')

# Firebase/Crashlytics plugins unchanged
check('Firebase plugins unchanged', gms == '4.3.15' and crash == '3.0.7', f'gms {gms} / crashlytics {crash}')

# no AGP9-only flags left
props = open('android/gradle.properties').read()
leftover = [k for k in ('newDsl', 'builtInKotlin', 'proguardAndroidTxt') if k in props]
check('no AGP9-only gradle.properties flags', not leftover, f'leftover={leftover}')

sys.exit(0 if ok else 1)

