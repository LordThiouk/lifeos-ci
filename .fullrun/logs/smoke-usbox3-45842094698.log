import '../helpers/recording_api_client.dart';

class _MapRepo extends PolylineRepo {
  _MapRepo({required super.apiClient});
}

class _RideRepo extends RideRepo {
  _RideRepo({required super.apiClient});
}

typedef _Call = ({String uri, Map<String, dynamic>? params});

class _CountingApiClient extends RecordingApiClient {
  _CountingApiClient({required super.sharedPreferences});

  final List<_Call> calls = [];

  @override
  Future<ResponseModel> request(
    String uri,
    String method,
    Map<String, dynamic>? params, {
    bool passHeader = false,
    bool isOnlyAcceptType = false,
    bool skipAuthSideEffects = false,
    bool redactSensitiveLogs = false,
  }) {
    calls.add((uri: uri, params: params));
    return super.request(
      uri,
      method,
      params,
      passHeader: passHeader,
      isOnlyAcceptType: isOnlyAcceptType,
      skipAuthSideEffects: skipAuthSideEffects,
      redactSensitiveLogs: redactSensitiveLogs,
    );
  }

  List<_Call> get locationPings => calls
      .where((call) => call.uri.endsWith(UrlContainer.driverLocationUpdate))
      .toList();
}

RideModel _ride(String status) => RideModel(id: 'ride-live-19', status: status);

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  late _CountingApiClient apiClient;
  late RideMapController mapController;
  late RideDetailsController details;
  late StreamController<LatLng> positions;

  setUp(() async {
    Get.testMode = true;
    SharedPreferences.setMockInitialValues({});
    final prefs = await SharedPreferences.getInstance();
    apiClient = _CountingApiClient(sharedPreferences: prefs);
    Get.put<ApiClient>(apiClient);
    mapController = RideMapController(
      polylineRepo: _MapRepo(apiClient: apiClient),
    );
    details = RideDetailsController(
      repo: _RideRepo(apiClient: apiClient),
      mapController: mapController,
      locationRepo: DashBoardRepo(apiClient: apiClient),
    );
    Get.put(details);
    positions = StreamController<LatLng>();
    details.driverLocationStreamForTest = () => positions.stream;
  });

  tearDown(() async {
    await positions.close();
    Get.reset();
  });

  group('ISC-F5-19 live driver location in ride', () {
    test('RIDE_ACTIVE: marker follows two successive GPS fixes', () async {
      details.ride = _ride(AppStatus.RIDE_ACTIVE);
      details.startLiveLocationTracking();
      expect(details.isLiveLocationTracking, isTrue);

      const first = LatLng(14.7000, -17.4500);
      const second = LatLng(14.7010, -17.4510);

      positions.add(first);
      await pumpEventQueue();
      expect(mapController.driverLatLng, first);

      positions.add(second);
      await pumpEventQueue();
      expect(mapController.driverLatLng, second);
      expect(mapController.driverLatLng, isNot(first));

      final carMarkers = mapController
          .getMarkers(
            pickup: const LatLng(14.69, -17.44),
            destination: const LatLng(14.72, -17.47),
          )
          .where((marker) => marker.markerId.value == 'driver_location');
      expect(carMarkers, hasLength(1));
      expect(carMarkers.single.position, second);
    });

    test('RIDE_ACTIVE: emits driver/location-update from the ride context',
        () async {
      details.ride = _ride(AppStatus.RIDE_ACTIVE);
      details.startLiveLocationTracking();

      const first = LatLng(14.7000, -17.4500);
      positions.add(first);
      await pumpEventQueue();

      final pings = apiClient.locationPings;
      expect(pings, hasLength(1));
      expect(pings.single.uri,
