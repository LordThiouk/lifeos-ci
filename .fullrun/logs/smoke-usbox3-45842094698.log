import 'dart:io';

import 'package:flutter_test/flutter_test.dart';

/// Anti-2.1 — no active codemagic.yaml; only .deprecated allowed.
/// ISA `galass-version-release-docs-180716`.
void main() {
  final repoRoot = Directory.current.path;

  group('Anti-2.1 Codemagic yaml hygiene', () {
    test('codemagic.yaml must not exist (active yaml forbidden)', () {
      final active = File('$repoRoot/codemagic.yaml');
      expect(
        active.existsSync(),
        isFalse,
        reason: 'Anti-2.1: active codemagic.yaml is forbidden',
      );
    });

    test('codemagic.yaml.deprecated must exist', () {
      final deprecated = File('$repoRoot/codemagic.yaml.deprecated');
      expect(
        deprecated.existsSync(),
        isTrue,
        reason: 'Anti-2.1: deprecated yaml archive must remain',
      );
    });
  });
}

