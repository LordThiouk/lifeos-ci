import 'package:galass_driver/core/utils/app_status.dart';
import 'package:galass_driver/data/model/global/ride/ride_model.dart';
import 'package:galass_driver/data/model/global/ride/ride_stop_model.dart';
import 'package:galass_driver/data/model/global/user/global_user_model.dart';

/// Frozen Driver fixtures for the UI goldens.
///
/// Hard rule: no real ride id, no real phone number, no real address, no real
/// user. Everything below is invented and must stay byte-identical between
/// runs — a changed fixture is a changed golden, and a golden diff that comes
/// from the fixture instead of the UI is a false positive in the gate.
class GoldenFixtures {
  const GoldenFixtures._();

  static GlobalUser rider({
    String firstname = 'Awa',
    String lastname = 'Ndiaye',
    String avgRating = '4.80',
    String mobile = '77 000 00 00',
    String totalReviews = '128',
  }) {
    return GlobalUser(
      id: 'golden-user-1',
      firstname: firstname,
      lastname: lastname,
      name: '$firstname $lastname',
      avatar: null,
      countryCode: '+221',
      mobile: mobile,
      totalReviews: totalReviews,
      avgRating: avgRating,
      status: AppStatus.ENABLE,
    );
  }

  static List<RideStopModel> stops({int completed = 0}) {
    final labels = <String>['Colobane', 'Médina', 'Yoff'];
    return List<RideStopModel>.generate(labels.length, (index) {
      final sequence = index + 1;
      return RideStopModel(
        id: 'golden-stop-$sequence',
        sequence: '$sequence',
        latitude: '14.6928${index + 1}',
        longitude: '-17.4467${index + 1}',
        locationLabel: labels[index],
        zoneId: 'golden-zone-$sequence',
        // Fixed timestamp, never DateTime.now(): a clock read would make the
        // golden non-reproducible.
        completedAt: index < completed ? '2026-11-23 09:1$sequence:00' : null,
      );
    });
  }

  /// Single-stop ride (no `stops[]`) — the legacy shape that must stay
  /// pixel-identical to pre-multistop.
  static RideModel singleStopRide({String status = AppStatus.RIDE_RUNNING}) {
    return RideModel(
      id: 'golden-ride-single',
      uid: 'golden-uid-single',
      userId: 'golden-user-1',
      pickupLocation: 'Plateau, Dakar',
      pickupLatitude: '14.6708',
      pickupLongitude: '-17.4381',
      destination: 'Aéroport AIBD, Diass',
      destinationLatitude: '14.6708',
      destinationLongitude: '-17.0731',
      distance: '38.4',
      duration: '52',
      amount: '12500',
      status: status,
      paymentStatus: '0',
      paymentType: AppStatus.PAYMENT_TYPE_CASH,
      numberOfPassenger: '2',
      user: rider(),
      stops: null,
    );
  }

  /// Multistop ride with [completed] stops already acknowledged.
  ///
  /// The active stop is the first one whose `completed_at` is null, exactly as
  /// the API orders them (`sequence` ASC).
  static RideModel multiStopRide({
    int completed = 0,
    String status = AppStatus.RIDE_RUNNING,
  }) {
    return RideModel(
      id: 'golden-ride-multi',
      uid: 'golden-uid-multi',
      userId: 'golden-user-1',
      pickupLocation: 'Plateau, Dakar',
      pickupLatitude: '14.6708',
      pickupLongitude: '-17.4381',
      destination: 'Aéroport AIBD, Diass',
      destinationLatitude: '14.6708',
      destinationLongitude: '-17.0731',
      distance: '38.4',
      duration: '52',
      amount: '12500',
      status: status,
      paymentStatus: '0',
      paymentType: AppStatus.PAYMENT_TYPE_CASH,
      numberOfPassenger: '2',
      user: rider(),
      stops: stops(completed: completed),
    );
  }

  /// Finished ride, rider not reviewed yet: the sheet shows the "Avis" CTA.
  static RideModel completedRide() {
    return RideModel(
      id: 'golden-ride-completed',
      uid: 'golden-uid-completed',
      userId: 'golden-user-1',
      pickupLocation: 'Plateau, Dakar',
      destination: 'Aéroport AIBD, Diass',
      distance: '38.4',
      duration: '52',
      amount: '12500',
      status: AppStatus.RIDE_COMPLETED,
      paymentStatus: '1',
      paymentType: AppStatus.PAYMENT_TYPE_CASH,
      numberOfPassenger: '2',
      completedAt: '2026-11-23 09:30:00',
      user: rider(),
      stops: stops(completed: 3),
      userReview: null,
    );
  }
}

