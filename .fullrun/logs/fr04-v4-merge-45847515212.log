+
+/// Applies one live GPS fix to the car marker and follows it reasonably
+/// (ISC-F5-19). Called from the ride-context location stream.
+void applyLiveDriverLocation(LatLng position, {DateTime? now}) {
+  driverLatLng = position;
+  _followDriverWithCamera(position, now: now);
+  update();
+}
+
+void _followDriverWithCamera(LatLng position, {DateTime? now}) {
+  final hasMap = mapController != null || cameraAnimatorForTest != null;
+  if (!hasMap) {
+    // The map is still loading: keep the fix for the marker, follow on the
+    // next one once the controller is attached.
+    return;
+  }
+  final at = now ?? DateTime.now();
+  final last = _lastCameraFollowTarget;
+  final lastAt = _lastCameraFollowAt;
+  if (last != null && lastAt != null) {
+    final moved = Geolocator.distanceBetween(
+      last.latitude,
+      last.longitude,
+      position.latitude,
+      position.longitude,
+    );
+    if (moved < cameraFollowMinDistanceMeters) return;
+    if (at.difference(lastAt) < cameraFollowMinInterval) return;
+  }
+  _lastCameraFollowTarget = position;
+  _lastCameraFollowAt = at;
+  final update = CameraUpdate.newLatLng(position);
+  final hook = cameraAnimatorForTest;
+  if (hook != null) {
+    hook(update);
+    return;
+  }
+  mapController?.animateCamera(update);
+}
