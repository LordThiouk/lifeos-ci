import 'dart:async';

import 'package:flutter/material.dart';
import 'package:geolocator/geolocator.dart';
import 'package:get/get.dart';
import 'package:google_maps_flutter/google_maps_flutter.dart';
import 'package:galass_driver/core/helper/string_format_helper.dart';
import 'package:galass_driver/core/helper/last_ping_store.dart';
import 'package:galass_driver/core/helper/location_ping_policy.dart';
import 'package:galass_driver/core/helper/server_rejection.dart';
import 'package:galass_driver/core/route/route.dart';
import 'package:galass_driver/core/utils/app_status.dart';
import 'package:galass_driver/core/utils/my_strings.dart';
import 'package:galass_driver/core/utils/util.dart';
import 'package:galass_driver/data/controller/map/ride_map_controller.dart';
import 'package:galass_driver/data/controller/ride/ride_meassage/ride_meassage_controller.dart';
import 'package:galass_driver/data/model/authorization/authorization_response_model.dart';
import 'package:galass_driver/data/model/global/response_model/response_model.dart';
import 'package:galass_driver/data/model/global/ride/multistop_stop_sync.dart';
import 'package:galass_driver/data/model/global/ride/ride_event_merge.dart';
import 'package:galass_driver/data/model/global/ride/ride_model.dart';
import 'package:galass_driver/data/model/global/ride/ride_stop_progress.dart';
import 'package:galass_driver/data/model/global/user/review_model.dart';
import 'package:galass_driver/data/model/ride/ride_details_response_model.dart';
import 'package:galass_driver/data/repo/dashboard/dashboard_repo.dart';
import 'package:galass_driver/data/repo/ride/ride_repo.dart';
import 'package:galass_driver/environment.dart';
import 'package:galass_driver/presentation/components/snack_bar/show_custom_snackbar.dart';
import 'package:url_launcher/url_launcher.dart';
import 'package:galass_driver/presentation/screens/ride_details/widgets/payment_receive_dialog.dart';

class RideDetailsController extends GetxController {
  RideRepo repo;
  RideMapController mapController;

  /// `driver/location-update` sink. Injected in tests; otherwise built from
  /// the ride repo's API client.
  final DashBoardRepo locationRepo;

  RideDetailsController({
    required this.repo,
    required this.mapController,
    DashBoardRepo? locationRepo,
  }) : locationRepo = locationRepo ?? DashBoardRepo(apiClient: repo.apiClient);

  StreamSubscription<LatLng>? _driverLocationSubscription;
  final LocationPingPolicy _rideLocationPingPolicy = LocationPingPolicy(
    maxIntervalSeconds: Environment.driverLocationUpdateMaxIntervalSeconds,
  );
  DateTime? _lastRideLocationPingAt;

  /// Test seam: replaces the Geolocator position stream.
  @visibleForTesting
  Stream<LatLng> Function()? driverLocationStreamForTest;

  /// Test seam: lets a test advance the ping clock.
  @visibleForTesting
  DateTime Function() nowProvider = DateTime.now;

  /// True while the ride screen listens to the GPS stream (ISC-F5-19).
  bool get isLiveLocationTracking => _driverLocationSubscription != null;

  /// The car only streams and pings while the ride is in progress.
  bool get isRideInProgress =>
      ride.status == AppStatus.RIDE_ACTIVE ||
      ride.status == AppStatus.RIDE_RUNNING;

  /// Sticky/list ACTIVE CTAs — exact status only (null/empty must not flash).
  static bool showsActiveRideCtas(String? status) =>
      status == AppStatus.RIDE_ACTIVE;

  /// CallKit / re-open must not reuse a stale singleton with wrong status/map.
  static RideDetailsController putFresh({
    required RideRepo repo,
    required RideMapController mapController,
  }) {
    if (Get.isRegistered<RideDetailsController>()) {
      Get.delete<RideDetailsController>(force: true);
    }
    return Get.put(
      RideDetailsController(repo: repo, mapController: mapController),
    );
  }

  RideModel ride = RideModel(id: '-1');

  bool isCashPaymentRequest = false;

  /// One cash-payment modal at a time, app-wide.
  ///
  /// Static on purpose: [putFresh] replaces this controller every time the
  /// details screen opens, so an instance flag cannot see the modal opened by
  /// the previous instance — that is exactly how two stacked dialogs (and two
  /// `acceptCashPayment` POSTs) were produced. The modal belongs to the
  /// navigator, not to a controller instance.
  // F3 (accepté non corrigé): les flags statiques ne sont pas remis à zéro au logout; risque faible, documenté dans l'ISA.
  static bool _paymentDialogVisible = false;
  static String? _paymentDialogRideId;

  /// Context of the modal route currently on screen (null when no modal).
  /// Stored so [dismissPaymentDialog] pops *that* route, never whatever route
  /// happens to be on top.
  static BuildContext? _paymentDialogContext;

  /// Generation of the modal currently presented — incremented on every
  /// presentation.
  ///
  /// F1: the state above belongs to ONE modal. Without this counter the
  /// `whenComplete` of a replaced modal A released the state of the live modal
  /// B (A closes after B opened), so `acceptPaymentRide` on B saw no context,
  /// never popped it and left the driver stuck behind a dead modal. Every
  /// cleanup below only runs while `gen == _paymentDialogGen`.
  static int _paymentDialogGen = 0;

  /// Ride whose cash request could not be shown yet (no `BuildContext`). Also
  /// static: the request must survive a controller swap instead of being lost.
  // F3 (accepté non corrigé): les flags statiques ne sont pas remis à zéro au logout; risque faible, documenté dans l'ISA.
  static String? _pendingCashPaymentRideId;

  @visibleForTesting
  String? get pendingCashPaymentRideId => _pendingCashPaymentRideId;

  @visibleForTesting
  static void resetCashPaymentDialogStateForTest() {
    _paymentDialogGen = 0;
    _paymentDialogVisible = false;
    _paymentDialogRideId = null;
    _paymentDialogContext = null;
    _pendingCashPaymentRideId = null;
  }

  /// UI END gate — false while multistop escales are pending.
  bool get canEndRide => ride.canEndRide;

  /// UI CONFIRM STOP — true while at least one escale is pending.
  bool get canConfirmStop => ride.canConfirmStop;

  void updateRide(RideModel newRide) {
    ride = newRide;
    update();
    printX('update ride from event');
  }

  /// Starts the in-ride GPS stream (ISC-F5-19): car marker + camera follow and
  /// `driver/location-update` pings from the ride context, independent of the
  /// home "online" state.
  void startLiveLocationTracking() {
    if (_driverLocationSubscription != null) return;
    if (!isRideInProgress) return;
    // Widget/unit tests must never open a real platform location stream; they
    // inject [driverLocationStreamForTest] when they exercise this path.
    if (Get.testMode && driverLocationStreamForTest == null) return;
    try {
      final stream =
          (driverLocationStreamForTest ?? _defaultDriverLocationStream)();
      _driverLocationSubscription = stream.listen(
        handleDriverLocation,
        onError: (Object error, StackTrace stackTrace) {
          printX('[ride] live location stream error: $error');
        },
      );
      printX('[ride] live location tracking started (ride=${ride.id})');
    } catch (e) {
      printX('[ride] live location tracking unavailable: $e');
    }
  }

  Stream<LatLng> _defaultDriverLocationStream() =>
      Geolocator.getPositionStream(
        locationSettings: const LocationSettings(
          accuracy: LocationAccuracy.bestForNavigation,
          distanceFilter: 5,
        ),
      ).map((position) => LatLng(position.latitude, position.longitude));

  void stopLiveLocationTracking() {
    _driverLocationSubscription?.cancel();
    _driverLocationSubscription = null;
  }

  /// One GPS fix: move the car marker, follow with the camera, ping the server.
  @visibleForTesting
  void handleDriverLocation(LatLng position) {
    if (!isRideInProgress) {
      // The ride ended while the stream was open: stop instead of pinging.
      stopLiveLocationTracking();
      return;
    }
    mapController.applyLiveDriverLocation(position);
    unawaited(pingRideLocation(position));
  }

  /// Sends `driver/location-update` for the current ride, throttled by
  /// [LocationPingPolicy] (same max interval as the foreground service).
  Future<void> pingRideLocation(LatLng position) async {
    if (!isRideInProgress) return;
    final now = nowProvider();
    if (!_rideLocationPingPolicy.shouldPing(
      lastPingAt: _lastRideLocationPingAt,
      now: now,
    )) {
      return;
    }
    // Throttle on the attempt, not on success: a failing backend must not turn
    // every GPS fix into a POST.
    _lastRideLocationPingAt = now;
    try {
      final response = await locationRepo.updateLiveLocation(
        lat: position.latitude.toString(),
        long: position.longitude.toString(),
      );
      printX('[ride] location ping HTTP=${response.statusCode} ride=${ride.id}');
    } catch (e) {
      printX('[ride] location ping error: $e');
    }
  }

  @override
  void onClose() {
    stopLiveLocationTracking();
    super.onClose();
  }

  /// Applies Pusher `STOP_COMPLETED` payload and retargets map to current_leg.
  void applyStopCompleted(Map<String, dynamic> payload) {
    MultistopStopSync.applyStopCompletedPayload(ride, payload);
    loadMapForRide(ride);
    update();
  }

  /// Targets map navigation to [RideModel] current_leg (pending stop or final dest).
  void loadMapForRide(RideModel tRide) {
    pickupLatLng = LatLng(
      StringConverter.formatDouble(
        tRide.pickupLatitude.toString(),
        precision: 16,
      ),
      StringConverter.formatDouble(
        tRide.pickupLongitude.toString(),
        precision: 16,
      ),
    );
    destinationLatLng = LatLng(
      StringConverter.formatDouble(
        tRide.destinationLatitude.toString(),
        precision: 16,
      ),
      StringConverter.formatDouble(
        tRide.destinationLongitude.toString(),
        precision: 16,
      ),
    );

    LatLng? currentLeg;
    final intermediateStops = <LatLng>[];
    if (tRide.hasStops) {
      final next = tRide.nextLegCoordinates();
      if (next != null) {
        currentLeg = LatLng(next.lat, next.lng);
      }
      for (final stop in tRide.stops!) {
        if (stop.isCompleted) {
          continue;
        }
        final coords = stop.parsedCoordinates();
        if (coords == null) {
          continue;
        }
        final point = LatLng(coords.lat, coords.lng);
        if (currentLeg != null &&
            point.latitude == currentLeg.latitude &&
            point.longitude == currentLeg.longitude) {
          continue;
        }
        intermediateStops.add(point);
      }
    }

    mapController.setStopMarkers(RideStopProgress.listFromRide(tRide));
    mapController.loadMap(
      pickup: pickupLatLng,
      destination: destinationLatLng,
      intermediateStops: intermediateStops,
      currentLeg: currentLeg,
    );
  }

  String currency = '';
  String currencySym = '';
  String userImageUrl = '';
  bool isLoading = true;
  bool isRunning = false;
  LatLng pickupLatLng = const LatLng(0, 0);
  LatLng destinationLatLng = const LatLng(0, 0);

  Future<void> getRideDetails(String id, {bool shouldLoading = true}) async {
    final rideId = StringConverter.normalizeDispatchRideId(id) ?? '';
    currency = repo.apiClient.getCurrency();
    currencySym = repo.apiClient.getCurrency(isSymbol: true);
    isLoading = shouldLoading;
    update();

    if (rideId.isEmpty) {
      isLoading = false;
      update();
      return;
    }

    try {
      ResponseModel responseModel = await repo.getRideDetails(rideId);
      if (responseModel.statusCode == 200) {
        RideDetailsResponseModel model = RideDetailsResponseModel.fromJson(
          (responseModel.responseJson),
        );
        if (model.status == MyStrings.success) {
          RideModel? tRide = model.data?.ride;
          userImageUrl = model.data?.userImagePath ?? '';
          if (tRide != null) {
            // F8: same rule as the Pusher events — the API response is the
            // source of truth for what it carries, it does not wipe the rest
            // (a wholesale replace erases every field a response omits, which
            // this file already documents for `updateRide`).
            ride = RideEventMerge.applyEvent(current: ride, event: tRide);
            isRunning = ride.isRunning == '1' ? true : false;
            update();
            loadMapForRide(ride);
          }
          // ISC-F5-19: a ride loaded as ACTIVE/RUNNING starts the car stream;
          // a ride that is no longer in progress stops it.
          if (isRideInProgress) {
            startLiveLocationTracking();
          } else {
            stopLiveLocationTracking();
          }
          if (ride.isRunning == "1" || ride.status == "1") {
            await mapController.setCustomMarkerIcon(isRunning: true);
          }
          if (ride.paymentStatus == "3" && shouldLoading == true) {
            onShowPaymentDialog(Get.context);
          }
          // A request received while no context existed is shown now, on this
          // successful load, instead of being lost (H3).
          consumePendingCashPayment();
        } else {
          CustomSnackBar.error(
            errorList: model.message ?? [MyStrings.somethingWentWrong],
          );
        }
      } else {
        CustomSnackBar.error(errorList: [responseModel.message]);
      }
    } catch (e) {
      printX(e);
    } finally {
      isLoading = false;
      update();
    }
  }

  TextEditingController otpController = TextEditingController();

  bool isStartBtnLoading = false;
  bool isRideStart = false;
  Future<void> startRide(String rideId) async {
    isStartBtnLoading = true;
    update();

    // The explicit id wins: ride.id can still be the untouched default when
    // the model has not been hydrated, and '-1' is never a ride.
    final id = rideId.trim().isNotEmpty ? rideId : (ride.id ?? '-1');
    try {
      ResponseModel responseModel = await repo.startRide(id: id);
      if (responseModel.statusCode == 200) {
        AuthorizationResponseModel model = AuthorizationResponseModel.fromJson(
          (responseModel.responseJson),
        );
        if (model.status == MyStrings.success) {
          isRideStart = true;
          CustomSnackBar.success(
            successList: model.message ?? [MyStrings.requestSuccess.tr],
          );
          // Await the refresh: the RUNNING CTAs render from the refreshed
          // model, so returning first left the ACTIVE screen up while the
          // backend was already RUNNING (e2e point 37, status=3).
          await getRideDetails(id, shouldLoading: false);
          update();
        } else {
          CustomSnackBar.error(
            errorList: model.message ?? [MyStrings.somethingWentWrong],
          );
        }
      } else {
        CustomSnackBar.error(errorList: [responseModel.message]);
      }
    } catch (e) {
      printX(e);
    }
    isStartBtnLoading = false;
    otpController.text = '';
    update();
  }

  bool isEndBtnLoading = false;
  bool isCompleteStopBtnLoading = false;

  /// Why the last complete-stop was refused (server reason when it sent one).
  String? completeStopError;

  @visibleForTesting
  void showCompleteStopError(List<String> messages) => CustomSnackBar.error(errorList: messages);

  /// Sink of the complete-stop log lines (a test records them).
  @visibleForTesting
  void logLine(String line) => printX(line);

  /// Last ping the location service sent (a test supplies one).
  @visibleForTesting
  Future<LastPing?> readLastPing() => LastPingStore.read();

  Future<void> completeStop(String rideId) async {
    // A second tap while the first request is in flight must not POST again
    // (the second one would hit an already-advanced timeline).
    if (isCompleteStopBtnLoading) {
      logLine('complete-stop ignored: request already in flight (ride=$rideId)');
      return;
    }
    if (!ride.canConfirmStop) {
      logLine('complete-stop ignored: no pending stop (ride=$rideId)');
      return;
    }
    completeStopError = null;
    isCompleteStopBtnLoading = true;
    update();
    try {
      LastPing? ping;
      try {
        ping = await readLastPing();
      } catch (_) {}
      logLine(
        completeStopRequestLine(
          rideId: rideId,
          stop: ride.pendingStops.isEmpty ? null : ride.pendingStops.first,
          pendingCount: ride.pendingStops.length,
          ping: ping,
          now: DateTime.now(),
        ),
      );
      ResponseModel responseModel = await repo.completeStop(id: rideId);
      final reply = ServerRejection.from(responseModel);
      if (responseModel.statusCode == 200) {
        AuthorizationResponseModel model = AuthorizationResponseModel.fromJson(
          (responseModel.responseJson),
        );
        if (model.status == MyStrings.success) {
          logLine(
            'complete-stop response: http=200 remark=${reply.remark} outcome=accepted ride=$rideId',
          );
          await getRideDetails(rideId, shouldLoading: false);
          update();
        } else {
          final reasons = model.message ?? [MyStrings.somethingWentWrong];
          completeStopError = reasons.join(' ');
          logLine(
            'complete-stop response: http=200 remark=${reply.remark} outcome=refused message=$completeStopError',
          );
          showCompleteStopError(reasons);
        }
      } else {
        completeStopError = reply.text;
        logLine(
          'complete-stop response: http=${responseModel.statusCode} remark=${reply.remark} '
          'outcome=rejected message=${reply.text}',
        );
        showCompleteStopError(reply.messages);
      }
    } catch (e) {
      logLine('complete-stop response: outcome=error exception=$e');
      completeStopError = MyStrings.somethingWentWrong;
      showCompleteStopError([MyStrings.somethingWentWrong]);
    }
    isCompleteStopBtnLoading = false;
    update();
  }

  Future<void> endRide(String rideId) async {
    if (!canEndRide) {
      CustomSnackBar.error(errorList: [MyStrings.somethingWentWrong]);
      return;
    }
    isEndBtnLoading = true;
    update();
    try {
      ResponseModel responseModel = await repo.endRide(id: rideId);
      if (responseModel.statusCode == 200) {
        AuthorizationResponseModel model = AuthorizationResponseModel.fromJson(
          (responseModel.responseJson),
        );
        if (model.status == MyStrings.success) {
          getRideDetails(rideId, shouldLoading: false);
          update();
        } else {
          CustomSnackBar.error(
            errorList: model.message ?? [MyStrings.somethingWentWrong],
          );
        }
      } else {
        CustomSnackBar.error(errorList: [responseModel.message]);
      }
    } catch (e) {
      printX(e);
    }
    isEndBtnLoading = false;
    update();
  }

  TextEditingController cancelReasonController = TextEditingController();
  bool isCancelBtnLoading = false;
  Future<void> cancelRide(String rideId) async {
    isCancelBtnLoading = true;
    update();

    try {
      ResponseModel responseModel = await repo.cancelRide(
        id: rideId,
        reason: cancelReasonController.text,
      );
      if (responseModel.statusCode == 200) {
        AuthorizationResponseModel model = AuthorizationResponseModel.fromJson(
          (responseModel.responseJson),
        );
        if (model.status == MyStrings.success) {
          getRideDetails(rideId, shouldLoading: false);
          Get.back();
          CustomSnackBar.success(
            successList: model.message ?? [MyStrings.requestSuccess.tr],
          );
        } else {
          CustomSnackBar.error(
            errorList: model.message ?? [MyStrings.somethingWentWrong],
          );
        }
      } else {
        CustomSnackBar.error(errorList: [responseModel.message]);
      }
    } catch (e) {
      printX(e);
    }
    isCancelBtnLoading = false;
    update();
  }

  bool isAcceptPaymentBtnLoading = false;
  Future<void> acceptPaymentRide(String rideId, BuildContext context) async {
    // T2: the answer closes the modal it was called for, never "whatever modal
    // is on screen". The owner can be replaced while the POST is in flight (a
    // request for another ride dismisses A's modal and presents B's), and on
    // return A's `finally` used to pop B. Both keys are captured before the
    // await: the generation of the modal this accept belongs to, and its ride.
    final gen = _paymentDialogGen;
    final acceptedRideId = RideMessageController.normalizeRideId(rideId);
    isAcceptPaymentBtnLoading = true;
    update();
    try {
      ResponseModel responseModel = await repo.acceptCashPayment(id: rideId);
      if (responseModel.statusCode == 200) {
        RideDetailsResponseModel model = RideDetailsResponseModel.fromJson(
          (responseModel.responseJson),
        );
        if (model.status == MyStrings.success) {
          // T3: the answer is only valid for the ride it was POSTed for. While
          // it is in flight another ride can take the screen (B's request
          // replaces A's modal), and applying A's ride then rewrites `ride` to
          // A: the screen shows a ride the driver is not on and every later
          // `ride.id` consumer (cash accept, chat, stops) targets A. Identity
          // is re-read now, never captured before the await — the point is
          // which ride is current *when the answer lands*.
          final currentRideId = RideMessageController.normalizeRideId(ride.id);
          if (acceptedRideId != null && currentRideId == acceptedRideId) {
            isCashPaymentRequest = false;
            RideModel? tRide = model.data?.ride;
            if (tRide != null) {
              // F6: merge instead of replacing — the response is complete today
              // (`RideController::receivedCashPayment()` loads `stops`/`user`),
              // but a wholesale replace wipes every field any response omits.
              ride = RideEventMerge.applyEvent(current: ride, event: tRide);
            }
            update();
          } else {
            // Ride B stays exactly as it is: different ride, different payment.
            printX(
              'Cash accept response for ride $acceptedRideId ignored: '
              'ride $currentRideId is on screen',
            );
          }
          CustomSnackBar.success(
            successList: model.message ?? [MyStrings.requestSuccess.tr],
          );
        } else {
          CustomSnackBar.error(
            errorList: model.message ?? [MyStrings.somethingWentWrong],
          );
        }
      } else {
        CustomSnackBar.error(errorList: [responseModel.message]);
      }
    } catch (e) {
      printX(e);
    } finally {
      isAcceptPaymentBtnLoading = false;
      // F1: the guard is released by an *effective* close only.
      // `dismissPaymentDialog` pops the modal it owns and clears the state
      // synchronously; when the modal is buried (or still being built) it keeps
      // the guard armed, so clearing it here would leave a modal on screen with
      // nobody owning it — the next request would stack a second one.
      // T2: and it only closes the modal this call was made for — a modal
      // presented meanwhile (new generation, other ride) is not ours to pop.
      if (gen == _paymentDialogGen &&
          _paymentDialogRideId == acceptedRideId &&
          _paymentDialogContext != null) {
        dismissPaymentDialog();
      }
      update();
    }
  }

  TextEditingController reviewMsgController = TextEditingController();
  double rating = 0.0;
  void updateRating(double rate) {
    rating = rate;
    update();
  }

  bool isReviewLoading = false;
  Future<void> reviewRide(String rideId) async {
    isReviewLoading = true;
    update();

    try {
      ResponseModel responseModel = await repo.reviewRide(
        id: rideId,
        rating: rating.toString(),
        review: reviewMsgController.text,
      );
      if (responseModel.statusCode == 200) {
        AuthorizationResponseModel model = AuthorizationResponseModel.fromJson(
          (responseModel.responseJson),
        );
        if (model.status == MyStrings.success) {
          ride.userReview = UserReview(
            rating: rating.toString(),
            review: reviewMsgController.text,
          );
          reviewMsgController.text = '';
          rating = 0.0;
          update();

          // Get.offAllNamed(RouteHelper.dashboard);
          Get.back();
          CustomSnackBar.success(successList: model.message ?? []);
        } else {
          CustomSnackBar.error(
            errorList: model.message ?? [MyStrings.somethingWentWrong],
          );
        }
      } else {
        CustomSnackBar.error(errorList: [responseModel.message]);
      }
    } catch (e) {
      printX(e);
    }
    isReviewLoading = false;
    update();
  }

  /// Single entry point for the rider's cash payment request — `getRideDetails`
  /// and `PusherRideController` both go through here.
  ///
  /// - merges the incoming ride into the displayed one when [eventRide] is
  ///   given: a wholesale replace wipes whatever this payload does not carry,
  ///   and the ride is not guaranteed to be complete (`RideEventMerge`);
  /// - shows at most one dialog, whoever asks and whichever controller instance
  ///   is registered;
  /// - [context] null → the ride id stays pending and is consumed by the next
  ///   [getRideDetails] instead of silently dropping the request.
  void onShowPaymentDialog(BuildContext? context, {RideModel? eventRide}) {
    if (eventRide != null) {
      updateRide(RideEventMerge.applyEvent(current: ride, event: eventRide));
    }

    final rideId = RideMessageController.normalizeRideId(ride.id);
    if (_paymentDialogVisible) {
      // Only a modal known to belong to another ride is replaceable. An unknown
      // owner (`_paymentDialogRideId == null`) must not block a known ride.
      final sameRide = rideId == null || rideId == _paymentDialogRideId;
      if (sameRide) {
        if (_pendingCashPaymentRideId == _paymentDialogRideId) {
          // The parked request is exactly the modal already on screen: consumed.
          _pendingCashPaymentRideId = null;
        }
        printX('Cash payment dialog already visible (ride $_paymentDialogRideId)');
        return;
      }
      // Another ride owns the screen now: replace, never stack.
      dismissPaymentDialog();
      if (_paymentDialogVisible) {
        // F4: the pop is only legal while the modal is the current route. When
        // it is buried (or its builder has not run yet — F1 first frame), the
        // guard stays armed and the new request is PARKED instead of being
        // dropped with the guard armed forever. `consumePendingCashPayment`
        // retries it on the way back / on the next load. `rideId` is known
        // here: an unknown id returned through the `sameRide` branch above.
        _pendingCashPaymentRideId = rideId;
        printX(
          'Cash payment dialog cannot be replaced yet — ride $rideId parked',
        );
        return;
      }
    }

    if (context == null) {
      // F10: never overwrite a known pending ride with `null` (a context-less
      // call for an unknown ride must not erase the request we already hold).
      if (rideId != null) {
        _pendingCashPaymentRideId = rideId;
      }
      printX('No context for cash payment dialog (ride $rideId) — pending');
      return;
    }

    _paymentDialogVisible = true;
    _paymentDialogRideId = rideId;
    _pendingCashPaymentRideId = null;
    printX('Showing payment dialog...');
    presentPaymentDialog(context);
  }

  /// True while the ride-details screen owns the screen.
  ///
  /// `Get.currentRoute` only moves on `PageRoute` pushes (get 4.7.3
  /// `GetObserver.didPush`), so a dialog or a bottom sheet on top of the
  /// details screen keeps it on the details route.
  static bool isRideDetailsRoute() =>
      Get.currentRoute == RouteHelper.rideDetailsScreen;

  /// Presents the modal and re-arms the guard when it closes (any outcome).
  ///
  /// F2: the modal is only ever opened on top of ride-details. A request can
  /// reach this owner while another screen is on top (a `getRideDetails`
  /// response landing after the driver navigated away, a CallKit reload), and
  /// opening it there leaves a modal with no ride behind it. Off the details
  /// route the request is parked instead — the ride state is already updated —
  /// and [consumePendingCashPayment] opens it when the screen arrives.
  @visibleForTesting
  void presentPaymentDialog(BuildContext context) {
    if (!isRideDetailsRoute()) {
      _paymentDialogVisible = false;
      _paymentDialogRideId = null;
      _paymentDialogContext = null;
      final rideId = RideMessageController.normalizeRideId(ride.id);
      if (rideId != null) {
        _pendingCashPaymentRideId = rideId;
      }
      printX(
        'Cash payment dialog parked: ride-details is not the current route '
        '(ride $rideId)',
      );
      return;
    }
    // F1: the presentation owns the state from here on; its generation is the
    // only key that may release it.
    final gen = ++_paymentDialogGen;
    _paymentDialogVisible = true;
    _paymentDialogRideId = RideMessageController.normalizeRideId(ride.id);
    try {
      showDialog(
        barrierDismissible: false,
        context: context,
        builder: (dialogContext) {
          // A newer presentation owns the modal: a stale builder must not steal
          // the context of the modal that replaced it.
          if (gen == _paymentDialogGen) {
            _paymentDialogContext = dialogContext;
          }
          return PaymentReceiveDialog();
        },
      ).whenComplete(() {
        // F1: a replaced modal closes *after* its replacement opened. Releasing
        // the state here unconditionally disarmed the live modal (accept could
        // no longer pop it → stuck screen). Only the current generation cleans.
        if (gen != _paymentDialogGen) {
          printX('Cash payment dialog $gen closed after being replaced — state kept');
          return;
        }
        _paymentDialogContext = null;
        _paymentDialogVisible = false;
        _paymentDialogRideId = null;
      });
    } catch (e) {
      // F5: a stale/invalid context must not latch the guard — otherwise every
      // later cash request for this ride is silently ignored (R8-7 symptom).
      if (gen == _paymentDialogGen) {
        _paymentDialogContext = null;
        _paymentDialogVisible = false;
        _paymentDialogRideId = null;
      }
      printX('Could not present cash payment dialog: $e');
    }
  }

  /// Pops the modal, but only while it is the route on screen.
  ///
  /// `Get.back()` used to pop whatever route was on top: with the modal buried
  /// under another screen (or already closed) it closed the wrong page. The
  /// guard is re-armed by the modal's own `whenComplete`.
  @visibleForTesting
  void dismissPaymentDialog() {
    final dialogContext = _paymentDialogContext;
    if (dialogContext == null || !dialogContext.mounted) {
      _paymentDialogContext = null;
      printX('Cash payment dialog is not open — nothing to dismiss');
      return;
    }
    final route = ModalRoute.of(dialogContext);
    if (route == null || !route.isCurrent) {
      printX('Cash payment dialog is not the current route — not popping');
      return;
    }
    _paymentDialogContext = null;
    _paymentDialogVisible = false;
    _paymentDialogRideId = null;
    Navigator.of(dialogContext, rootNavigator: true).pop();
  }

  /// Consumes a cash request that could not be shown yet.
  ///
  /// F2: this is the only way back for a request parked while the modal could
  /// not be presented — no `BuildContext` at the time, another route on top
  /// (`getRideDetails` landing after the driver navigated away), or a modal
  /// that could not be replaced yet. Called by [getRideDetails], by
  /// `RideDetailsScreen.didPopNext` and on `AppLifecycleState.resumed`, so a
  /// request received while the driver was reading messages is not lost when
  /// he comes back to the ride.
  ///
  /// Idempotent: the pending id is consumed once and the dialog guard keeps a
  /// second call from stacking a modal.
  void consumePendingCashPayment() {
    final pendingId = _pendingCashPaymentRideId;
    if (pendingId == null) {
      return;
    }
    if (RideMessageController.normalizeRideId(ride.id) != pendingId) {
      // F10: another ride was opened — the request belonged to the previous one
      // and must not fire on this screen.
      _pendingCashPaymentRideId = null;
      printX('Pending cash request for ride $pendingId purged');
      return;
    }
    // F3: a request is only worth showing for a ride that still owes the cash —
    // `payment_status 3` and a ride that is neither finished nor cancelled.
    // Otherwise the driver gets a payment modal for a settled/dead ride, and
    // `acceptCashPayment` would POST against it.
    final rideIsClosed = ride.status == AppStatus.RIDE_COMPLETED ||
        ride.status == AppStatus.RIDE_CANCELED;
    if (ride.paymentStatus != '3' || rideIsClosed) {
      _pendingCashPaymentRideId = null;
      printX(
        'Pending cash request for ride $pendingId purged: '
        'payment_status ${ride.paymentStatus}, status ${ride.status}',
      );
      return;
    }
    onShowPaymentDialog(Get.context);
  }

  void changeCashPaymentRequest(bool value) {
    isCashPaymentRequest = value;
    update();
  }

  Future<void> openGoogleMaps() async {
    final String pickupLat = ride.pickupLatitude ?? "";
    final String pickupLng = ride.pickupLongitude ?? "";
    final String destLat = ride.destinationLatitude ?? "";
    final String destLng = ride.destinationLongitude ?? "";

    String url = "";

    if (ride.status == AppStatus.RIDE_RUNNING) {
      // ✅ Get driver's current location
      Position position = await MyUtils.getCurrentLocationPosition();

      final String driverLat = position.latitude.toString();
      final String driverLng = position.longitude.toString();

      // Navigate from driver current → destination
      url = "https://www.google.com/maps/dir/?api=1&origin=$driverLat,$driverLng&destination=$destLat,$destLng&travelmode=driving";
    } else {
      // Navigate from pickup → destination
      url = "https://www.google.com/maps/dir/?api=1&origin=$pickupLat,$pickupLng&destination=$destLat,$destLng&travelmode=driving";
    }

    final Uri uri = Uri.parse(url);

    if (await canLaunchUrl(uri)) {
      await launchUrl(uri, mode: LaunchMode.externalApplication);
    } else {
      throw 'Could not open Google Maps.';
    }
  }
}

$ cat lib/presentation/screens/ride_details/ride_details_screen.dart
import 'dart:async';
import 'package:flutter/cupertino.dart';
import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:get/get.dart';
import 'package:lottie/lottie.dart';
import 'package:galass_driver/core/utils/app_status.dart';
import 'package:galass_driver/core/utils/dimensions.dart';
import 'package:galass_driver/core/utils/my_animation.dart';
import 'package:galass_driver/core/utils/my_color.dart';
import 'package:galass_driver/data/controller/map/ride_map_controller.dart';
import 'package:galass_driver/data/controller/pusher/pusher_ride_controller.dart';
import 'package:galass_driver/data/controller/ride/ride_details/ride_details_controller.dart';
import 'package:galass_driver/data/controller/ride/ride_meassage/ride_meassage_controller.dart';
import 'package:galass_driver/data/repo/meassage/meassage_repo.dart';
import 'package:galass_driver/data/repo/polyline/polyline_repo.dart';
import 'package:galass_driver/data/repo/ride/ride_repo.dart';
import 'package:galass_driver/presentation/screens/ride_details/widgets/ride_details_bottom_sheet_widget.dart';
import 'package:galass_driver/presentation/screens/ride_details/widgets/poly_line_map.dart';
import 'package:toastification/toastification.dart';
import 'package:galass_driver/core/utils/app_route_observer.dart';

class RideDetailsScreen extends StatefulWidget {
  final String rideId;

  const RideDetailsScreen({super.key, required this.rideId});

  @override
  State<RideDetailsScreen> createState() => _RideDetailsScreenState();
}

class _RideDetailsScreenState extends State<RideDetailsScreen> with RouteAware, WidgetsBindingObserver {
  DraggableScrollableController draggableScrollableController = DraggableScrollableController();
  bool _routeObserverSubscribed = false;

  @override
  void initState() {
    Get.put(RideRepo(apiClient: Get.find()));
    if (!Get.isRegistered<RideMapController>()) {
      Get.put(RideMapController(polylineRepo: Get.find<PolylineRepo>()));
    }
    Get.put(MessageRepo(apiClient: Get.find()));
    Get.put(RideMessageController(repo: Get.find()));
    // Force fresh controller — Get.put alone reuses stale ride.status after
    // inbox/prior details, so ACTIVE CTAs stay gated false on CallKit open.
    final controller = RideDetailsController.putFresh(
      repo: Get.find(),
      mapController: Get.find(),
    );
    if (Get.isRegistered<PusherRideController>()) {
      Get.delete<PusherRideController>(force: true);
    }
    Get.put(
      PusherRideController(
        apiClient: Get.find(),
        rideMessageController: Get.find(),
        rideDetailsController: controller,
        rideID: widget.rideId,
      ),
    );
    super.initState();
    WidgetsBinding.instance.addObserver(this);
    WidgetsBinding.instance.addPostFrameCallback((timeStamp) async {
      await controller.getRideDetails(widget.rideId);
      Get.find<PusherRideController>().ensureConnection();
      if (controller.ride.paymentStatus == "2" && controller.ride.paymentStatus != "1") {
        //  controller.onShowPaymentDialog(context);
      }
      // CallKit/fresh route: settle sheet after data load; retry if not attached.
      _settleSheetAfterLoad(retriesLeft: 3);
    });
  }

  void _settleSheetAfterLoad({int retriesLeft = 0}) {
    if (!mounted) return;
    if (draggableScrollableController.isAttached) {
      draggableScrollableController.animateTo(
        0.4,
        duration: const Duration(milliseconds: 200),
        curve: Curves.easeOut,
      );
      return;
    }
    if (retriesLeft <= 0) return;
    WidgetsBinding.instance.addPostFrameCallback((_) {
      _settleSheetAfterLoad(retriesLeft: retriesLeft - 1);
    });
  }

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    final route = ModalRoute.of(context);
    if (!_routeObserverSubscribed && route is PageRoute) {
      appRouteObserver.subscribe(this, route);
      _routeObserverSubscribed = true;
    }
  }

  @override
  void dispose() {
    if (_routeObserverSubscribed) {
      appRouteObserver.unsubscribe(this);
    }
    WidgetsBinding.instance.removeObserver(this);
    // ISC-F5-19: stop the GPS stream before the map controller it feeds.
    if (Get.isRegistered<RideDetailsController>()) {
      Get.find<RideDetailsController>().stopLiveLocationTracking();
    }
    if (Get.isRegistered<RideMapController>()) {
      Get.find<RideMapController>().stopPolylineAnimation();
      Get.delete<RideMapController>(force: true);
    }
    if (Get.isRegistered<PusherRideController>()) {
      Get.delete<PusherRideController>(force: true);
    }
    if (Get.isRegistered<RideDetailsController>()) {
      Get.delete<RideDetailsController>(force: true);
    }
    super.dispose();
  }

  @override
  void didPushNext() {
    // Another route covers this screen; stop heavy animations.
    if (Get.isRegistered<RideMapController>()) {
      Get.find<RideMapController>().stopPolylineAnimation();
    }
  }

  @override
  void didPopNext() {
    // Back to this screen; resume animation if needed.
    if (Get.isRegistered<RideMapController>()) {
      Get.find<RideMapController>().startPolylineAnimationIfNeeded();
    }
    // F2: a cash request received while another route (e.g. the messages screen)
    // covered this one was parked — it is shown on the way back, without waiting
    // for a reload.
    if (Get.isRegistered<RideDetailsController>()) {
      Get.find<RideDetailsController>().consumePendingCashPayment();
    }
  }

  @override
  void didChangeAppLifecycleState(AppLifecycleState state) {
    if (state == AppLifecycleState.paused || state == AppLifecycleState.inactive) {
      if (Get.isRegistered<RideMapController>()) {
        Get.find<RideMapController>().stopPolylineAnimation();
      }
    } else if (state == AppLifecycleState.resumed) {
      if (Get.isRegistered<RideMapController>()) {
        Get.find<RideMapController>().startPolylineAnimationIfNeeded();
      }
      // F2: the app comes back on this screen — same recovery as `didPopNext`.
      if (Get.isRegistered<RideDetailsController>()) {
        Get.find<RideDetailsController>().consumePendingCashPayment();
      }
    }
  }

  Future _zoomBasedOnExtent(double extent) async {
    var controller = Get.find<RideMapController>();
    var polylinePoints = controller.polylineCoordinates;
    if (controller.mapController == null || polylinePoints.isEmpty) return;

    controller.fitPolylineBounds(polylinePoints);
  }

  @override
  Widget build(BuildContext context) {
    return GetBuilder<RideDetailsController>(
      builder: (controller) {
        return AnnotatedRegion<SystemUiOverlayStyle>(
          value: const SystemUiOverlayStyle(
            statusBarColor: Colors.transparent,
            statusBarBrightness: Brightness.light,
            statusBarIconBrightness: Brightness.dark,
          ),
          child: PopScope(
            canPop: false,
            onPopInvokedWithResult: (bool didPop, d) async {
              if (didPop) return;
              Get.back();
              toastification.dismissAll();
            },
            child: Scaffold(
              body: Stack(
                children: [
                  //Map
                  controller.isLoading
                      ? SizedBox(
                          height: context.height,
                          width: double.infinity,
                          child: LottieBuilder.asset(
                            MyAnimation.rideDetailsLoadingAnimation,
                          ),
                        )
                      : SizedBox(
                          height: context.isTablet ? context.height : context.height / 1.3,
                          child: const PolyLineMapScreen(),
                        ),
                  Positioned(
                    top: 0,
                    left: 0,
                    child: SafeArea(
                      child: Padding(
                        padding: const EdgeInsets.symmetric(
                          horizontal: Dimensions.space12,
                        ),
                        child: IconButton(
                          style: IconButton.styleFrom(
                            backgroundColor: MyColor.colorWhite,
                          ),
                          color: MyColor.colorBlack,
                          onPressed: () => Get.back(result: true),
                          icon: const Icon(Icons.arrow_back_ios_new_rounded),
                        ),
                      ),
                    ),
                  ),
                ],
              ),
              bottomSheet: controller.isLoading
                  ? Container(
                      color: MyColor.colorWhite,
                      height: context.height / 4,
                      child: const SizedBox.shrink(),
                    )
                  : AnimatedPadding(
                      padding: EdgeInsetsDirectional.only(
                        bottom: MediaQuery.of(context).viewInsets.bottom,
                      ),
                      duration: const Duration(milliseconds: 500),
                      curve: Curves.decelerate,
                      child: DraggableScrollableSheet(
                        controller: draggableScrollableController,
                        snap: true,
                        shouldCloseOnMinExtent: true,
                        expand: false,
                        initialChildSize: 0.4, // initial height (percentage of screen height)
                        minChildSize: 0.4, // minimum height when fully collapsed
                        maxChildSize: 0.8, // maximum height when fully expanded
                        snapSizes: [0.4, 0.5, 0.7, 0.8],
                        snapAnimationDuration: Duration(milliseconds: 500),
                        builder: (context, scrollController) {
                          return NotificationListener<DraggableScrollableNotification>(
                            onNotification: (notification) {
                              // printX("Notification: ${notification.extent}");
                              _zoomBasedOnExtent(notification.extent);
                              return true;
                            },
                            child: RideDetailsBottomSheetWidget(
                              scrollController: scrollController,
                              draggableScrollableController: draggableScrollableController,
                            ),
                          );
                        },
                      ),
                    ),
              floatingActionButton: controller.isLoading
                  ? SizedBox.shrink()
                  : InkWell(
                      onTap: () {
                        controller.openGoogleMaps();
                      },
                      customBorder: RoundedRectangleBorder(
                        borderRadius: BorderRadius.circular(25),
                        side: BorderSide.none,
                      ),
                      child: Container(
                        height: 50,
                        width: 50,
                        decoration: BoxDecoration(
                          color: controller.ride.status == AppStatus.RIDE_RUNNING ? MyColor.primaryColor : MyColor.colorBlack,
                          shape: BoxShape.circle,
                        ),
                        child: Icon(
                          controller.ride.status == AppStatus.RIDE_RUNNING ? CupertinoIcons.location_fill : CupertinoIcons.location,
                          color: MyColor.colorWhite,
                        ),
                      ),
                    ),
            ),
          ),
        );
      },
    );
  }
}

$ cat lib/data/repo/dashboard/dashboard_repo.dart
import 'package:galass_driver/core/utils/method.dart';
import 'package:galass_driver/core/utils/url_container.dart';
import 'package:galass_driver/data/model/global/response_model/response_model.dart';
import 'package:galass_driver/data/services/api_client.dart';

class DashBoardRepo {
  ApiClient apiClient;
  DashBoardRepo({required this.apiClient});

  Future<ResponseModel> getDashboardData({String page = '1'}) async {
    String url = "${UrlContainer.baseUrl}${UrlContainer.dashBoardEndPoint}?page=$page";
    ResponseModel responseModel = await apiClient.request(
      url,
      Method.getMethod,
      null,
      passHeader: true,
    );
    return responseModel;
  }

  Future<ResponseModel> onlineStatus({
    required String lat,
    required String long,
  }) async {
    String url = "${UrlContainer.baseUrl}${UrlContainer.onlineStatus}";

    Map<String, String> params = {'lat': lat, 'long': long};

    ResponseModel responseModel = await apiClient.request(
      url,
      Method.postMethod,
      params,
      passHeader: true,
    );
    return responseModel;
  }

  Future<ResponseModel> updateLiveLocation({
    required String lat,
    required String long,
  }) async {
    String url = "${UrlContainer.baseUrl}${UrlContainer.driverLocationUpdate}";

    Map<String, String> params = {'current_lat': lat, 'current_lot': long};

    ResponseModel responseModel = await apiClient.request(
      url,
      Method.postMethod,
      params,
      passHeader: true,
    );
    return responseModel;
  }

  Future<ResponseModel> respondToOffer({
    required String rideId,
    required String action,
  }) async {
    String url = "${UrlContainer.baseUrl}${UrlContainer.offerRespond}";
    Map<String, String> params = {
      'ride_id': rideId,
      'action': action,
    };
    ResponseModel responseModel = await apiClient.request(
      url,
      Method.postMethod,
      params,
      passHeader: true,
      skipAuthSideEffects: true,
    );
    return responseModel;
  }

  Future<String?> getActualAddress(double lat, double lng) async {
    final url = '${UrlContainer.getLocationByLatlng}?lat=$lat&lng=$lng';

    final response = await apiClient.request(url, Method.getMethod, null);

    if (response.statusCode == 200) {
      final data = response.responseJson;
      if (data['results'] != null && data['results'].isNotEmpty) {
        for (var result in data['results']) {
          final types = result['types'];
          if (types != null && (types.contains('street_address') || types.contains('premise') || types.contains('subpremise') || types.contains('route') || types.contains('locality'))) {
            return result['formatted_address'];
          }
        }
        return data['results'][0]['formatted_address'];
      }

      if (data['plus_code']?['compound_code'] != null) {
        return data['plus_code']['compound_code'];
      }
    }

    return null;
  }
}

$ cat lib/data/services/forground_location_service.dart
import 'dart:async';
import 'package:flutter_foreground_task/flutter_foreground_task.dart';
import 'package:geolocator/geolocator.dart';
import 'package:galass_driver/core/helper/last_ping_store.dart';
import 'package:galass_driver/core/helper/location_ping_policy.dart';
import 'package:galass_driver/core/helper/string_format_helper.dart';
import 'package:galass_driver/data/repo/dashboard/dashboard_repo.dart';
import 'package:galass_driver/data/services/api_client.dart';
import 'package:galass_driver/environment.dart';
import 'package:galass_driver/core/utils/my_strings.dart';
import 'package:shared_preferences/shared_preferences.dart';

class ForgroundLocationService extends TaskHandler {
  ForgroundLocationService();

  StreamSubscription<Position>? _positionStream;
  Timer? _intervalTimer;
  late DashBoardRepo dashBoardRepo;
  Position? _lastPosition;
  DateTime? _lastPingAt;
  final LocationPingPolicy _pingPolicy = const LocationPingPolicy(
    maxIntervalSeconds: Environment.driverLocationUpdateMaxIntervalSeconds,
  );

  Future<void> _stopForegroundTask() async {
    printE("Stopped Foreground Task");
    _intervalTimer?.cancel();
    _intervalTimer = null;
    await _positionStream?.cancel();
    _positionStream = null;
    await FlutterForegroundTask.stopService();
  }

  Future<bool> _shouldKeepRunning() async {
    final isOnline = dashBoardRepo.apiClient.getUserOnlineStatus();
    final isLoggedIn = await dashBoardRepo.apiClient.isLoggedIn();
    printX("Is online -> $isOnline | isLoggedIn -> $isLoggedIn");
    return isOnline && isLoggedIn;
  }

  Future<void> _sendIfNeeded({
    required double lat,
    required double lon,
    required bool forceInterval,
  }) async {
    final now = DateTime.now();
    if (!forceInterval && !_pingPolicy.shouldPing(lastPingAt: _lastPingAt, now: now)) {
      return;
    }

    FlutterForegroundTask.updateService(
      notificationText: MyStrings.foregroundLocationCurrent
          .replaceAll('{lat}', '$lat')
          .replaceAll('{lon}', '$lon'),
    );
    final outcome = await sendLocationToServer(lat: lat, long: lon);
    if (shouldAdvancePingClock(outcome)) {
      _lastPingAt = now;
    }
    if (outcome == LocationPingSendOutcome.success) {
      await LastPingStore.record(lat, lon, now: now);
    }
    if (shouldStopForegroundOnPingOutcome(outcome)) {
      await _stopForegroundTask();
    }
  }

  // Called when the task is started.
  @override
  Future<void> onStart(DateTime timestamp, TaskStarter starter) async {
    try {
      SharedPreferences sharedPreferences = await SharedPreferences.getInstance();
      ApiClient apiClient = ApiClient(sharedPreferences: sharedPreferences);
      dashBoardRepo = DashBoardRepo(apiClient: apiClient);
      if (!await _shouldKeepRunning()) {
        await _stopForegroundTask();
        return;
      }
      _positionStream = Geolocator.getPositionStream(
        locationSettings: const LocationSettings(
          accuracy: LocationAccuracy.best,
          distanceFilter: Environment.driverLocationUpdateAfterNmetersOrMovements,
        ),
      ).listen((Position? location) async {
        if (location != null) {
          _lastPosition = location;
          if (await _shouldKeepRunning()) {
            await _sendIfNeeded(
              lat: location.latitude,
              lon: location.longitude,
              forceInterval: false,
            );
          } else {
            await _stopForegroundTask();
          }
        }
      });

      _intervalTimer = Timer.periodic(
        Duration(seconds: Environment.driverLocationUpdateMaxIntervalSeconds),
        (_) async {
          if (_lastPosition == null || !await _shouldKeepRunning()) {
            if (!await _shouldKeepRunning()) {
              await _stopForegroundTask();
            }
            return;
          }
          await _sendIfNeeded(
            lat: _lastPosition!.latitude,
            lon: _lastPosition!.longitude,
            forceInterval: true,
          );
        },
      );
    } catch (e) {
      printE(e);
      await _stopForegroundTask();
    }
  }

  Future<LocationPingSendOutcome> sendLocationToServer({
    required double lat,
    required double long,
  }) async {
    try {
      var response = await dashBoardRepo.updateLiveLocation(lat: "$lat", long: "$long");
      printX('[dispatch] location ping HTTP=${response.statusCode}');
      final remark = response.responseJson is Map<String, dynamic>
          ? (response.responseJson as Map<String, dynamic>)['remark']?.toString()
          : null;
      final outcome = resolveLocationPingSendOutcome(
        statusCode: response.statusCode,
        remark: remark,
      );
      if (outcome == LocationPingSendOutcome.success) {
        FlutterForegroundTask.updateService(
          notificationText: MyStrings.foregroundLocationSynced,
        );
        return outcome;
      }
      if (outcome == LocationPingSendOutcome.fatalFailure) {
        await dashBoardRepo.apiClient.handleUnauthorizedSession(
          navigateToLogin: false,
        );
      }
      return outcome;
    } catch (e) {
      printX('[dispatch] location ping HTTP=error');
      printE(e);
      return LocationPingSendOutcome.transientFailure;
    }
  }

  @override
  void onRepeatEvent(DateTime timestamp) async {
    if (!await _shouldKeepRunning()) {
      await _stopForegroundTask();
      return;
    }

    // Watchdog when position stream stalls in background (ISC-F7-7).
    var position = _lastPosition;
    if (position == null) {
      try {
        position = await Geolocator.getLastKnownPosition();
        if (position != null) {
          _lastPosition = position;
        }
      } catch (e) {
        printE(e);
      }
    }
    if (position == null) {
      return;
    }
    await _sendIfNeeded(
      lat: position.latitude,
      lon: position.longitude,
      forceInterval: true,
    );
  }

  // Called when the task is destroyed.
  @override
  Future<void> onDestroy(DateTime timestamp, bool isTimeout) async {
    printX('onDestroy:::::::::::: Forground Task');
    try {
      _intervalTimer?.cancel();
      _intervalTimer = null;
      await _positionStream?.cancel();
      _positionStream = null;
    } catch (e) {
      printE(e);
    }
  }

  // Called when data is sent using [FlutterForegroundTask.sendDataToTask].
  @override
  void onReceiveData(Object data) {
    printX('onReceiveData999: $data');
    FlutterForegroundTask.sendDataToMain(data);
  }

  // Called when the notification button is pressed.
  @override
  void onNotificationButtonPressed(String id) {
    printX('onNotificationButtonPressed: $id');
  }

  // Called when the notification itself is pressed.
  //
  // AOS: "android.permission.SYSTEM_ALERT_WINDOW" permission must be granted
  // for this function to be called.
  @override
  void onNotificationPressed() {
    FlutterForegroundTask.launchApp('/');
    printX('onNotificationPressed');
  }

  // Called when the notification itself is dismissed.
  //
  // AOS: only work Android 14+
  // iOS: only work iOS 10+
  @override
  void onNotificationDismissed() {
    printX('onNotificationDismissed');
  }
}

$ cat lib/core/helper/location_ping_policy.dart
/// Result of a server location ping attempt.
enum LocationPingSendOutcome {
  /// HTTP 200 — backend stamped `location_updated_at`.
  success,

  /// Network/5xx/429 — keep foreground service alive and retry.
  transientFailure,

  /// 401/unauthenticated — stop service; session invalid.
  fatalFailure,
}

LocationPingSendOutcome resolveLocationPingSendOutcome({
  int? statusCode,
  bool networkError = false,
  String? remark,
}) {
  if (networkError) {
    return LocationPingSendOutcome.transientFailure;
  }
  if (statusCode == 200) {
    if (remark == 'unauthenticated') {
      return LocationPingSendOutcome.fatalFailure;
    }
    return LocationPingSendOutcome.success;
  }
  if (statusCode == 401) {
    return LocationPingSendOutcome.fatalFailure;
  }
  return LocationPingSendOutcome.transientFailure;
}

bool shouldStopForegroundOnPingOutcome(LocationPingSendOutcome outcome) =>
    outcome == LocationPingSendOutcome.fatalFailure;

bool shouldAdvancePingClock(LocationPingSendOutcome outcome) =>
    outcome == LocationPingSendOutcome.success;

class LocationPingPolicy {
  const LocationPingPolicy({required this.maxIntervalSeconds});

  final int maxIntervalSeconds;

  bool shouldPing({
    required DateTime? lastPingAt,
    required DateTime now,
  }) {
    if (lastPingAt == null) {
      return true;
    }
    return now.difference(lastPingAt).inSeconds >= maxIntervalSeconds;
  }
}

