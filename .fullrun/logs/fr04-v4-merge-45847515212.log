  group('ISC-F5-13 — Annuler la course = danger', () {
    late RideDetailsController controller;

    setUp(() async {
      Get.testMode = true;
      Get.reset();
      SharedPreferences.setMockInitialValues(<String, Object>{});
      final prefs = await SharedPreferences.getInstance();
      final apiClient = RecordingApiClient(sharedPreferences: prefs);
      Get.put<ApiClient>(apiClient);
      controller = Get.put<RideDetailsController>(
        RideDetailsController(
          repo: _NoopRideRepo(apiClient: apiClient),
          mapController: _NoopMap(
            polylineRepo: PolylineRepo(apiClient: apiClient),
          ),
        ),
      );
      controller.currency = 'FCFA';
      controller.userImageUrl = '';
      controller.isLoading = false;
    });

    tearDown(Get.reset);

    Future<void> pumpSheet(WidgetTester tester, RideModel ride) async {
      controller.ride = ride;
      await tester.pumpWidget(
        GetMaterialApp(
          home: Scaffold(
            body: Align(
              alignment: Alignment.bottomCenter,
              child: SizedBox(
                height: 560,
                child: RideDetailsBottomSheetWidget(
                  scrollController: ScrollController(),
                  draggableScrollableController:
                      DraggableScrollableController(),
                ),
              ),
            ),
          ),
        ),
      );
      await tester.pump(const Duration(milliseconds: 100));
      await tester.pump(const Duration(milliseconds: 100));
    }

    testWidgets(
        'RIDE_ACTIVE : « Annuler la course » reste danger, ≠ CTA principal',
        (tester) async {
      await pumpSheet(
        tester,
        RideModel(
          id: '44',
          status: AppStatus.RIDE_ACTIVE,
          pickupLocation: 'Plateau, Dakar',
          destination: 'Aéroport AIBD, Diass',
          distance: '38.4',
          duration: '52',
          amount: '12500',
        ),
      );

      final cancel = find.byKey(const Key('driver_cancel_cta'));
      expect(
        cancel,
        findsOneWidget,
        reason:
            'ISC-F5-13 : en RIDE_ACTIVE le CTA « Annuler la course » doit être rendu',
      );
      final cancelButton = tester.widget<RoundedButton>(cancel);
      expect(
        cancelButton.bgColor,
        MyColor.redCancelTextColor,
        reason: 'ISC-F5-13 : le CTA Annuler doit porter la couleur danger',
      );
      expect(cancelButton.bgColor, isNot(MyColor.getPrimaryColor()));
      expect(cancelButton.isDisabled, isFalse);

      final pickup = find.byKey(const Key('driver_pickup_cta'));
      expect(
        pickup,
        findsOneWidget,
        reason: 'ISC-F5-13 : en RIDE_ACTIVE le CTA principal doit être rendu',
      );
      final pickupButton = tester.widget<RoundedButton>(pickup);
      expect(
        pickupButton.bgColor,
        isNull,
        reason: 'ISC-F5-13 : CTA principal par défaut (couleur primaire)',
      );
      expect(pickupButton.bgColor, isNot(MyColor.redCancelTextColor));
    });

    testWidgets(
        'RIDE_RUNNING : aucun CTA Annuler rendu, CTA unique = CTA principal',
        (tester) async {
      await pumpSheet(tester, _rideWithStops(completed: 1));

      expect(
        find.byKey(const Key('driver_cancel_cta')),
        findsNothing,
        reason:
            'ISC-F5-13 : en RIDE_RUNNING le CTA « Annuler la course » ne doit pas cohabiter avec le CTA principal',
      );
      expect(
        find.byKey(const Key('driver_confirm_stop_cta')),
        findsOneWidget,
        reason: 'ISC-F5-12 : en RIDE_RUNNING un seul CTA principal doit être rendu',
      );
      expect(
        find.byKey(const Key('driver_end_ride_cta')),
        findsNothing,
        reason: 'ISC-F5-12 : en RIDE_RUNNING « Terminer la course » est masqué',
      );
      expect(find.byType(RoundedButton), findsOneWidget);
    });

