     7	class RoundedButton extends StatefulWidget {
     8	  final bool isColorChange;
     9	  final String text;
    10	  final VoidCallback press;
    11	  final Color? bgColor;
    12	  final Color? textColor;
    13	  final double width;
    14	  final double height;
    15	  final double cornerRadius;
    16	  final bool isOutlined;
    17	  final Widget? child;
    18	  final TextStyle? textStyle;
    19	  final bool isLoading;
    20	  final Color borderColor; // Added for outlined button border color
    21	  final bool isDisabled; // Added to handle disabled state
    22	  const RoundedButton({
    23	    super.key,
    24	    this.isColorChange = false,
    25	    this.width = 1,
    26	    this.child,
    27	    this.cornerRadius = 14,
    28	    this.height = 56,
    29	    required this.text,
    30	    required this.press,
    31	    this.isOutlined = false,
    32	    this.bgColor,
    33	    this.textColor = MyColor.colorWhite,
    34	    this.textStyle,
    35	    this.isLoading = false,
    36	    this.borderColor = MyColor.primaryButtonColor, // Default border color
    37	    this.isDisabled = false,
    38	  });
    39	
    40	  @override
    41	  State<RoundedButton> createState() => _RoundedButtonState();
    42	}
    43	
    44	class _RoundedButtonState extends State<RoundedButton> {
    45	  bool _isPressed = false;
    46	
    47	  void _onPointerDown(PointerDownEvent event) {
    48	    // printX("_onPointerDown");
    49	    if (widget.isDisabled || widget.isLoading) return;
    50	    setState(() => _isPressed = true);
    51	  }
    52	
    53	  void _onPointerUp(PointerUpEvent event) {
    54	    // printX("_onPointerUp");
    55	    if (widget.isDisabled || widget.isLoading) return;
    56	    setState(() => _isPressed = false);
    57	    // widget.press();
    58	  }
    59	
    60	  @override
    61	  Widget build(BuildContext context) {
    62	    final double buttonScale = _isPressed ? 0.95 : 1.0;
    63	    final double buttonOpacity = widget.isDisabled ? 0.6 : 1.0;
    64	
    65	    // Define the text style for the button
    66	    final effectiveTextStyle = widget.textStyle ??
    67	        regularDefault.copyWith(
    68	          color: widget.isOutlined ? widget.textColor ?? widget.bgColor ?? MyColor.primaryButtonColor : widget.textColor ?? MyColor.colorWhite,
    69	          fontSize: 16,
    70	          fontWeight: FontWeight.w500,
    71	          letterSpacing: 1.2,
    72	        );
    73	
    74	    // Define the main content of the button (text or loading indicator)
    75	    Widget buttonContent = widget.isLoading
    76	        ? SpinKitFadingCircle(
    77	            color: widget.isOutlined ? widget.textColor ?? widget.bgColor ?? MyColor.primaryButtonColor : widget.textColor ?? MyColor.colorWhite,
    78	            size: 25.0,
    79	          )
    80	        : widget.child ?? Text(widget.text.tr, style: effectiveTextStyle);
    81	
    82	    // Un noeud d'accessibilité par bouton, portant SON libellé. Sans cette barrière,
    83	    // deux boutons voisins (« Confirmer l'arrêt » / « Terminer la course ») sont fusionnés
    84	    // par le moteur sémantique de Flutter en un seul noeud cliquable qui additionne les
    85	    // deux libellés : TalkBack lit une phrase, et l'app ne peut plus être pilotée bouton
    86	    // par bouton (mesuré sur ui/37-driver-running-stop1.xml, bounds couvrant les deux).
    87	    final String semanticsLabel = widget.text.trim();
    88	    final bool hasSemanticsLabel = semanticsLabel.isNotEmpty;
    89	    final bool isInert = widget.isDisabled || widget.isLoading;
    90	
    91	    return Semantics(
    92	      container: true,
    93	      button: true,
    94	      enabled: !isInert,
    95	      label: hasSemanticsLabel ? semanticsLabel.tr : null,
    96	      // Le libellé du parent remplace le texte enfant : un seul noeud, un seul libellé,
    97	      // jamais deux annonces. Un bouton à contenu riche (text vide) garde ses enfants.
    98	      excludeSemantics: hasSemanticsLabel,
    99	      onTap: hasSemanticsLabel && !isInert ? widget.press : null,
   100	      child: Listener(
   101	        onPointerDown: _onPointerDown,
   102	        onPointerUp: _onPointerUp,
   103	        child: AnimatedScale(
   104	          scale: buttonScale,
   105	          duration: const Duration(milliseconds: 150),
   106	          curve: Curves.easeInOut,
   107	          child: AnimatedOpacity(
   108	            opacity: buttonOpacity,
   109	            duration: const Duration(milliseconds: 150),
   110	            child: widget.isOutlined ? buildOutLineButtonStyleWidget(buttonContent) : buildButtonStyleWidget(buttonContent),
   111	          ),
   112	        ),
   113	      ),
   114	    );
   115	  }
