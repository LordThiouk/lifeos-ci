import 'dart:async';
import 'dart:typed_data';
import 'dart:ui' as ui;

import 'package:flutter/foundation.dart';
import 'package:flutter/painting.dart';
import 'package:geolocator/geolocator.dart';
import 'package:galass_driver/presentation/packages/flutter_polyline_points/flutter_polyline_points.dart';

import 'package:get/get.dart';
import 'package:google_maps_flutter/google_maps_flutter.dart';
import 'package:galass_driver/core/helper/string_format_helper.dart';
import 'package:galass_driver/core/utils/app_status.dart';
import 'package:galass_driver/core/utils/helper.dart';
import 'package:galass_driver/core/utils/my_color.dart';
import 'package:galass_driver/core/utils/my_icons.dart';
import 'package:galass_driver/data/controller/ride/ride_details/ride_details_controller.dart';
import 'package:galass_driver/data/model/global/ride/ride_stop_model.dart';
import 'package:galass_driver/data/model/global/ride/ride_stop_progress.dart';
import 'package:galass_driver/environment.dart';
import 'package:galass_driver/presentation/packages/polyline_animation/polyline_animation_v1.dart';
import 'package:galass_driver/data/repo/polyline/polyline_repo.dart';

class RideMapController extends GetxController {
  final PolylineRepo polylineRepo;
  RideMapController({required this.polylineRepo});
  bool isLoading = false;
  LatLng pickupLatLng = const LatLng(0, 0);
  LatLng destinationLatLng = const LatLng(0, 0);
  LatLng? currentLegLatLng;
  bool navigateCurrentLegOnly = false;
  List<LatLng> intermediateStopLatLngs = const [];

  /// Stop pins for the active ride (ISC-F5-16). Empty keeps the legacy
  /// `intermediateStopLatLngs` rendering untouched.
  List<RideStopProgress> stopMarkers = const [];
  Map<PolylineId, Polyline> polylines = {};
  final PolylineAnimator animator = PolylineAnimator();
  static const String _animatedPolylineId = 'polyline_id';
  bool _isPolylineAnimationActive = false;

  /// Waypoints passed to the Directions/Routes polyline (empty on current-leg nav).
  List<LatLng> get polylineWaypointLatLngs =>
      navigateCurrentLegOnly ? const [] : intermediateStopLatLngs;

  /// Replaces the stop pins without touching navigation state (ISC-F5-8).
  void setStopMarkers(List<RideStopProgress> markers) {
    stopMarkers = List<RideStopProgress>.unmodifiable(markers);
    update();
  }

  /// Minimum movement before the camera follows the car again (ISC-F5-19).
  static const double cameraFollowMinDistanceMeters = 10;

  /// Minimum delay between two camera follows, so a dense GPS stream does not
  /// fight the driver's own pan/zoom gestures.
  static const Duration cameraFollowMinInterval = Duration(seconds: 4);

  LatLng? _lastCameraFollowTarget;
  DateTime? _lastCameraFollowAt;

  /// Test seam: records camera moves instead of touching a real GoogleMap.
  @visibleForTesting
  void Function(CameraUpdate update)? cameraAnimatorForTest;

  /// Applies one live GPS fix to the car marker and follows it reasonably
  /// (ISC-F5-19). Called from the ride-context location stream.
  void applyLiveDriverLocation(LatLng position, {DateTime? now}) {
    driverLatLng = position;
    _followDriverWithCamera(position, now: now);
    update();
  }

  void _followDriverWithCamera(LatLng position, {DateTime? now}) {
    final hasMap = mapController != null || cameraAnimatorForTest != null;
    if (!hasMap) {
      // The map is still loading: keep the fix for the marker, follow on the
      // next one once the controller is attached.
      return;
    }
    final at = now ?? DateTime.now();
    final last = _lastCameraFollowTarget;
    final lastAt = _lastCameraFollowAt;
    if (last != null && lastAt != null) {
      final moved = Geolocator.distanceBetween(
        last.latitude,
        last.longitude,
        position.latitude,
        position.longitude,
      );
      if (moved < cameraFollowMinDistanceMeters) return;
      if (at.difference(lastAt) < cameraFollowMinInterval) return;
    }
    _lastCameraFollowTarget = position;
    _lastCameraFollowAt = at;
    final update = CameraUpdate.newLatLng(position);
    final hook = cameraAnimatorForTest;
    if (hook != null) {
      hook(update);
      return;
    }
    mapController?.animateCamera(update);
  }

  void loadMap({
    required LatLng pickup,
    required LatLng destination,
    List<LatLng> intermediateStops = const [],
    LatLng? currentLeg,
  }) async {
    pickupLatLng = pickup;
    intermediateStopLatLngs = intermediateStops
        .where(
          (stop) => RideStopModel.isValidCoordinates(
            stop.latitude,
            stop.longitude,
          ),
        )
        .take(RideStopModel.maxCountPerRide)
        .toList();
    if (currentLeg != null &&
        RideStopModel.isValidCoordinates(
          currentLeg.latitude,
          currentLeg.longitude,
        )) {
      currentLegLatLng = currentLeg;
      destinationLatLng = currentLeg;
      navigateCurrentLegOnly = true;
    } else {
      currentLegLatLng = null;
      destinationLatLng = destination;
      navigateCurrentLegOnly = false;
    }
    update();

    getPolyLinePoints().then((data) {
      polylineCoordinates = data;
      generatePolyLineFromPoints(data);
      if (shouldFitDriverAndPickup()) {
        fitDriverAndPickupBounds();
      } else {
        fitPolylineBounds(data);
      }
      if (Get.isRegistered<RideDetailsController>()) {
        if (![
          AppStatus.RIDE_RUNNING,
          AppStatus.RIDE_ACTIVE,
          AppStatus.RIDE_COMPLETED,
        ].contains(Get.find<RideDetailsController>().ride.status)) {
          startPolylineAnimationIfNeeded(data);
        }
      }
    });
    await setCustomMarkerIcon();
    await refreshDriverMarker();
  }

  void startPolylineAnimationIfNeeded([List<LatLng>? points]) {
    if (_isPolylineAnimationActive) return;
    if (!Get.isRegistered<RideDetailsController>()) return;

    final rideStatus = Get.find<RideDetailsController>().ride.status;
    if ([AppStatus.RIDE_RUNNING, AppStatus.RIDE_ACTIVE, AppStatus.RIDE_COMPLETED].contains(rideStatus)) {
      return;
    }

    final data = points ?? polylineCoordinates;
    if (data.isEmpty) return;

    _isPolylineAnimationActive = true;
    animator.animatePolyline(
      data,
      _animatedPolylineId,
      MyColor.colorOrange,
      MyColor.primaryColor,
      polylines,
      () {
        // Only repaint while visible/active; controller update is guarded by caller.
        if (_isPolylineAnimationActive) {
          update();
        }
      },
    );
  }

  void stopPolylineAnimation() {
    _isPolylineAnimationActive = false;
    animator.stop(_animatedPolylineId);
  }

  @override
  void onClose() {
    stopPolylineAnimation();
    animator.dispose();
    super.onClose();
  }

  GoogleMapController? mapController;
  void animateMapCameraPosition() {
    mapController?.animateCamera(
      CameraUpdate.newCameraPosition(
        CameraPosition(
          target: LatLng(pickupLatLng.latitude, pickupLatLng.longitude),
          zoom: Environment.mapDefaultZoom,
        ),
      ),
    );
  }

  void generatePolyLineFromPoints(List<LatLng> polylineCoordinates) async {
    isLoading = true;
    update();
    PolylineId id = const PolylineId("poly");
    Polyline polyline = Polyline(
      polylineId: id,
      color: MyColor.primaryColor,
      points: polylineCoordinates,
      width: 5,
    );
    polylines[id] = polyline;
    isLoading = false;
    update();
  }

  List<LatLng> polylineCoordinates = [];
  Future<List<LatLng>> getPolyLinePoints() async {
    List<LatLng> polyLinePoints = [];

    PolylinePoints polylinePoints = PolylinePoints(
      networkClient: polylineRepo,
    );

    final intermediates = polylineWaypointLatLngs
        .map(
          (stop) => PolylineWayPoint(
            location: '${stop.latitude},${stop.longitude}',
            stopOver: true,
          ),
        )
        .toList();

    // Create Routes API request
    RoutesApiRequest request = RoutesApiRequest(
      origin: PointLatLng(pickupLatLng.latitude, pickupLatLng.longitude),
      destination: PointLatLng(
        destinationLatLng.latitude,
        destinationLatLng.longitude,
      ),
      intermediates: intermediates.isEmpty ? null : intermediates,
      travelMode: TravelMode.driving,
      routingPreference: RoutingPreference.trafficAware,
    );

    // Get route using Routes API (via our PolylineRepo proxy)
    RoutesApiResponse response = await polylinePoints.getRouteBetweenCoordinatesV2(request: request);

    if (response.primaryRoute?.polylinePoints case List<PointLatLng> points) {
      for (var point in points) {
        polyLinePoints.add(LatLng(point.latitude, point.longitude));
      }
    }

    return polyLinePoints;
  }

  Uint8List? pickupIcon;
  Uint8List? destinationIcon;
  Uint8List? driverIcon;
  Uint8List? activeStopIcon;
  final Map<int, Uint8List> numberedStopIcons = {};
  LatLng? driverLatLng;

  Set<Marker> getMarkers({
    required LatLng pickup,
    required LatLng destination,
  }) {
    final markers = <Marker>{
      if (driverLatLng != null)
        Marker(
          markerId: const MarkerId('driver_location'),
          position: driverLatLng!,
          flat: true,
          anchor: const ui.Offset(0.5, 0.5),
          icon: driverIcon == null
              ? BitmapDescriptor.defaultMarker
              : BitmapDescriptor.bytes(
                  driverIcon!,
                  height: 45,
                  bitmapScaling: MapBitmapScaling.auto,
                ),
        ),
      Marker(
        markerId: MarkerId('markerId${pickup.latitude}'),
        position: LatLng(pickup.latitude, pickup.longitude),
        icon: pickupIcon == null
            ? BitmapDescriptor.defaultMarker
            : BitmapDescriptor.bytes(
                pickupIcon!,
                height: 40,
                width: 40,
                bitmapScaling: MapBitmapScaling.auto,
              ),
        onTap: () {
          mapController?.animateCamera(
            CameraUpdate.newCameraPosition(
              CameraPosition(
                target: LatLng(pickup.latitude, pickup.longitude),
                zoom: 20,
              ),
            ),
          );
        },
      ),
      if (stopMarkers.isNotEmpty)
        ...stopMarkers.map(_buildStopMarker)
      else
        ...intermediateStopLatLngs.asMap().entries.map(
              (entry) => Marker(
                markerId: MarkerId('stop_${entry.key}_${entry.value.latitude}'),
                position: entry.value,
                icon: destinationIcon == null
                    ? BitmapDescriptor.defaultMarker
                    : BitmapDescriptor.bytes(
                        destinationIcon!,
                        height: 40,
                        width: 40,
                        bitmapScaling: MapBitmapScaling.auto,
                      ),
                onTap: () {
                  mapController?.animateCamera(
                    CameraUpdate.newCameraPosition(
                      CameraPosition(
                        target: entry.value,
                        zoom: 20,
                      ),
                    ),
                  );
                },
              ),
            ),
      // The active stop pin replaces the plain destination pin while a stop is
      // still pending: both sit on the same current-leg coordinates.
      if (stopMarkers.isEmpty || !_hasStopMarkerAt(stopMarkers, destination))
        Marker(
          markerId: MarkerId('markerId${destination.latitude}'),
          position: LatLng(destination.latitude, destination.longitude),
          icon: destinationIcon == null
              ? BitmapDescriptor.defaultMarker
              : BitmapDescriptor.bytes(
                  destinationIcon!,
                  height: 45,
                  width: 45,
                  bitmapScaling: MapBitmapScaling.auto,
                ),
          onTap: () {
            mapController?.animateCamera(
              CameraUpdate.newCameraPosition(
                CameraPosition(
                  target: LatLng(destination.latitude, destination.longitude),
                  zoom: 20,
                ),
              ),
            );
          },
        ),
    };
    return markers;
  }

  Marker _buildStopMarker(RideStopProgress stop) {
    final bytes = stop.active
        ? (activeStopIcon ?? destinationIcon)
        : numberedStopIcons[stop.number];
    return Marker(
      markerId: MarkerId(stop.markerId),
      position: LatLng(stop.latitude, stop.longitude),
      icon: bytes == null
          ? BitmapDescriptor.defaultMarker
          : BitmapDescriptor.bytes(
              bytes,
              height: 40,
              width: 40,
              bitmapScaling: MapBitmapScaling.auto,
            ),
      onTap: () {
        mapController?.animateCamera(
          CameraUpdate.newCameraPosition(
            CameraPosition(
              target: LatLng(stop.latitude, stop.longitude),
              zoom: 20,
            ),
          ),
        );
      },
    );
  }

  static bool _hasStopMarkerAt(
    List<RideStopProgress> stops,
    LatLng position,
  ) {
    return stops.any(
      (stop) =>
          stop.latitude == position.latitude &&
          stop.longitude == position.longitude,
    );
  }

  @visibleForTesting
  List<LatLng> buildRouteBoundsLatLngs() {
    return [
      pickupLatLng,
      ...intermediateStopLatLngs,
      destinationLatLng,
    ];
  }

  Future<void> setCustomMarkerIcon({bool? isRunning}) async {
    pickupIcon = await Helper.getBytesFromAsset(
      MyIcons.mapMarkerPickUpIcon,
      150,
    );
    destinationIcon = await Helper.getBytesFromAsset(
      MyIcons.mapMarkerIcon,
      150,
    );
    driverIcon = await Helper.getBytesFromAsset(MyIcons.markerCar, 110);
    activeStopIcon = destinationIcon;
    await _buildNumberedStopIcons();
    update();
  }

  /// Dimmed numbered badges for every non-active stop (ISC-F5-16).
  Future<void> _buildNumberedStopIcons() async {
    numberedStopIcons.clear();
    for (final stop in stopMarkers.where((marker) => !marker.active)) {
      final bytes = await _buildStopBadge(
        label: stop.markerLabel,
        fillColor: MyColor.neutral500,
      );
      if (bytes != null) {
        numberedStopIcons[stop.number] = bytes;
      }
    }
  }

  Future<Uint8List?> _buildStopBadge({
    required String label,
    required ui.Color fillColor,
  }) async {
    const double dimension = 120;
    try {
      final recorder = ui.PictureRecorder();
      final canvas = ui.Canvas(recorder);
      const center = ui.Offset(dimension / 2, dimension / 2);
      canvas.drawCircle(
        center,
        46,
        ui.Paint()..color = MyColor.colorWhite,
      );
      canvas.drawCircle(
        center,
        40,
        ui.Paint()..color = fillColor,
      );
      final painter = TextPainter(
        text: TextSpan(
          text: label,
          style: TextStyle(
            color: MyColor.colorWhite,
            fontSize: 42,
            fontWeight: ui.FontWeight.w700,
          ),
        ),
        textDirection: ui.TextDirection.ltr,
      )..layout();
      painter.paint(
        canvas,
        center - ui.Offset(painter.width / 2, painter.height / 2),
      );
      final picture = recorder.endRecording();
      final image = await picture.toImage(
        dimension.toInt(),
        dimension.toInt(),
      );
      final data = await image.toByteData(format: ui.ImageByteFormat.png);
      image.dispose();
      picture.dispose();
      return data?.buffer.asUint8List();
    } catch (_) {
      return null;
    }
  }

  Future<LatLng?> resolveDriverLocation() async {
    if (driverLocationForTest != null) {
      return driverLocationForTest!();
    }
    try {
      final pos = await Geolocator.getCurrentPosition(
        locationSettings: const LocationSettings(
          accuracy: LocationAccuracy.high,
        ),
      );
      return LatLng(pos.latitude, pos.longitude);
    } catch (_) {
      return null;
    }
  }

  Future<void> refreshDriverMarker() async {
    final driver = await resolveDriverLocation();
    if (driver == null) {
      return;
    }
    driverLatLng = driver;
    update();
  }

  void fitPolylineBounds(List<LatLng> coords) {
    if (coords.isEmpty) return;

    setMapFitToTour(Set<Polyline>.of(polylines.values));
  }

  @visibleForTesting
  Future<LatLng> Function()? driverLocationForTest;

  @visibleForTesting
  bool shouldFitDriverAndPickup() {
    if (!Get.isRegistered<RideDetailsController>()) {
      return false;
    }
    final details = Get.find<RideDetailsController>();
    if (details.ride.status == AppStatus.RIDE_ACTIVE) {
      return true;
    }
    // Post-accept dispatch: backend may report RUNNING before driver taps pickup.
    return details.ride.status == AppStatus.RIDE_RUNNING && !details.isRideStart;
  }

  /// ACTIVE ride: frame driver GPS + pickup (not pickup→destination).
  Future<void> fitDriverAndPickupBounds() async {
    if (mapController == null) {
      return;
    }
    if (pickupLatLng.latitude == 0 && pickupLatLng.longitude == 0) {
      return;
    }
    try {
      final driver = await resolveDriverLocation();
      if (driver == null) {
        animateMapCameraPosition();
        return;
      }
      driverLatLng = driver;
      final swLat = driver.latitude < pickupLatLng.latitude ? driver.latitude : pickupLatLng.latitude;
      final neLat = driver.latitude > pickupLatLng.latitude ? driver.latitude : pickupLatLng.latitude;
      final swLng = driver.longitude < pickupLatLng.longitude ? driver.longitude : pickupLatLng.longitude;
      final neLng = driver.longitude > pickupLatLng.longitude ? driver.longitude : pickupLatLng.longitude;
      await mapController!.animateCamera(
        CameraUpdate.newLatLngBounds(
          LatLngBounds(
            southwest: LatLng(swLat, swLng),
            northeast: LatLng(neLat, neLng),
          ),
          80,
        ),
      );
    } catch (_) {
      animateMapCameraPosition();
    }
    update();
  }

  void fitInitialCamera() {
    if (shouldFitDriverAndPickup()) {
      fitDriverAndPickupBounds();
      return;
    }
    fitPickupDestinationBounds();
  }

  void fitPickupDestinationBounds() {
    if (mapController == null) {
      return;
    }
    final points = buildRouteBoundsLatLngs();
    if (points.every((p) => p.latitude == 0 && p.longitude == 0)) {
      return;
    }
    var swLat = points.first.latitude;
    var neLat = points.first.latitude;
    var swLng = points.first.longitude;
    var neLng = points.first.longitude;
    for (final point in points) {
      if (point.latitude < swLat) swLat = point.latitude;
      if (point.latitude > neLat) neLat = point.latitude;
      if (point.longitude < swLng) swLng = point.longitude;
      if (point.longitude > neLng) neLng = point.longitude;
    }
    mapController!.animateCamera(
      CameraUpdate.newLatLngBounds(
        LatLngBounds(
          southwest: LatLng(swLat, swLng),
          northeast: LatLng(neLat, neLng),
        ),
        100,
      ),
    );
  }

  void setMapFitToTour(Set<Polyline> p) {
    double minLat = p.first.points.first.latitude;
    double minLong = p.first.points.first.longitude;
    double maxLat = p.first.points.first.latitude;
    double maxLong = p.first.points.first.longitude;
    for (var poly in p) {
      for (var point in poly.points) {
        if (point.latitude < minLat) minLat = point.latitude;
        if (point.latitude > maxLat) maxLat = point.latitude;
        if (point.longitude < minLong) minLong = point.longitude;
        if (point.longitude > maxLong) maxLong = point.longitude;
      }
    }
    mapController?.animateCamera(
      CameraUpdate.newLatLngBounds(
        LatLngBounds(
          southwest: LatLng(minLat, minLong),
          northeast: LatLng(maxLat, maxLong),
        ),
        30,
      ),
    );
    // mapController?.moveCamera(CameraUpdate.newLatLngBounds(LatLngBounds(southwest: LatLng(minLat, minLong), northeast: LatLng(maxLat, maxLong)), 30));
  }
}

