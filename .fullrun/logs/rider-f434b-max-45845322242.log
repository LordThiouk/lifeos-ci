import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:galass_driver/core/utils/app_status.dart';
import 'package:galass_driver/data/controller/map/ride_map_controller.dart';
import 'package:galass_driver/data/controller/ride/ride_details/ride_details_controller.dart';
import 'package:galass_driver/data/model/global/response_model/response_model.dart';
import 'package:galass_driver/data/model/global/ride/ride_model.dart';
import 'package:galass_driver/data/model/global/ride/ride_stop_model.dart';
import 'package:galass_driver/data/repo/polyline/polyline_repo.dart';
import 'package:galass_driver/data/repo/ride/ride_repo.dart';
import 'package:galass_driver/data/services/api_client.dart';
import 'package:galass_driver/presentation/screens/ride_details/widgets/ride_details_bottom_sheet_widget.dart';
import 'package:get/get.dart';
import 'package:google_maps_flutter/google_maps_flutter.dart';
import 'package:shared_preferences/shared_preferences.dart';

import '../helpers/recording_api_client.dart';

/// No HTTP: the widget contract is the tree, never a response.
class _NoopRideRepo extends RideRepo {
  _NoopRideRepo({required super.apiClient});

  @override
  Future<ResponseModel> getRideDetails(String id) async =>
      ResponseModel(true, 'ok', 200, <String, dynamic>{});
}

/// No GoogleMap platform view in the test host.
class _NoopMap extends RideMapController {
  _NoopMap({required super.polylineRepo});

  @override
  void loadMap({
    required LatLng pickup,
    required LatLng destination,
    List<LatLng> intermediateStops = const <LatLng>[],
    LatLng? currentLeg,
  }) {}

  @override
  Future<void> setCustomMarkerIcon({bool? isRunning}) async {}
}

RideModel _rideWithStops({required int completed}) => RideModel(
      id: '42',
      status: AppStatus.RIDE_RUNNING,
      pickupLocation: 'Plateau, Dakar',
      destination: 'Aéroport AIBD, Diass',
      distance: '38.4',
      duration: '52',
      amount: '12500',
      stops: List<RideStopModel>.generate(3, (index) {
        final sequence = index + 1;
        return RideStopModel(
          id: '$sequence',
          sequence: '$sequence',
          latitude: '14.70$sequence',
          longitude: '-17.44$sequence',
          locationLabel: 'Arrêt $sequence',
          completedAt:
              index < completed ? '2026-11-23 09:1$sequence:00' : null,
        );
      }),
    );

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  group('ISC-F5-14 — compteur visible retiré, Semantics e2e présent', () {
    late RideDetailsController controller;

    setUp(() async {
      Get.testMode = true;
      Get.reset();
      SharedPreferences.setMockInitialValues(<String, Object>{});
      final prefs = await SharedPreferences.getInstance();
      final apiClient = RecordingApiClient(sharedPreferences: prefs);
      Get.put<ApiClient>(apiClient);
      controller = Get.put<RideDetailsController>(
        RideDetailsController(
          repo: _NoopRideRepo(apiClient: apiClient),
          mapController: _NoopMap(
            polylineRepo: PolylineRepo(apiClient: apiClient),
          ),
        ),
      );
      controller.currency = 'FCFA';
      controller.userImageUrl = '';
      controller.isLoading = false;
    });

    tearDown(Get.reset);

    Future<void> pumpSheet(WidgetTester tester, RideModel ride) async {
      controller.ride = ride;
      await tester.pumpWidget(
        GetMaterialApp(
          home: Scaffold(
            body: Align(
              alignment: Alignment.bottomCenter,
              child: SizedBox(
                height: 560,
                child: RideDetailsBottomSheetWidget(
                  scrollController: ScrollController(),
                  draggableScrollableController:
                      DraggableScrollableController(),
                ),
              ),
            ),
          ),
        ),
      );
      await tester.pump(const Duration(milliseconds: 100));
      await tester.pump(const Duration(milliseconds: 100));
    }

    testWidgets(
        'compteur "x/N arrêt(s) terminé(s)" absent du widget tree en course active',
        (tester) async {
      await pumpSheet(tester, _rideWithStops(completed: 1));

      // Le pattern compteur (ex. "1/3 arrêt terminé", "2/3 arrêts terminés")
      // ne doit plus apparaître. On cible le pattern numérique, pas "Arrêt 1"
      // des labels d'itinéraire.
      expect(
        find.byWidgetPredicate(
          (w) =>
              w is Text &&
              w.data != null &&
              RegExp(r'\d+/\d+\s+arrêts?\s+terminé').hasMatch(w.data!),
        ),
        findsNothing,
      );
    });

    testWidgets(
        'Semantics invisible galass.driver.stops=<done>/<total> monté quand stops non vide',
        (tester) async {
      await pumpSheet(tester, _rideWithStops(completed: 1));

      expect(
        find.bySemanticsLabel('galass.driver.stops=1/3'),
        findsOneWidget,
      );

      final semanticsWidget = tester.widget<Semantics>(
        find.byWidgetPredicate(
          (w) =>
              w is Semantics &&
              w.properties.label == 'galass.driver.stops=1/3',
        ),
      );
      // Repère invisible pour le harnais e2e (pas un Text visible).
      expect(semanticsWidget.child, isA<SizedBox>());
      final box = semanticsWidget.child! as SizedBox;
      expect(box.width, 0.0);
      expect(box.height, 0.0);
    });

    testWidgets('Semantics reflète la progression (tous terminés)', (tester) async {
      await pumpSheet(tester, _rideWithStops(completed: 3));

      expect(
        find.bySemanticsLabel('galass.driver.stops=3/3'),
        findsOneWidget,
      );
      expect(
        find.byWidgetPredicate(
          (w) =>
              w is Text &&
              w.data != null &&
              RegExp(r'\d+/\d+\s+arrêts?\s+terminé').hasMatch(w.data!),
        ),
        findsNothing,
      );
    });

    testWidgets('pas de Semantics stops quand ride.stops vide ou null',
        (tester) async {
      await pumpSheet(
        tester,
        RideModel(
          id: '43',
          status: AppStatus.RIDE_RUNNING,
          pickupLocation: 'Plateau, Dakar',
          destination: 'Aéroport AIBD, Diass',
          distance: '38.4',
          duration: '52',
          amount: '12500',
        ),
      );

      expect(
        find.byWidgetPredicate(
          (w) =>
              w is Semantics &&
              (w.properties.label ?? '').startsWith('galass.driver.stops='),
        ),
        findsNothing,
      );
    });

    testWidgets('pas de Semantics stops quand ride.stops est une liste vide',
        (tester) async {
      await pumpSheet(
        tester,
        RideModel(
          id: '44',
          status: AppStatus.RIDE_RUNNING,
          pickupLocation: 'Plateau, Dakar',
          destination: 'Aéroport AIBD, Diass',
          distance: '38.4',
          duration: '52',
          amount: '12500',
          stops: const <RideStopModel>[],
        ),
      );

      expect(
        find.byWidgetPredicate(
          (w) =>
              w is Semantics &&
              (w.properties.label ?? '').startsWith('galass.driver.stops='),
        ),
        findsNothing,
      );
    });
  });
}

