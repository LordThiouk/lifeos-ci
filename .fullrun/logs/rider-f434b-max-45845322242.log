import 'package:galassrider/core/helper/ride_alert_once.dart';
import 'package:galassrider/core/helper/shared_preference_helper.dart';
import 'package:galassrider/core/helper/string_format_helper.dart';
import 'package:galassrider/core/utils/method.dart';
import 'package:galassrider/core/utils/url_container.dart';
import 'package:galassrider/data/services/api_client.dart';
import 'package:path_provider/path_provider.dart';

Future<void> _messageHandler(RemoteMessage message) async {
  // Firebase is already initialized in main.dart
}

class PushNotificationService {
  PushNotificationService({required this.apiClient});

  final ApiClient apiClient;
  static bool _tokenRefreshListenerRegistered = false;

  // Shared with PusherRideController so a Pusher alert and its FCM duplicate
  // never produce two banners for the same `ride_id`+type (ISC-F4-34).
  final RideAlertOnce _rideAlertOnce = RideAlertOnce.shared;

  Future<void> setupInteractedMessage() async {
    FirebaseMessaging.onBackgroundMessage(_messageHandler);
    final FirebaseMessaging messaging = FirebaseMessaging.instance;
    await _requestPermissions();

    await messaging.requestPermission(
      alert: true,
      announcement: false,
      badge: true,
      carPlay: false,
      criticalAlert: false,
      provisional: false,
      sound: true,
    );

    _registerTokenRefreshListener();

    FirebaseMessaging.onMessageOpenedApp.listen((RemoteMessage message) {
      printX('onMessageOpenedApp ${message.toMap()}');
    });

    await enableIOSNotifications();
    await registerNotificationListeners();
  }

  void _registerTokenRefreshListener() {
    if (_tokenRefreshListenerRegistered) {
      return;
    }
    _tokenRefreshListenerRegistered = true;

    FirebaseMessaging.instance.onTokenRefresh.listen((String fcmToken) async {
      if (fcmToken.isEmpty) {
        return;
      }
      await apiClient.sharedPreferences.setString(
        SharedPreferenceHelper.fcmDeviceKey,
        fcmToken,
      );
      if (apiClient.getToken().isNotEmpty) {
        await sendUpdatedToken(fcmToken);
      }
    });
  }

  Future<void> registerNotificationListeners() async {
    final AndroidNotificationChannel channel = androidNotificationChannel();
    final FlutterLocalNotificationsPlugin flutterLocalNotificationsPlugin =
        FlutterLocalNotificationsPlugin();
    await flutterLocalNotificationsPlugin
        .resolvePlatformSpecificImplementation<
            AndroidFlutterLocalNotificationsPlugin>()
        ?.createNotificationChannel(channel);
    const androidSettings = AndroidInitializationSettings(
      '@mipmap/ic_launcher',
    );
    const iOSSettings = DarwinInitializationSettings(
      requestSoundPermission: true,
      requestBadgePermission: true,
      requestAlertPermission: true,
    );
    const initSettings = InitializationSettings(
      android: androidSettings,
      iOS: iOSSettings,
    );
    await flutterLocalNotificationsPlugin.initialize(
      initSettings,
      onDidReceiveNotificationResponse: (message) async {
        try {
          final dynamic rawPayload = message.payload;
          final String? payloadString = rawPayload == null
              ? null
              : rawPayload is String
                  ? rawPayload
                  : jsonEncode(rawPayload);
          printX('remarkNotification $payloadString');
          if (payloadString != null && payloadString.isNotEmpty) {
            final Map<dynamic, dynamic> payloadMap =
                jsonDecode(payloadString) as Map<dynamic, dynamic>;
            final Map<String, String> payload = payloadMap.map(
              (key, value) => MapEntry(key.toString(), value.toString()),
            );

            printX('remarkNotification ${payload['for_app']}');
            printX('remarkNotification ${payload['ride_id']}');
            final String? remark = payload['for_app'];

            if (remark != null && remark.isNotEmpty) {
              final String route = remark.split('-')[0];
              final String id = remark.split('-')[1];
              getx.Get.toNamed(route, arguments: id);
            }
          }
        } catch (e) {
          if (kDebugMode) {
            printX(e.toString());
          }
        }
      },
    );

    FirebaseMessaging.onMessage.listen((RemoteMessage message) async {
      final content = _notificationContent(message);
      if (content.title == null && content.body == null) {
        return;
      }

      // ISC-F4-34: never show two banners for the same ride + alert type. The
      // gate is shared with the Pusher path and a new `ride_id` re-alerts.
      if (!shouldPresentMessage(message)) {
        return;
      }

      final String title = content.title ?? '';
      final String body = content.body ?? '';
      final AndroidNotification? android = message.notification?.android;

      if (Platform.isAndroid) {
        BigPictureStyleInformation? bigPictureStyle;
        if (android?.imageUrl != null) {
          try {
            final Dio dio = Dio();
            final Response<List<int>> response = await dio.get<List<int>>(
              android!.imageUrl!,
              options: Options(responseType: ResponseType.bytes),
            );
            if (response.data != null) {
              final Uint8List bytes = Uint8List.fromList(response.data!);
              final String localImagePath = await _saveImageLocally(bytes);
              bigPictureStyle = BigPictureStyleInformation(
                FilePathAndroidBitmap(localImagePath),
                contentTitle: title,
                summaryText: body,
              );
            }
          } catch (e) {
            if (kDebugMode) {
              printX('notification image download failed: $e');
            }
          }
        }

        await flutterLocalNotificationsPlugin.show(
          message.hashCode,
          title,
          body,
          NotificationDetails(
            android: AndroidNotificationDetails(
              channel.id,
              channel.name,
              channelDescription: channel.description,
              icon: '@mipmap/ic_launcher',
              playSound: true,
              enableVibration: true,
              enableLights: true,
              fullScreenIntent: true,
              priority: Priority.high,
              styleInformation: bigPictureStyle ?? const BigTextStyleInformation(''),
              importance: Importance.high,
            ),
          ),
          payload: jsonEncode(message.data),
        );
        return;
      }

      if (Platform.isIOS) {
        // FCM foreground auto-presentation is disabled in enableIOSNotifications
        // so this shared-gated `show` is the only banner path. It covers both
        // notification payloads and data-only messages (ISC-F4-34).
        await flutterLocalNotificationsPlugin.show(
          message.hashCode,
          title,
          body,
          const NotificationDetails(
            iOS: DarwinNotificationDetails(
              presentAlert: true,
              presentBadge: true,
              presentSound: true,
            ),
          ),
          payload: jsonEncode(message.data),
        );
      }
    });
  }

  /// Whether this FCM message may produce a banner. Uses the gate shared with
  /// the Pusher alert path (ISC-F4-34); exposed so the dedup can be unit-tested
  /// without initializing Firebase.
  @visibleForTesting
  bool shouldPresentMessage(RemoteMessage message) {
    return _rideAlertOnce.shouldAlert(
      rideId: _messageRideId(message),
      type: _messageType(message),
    );
  }

  ({String? title, String? body}) _notificationContent(RemoteMessage message) {
    final RemoteNotification? notification = message.notification;
    final Map<String, dynamic> data = message.data;

    final String? title = notification?.title ??
        data['title']?.toString() ??
        data['subject']?.toString();
    final String? body = notification?.body ??
        data['body']?.toString() ??
        data['message']?.toString() ??
        data['text']?.toString();

    return (title: title, body: body);
  }

  String? _messageRideId(RemoteMessage message) {
    final Map<String, dynamic> data = message.data;
    final String value =
        (data['ride_id'] ?? data['rideId'] ?? '').toString().trim();
    return value.isEmpty ? null : value;
  }

  String? _messageType(RemoteMessage message) {
    final Map<String, dynamic> data = message.data;
    final String value =
        (data['type'] ?? data['act'] ?? data['event'] ?? '').toString().trim();
    return value.isEmpty ? null : value;
  }

  /// Shows an in-app ride alert as a local notification (audio and vibration
  /// are handled by the caller). Uses the same high-importance channel as FCM.
  static Future<void> showLocalAlert({
    required String title,
    required String body,
  }) async {
    final FlutterLocalNotificationsPlugin plugin =
        FlutterLocalNotificationsPlugin();
    final AndroidNotificationChannel channel = const AndroidNotificationChannel(
      'high_importance_channel',
      'High Importance Notifications',
      description: 'This channel is used for important notifications.',
      playSound: true,
      enableVibration: true,
      enableLights: true,
      importance: Importance.high,
    );
    await plugin.show(
      DateTime.now().millisecondsSinceEpoch ~/ 1000,
      title,
      body,
      NotificationDetails(
        android: AndroidNotificationDetails(
          channel.id,
          channel.name,
          channelDescription: channel.description,
          importance: Importance.high,
          priority: Priority.high,
          playSound: true,
          enableVibration: true,
        ),
        iOS: const DarwinNotificationDetails(
          presentAlert: true,
          presentBadge: true,
          presentSound: true,
        ),
      ),
    );
  }

  Future<void> enableIOSNotifications() async {
    // Let the `onMessage` listener present every foreground banner instead of
    // letting FCM auto-present notification payloads. Auto-presentation cannot
    // be gated, so identical `ride_id`+type pushes would always show twice on
    // iOS (ISC-F4-34). Manual `show` keeps the shared dedup authoritative.
    await FirebaseMessaging.instance.setForegroundNotificationPresentationOptions(
      alert: false,
      badge: false,
      sound: false,
    );
  }

  AndroidNotificationChannel androidNotificationChannel() =>
      const AndroidNotificationChannel(
        'high_importance_channel',
        'High Importance Notifications',
        description: 'This channel is used for important notifications.',
        playSound: true,
        enableVibration: true,
        enableLights: true,
        importance: Importance.high,
      );

  Future<void> _requestPermissions() async {
    final FlutterLocalNotificationsPlugin flutterLocalNotificationsPlugin =
        FlutterLocalNotificationsPlugin();

    if (Platform.isIOS || Platform.isMacOS) {
      await flutterLocalNotificationsPlugin
          .resolvePlatformSpecificImplementation<
              IOSFlutterLocalNotificationsPlugin>()
          ?.requestPermissions(alert: true, badge: true, sound: true);
      await flutterLocalNotificationsPlugin
          .resolvePlatformSpecificImplementation<
              MacOSFlutterLocalNotificationsPlugin>()
          ?.requestPermissions(alert: true, badge: true, sound: true);
    } else if (Platform.isAndroid) {
      final AndroidFlutterLocalNotificationsPlugin? androidImplementation =
          flutterLocalNotificationsPlugin
              .resolvePlatformSpecificImplementation<
                  AndroidFlutterLocalNotificationsPlugin>();
      await androidImplementation?.requestNotificationsPermission();
    }
  }

  Future<String> _saveImageLocally(Uint8List bytes) async {
    final directory = await getTemporaryDirectory();
    final imagePath = '${directory.path}/notification_image.png';
    final file = File(imagePath);
    await file.writeAsBytes(bytes);
    return imagePath;
  }

  /// Registers the current FCM token with Laravel after authentication.
  Future<bool> sendUserToken() async {
    if (apiClient.getToken().isEmpty) {
      return false;
    }

    final String? fcmToken = await FirebaseMessaging.instance.getToken();
    if (fcmToken == null || fcmToken.isEmpty) {
      return false;
    }

    await apiClient.sharedPreferences.setString(
      SharedPreferenceHelper.fcmDeviceKey,
      fcmToken,
    );
    return sendUpdatedToken(fcmToken);
  }

  Future<bool> sendUpdatedToken(String deviceToken) async {
    if (deviceToken.isEmpty) {
      return false;
    }

    await apiClient.sharedPreferences.setString(
      SharedPreferenceHelper.fcmDeviceKey,
      deviceToken,
    );

    final String url =
        '${UrlContainer.baseUrl}${UrlContainer.deviceTokenEndPoint}';
    final Map<String, String> map = deviceTokenMap(deviceToken);

    final response = await apiClient.request(
      url,
      Method.postMethod,
      map,
      passHeader: true,
    );
    return response.isSuccess && response.statusCode == 200;
  }

  Map<String, String> deviceTokenMap(String deviceToken) {
    return {'token': deviceToken};
  }
}

