          channelName: 'private-rider-user-1',
          data: EventData(rideId: '42'),
        ),
      );
      expect(pusherRideController.alerts, [PusherRideController.pickUpAlertType]);

      final service = PushNotificationService(apiClient: apiClient);

      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '42', 'type': 'pick_up'}),
        ),
        isFalse,
      );
    });

    test('an FCM banner suppresses the Pusher alert for the same ride+type', () {
      final service = PushNotificationService(apiClient: apiClient);

      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '42', 'type': 'pick_up'}),
        ),
        isTrue,
      );

      pusherRideController.updateEvent(
        PusherResponseModel(
          eventName: 'pick_up',
          channelName: 'private-rider-user-1',
          data: EventData(rideId: '42'),
        ),
      );

      expect(pusherRideController.alerts, isEmpty);
    });
  });
}

