      );
      expect(pusherRideController.alerts, [PusherRideController.pickUpAlertType]);

      pusherRideController.onClose();
      pusherRideController = RecordingPusherRideController(
        apiClient: apiClient,
        rideMessageController: RideMessageController(
          repo: PusherMockMessageRepo(apiClient: apiClient),
        ),
        rideDetailsController: rideDetailsController,
        rideID: '42',
      );

      pusherRideController.updateEvent(
        PusherResponseModel(
          eventName: 'pick_up',
          channelName: 'private-rider-user-1',
          data: EventData(rideId: '42'),
