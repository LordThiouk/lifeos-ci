import 'dart:math' as math;

import 'package:flutter/foundation.dart' show visibleForTesting;
import 'package:google_maps_flutter/google_maps_flutter.dart';
import 'package:galassrider/core/helper/ride_alert_once.dart';
import 'package:galassrider/core/helper/shared_preference_helper.dart';
import 'package:galassrider/core/helper/string_format_helper.dart';
import 'dart:convert';
import 'package:galassrider/core/route/route.dart';
import 'package:galassrider/core/utils/app_status.dart';
import 'package:galassrider/core/utils/audio_utils.dart';
import 'package:galassrider/core/utils/my_strings.dart';
import 'package:galassrider/core/utils/util.dart';
import 'package:galassrider/data/controller/ride/ride_details/ride_details_controller.dart';
import 'package:galassrider/data/model/general_setting/general_setting_response_model.dart';
import 'package:galassrider/data/model/global/pusher/pusher_event_response_model.dart';
import 'package:galassrider/data/services/push_notification_service.dart';
import 'package:galassrider/data/services/pusher_service.dart';
import 'package:pusher_channels_flutter/pusher_channels_flutter.dart';
import 'package:get/get.dart';
import 'package:galassrider/data/controller/ride/ride_meassage/ride_meassage_controller.dart';
import 'package:galassrider/data/services/api_client.dart';

class PusherRideController extends GetxController {
  ApiClient apiClient;
  RideMessageController rideMessageController;
  RideDetailsController rideDetailsController;
  String rideID;
  PusherRideController({
    required this.apiClient,
    required this.rideMessageController,
    required this.rideDetailsController,
    required this.rideID,
  });

  static const String pickUpAlertType = 'pick_up';
  static const String arrivingSoonAlertType = 'arriving_soon';
  static const double arrivingSoonRadiusMeters = 300;

  // Shared with PushNotificationService so the gate survives controller
  // recreation and dedupes across Pusher <-> FCM (ISC-F4-34).
  final RideAlertOnce _rideAlertOnce = RideAlertOnce.shared;

  @override
  void onInit() {
    super.onInit();
    PusherManager().addListener(onEvent);
  }

  PusherConfig pusherConfig = PusherConfig();

  /// Handle incoming Pusher events
  void onEvent(PusherEvent event) {
    try {
      printD('Pusher Channel: ${event.channelName}');
      printD('Pusher Event: ${event.eventName}');
      if (event.data == null) return;

      Map<String, dynamic> data = {};
      try {
        final decoded = jsonDecode(event.data);
        if (decoded is! Map) {
          printX('Invalid JSON: expected object');
          return;
        }
        data = Map<String, dynamic>.from(decoded);
      } catch (e) {
        printX('Invalid JSON: $e');
        return;
      }

      if (_isStopCompletedEvent(event.eventName)) {
        data = _stopCompletedEnvelope(event, data);
      }

      final model = PusherResponseModel.fromJson(data);
      final modifiedEvent = PusherResponseModel(
        eventName: event.eventName,
        channelName: event.channelName,
        data: model.data,
      );

      updateEvent(modifiedEvent);
    } catch (e) {
      printX('onEvent error: $e');
    }
  }

  /// Update UI or state based on event name
  void updateEvent(PusherResponseModel event) {
    final eventName = event.eventName?.toLowerCase();
    printX('Handling event: $eventName');

    switch (eventName) {
      case 'online_payment_received':
        _handleOnlinePayment(event);
        break;

      case 'message_received':
        _handleMessageReceived(event);
        break;

      case 'live_location':
        _handleLiveLocation(event);
        break;

      case 'driver_assigned':
        _handleDriverAssigned(event);
        break;

      case 'cancel_ride':
        _handleCancelRide(event);
        break;

      case 'cash_payment_received':
        _handleCashPayment(event);
        break;

      case 'pick_up':
        _handlePickUp(event);
        break;

      case 'ride_end':
        _updateRideIfAvailable(event);
        break;

      case 'stop_completed':
        _handleStopCompleted(event);
        break;

      default:
        _updateRideIfAvailable(event);
        break;
    }
  }

  /// Handlers for each event type

  String? _eventRideId(PusherResponseModel event) =>
      event.data?.ride?.id ?? event.data?.rideId;

  bool _isDifferentRide(PusherResponseModel event) {
    final eventRideId = _eventRideId(event);
    if (eventRideId != null && eventRideId != rideID) {
      printX('Event for different ride: $eventRideId, current ride: $rideID');
      return true;
    }
    return false;
  }

  void _handleOnlinePayment(PusherResponseModel event) {
    if (_isDifferentRide(event)) {
      return;
    }
    final eventRideId = _eventRideId(event);
    printX('Online payment received for ride: $eventRideId');
    openRideReview(eventRideId ?? '');
  }

  void _handleMessageReceived(PusherResponseModel eventResponse) {
    if (eventResponse.data?.message != null) {
      if (_isDifferentRide(eventResponse)) {
        return;
      }
      if (isRideDetailsPage()) {
        if (rideDetailsController.repo.apiClient.isNotificationAudioEnable()) {
          MyUtils.vibrate();
        }
      }

      rideMessageController.addEventMessage(eventResponse.data!.message!);
    }
  }

  void _handleLiveLocation(PusherResponseModel eventResponse) {
    if (_isDifferentRide(eventResponse)) {
      return;
    }
    final status = rideDetailsController.ride.status;
    final isActive = status == AppStatus.RIDE_ACTIVE.toString();
    final isRunning = status == AppStatus.RIDE_RUNNING.toString();
    if (!isActive && !isRunning) {
      return;
    }
    final lat = StringConverter.formatDouble(eventResponse.data?.driverLatitude ?? '0', precision: 10);
    final lng = StringConverter.formatDouble(eventResponse.data?.driverLongitude ?? '0', precision: 10);
    final driverPosition = LatLng(lat, lng);
    rideDetailsController.mapController.updateDriverLocation(
      latLng: driverPosition,
      isRunning: false,
    );
    if (isActive) {
      _alertArrivingSoonIfNearPickup(eventResponse, driverPosition);
    }
  }

  /// Option B (Papa 2026-11-26): a distinct "arriving soon" alert once the
  /// driver enters the pickup geofence. One-shot per ride, independent of the
  /// `pick_up` alert so both types can fire once each.
  void _alertArrivingSoonIfNearPickup(
    PusherResponseModel eventResponse,
    LatLng driverPosition,
  ) {
    final pickup = _ridePickupLatLng();
    if (pickup == null) {
      return;
    }
    if (distanceMetersBetween(driverPosition, pickup) > arrivingSoonRadiusMeters) {
      return;
    }
    _alertOnce(
      rideId: _eventRideId(eventResponse) ?? rideID,
      type: arrivingSoonAlertType,
    );
  }

  /// Option C (Papa 2026-11-26): the driver pressed "start/pick up". Plays the
  /// single client alert for this ride and type, then refreshes the ride.
  void _handlePickUp(PusherResponseModel eventResponse) {
    if (_isDifferentRide(eventResponse)) {
      return;
    }
    _alertOnce(
      rideId: _eventRideId(eventResponse) ?? rideID,
      type: pickUpAlertType,
    );
    _updateRideIfAvailable(eventResponse);
  }

  void _alertOnce({required String rideId, required String type}) {
    if (!_rideAlertOnce.shouldAlert(rideId: rideId, type: type)) {
      return;
    }
    playRideAlert(rideId: rideId, type: type);
  }

  /// Audio + vibration + local notification for one ride alert. Overridable so
  /// unit tests can observe the one-shot gate without platform channels.
  @visibleForTesting
  void playRideAlert({required String rideId, required String type}) {
    AudioUtils.playAudio(apiClient.getNotificationAudio());
    if (rideDetailsController.repo.apiClient.isNotificationAudioEnable()) {
      MyUtils.vibrate();
    }
    final bool isPickUp = type == pickUpAlertType;
    PushNotificationService.showLocalAlert(
      title: isPickUp ? MyStrings.ridePickedUpTitle : MyStrings.rideArrivingSoonTitle,
      body: isPickUp ? MyStrings.ridePickedUpBody : MyStrings.rideArrivingSoonBody,
    );
  }

  LatLng? _ridePickupLatLng() {
    final controllerPickup = rideDetailsController.pickupLatLng;
    if (controllerPickup.latitude != 0 && controllerPickup.longitude != 0) {
      return controllerPickup;
    }
    final ride = rideDetailsController.ride;
    final lat = StringConverter.formatDouble(ride.pickupLatitude ?? '', precision: 16);
    final lng = StringConverter.formatDouble(ride.pickupLongitude ?? '', precision: 16);
    if (lat == 0 || lng == 0) {
      return null;
    }
    return LatLng(lat, lng);
  }

  /// Great-circle distance in metres (pure Dart, no platform channel) used by
  /// the "arriving soon" geofence.
  @visibleForTesting
  static double distanceMetersBetween(LatLng a, LatLng b) {
    const double earthRadiusMeters = 6371000;
    final double dLat = _toRadians(b.latitude - a.latitude);
    final double dLng = _toRadians(b.longitude - a.longitude);
    final double lat1 = _toRadians(a.latitude);
    final double lat2 = _toRadians(b.latitude);
    final double h = math.sin(dLat / 2) * math.sin(dLat / 2) +
        math.cos(lat1) * math.cos(lat2) * math.sin(dLng / 2) * math.sin(dLng / 2);
    return 2 * earthRadiusMeters * math.asin(math.min(1, math.sqrt(h)));
  }

  static double _toRadians(double degrees) => degrees * math.pi / 180.0;

  void _handleDriverAssigned(PusherResponseModel eventResponse) {
    if (_isDifferentRide(eventResponse)) {
      return;
    }
    final data = eventResponse.data;
    if (data == null) return;

    AudioUtils.playAudio(apiClient.getNotificationAudio());
    if (rideDetailsController.repo.apiClient.isNotificationAudioEnable()) {
      MyUtils.vibrate();
    }

    rideDetailsController.updateDriverAssigned(
      driverName: data.driverName ?? '',
      avgRating: data.avgRating ?? '',
      etaMinutes: data.etaMinutes ?? '',
      ride: data.ride,
    );
    rideDetailsController.getRideDetails(rideID, shouldLoading: false);
  }

  void _handleCancelRide(PusherResponseModel eventResponse) {
    if (_isDifferentRide(eventResponse)) {
      return;
    }
    rideDetailsController.stopPendingPoll();
    final ride = eventResponse.data?.ride;
    if (ride != null) {
      rideDetailsController.updateRide(ride);
    }
    rideDetailsController.getRideDetails(rideID, shouldLoading: false);
  }

  /// Sortie de l'écran de paiement, quel que soit le moyen d'encaissement. Un seul
  /// endroit pour les deux : le rider doit atterrir sur la même fin de course.
  @visibleForTesting
  void openRideReview(String rideId) {
    Get.offAndToNamed(RouteHelper.rideReviewScreen, arguments: rideId);
  }

  void _handleCashPayment(PusherResponseModel event) {
    if (_isDifferentRide(event)) {
      return;
    }
    // Le chauffeur a encaissé en espèces. Le rider n'a plus rien à payer : la modale
    // « Sélectionnez un mode de paiement » doit disparaître et l'écran de fin de course
    // s'ouvrir. Sans ça (run 44354825315) le rider restait bloqué sur la modale alors
    // que la course était réglée — le paiement en ligne, lui, naviguait déjà.
    rideDetailsController.updatePaymentRequested(isRequested: false);
    _updateRideIfAvailable(event);
    final eventRideId = _eventRideId(event);
    printX('Cash payment received for ride: $eventRideId');
    if (Get.currentRoute == RouteHelper.rideReviewScreen) {
      return;
    }
    openRideReview(eventRideId ?? '');
  }

  bool _isStopCompletedEvent(String? eventName) =>
      eventName?.toLowerCase() == 'stop_completed';

  Map<String, dynamic> _stopCompletedEnvelope(
    PusherEvent event,
    Map<String, dynamic> decoded,
  ) {
    if (decoded['data'] is Map) {
      final inner = Map<String, dynamic>.from(decoded['data'] as Map);
      return {
        'channelName': decoded['channelName'] ?? event.channelName,
        'eventName': decoded['eventName'] ?? event.eventName,
        'data': inner,
      };
    }

    return {
      'channelName': event.channelName,
      'eventName': event.eventName,
      'data': decoded,
    };
  }

  String? _usableRideId(String? raw) {
    final value = raw?.trim() ?? '';
    if (value.isEmpty || value.toLowerCase() == 'null') {
      return null;
    }
    return value;
  }

  void _handleStopCompleted(PusherResponseModel event) {
    final data = event.data;
    if (data == null) return;

    final eventRideId =
        _usableRideId(data.ride?.id) ?? _usableRideId(data.rideId);
    if (eventRideId == null || eventRideId != rideID) {
      return;
    }

    final stopId = data.stopId;
    final sequence = data.stopSequence;

    if (stopId == null && sequence == null) return;

    rideDetailsController.markStopCompleted(
      stopId: stopId,
      sequence: sequence,
    );
  }

  void _updateRideIfAvailable(PusherResponseModel eventResponse) {
    if (_isDifferentRide(eventResponse)) {
      return;
    }
    final ride = eventResponse.data?.ride;
    if (ride != null) {
      rideDetailsController.updateRide(ride);
    }
  }

  /// Utility
  bool isRideDetailsPage() => Get.currentRoute == RouteHelper.rideDetailsScreen;

  @override
  void onClose() {
    PusherManager().removeListener(onEvent);
    super.onClose();
  }

  Future<void> ensureConnection({String? channelName}) async {
    try {
      var userId = apiClient.sharedPreferences.getString(SharedPreferenceHelper.userIdKey) ?? '';
      await PusherManager().checkAndInitIfNeeded(channelName ?? "private-rider-user-$userId");
    } catch (e) {
      printX("Error ensuring connection: $e");
    }
  }
}

