    test('a Pusher alert suppresses the FCM banner for the same ride+type', () {
      pusherRideController.updateEvent(
        PusherResponseModel(
          eventName: 'pick_up',
          channelName: 'private-rider-user-1',
          data: EventData(rideId: '42'),
        ),
      );
      expect(pusherRideController.alerts, [PusherRideController.pickUpAlertType]);

