import 'package:flutter/material.dart';
import 'package:flutter/rendering.dart';
import 'package:flutter/semantics.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:galass_driver/presentation/components/buttons/rounded_button.dart';
import 'package:get/get.dart';

/// Bornes d'un noeud ramenées dans l'espace de son parent.
///
/// `SemanticsNode.rect` est local au noeud : la position réelle d'un frère vit dans son
/// `transform`. Comparer les `rect` bruts fait croire que deux boutons empilés occupent
/// la même place (mesure du 2026-11-19 : rect identiques (0,0,800,56), transform (0,76)).
Rect _boundsInParent(SemanticsNode node) {
  final Matrix4 transform = node.transform ?? Matrix4.identity();
  return MatrixUtils.transformRect(transform, node.rect);
}

/// Mesure du 2026-11-18 (run e2e 44354825315, ui/37-driver-running-stop1.xml) :
/// « Confirmer l'arrêt » et « Terminer la course » sortaient dans UN seul noeud
/// cliquable (bounds [0,1402][1080,2337], content-desc = les deux libellés). Le harnais
/// ne pouvait donc pas taper « Confirmer l'arrêt » à l'exact, et TalkBack lisait les
/// deux actions d'un coup.
///
/// Contrat : chaque RoundedButton est son propre noeud, avec SON libellé, et son action.
void main() {
  testWidgets('deux RoundedButton voisins ne fusionnent pas en un seul noeud',
      (tester) async {
    final handle = tester.ensureSemantics();
    var confirmed = 0;
    var ended = 0;

    await tester.pumpWidget(
      GetMaterialApp(
        home: Scaffold(
          body: Column(
            children: [
              RoundedButton(
                text: 'Confirmer l arret',
                press: () => confirmed++,
              ),
              const SizedBox(height: 20),
              RoundedButton(
                text: 'Terminer la course',
                press: () => ended++,
              ),
            ],
          ),
        ),
      ),
    );
    await tester.pumpAndSettle();

    final confirmNode =
        tester.getSemantics(find.bySemanticsLabel('Confirmer l arret'));
    final endNode =
        tester.getSemantics(find.bySemanticsLabel('Terminer la course'));

    expect(confirmNode.id, isNot(endNode.id),
        reason: 'les deux boutons doivent etre deux noeuds distincts');
    expect(confirmNode.label, 'Confirmer l arret');
    expect(endNode.label, 'Terminer la course');
    expect(confirmNode.getSemanticsData().hasAction(SemanticsAction.tap), isTrue);
    expect(endNode.getSemanticsData().hasAction(SemanticsAction.tap), isTrue);

    final Rect confirmBounds = _boundsInParent(confirmNode);
    final Rect endBounds = _boundsInParent(endNode);
    expect(confirmBounds, isNot(endBounds),
        reason: 'chaque noeud porte ses propres bornes, pas celles des deux');
    expect(confirmBounds.height, lessThan(100),
        reason: 'un noeud = un bouton (56 px), jamais les deux empilés');
    expect(endBounds.height, lessThan(100),
        reason: 'un noeud = un bouton (56 px), jamais les deux empilés');
    expect(confirmBounds.top, lessThan(endBounds.top),
        reason: 'le premier bouton reste au-dessus du second');

    handle.dispose();
  });

  testWidgets('le libellé du bouton est le sien, pas celui du voisin',
      (tester) async {
    final handle = tester.ensureSemantics();
    await tester.pumpWidget(
      GetMaterialApp(
        home: Scaffold(
          body: Column(
            children: [
              RoundedButton(text: 'Confirmer l arret', press: () {}),
              const SizedBox(height: 20),
              RoundedButton(text: 'Terminer la course', press: () {}),
            ],
          ),
        ),
      ),
    );
    await tester.pumpAndSettle();

    final labels = tester
        .widgetList<Semantics>(find.byType(Semantics))
        .map((s) => s.properties.label)
        .whereType<String>()
        .toList();

    expect(labels, contains('Confirmer l arret'));
    expect(labels, contains('Terminer la course'));
    expect(labels.any((l) => l.contains('Terminer la course') && l.contains('Confirmer')),
        isFalse,
        reason: 'aucun noeud ne doit additionner les deux libellés');

    handle.dispose();
  });

  testWidgets('un bouton désactivé reste un bouton, mais inerte', (tester) async {
    final handle = tester.ensureSemantics();
    await tester.pumpWidget(
      GetMaterialApp(
        home: Scaffold(
          body: RoundedButton(
            text: 'Terminer la course',
            isDisabled: true,
            press: () => fail('un bouton désactivé ne doit pas agir'),
          ),
        ),
      ),
    );
    await tester.pumpAndSettle();

    final node = tester.getSemantics(find.bySemanticsLabel('Terminer la course'));
    expect(node.getSemanticsData().hasAction(SemanticsAction.tap), isFalse);

    handle.dispose();
  });
}

