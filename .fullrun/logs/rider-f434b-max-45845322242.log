$ cat lib/core/helper/ride_alert_once.dart
import 'package:flutter/foundation.dart' show visibleForTesting;

/// One-shot gate keyed by `ride_id` + alert `type` (ISC-F4-34).
///
/// The first alert of a given type for a given ride wins; any duplicate of the
/// same pair is a no-op. A new ride carries a new `ride_id`, so it alerts again
/// without an explicit reset. When either part of the key is unknown there is
/// nothing to deduplicate and the alert is allowed.
class RideAlertOnce {
  RideAlertOnce();

  /// Process-wide gate shared by the Pusher alert path and the FCM banner path.
  ///
  /// Sharing one instance keeps the gate alive across `PusherRideController` /
  /// `RideDetailsScreen` recreation and prevents a Pusher alert and its FCM
  /// duplicate from producing two banners for the same `ride_id`+type.
  static final RideAlertOnce shared = RideAlertOnce();

  final Set<String> _fired = <String>{};

  bool shouldAlert({String? rideId, String? type}) {
    final String id = (rideId ?? '').trim();
    final String kind = (type ?? '').trim();
    if (id.isEmpty || kind.isEmpty) {
      return true;
    }
    return _fired.add('$id::$kind');
  }

  @visibleForTesting
  bool hasAlerted({required String rideId, required String type}) {
    return _fired.contains('${rideId.trim()}::${type.trim()}');
  }

  @visibleForTesting
  void reset() {
    _fired.clear();
  }
}

