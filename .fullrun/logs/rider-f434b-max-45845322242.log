      expect(pusherRideController.alerts, isEmpty);
    });

    test('the gate re-alerts for a new ride id', () {
      final gate = RideAlertOnce();

      expect(gate.shouldAlert(rideId: '42', type: 'pick_up'), isTrue);
      expect(gate.shouldAlert(rideId: '42', type: 'pick_up'), isFalse);
      expect(gate.shouldAlert(rideId: '42', type: 'arriving_soon'), isTrue);
      expect(gate.shouldAlert(rideId: '43', type: 'pick_up'), isTrue);
    });

    test('the one-shot gate survives PusherRideController recreation', () {
      pusherRideController.updateEvent(
        PusherResponseModel(
          eventName: 'pick_up',
          channelName: 'private-rider-user-1',
          data: EventData(rideId: '42'),
