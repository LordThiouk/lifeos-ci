import 'package:firebase_messaging/firebase_messaging.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:galassrider/core/helper/ride_alert_once.dart';
import 'package:galassrider/core/helper/shared_preference_helper.dart';
import 'package:galassrider/core/utils/method.dart';
import 'package:galassrider/data/model/global/response_model/response_model.dart';
import 'package:galassrider/data/services/api_client.dart';
import 'package:galassrider/data/services/push_notification_service.dart';
import 'package:shared_preferences/shared_preferences.dart';

class _RecordingApiClient extends ApiClient {
  _RecordingApiClient({required super.sharedPreferences});

  int postCount = 0;
  Map<String, dynamic>? lastParams;
  bool succeedPost = true;

  @override
  Future<ResponseModel> request(
    String uri,
    String method,
    Map<String, dynamic>? params, {
    bool passHeader = false,
    bool isOnlyAcceptType = false,
  }) async {
    if (method == Method.postMethod) {
      postCount++;
      lastParams = params;
    }
    return ResponseModel(succeedPost, 'ok', succeedPost ? 200 : 401, {});
  }
}

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  group('PushNotificationService.sendUpdatedToken', () {
    late SharedPreferences prefs;
    late _RecordingApiClient apiClient;
    late PushNotificationService service;

    setUp(() async {
      SharedPreferences.setMockInitialValues({
        SharedPreferenceHelper.accessTokenKey: 'test-access-token',
      });
      prefs = await SharedPreferences.getInstance();
      apiClient = _RecordingApiClient(sharedPreferences: prefs);
      service = PushNotificationService(apiClient: apiClient);
    });

    test('persists FCM token in SharedPreferences', () async {
      await service.sendUpdatedToken('fcm-token-123');

      expect(
        prefs.getString(SharedPreferenceHelper.fcmDeviceKey),
        'fcm-token-123',
      );
    });

    test('POSTs token to save-device-token endpoint', () async {
      await service.sendUpdatedToken('fcm-token-456');

      expect(apiClient.postCount, 1);
      expect(apiClient.lastParams, {'token': 'fcm-token-456'});
    });

    test('returns false for empty token', () async {
      final success = await service.sendUpdatedToken('');

      expect(success, isFalse);
      expect(apiClient.postCount, 0);
    });

    test('returns false when API request fails', () async {
      apiClient.succeedPost = false;

      final success = await service.sendUpdatedToken('fcm-token-fail');

      expect(success, isFalse);
      expect(apiClient.postCount, 1);
      expect(
        prefs.getString(SharedPreferenceHelper.fcmDeviceKey),
        'fcm-token-fail',
      );
    });
  });

  group('PushNotificationService.sendUserToken', () {
    test('returns false when access token is missing', () async {
      SharedPreferences.setMockInitialValues({});
      final prefs = await SharedPreferences.getInstance();
      final apiClient = _RecordingApiClient(sharedPreferences: prefs);
      final service = PushNotificationService(apiClient: apiClient);

      final success = await service.sendUserToken();

      expect(success, isFalse);
      expect(apiClient.postCount, 0);
    });
  });

  group('PushNotificationService FCM dedup (ISC-F4-34)', () {
    late _RecordingApiClient apiClient;
    late PushNotificationService service;

    setUp(() async {
      SharedPreferences.setMockInitialValues({});
      final prefs = await SharedPreferences.getInstance();
      apiClient = _RecordingApiClient(sharedPreferences: prefs);
      service = PushNotificationService(apiClient: apiClient);
      RideAlertOnce.shared.reset();
    });

    tearDown(() {
      RideAlertOnce.shared.reset();
    });

    test('shows the first message and drops a duplicate ride+type', () {
      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '42', 'type': 'pick_up'}),
        ),
        isTrue,
      );
      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '42', 'type': 'pick_up'}),
        ),
        isFalse,
      );
    });

    test('different alert types for the same ride both show', () {
      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '42', 'type': 'arriving_soon'}),
        ),
        isTrue,
      );
      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '42', 'type': 'pick_up'}),
        ),
        isTrue,
      );
    });

    test('a new ride re-alerts', () {
      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '42', 'type': 'pick_up'}),
        ),
        isTrue,
      );
      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '43', 'type': 'pick_up'}),
        ),
        isTrue,
      );
    });

    test('messages without ride_id or type are not deduplicated', () {
      expect(
        service.shouldPresentMessage(RemoteMessage(data: {'type': 'pick_up'})),
        isTrue,
      );
      expect(
        service.shouldPresentMessage(RemoteMessage(data: {'type': 'pick_up'})),
        isTrue,
      );
    });
  });
}

