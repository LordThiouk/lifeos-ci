class RideStopModel {
  static const int maxCountPerRide = 25;

  String? id;
  String? sequence;
  String? latitude;
  String? longitude;
  String? locationLabel;
  String? zoneId;
  String? completedAt;

  RideStopModel({
    this.id,
    this.sequence,
    this.latitude,
    this.longitude,
    this.locationLabel,
    this.zoneId,
    this.completedAt,
  });

  factory RideStopModel.fromJson(Map<String, dynamic> json) => RideStopModel(
        id: json['id']?.toString(),
        sequence: json['sequence']?.toString(),
        latitude: json['latitude']?.toString(),
        longitude: json['longitude']?.toString(),
        locationLabel: json['location_label']?.toString(),
        zoneId: json['zone_id']?.toString(),
        completedAt: json['completed_at']?.toString(),
      );

  Map<String, dynamic> toJson() => {
        'id': id,
        'sequence': sequence,
        'latitude': latitude,
        'longitude': longitude,
        'location_label': locationLabel,
        'zone_id': zoneId,
        'completed_at': completedAt,
      };

  bool get isCompleted {
    final value = completedAt;
    return value != null && value.isNotEmpty && value != 'null';
  }

  static bool isValidCoordinates(double lat, double lng) {
    if (lat == 0 && lng == 0) {
      return false;
    }
    if (lat < -90 || lat > 90) {
      return false;
    }
    if (lng < -180 || lng > 180) {
      return false;
    }
    return true;
  }

  ({double lat, double lng})? parsedCoordinates() {
    final lat = double.tryParse(latitude ?? '');
    final lng = double.tryParse(longitude ?? '');
    if (lat == null || lng == null) {
      return null;
    }
    if (!isValidCoordinates(lat, lng)) {
      return null;
    }
    return (lat: lat, lng: lng);
  }
}

