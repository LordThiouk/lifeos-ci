      expect(
        service.shouldPresentMessage(
          RemoteMessage(data: {'ride_id': '42', 'type': 'pick_up'}),
        ),
        isFalse,
      );
    });

    test('an FCM banner suppresses the Pusher alert for the same ride+type', () {
