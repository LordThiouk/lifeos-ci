ALTER TABLE `general_settings`
    ADD COLUMN `dispatch_enabled` TINYINT(1) UNSIGNED NOT NULL DEFAULT 1 COMMENT '1=auto dispatch on create/cron' AFTER `negative_balance_driver`,
    ADD COLUMN `offer_timeout_sec` INT UNSIGNED NOT NULL DEFAULT 30 COMMENT 'Driver offer countdown seconds' AFTER `dispatch_enabled`,
    ADD COLUMN `max_attempts` TINYINT UNSIGNED NOT NULL DEFAULT 5 COMMENT 'Cascade attempts before NO_DRIVER' AFTER `offer_timeout_sec`,
    ADD COLUMN `score_w_dist` DECIMAL(4,2) NOT NULL DEFAULT 0.70 COMMENT 'Score weight distance 0-1' AFTER `max_attempts`,
    ADD COLUMN `score_w_rating` DECIMAL(4,2) NOT NULL DEFAULT 0.30 COMMENT 'Score weight rating 0-1' AFTER `score_w_dist`,
    ADD COLUMN `gps_ttl_sec` INT UNSIGNED NOT NULL DEFAULT 60 COMMENT 'Fresh GPS cutoff seconds' AFTER `score_w_rating`;

