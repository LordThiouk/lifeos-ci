<?php

namespace Tests\Concerns;

use App\Constants\Status;
use Carbon\Carbon;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;

trait BootstrapsDispatchTestDatabase
{
    protected function bootstrapDispatchTestDatabase(bool $withUsers = false): void
    {
        Schema::create('drivers', function (Blueprint $table) {
            $table->id();
            $table->string('firstname')->nullable();
            $table->string('lastname')->nullable();
            $table->integer('status')->default(Status::USER_ACTIVE);
            $table->integer('ev')->default(Status::VERIFIED);
            $table->integer('sv')->default(Status::VERIFIED);
            $table->integer('vv')->default(Status::VERIFIED);
            $table->integer('dv')->default(Status::VERIFIED);
            $table->integer('online_status')->default(Status::YES);
            $table->unsignedBigInteger('zone_id')->default(1);
            $table->unsignedBigInteger('service_id')->default(1);
            $table->double('balance')->default(0);
            $table->double('current_lat')->nullable();
            $table->double('current_lot')->nullable();
            $table->timestamp('location_updated_at')->nullable();
            $table->double('avg_rating')->default(4.5);
            $table->timestamps();
        });

        Schema::create('rides', function (Blueprint $table) {
            $table->id();
            $table->string('uid')->nullable();
            $table->unsignedBigInteger('user_id')->nullable();
            $table->unsignedBigInteger('driver_id')->nullable();
            $table->unsignedBigInteger('pickup_zone_id')->default(1);
            $table->unsignedBigInteger('service_id')->default(1);
            $table->double('pickup_latitude')->nullable();
            $table->double('pickup_longitude')->nullable();
            $table->string('pickup_location')->nullable();
            $table->string('destination')->nullable();
            $table->string('duration')->nullable();
            $table->string('distance')->nullable();
            $table->double('recommend_amount')->nullable();
            $table->double('amount')->nullable();
            $table->string('otp')->nullable();
            $table->string('cancel_reason')->nullable();
            $table->integer('status')->default(Status::RIDE_PENDING);
            $table->timestamps();
        });

        Schema::create('dispatch_attempts', function (Blueprint $table) {
            $table->id();
            $table->unsignedBigInteger('ride_id');
            $table->unsignedBigInteger('driver_id');
            $table->unsignedTinyInteger('attempt_number');
            $table->string('status', 20)->default('pending');
            $table->timestamp('offered_at')->nullable();
            $table->timestamp('responded_at')->nullable();
            $table->timestamps();
        });

        if (!Schema::hasTable('ride_stops')) {
            Schema::create('ride_stops', function (Blueprint $table) {
                $table->id();
                $table->unsignedBigInteger('ride_id');
                $table->unsignedTinyInteger('sequence');
                $table->double('latitude');
                $table->double('longitude');
                $table->string('location_label');
                $table->unsignedBigInteger('zone_id')->nullable();
                $table->timestamp('completed_at')->nullable();
                $table->timestamps();
            });
        }

        if ($withUsers) {
            Schema::create('users', function (Blueprint $table) {
                $table->id();
                $table->string('username')->nullable();
                $table->string('firstname')->nullable();
                $table->string('email')->nullable();
                $table->string('mobile')->nullable();
                $table->timestamps();
            });

            Schema::create('services', function (Blueprint $table) {
                $table->id();
                $table->string('name')->default('Standard');
                $table->timestamps();
            });

            Schema::create('ride_queues', function (Blueprint $table) {
                $table->id();
                $table->unsignedBigInteger('ride_id');
                $table->string('action_type');
                $table->unsignedBigInteger('ordering')->default(0);
                $table->unsignedTinyInteger('dispatch_count')->default(0);
                $table->timestamps();
            });

            DB::table('users')->insert([
                'id'         => 1,
                'username'   => 'rider1',
                'created_at' => now(),
                'updated_at' => now(),
            ]);

            DB::table('services')->insert([
                'id'         => 1,
                'name'       => 'Standard',
                'created_at' => now(),
                'updated_at' => now(),
            ]);
        }
    }

    protected function createEligibleDriver(array $overrides = []): void
    {
        DB::table('drivers')->insert(array_merge([
            'firstname'             => 'Driver',
            'lastname'              => 'Test',
            'status'                => Status::USER_ACTIVE,
            'ev'                    => Status::VERIFIED,
            'sv'                    => Status::VERIFIED,
            'vv'                    => Status::VERIFIED,
            'dv'                    => Status::VERIFIED,
            'online_status'         => Status::YES,
            'zone_id'               => 1,
            'service_id'            => 1,
            'balance'               => 0,
            'current_lat'           => 14.72,
            'current_lot'           => -17.47,
            'location_updated_at'   => now()->subSeconds(30)->toDateTimeString(),
            'avg_rating'            => 4.5,
            'created_at'            => now()->toDateTimeString(),
            'updated_at'            => now()->toDateTimeString(),
        ], $this->normalizeDispatchOverrides($overrides)));
    }

    /** ISC-63 adaptation: move driver 1 onto a fresh ping (default 30 s old) before a complete-stop call. */
    protected function positionDriverNear(float $lat, float $lon, int $secondsAgo = 30): void
    {
        DB::table('drivers')->where('id', 1)->update([
            'current_lat'         => $lat,
            'current_lot'         => $lon,
            'location_updated_at' => now()->subSeconds($secondsAgo)->toDateTimeString(),
        ]);

        // The in-memory DB row changed mid-test: drop cached guard/user instances so
        // the next request re-resolves auth with the fresh ping (RequestGuard caches
        // its resolved user across requests within one test's shared app instance).
        app('auth')->forgetGuards();
    }

    protected function createDispatchRide(array $overrides = []): int
    {
        return DB::table('rides')->insertGetId(array_merge([
            'uid'              => 'RIDE-TEST-001',
            'user_id'          => 1,
            'pickup_zone_id'   => 1,
            'service_id'       => 1,
            'pickup_latitude'  => 14.7167,
            'pickup_longitude' => -17.4677,
            'pickup_location'  => 'Pickup A',
            'destination'      => 'Destination B',
            'status'           => Status::RIDE_PENDING,
            'created_at'       => now()->toDateTimeString(),
            'updated_at'       => now()->toDateTimeString(),
        ], $this->normalizeDispatchOverrides($overrides)));
    }

    protected function normalizeDispatchOverrides(array $overrides): array
    {
        foreach (['location_updated_at', 'offered_at', 'responded_at', 'created_at', 'updated_at'] as $key) {
            if (array_key_exists($key, $overrides) && $overrides[$key] instanceof Carbon) {
                $overrides[$key] = $overrides[$key]->toDateTimeString();
            }
        }

        return $overrides;
    }
}

