<?php

namespace Tests\Feature\Admin;

use App\Constants\Status;
use App\Models\Admin;
use App\Models\Service;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Route;
use Illuminate\Support\Facades\Schema;
use Spatie\Permission\Models\Permission;
use Tests\TestCase;

/**
 * ISA 2026-11-22-galass-lot-client — ISC-40, ISC-41, ISC-42, ISC-43, ISC-44.
 */
class ServiceOrderVisibilityTest extends TestCase
{
    protected function setUp(): void
    {
        parent::setUp();

        config([
            'database.default'                     => 'sqlite',
            'database.connections.sqlite.database' => ':memory:',
        ]);
        DB::purge('sqlite');
        DB::reconnect('sqlite');

        $this->bootstrapTables();
    }

    public function test_migration_adds_sort_order_and_visibility_with_initial_order(): void
    {
        $this->assertTrue(Schema::hasColumn('services', 'sort_order'));
        $this->assertTrue(Schema::hasColumn('services', 'is_visible'));

        $this->seedService(['name' => 'A']);
        $this->seedService(['name' => 'B']);
        $this->seedService(['name' => 'C']);

        $ids = Service::orderBy('id')->pluck('id')->all();
        $orders = Service::orderBy('id')->pluck('sort_order')->all();
        $this->assertSame([1, 2, 3], array_values($orders));
        $this->assertCount(3, $ids);
    }

    public function test_admin_can_reorder_and_toggle_visibility(): void
    {
        [$admin] = $this->seedAdmin();
        $s1 = $this->seedService(['name' => 'One', 'sort_order' => 1, 'is_visible' => true]);
        $s2 = $this->seedService(['name' => 'Two', 'sort_order' => 2, 'is_visible' => true]);

        $this->actingAs($admin, 'admin')
            ->post(route('admin.service.update', $s2->id), $this->servicePayload($s2, ['sort_order' => 1, 'is_visible' => 1]))
            ->assertRedirect();

        $this->actingAs($admin, 'admin')
            ->post(route('admin.service.visibility', $s1->id))
            ->assertRedirect();

        $s1->refresh();
        $s2->refresh();
        $this->assertSame(1, (int) $s2->sort_order);
        $this->assertFalse((bool) $s1->is_visible);
    }

    public function test_rider_service_api_returns_admin_order_and_excludes_hidden(): void
    {
        $this->seedService(['name' => 'B', 'sort_order' => 2, 'is_visible' => true]);
        $this->seedService(['name' => 'A', 'sort_order' => 1, 'is_visible' => true]);
        $this->seedService(['name' => 'Hidden', 'sort_order' => 3, 'is_visible' => false]);

        $services = Service::active()->visible()->ordered()->get();
        $this->assertSame(['A', 'B'], $services->pluck('name')->all());
    }

    private function seedAdmin(): array
    {
        $perm = Permission::firstOrCreate(['name' => 'edit service', 'guard_name' => 'admin']);
        Permission::firstOrCreate(['name' => 'add service', 'guard_name' => 'admin']);
        Permission::firstOrCreate(['name' => 'view service', 'guard_name' => 'admin']);
        $admin = Admin::create([
            'name' => 'Admin', 'username' => 'admin', 'email' => 'admin@example.com', 'password' => bcrypt('password'),
        ]);
        $admin->givePermissionTo($perm);
        return [$admin];
    }

    private function seedService(array $overrides = []): Service
    {
        static $n = 0;
        $n++;
        return Service::create(array_merge([
            'name' => 'Service ' . $n,
            'subtitle' => 'Sub',
            'city_min_fare' => 100, 'city_max_fare' => 500, 'city_recommend_fare' => 200, 'city_fare_commission' => 10,
            'intercity_min_fare' => 200, 'intercity_max_fare' => 800, 'intercity_recommend_fare' => 400, 'intercity_fare_commission' => 10,
            'status' => Status::ENABLE,
            'sort_order' => $n,
            'is_visible' => true,
        ], $overrides));
    }

    private function servicePayload(Service $service, array $overrides = []): array
    {
        return array_merge([
            'name' => $service->name,
            'subtitle' => $service->subtitle,
            'city_min_fare' => $service->city_min_fare,
            'city_max_fare' => $service->city_max_fare,
            'city_recommend_fare' => $service->city_recommend_fare,
            'city_fare_commission' => $service->city_fare_commission,
            'intercity_min_fare' => $service->intercity_min_fare,
            'intercity_max_fare' => $service->intercity_max_fare,
            'intercity_recommend_fare' => $service->intercity_recommend_fare,
            'intercity_fare_commission' => $service->intercity_fare_commission,
            'sort_order' => $service->sort_order,
            'is_visible' => $service->is_visible ? 1 : 0,
        ], $overrides);
    }

    private function bootstrapTables(): void
    {
        Schema::create('admins', function (Blueprint $table) {
            $table->id(); $table->string('name'); $table->string('username')->unique(); $table->string('email')->unique();
            $table->string('password'); $table->rememberToken(); $table->timestamps();
        });
        Schema::create('permissions', function (Blueprint $table) { $table->bigIncrements('id'); $table->string('name'); $table->string('guard_name'); $table->timestamps(); $table->unique(['name','guard_name']); });
        Schema::create('roles', function (Blueprint $table) { $table->bigIncrements('id'); $table->string('name'); $table->string('guard_name'); $table->timestamps(); $table->unique(['name','guard_name']); });
        Schema::create('model_has_permissions', function (Blueprint $table) { $table->unsignedBigInteger('permission_id'); $table->string('model_type'); $table->unsignedBigInteger('model_id'); $table->index(['model_id','model_type']); $table->primary(['permission_id','model_id','model_type']); });
        Schema::create('model_has_roles', function (Blueprint $table) { $table->unsignedBigInteger('role_id'); $table->string('model_type'); $table->unsignedBigInteger('model_id'); $table->index(['model_id','model_type']); $table->primary(['role_id','model_id','model_type']); });
        Schema::create('role_has_permissions', function (Blueprint $table) { $table->unsignedBigInteger('permission_id'); $table->unsignedBigInteger('role_id'); $table->primary(['permission_id','role_id']); });
        Schema::create('services', function (Blueprint $table) {
            $table->id();
            $table->unsignedInteger('sort_order')->default(0);
            $table->boolean('is_visible')->default(true);
            $table->string('name')->nullable();
            $table->string('subtitle')->nullable();
            $table->string('image')->nullable();
            $table->decimal('city_min_fare', 28, 8)->default(0);
            $table->decimal('city_max_fare', 28, 8)->default(0);
            $table->decimal('city_recommend_fare', 28, 8)->default(0);
            $table->decimal('city_fare_commission', 28, 8)->default(0);
            $table->decimal('intercity_min_fare', 28, 8)->default(0);
            $table->decimal('intercity_max_fare', 28, 8)->default(0);
            $table->decimal('intercity_recommend_fare', 28, 8)->default(0);
            $table->decimal('intercity_fare_commission', 28, 8)->default(0);
            $table->tinyInteger('status')->default(1);
            $table->timestamps();
        });
    }
}
