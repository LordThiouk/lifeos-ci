    public function test_registration_stores_photo(): void
    {
        Storage::fake('public');

        $file = UploadedFile::fake()->image('profile.jpg', 200, 200);

        $response = $this->post('/api/driver/register', [
            'firstname' => 'Test',
            'lastname'  => 'Driver',
            'email'     => 'driver@example.com',
            'password'  => 'password',
            'password_confirmation' => 'password',
