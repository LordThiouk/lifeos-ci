$ cat core/tests/Feature/Security/DeveloperTokenStatusTest.php
<?php

namespace Tests\Feature\Security;

use App\Http\Middleware\MaintenanceMode;
use Tests\TestCase;

/**
 * G-35 — DeveloperToken must fail closed with HTTP 401 (not soft 200).
 */
class DeveloperTokenStatusTest extends TestCase
{
    protected function setUp(): void
    {
        parent::setUp();
        $this->withoutMiddleware([MaintenanceMode::class]);
    }

    public function test_api_login_without_dev_token_returns_401(): void
    {
        $response = $this->postJson('/api/login', [
            'username' => 'nobody',
            'password' => 'x',
        ]);

        $response->assertStatus(401)
            ->assertJsonPath('status', 'error')
            ->assertJsonPath('remark', 'unauthorized_request');
    }

    public function test_api_login_with_wrong_dev_token_returns_401(): void
    {
        $response = $this->postJson('/api/login', [
            'username' => 'nobody',
            'password' => 'x',
        ], [
            'dev-token' => 'wrong-token',
        ]);

        $response->assertStatus(401)
            ->assertJsonPath('status', 'error')
            ->assertJsonPath('remark', 'unauthorized_request');
    }
}

