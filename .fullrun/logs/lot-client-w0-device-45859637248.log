<?php

namespace Tests\Feature\Security;

use Tests\Concerns\BootstrapsSecurityTestDatabase;
use Tests\TestCase;

/**
 * G-31 — Unauthenticated web Maps proxy must not return Places payload (401/403).
 */
class MapsWebAuthTest extends TestCase
{
    use BootstrapsSecurityTestDatabase;

    protected function setUp(): void
    {
        parent::setUp();
        $this->bootstrapSecurityTestDatabase();
    }

    public function test_suggested_places_unauth_returns_401(): void
    {
        $response = $this->getJson('/suggested-places?input=dakar');

        $response->assertStatus(401)
            ->assertJsonPath('status', 'error')
            ->assertJsonPath('remark', 'unauthorized_request');
    }

    public function test_location_by_lat_lon_unauth_returns_401(): void
    {
        $response = $this->getJson('/location-by-lat-lon?lat=14.6937&lng=-17.4441');

        $response->assertStatus(401)
            ->assertJsonPath('status', 'error')
            ->assertJsonPath('remark', 'unauthorized_request');
    }

    public function test_place_details_unauth_returns_401(): void
    {
        $response = $this->getJson('/place-details?place_id=test');

        $response->assertStatus(401)
            ->assertJsonPath('status', 'error')
            ->assertJsonPath('remark', 'unauthorized_request');
    }
}

$ cat core/tests/Concerns/BootstrapsSecurityTestDatabase.php | head -160
<?php

namespace Tests\Concerns;

use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;

trait BootstrapsSecurityTestDatabase
{
    protected function bootstrapSecurityTestDatabase(): void
    {
        if (! Schema::hasTable('general_settings')) {
            Schema::create('general_settings', function (Blueprint $table) {
                $table->id();
                $table->string('site_name')->default('Galass Test');
                $table->unsignedTinyInteger('maintenance_mode')->default(0);
                $table->timestamp('last_cron')->nullable();
                $table->timestamps();
            });
        }

        if (! Schema::hasTable('languages')) {
            Schema::create('languages', function (Blueprint $table) {
                $table->id();
                $table->string('code', 10)->default('en');
                $table->unsignedTinyInteger('is_default')->default(0);
                $table->timestamps();
            });
        }

        if (! Schema::hasTable('cron_schedules')) {
            Schema::create('cron_schedules', function (Blueprint $table) {
                $table->id();
                $table->string('name')->nullable();
                $table->timestamps();
            });
        }

        if (! Schema::hasTable('cron_jobs')) {
            Schema::create('cron_jobs', function (Blueprint $table) {
                $table->id();
                $table->unsignedBigInteger('cron_schedule_id')->nullable();
                $table->unsignedTinyInteger('is_running')->default(0);
                $table->unsignedTinyInteger('is_default')->default(0);
                $table->timestamp('next_run')->nullable();
                $table->string('alias')->nullable();
                $table->text('action')->nullable();
                $table->timestamps();
            });
        }

        if (DB::table('general_settings')->count() === 0) {
            DB::table('general_settings')->insert([
                'site_name'        => 'Galass Test',
                'maintenance_mode' => 0,
                'created_at'       => now(),
                'updated_at'       => now(),
            ]);
        }

        if (DB::table('languages')->count() === 0) {
            DB::table('languages')->insert([
                'code'        => 'en',
                'is_default'  => 1,
                'created_at'  => now(),
                'updated_at'  => now(),
            ]);
        }
    }
}

