<?php

namespace Tests\Feature\Dispatch;

use App\Constants\Status;
use App\Events\Ride as RideEvent;
use App\Http\Controllers\Admin\GeneralSettingController;
use App\Http\Controllers\CronController;
use App\Models\Driver;
use App\Models\GeneralSetting;
use App\Models\Ride;
use App\Services\Dispatch\DispatchConfig;
use App\Services\Dispatch\DispatchOrchestrator;
use App\Services\Dispatch\DispatchService;
use App\Services\Dispatch\DispatchTrigger;
use Carbon\Carbon;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\Cache;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Event;
use Illuminate\Support\Facades\Schema;
use Tests\Concerns\BootstrapsDispatchTestDatabase;
use Tests\TestCase;

/**
 * ISA 20261002-galass-auto-dispatch — ISC-F5-1 admin dispatch settings.
 */
class DispatchAdminSettingsTest extends TestCase
{
    use BootstrapsDispatchTestDatabase;

    private DispatchOrchestrator $orchestrator;

    private DispatchService $dispatchService;

    protected function setUp(): void
    {
        parent::setUp();

        Carbon::setTestNow('2026-10-05 12:00:00');

        config([
            'database.default'                     => 'sqlite',
            'database.connections.sqlite.database' => ':memory:',
        ]);

        DB::purge('sqlite');
        DB::reconnect('sqlite');

        $this->bootstrapDispatchTestDatabase(true);
        $this->bootstrapGeneralSettingsTable();

        $this->seedDispatchSettings();

        $this->orchestrator    = app(DispatchOrchestrator::class);
        $this->dispatchService = app(DispatchService::class);
    }

    protected function tearDown(): void
    {
        Carbon::setTestNow();
        Cache::forget('GeneralSetting');
        \Mockery::close();
        parent::tearDown();
    }

    public function test_dispatch_config_readers_return_isa_defaults_when_unset(): void
    {
        Cache::forget('GeneralSetting');
        Cache::put('GeneralSetting', new GeneralSetting());

        $this->assertTrue(DispatchConfig::dispatchEnabled());
        $this->assertSame(DispatchOrchestrator::OFFER_TIMEOUT_SECONDS, DispatchConfig::offerTimeoutSec());
        $this->assertSame(DispatchOrchestrator::MAX_ATTEMPTS, DispatchConfig::maxAttempts());
        $this->assertSame(DispatchService::WEIGHT_DISTANCE, DispatchConfig::scoreWeightDistance());
        $this->assertSame(DispatchService::WEIGHT_RATING, DispatchConfig::scoreWeightRating());
        $this->assertSame(DispatchService::GPS_TTL_SECONDS, DispatchConfig::gpsTtlSec());
        $this->assertSame(DispatchService::GPS_TTL_SECONDS * 2, DispatchConfig::expandedGpsTtlSec());
    }

    public function test_dispatch_config_readers_honor_custom_general_settings(): void
    {
        $this->seedDispatchSettings([
            'dispatch_enabled'  => 0,
            'offer_timeout_sec' => 45,
            'max_attempts'      => 3,
            'score_w_dist'      => 0.6,
            'score_w_rating'    => 0.4,
            'gps_ttl_sec'       => 90,
        ]);

        $this->assertFalse(DispatchConfig::dispatchEnabled());
        $this->assertSame(45, DispatchConfig::offerTimeoutSec());
        $this->assertSame(3, DispatchConfig::maxAttempts());
        $this->assertSame(0.6, DispatchConfig::scoreWeightDistance());
        $this->assertSame(0.4, DispatchConfig::scoreWeightRating());
        $this->assertSame(90, DispatchConfig::gpsTtlSec());
        $this->assertSame(180, DispatchConfig::expandedGpsTtlSec());
    }

    public function test_custom_max_attempts_from_settings_limits_cascade(): void
    {
        Event::fake([RideEvent::class]);

        $this->seedDispatchSettings(['max_attempts' => 2]);

        for ($i = 1; $i <= 3; $i++) {
            $this->createEligibleDriver([
                'id'          => $i,
                'current_lat' => 14.7167 + ($i * 0.001),
                'current_lot' => -17.4677,
            ]);
        }

        $ride = Ride::findOrFail($this->createDispatchRide());

        $this->assertNotNull($this->orchestrator->offerNext($ride));

        $firstPendingId = (int) DB::table('dispatch_attempts')
            ->where('ride_id', $ride->id)
            ->where('status', 'pending')
            ->value('driver_id');

        $result = $this->orchestrator->cascadeAfterDecline($ride->fresh(), Driver::find($firstPendingId));
        $this->assertTrue($result['success']);
        $this->assertNotNull($result['next_driver'] ?? null);

        $secondPendingId = (int) DB::table('dispatch_attempts')
            ->where('ride_id', $ride->id)
            ->where('status', 'pending')
            ->value('driver_id');

        $result = $this->orchestrator->cascadeAfterDecline($ride->fresh(), Driver::find($secondPendingId));
        $this->assertTrue($result['success']);
        $this->assertNull($result['next_driver'] ?? null);

        $ride->refresh();
        $this->assertSame(Status::RIDE_CANCELED, (int) $ride->status);
        $this->assertSame('NO_DRIVER_AVAILABLE', $ride->cancel_reason);
        $this->assertSame(2, DB::table('dispatch_attempts')->where('ride_id', $ride->id)->count());
    }

    public function test_custom_gps_ttl_excludes_stale_drivers_per_setting(): void
    {
        $this->seedDispatchSettings(['gps_ttl_sec' => 30]);

        $this->createEligibleDriver(['id' => 1, 'location_updated_at' => now()->subSeconds(45)]);
        $this->createEligibleDriver(['id' => 2, 'location_updated_at' => now()->subSeconds(20)]);

        $ride   = Ride::findOrFail($this->createDispatchRide());
        $result = $this->dispatchService->rankCandidates($ride);

        $this->assertCount(1, $result);
        $this->assertSame(2, $result->first()->id);
    }

    public function test_dispatch_disabled_skips_sync_start(): void
    {
        $this->seedDispatchSettings(['dispatch_enabled' => 0]);

        $this->createEligibleDriver(['id' => 1]);

        $ride   = Ride::findOrFail($this->createDispatchRide());
        $driver = app(DispatchTrigger::class)->syncStart($ride);

        $this->assertNull($driver);
        $this->assertSame(0, DB::table('dispatch_attempts')->where('ride_id', $ride->id)->count());
    }

    public function test_admin_post_ride_setting_persists_dispatch_fields(): void
    {
        $this->withoutMiddleware();

        $response = $this->post('/admin/ride-setting', $this->validRideSettingPayload([
            'dispatch_enabled'  => 1,
            'offer_timeout_sec' => 45,
            'max_attempts'      => 3,
            'score_w_dist'      => 0.6,
            'score_w_rating'    => 0.4,
            'gps_ttl_sec'       => 90,
        ]));

        $response->assertRedirect();
        $response->assertSessionHas('notify');

        Cache::forget('GeneralSetting');

        $this->assertSame(1, (int) gs('dispatch_enabled'));
        $this->assertSame(45, (int) gs('offer_timeout_sec'));
        $this->assertSame(3, (int) gs('max_attempts'));
        $this->assertSame(0.6, (float) gs('score_w_dist'));
        $this->assertSame(0.4, (float) gs('score_w_rating'));
        $this->assertSame(90, (int) gs('gps_ttl_sec'));
    }

    public function test_ride_setting_rejects_invalid_weight_sum(): void
    {
        $this->withoutMiddleware();

        $response = $this->post('/admin/ride-setting', $this->validRideSettingPayload([
            'score_w_dist'   => 0.5,
            'score_w_rating' => 0.4,
        ]));

        $response->assertSessionHasErrors('score_w_dist');
    }

    public function test_configuration_json_excludes_global_bid_enabled(): void
    {
        $configurations = json_decode(
            file_get_contents(resource_path('views/admin/setting/configuration.json')),
            true
        );

        $this->assertIsArray($configurations);
        $this->assertArrayNotHasKey('global_bid_enabled', $configurations);
        $this->assertStringNotContainsString('global_bid', json_encode($configurations));
    }

    public function test_system_configuration_update_rejects_dispatch_keys(): void
    {
        $controller = app(GeneralSettingController::class);

        $response = $controller->systemConfigurationUpdate('dispatch_enabled');

        $this->assertSame(403, $response->getStatusCode());
        $payload = json_decode($response->getContent(), true);
        $this->assertFalse($payload['success']);
    }

    public function test_dispatch_disabled_blocks_cascade_after_decline(): void
    {
        $this->createEligibleDriver(['id' => 1, 'current_lat' => 14.80, 'current_lot' => -17.40]);
        $this->createEligibleDriver(['id' => 2, 'current_lat' => 14.7170, 'current_lot' => -17.4680]);

        $ride = Ride::findOrFail($this->createDispatchRide());

        $this->orchestrator->offerNext($ride);
        $this->assertSame(1, DB::table('dispatch_attempts')->where('ride_id', $ride->id)->count());

        $this->seedDispatchSettings(['dispatch_enabled' => 0]);

        $pendingDriverId = (int) DB::table('dispatch_attempts')
            ->where('ride_id', $ride->id)
            ->where('status', 'pending')
