<?php

namespace Tests\Feature\Admin;

use App\Constants\Status;
use App\Models\Admin;
use App\Models\Driver;
use App\Models\Vehicle;
use App\Notify\Sms;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Route;
use Illuminate\Support\Facades\Schema;
use Spatie\Permission\Models\Permission;
use Tests\TestCase;

/**
 * ISA 2026-11-22-galass-lot-client — ISC-10, ISC-10.1, ISC-10.2, ISC-11, ISC-11.1, ISC-11.2, ISC-11.3.
 */
class DriverOneStepApprovalTest extends TestCase
{
    protected function setUp(): void
    {
        parent::setUp();

        config([
            'database.default'                     => 'sqlite',
            'database.connections.sqlite.database' => ':memory:',
        ]);
        DB::purge('sqlite');
        DB::reconnect('sqlite');

        $this->bootstrapTables();
    }

    public function test_one_step_approval_approves_documents_and_vehicle(): void
    {
        [$admin, $driver] = $this->seedAdminAndDriver([
            'dv' => Status::PENDING,
            'vv' => Status::PENDING,
        ]);
        $this->seedVehicle($driver->id);

        $sms = $this->mockSmsSend();
        $sms->shouldReceive('send')->once();

        $response = $this->actingAs($admin, 'admin')
            ->post(route('admin.driver.approve.all', $driver->id));

        $response->assertRedirect();
        $response->assertSessionHas('notify');

        $driver->refresh();
        $this->assertSame(Status::VERIFIED, (int) $driver->dv);
        $this->assertSame(Status::VERIFIED, (int) $driver->vv);
    }

    public function test_incomplete_driver_cannot_be_one_step_approved(): void
    {
        [$admin, $driver] = $this->seedAdminAndDriver([
            'dv' => Status::PENDING,
            'vv' => Status::PENDING,
        ]);
        // No vehicle, no driver_data => incomplete

        $sms = $this->mockSmsSend();
        $sms->shouldNotReceive('send');

        $response = $this->actingAs($admin, 'admin')
            ->post(route('admin.driver.approve.all', $driver->id));

        $response->assertRedirect();
        $driver->refresh();
        $this->assertSame(Status::PENDING, (int) $driver->dv);
        $this->assertSame(Status::PENDING, (int) $driver->vv);
    }

    public function test_separate_approval_routes_still_exist(): void
    {
        $this->assertTrue(Route::has('admin.driver.verification.approve'));
        $this->assertTrue(Route::has('admin.driver.verification.reject'));
        $this->assertTrue(Route::has('admin.driver.vehicle.approve'));
        $this->assertTrue(Route::has('admin.driver.vehicle.reject'));
    }

    private function seedAdminAndDriver(array $driverOverrides = []): array
    {
        $perm = Permission::create(['name' => 'update drivers', 'guard_name' => 'admin']);
        $admin = Admin::create([
            'name'     => 'Admin',
            'username' => 'admin',
            'email'    => 'admin@example.com',
            'password' => bcrypt('password'),
        ]);
        $admin->givePermissionTo($perm);

        $driver = Driver::create(array_merge([
            'firstname'    => 'Test',
            'lastname'     => 'Driver',
            'username'     => 'driver1',
            'email'        => 'driver@example.com',
            'country_code' => 'SN',
            'mobile'       => '770000001',
            'dial_code'    => '221',
            'password'     => bcrypt('password'),
            'status'       => Status::USER_ACTIVE,
            'dv'           => Status::PENDING,
            'vv'           => Status::PENDING,
            'ev'           => Status::VERIFIED,
            'sv'           => Status::VERIFIED,
            'driver_data'  => json_decode(json_encode([['name' => 'nid', 'type' => 'text', 'value' => '123']])),
        ], $driverOverrides));

        return [$admin, $driver];
    }

    private function seedVehicle(int $driverId): void
    {
        Vehicle::create([
            'driver_id'      => $driverId,
            'vehicle_number' => 'DK-001-AA',
            'service_id'     => 1,
            'brand_id'       => 1,
            'model_id'       => 1,
            'color_id'       => 1,
            'year_id'        => 1,
            'form_data'      => json_decode(json_encode([['name' => 'carte_grise', 'type' => 'text', 'value' => 'CG123']])),
        ]);
    }

    private function mockSmsSend()
    {
        $mock = \Mockery::mock(Sms::class)->makePartial();
        $mock->shouldReceive('prevConfiguration')->andReturnNull();
        $mock->shouldReceive('getMessage')->andReturn('Votre compte chauffeur Galass a été validé.');
        $this->app->instance(Sms::class, $mock);
        return $mock;
    }

    private function bootstrapTables(): void
    {
        Schema::create('admins', function (Blueprint $table) {
            $table->id();
            $table->string('name');
            $table->string('username')->unique();
            $table->string('email')->unique();
