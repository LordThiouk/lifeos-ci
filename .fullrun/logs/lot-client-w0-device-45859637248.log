                $service->{$fare['max']} * $distance,
                $service->{$fare['recommend']} * $distance,
            );

            $data[] = [
                ...$service->toArray(),
                'service_id'       => $service->id,
                'service_name'     => $service->name,
                'min_amount'       => $amounts['min_amount'],
                'max_amount'       => $amounts['max_amount'],
                'recommend_amount' => $amounts['recommend_amount'],
            ];
        }

        return [
            'ride_type' => $fare['type'],
            'services'  => $data
        ];
