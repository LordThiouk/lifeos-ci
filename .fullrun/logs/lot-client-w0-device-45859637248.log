<?php

namespace Tests\Feature\Security;

use App\Http\Middleware\MaintenanceMode;
use App\Models\GeneralSetting;
use Illuminate\Support\Facades\Cache;
use Tests\TestCase;

/**
 * ISA 20261013-galass-security-general-setting-messages — Silas H1.
 * /api/general-setting must expose public keys only (explicit allowlist).
 */
class GeneralSettingNoSecretsTest extends TestCase
{
    private const SENTINEL = 'SENTINEL-MUST-NOT-LEAK';

    protected function setUp(): void
    {
        parent::setUp();
        $this->withoutMiddleware([MaintenanceMode::class]);

        $gs = new GeneralSetting();
        $gs->setRawAttributes([
            'id'                => 1,
            'site_name'         => 'Galass Test',
            'cur_text'          => 'XOF',
            'cur_sym'           => 'F',
            'maintenance_mode'  => 0,
            'google_login'      => 1,
            'apple_login'       => 0,
            'timezone'          => 'Africa/Dakar',
            'distance_unit'     => 1,
            'fixed_charge'      => 0,
            'operating_country' => json_encode(['SN' => ['country' => 'Senegal', 'dial_code' => '221']]),
            'pusher_config'     => json_encode([
                'app_key'    => 'public-pusher-key',
                'app_id'     => '123456',
                'cluster'    => 'eu',
                'app_secret' => self::SENTINEL . '-pusher',
            ]),
            'socialite_credentials' => json_encode([
                'google'   => ['client_id' => 'google-client-id', 'client_secret' => self::SENTINEL . '-google', 'status' => 1],
                'facebook' => ['client_id' => 'fb-client-id', 'client_secret' => self::SENTINEL . '-facebook', 'status' => 0],
                'linkedin' => ['client_id' => 'li-client-id', 'client_secret' => self::SENTINEL . '-linkedin', 'status' => 0],
            ]),
            'firebase_config' => json_encode([
                'apiKey'            => 'public-web-api-key',
                'projectId'         => 'galass-test',
                'messagingSenderId' => '42',
                'appId'             => '1:42:web:abc',
                'serverKey'         => self::SENTINEL . '-firebase-server',
                'private_key'       => self::SENTINEL . '-firebase-private',
                'client_email'      => self::SENTINEL . '-firebase-sa',
            ]),
            'mail_config'     => json_encode(['password' => self::SENTINEL . '-mail']),
            'sms_config'      => json_encode(['token' => self::SENTINEL . '-sms']),
            'google_maps_api' => self::SENTINEL . '-maps',
            'email_template'  => self::SENTINEL . '-tpl',
