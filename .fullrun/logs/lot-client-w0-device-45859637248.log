# Firebase JWT verification (Galass Phone Auth)
# Production: Google JWKS
FIREBASE_PROJECT_ID=galass
FIREBASE_JWKS_URL=https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com

# Local / staging: override to serve test JWKS (see routes/web.php /test-jwks)
# FIREBASE_JWKS_URL=http://192.162.69.113/test-jwks

# API gate — required on all /api/* (header: dev-token). Long random string; never commit real value.
DEVELOPER_TOKEN=

# Admin URL prefix (default "admin"). Change only with nginx IP/CF Access gate — see docs/nginx-galass-admin-harden.conf
ADMIN_PREFIX=admin

# Protect GET /cron (query ?secret= or header X-Cron-Secret)
CRON_SECRET=

# Protect GET /clear?token= ; empty keeps /clear disabled (403)
MAINTENANCE_TOKEN=

# Wave Checkout (gateway 511) — production values in admin gateway_parameter only
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_SIGNING_SECRET=
WAVE_BASE_URL=https://api.wave.com

# Orange Money eWallet QR Code (gateway 512) — production values in admin gateway_parameter only
# Also set callback_api_key in admin gateway_parameter (Sonatel MerchantCallBack.apiKey)
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

