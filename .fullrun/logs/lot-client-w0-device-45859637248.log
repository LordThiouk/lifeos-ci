            'email_from'      => 'ops@example.test',
            'sms_body'        => self::SENTINEL . '-sms-body',
            'some_future_secret_column' => self::SENTINEL . '-future',
        ]);
        Cache::put('GeneralSetting', $gs);
    }

    protected function tearDown(): void
    {
        Cache::forget('GeneralSetting');
        parent::tearDown();
    }

    private function fetch()
    {
        return $this->withHeaders([
            'dev-token' => 'test-dev-token-g35',
            'Accept'    => 'application/json',
        ])->getJson('/api/general-setting');
