            ->assertJsonPath($gs . 'socialite_credentials.google.client_id', 'google-client-id')
            ->assertJsonPath($gs . 'socialite_credentials.google.status', 1)
            ->assertJsonPath($gs . 'firebase_config.projectId', 'galass-test')

