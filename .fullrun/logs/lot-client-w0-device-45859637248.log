<?php

namespace Tests\Feature\Admin;

use App\Constants\Status;
use App\Models\Service;
use Illuminate\Database\Schema\Blueprint;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Schema;
use Tests\TestCase;

/**
 * ISA 2026-11-22-galass-lot-client — ISC-43, ISC-44.
 */
class HiddenServiceRideTest extends TestCase
{
    protected function setUp(): void
    {
        parent::setUp();

        config([
            'database.default'                     => 'sqlite',
            'database.connections.sqlite.database' => ':memory:',
        ]);
        DB::purge('sqlite');
        DB::reconnect('sqlite');

        Schema::create('services', function (Blueprint $table) {
            $table->id();
            $table->unsignedInteger('sort_order')->default(0);
            $table->boolean('is_visible')->default(true);
            $table->string('name')->nullable();
            $table->tinyInteger('status')->default(1);
            $table->timestamps();
        });
        Schema::create('rides', function (Blueprint $table) {
            $table->id();
            $table->unsignedBigInteger('user_id')->nullable();
            $table->unsignedBigInteger('service_id')->nullable();
            $table->integer('status')->default(Status::RIDE_COMPLETED);
            $table->double('amount')->default(0);
            $table->timestamps();
        });
    }

    public function test_hidden_service_still_readable_for_existing_ride(): void
    {
        $service = Service::create(['name' => 'Hidden', 'status' => Status::ENABLE, 'is_visible' => false, 'sort_order' => 1]);
        DB::table('rides')->insert(['id' => 1, 'user_id' => 1, 'service_id' => $service->id, 'status' => Status::RIDE_COMPLETED, 'amount' => 1000, 'created_at' => now(), 'updated_at' => now()]);

        $ride = DB::table('rides')->where('id', 1)->first();
        $found = Service::find($ride->service_id);
        $this->assertNotNull($found);
        $this->assertFalse((bool) $found->is_visible);
    }

    public function test_hidden_service_cannot_be_used_for_new_ride(): void
    {
        $service = Service::create(['name' => 'Hidden', 'status' => Status::ENABLE, 'is_visible' => false, 'sort_order' => 1]);

        $visible = Service::active()->visible()->find($service->id);
        $this->assertNull($visible);
    }
}
