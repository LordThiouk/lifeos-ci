        $result = $this->orchestrator->cascadeAfterDecline($ride->fresh(), Driver::find($pendingDriverId));

        $this->assertTrue($result['success']);
        $this->assertNull($result['next_driver'] ?? null);
        $this->assertSame(1, DB::table('dispatch_attempts')->where('ride_id', $ride->id)->count());
        $this->assertSame('declined', DB::table('dispatch_attempts')->where('driver_id', $pendingDriverId)->value('status'));
    }

