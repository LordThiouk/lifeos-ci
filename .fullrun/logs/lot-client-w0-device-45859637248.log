      expect(pings.single.params, isNotNull);
      expect(pings.single.params!['current_lat'], '${first.latitude}');
      expect(pings.single.params!['current_lot'], '${first.longitude}');
    });

    test('RIDE_RUNNING: camera follows the live driver position', () async {
      final cameraUpdates = <CameraUpdate>[];
      mapController.cameraAnimatorForTest = cameraUpdates.add;
      details.ride = _ride(AppStatus.RIDE_RUNNING);
      details.startLiveLocationTracking();

      const fix = LatLng(14.7110, -17.4520);
      positions.add(fix);
      await pumpEventQueue();

      expect(cameraUpdates, isNotEmpty);
      expect(cameraUpdates.first.toJson(), <Object>[
        'newLatLng',
        <double>[fix.latitude, fix.longitude],
      ]);
    });

    test('no tracking or ping outside RIDE_ACTIVE/RIDE_RUNNING', () async {
      details.ride = _ride(AppStatus.RIDE_COMPLETED);
      details.startLiveLocationTracking();
      expect(details.isLiveLocationTracking, isFalse);

      await details.pingRideLocation(const LatLng(14.7, -17.45));
      expect(apiClient.locationPings, isEmpty);
    });

    test('stops tracking once the ride leaves ACTIVE/RUNNING', () async {
      details.ride = _ride(AppStatus.RIDE_ACTIVE);
      details.startLiveLocationTracking();

      const first = LatLng(14.7000, -17.4500);
      positions.add(first);
      await pumpEventQueue();
      expect(details.isLiveLocationTracking, isTrue);

      details.ride = _ride(AppStatus.RIDE_COMPLETED);
      positions.add(const LatLng(14.7050, -17.4550));
      await pumpEventQueue();

      expect(details.isLiveLocationTracking, isFalse);
      expect(mapController.driverLatLng, first);
    });

    test('location ping is throttled then sent after the interval', () async {
      var now = DateTime(2026, 11, 26, 12);
      details.nowProvider = () => now;
      details.ride = _ride(AppStatus.RIDE_RUNNING);

      const first = LatLng(14.7000, -17.4500);
      await details.pingRideLocation(first);
      expect(apiClient.locationPings, hasLength(1));

      now = now.add(const Duration(seconds: 10));
      await details.pingRideLocation(const LatLng(14.7010, -17.4510));
      expect(apiClient.locationPings, hasLength(1));

      now = now.add(const Duration(seconds: 25));
      await details.pingRideLocation(const LatLng(14.7020, -17.4520));
      expect(apiClient.locationPings, hasLength(2));
    });

    test('car marker uses the shared marker_car.png asset', () {
      expect(MyIcons.markerCar, 'assets/icon/marker_car.png');
    });
  });
}

