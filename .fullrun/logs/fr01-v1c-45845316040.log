#!/usr/bin/env python3
"""ISC-10 — croisement de l'inventaire et du rapport de capture.

Deux violations seulement : une chaine simulee (``simulated: true``) et une
capture dont la chaine n'existe pas dans l'inventaire. Une chaine non
disponible est marquee, jamais simulee. Sortie 0 conforme, 1 violation nommee,
2 donnee absente.

  inventory_check.py
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import (
    DEFAULT_INVENTORY,
    DEFAULT_MANIFEST,
    EXIT_OK,
    EXIT_VIOLATION,
    HarnessError,
    load_manifest,
    read_inventory,
    report_error,
)


def check(records: list[dict], inventory: dict[str, dict]) -> list[str]:
    problems: list[str] = []
    for record in records:
        channel_id = record["channel_id"]
        if record.get("simulated") is True:
            problems.append(f"chaine simulee: {channel_id}")
        if channel_id not in inventory:
            problems.append(f"capture sans inventaire: {channel_id}")
    return problems


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    parser.add_argument("--inventory-path", type=Path, default=DEFAULT_INVENTORY)
    args = parser.parse_args(argv)

    try:
        records = load_manifest(args.manifest)
        inventory = read_inventory(args.inventory_path)
        problems = check(records, inventory)
    except HarnessError as exc:
        return report_error(str(exc))

    captured = {record["channel_id"] for record in records}
    simulated = sum(1 for record in records if record.get("simulated") is True)
    unknown = sum(1 for record in records if record["channel_id"] not in inventory)
    print(
        f"inventaire={len(inventory)} chaines capturees={len(captured)} "
        f"segments={len(records)} simulees={simulated} "
        f"capture_sans_inventaire={unknown}"
    )
    if problems:
        for problem in problems:
            print(f"VIOLATION: {problem}")
        return EXIT_VIOLATION
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())

