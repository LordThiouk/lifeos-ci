#!/usr/bin/env python3
"""ISC-1/ISC-2/ISC-3/ISC-5 — audit des trous du manifeste d'ingestion.

Une ligne du manifeste par segment capte. La probe mesure l'ecart maximal entre
segments consecutifs d'une meme chaine, bornes de la fenetre comprises, et
refuse une fenetre plus courte que demandee : une capture de 2 h ne prouve pas
24 h. Un segment ``simulated: true`` ou d'etat ``unavailable``, ``timeout`` ou
``offline`` ne compte jamais comme couverture ; un segment simule est une
violation explicite. Sortie 0 conforme, 1 trou ou fenetre insuffisante nommes,
2 donnee absente.

  audit_gaps.py --source=http
  audit_gaps.py --source=hls --manifest data/ingest/manifest.jsonl --window-hours 24
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import (
    DEFAULT_MANIFEST,
    EXIT_OK,
    EXIT_VIOLATION,
    MAX_GAP_S,
    HarnessError,
    channel_gaps,
    format_utc,
    load_manifest,
    report_error,
    segment_ok,
    segments_by_channel,
)

SOURCES = ("http", "hls", "icecast", "fm-tnt")


def audit(records: list[dict], max_gap_s: float, window_hours: float) -> list[str]:
    """Retourne les violations nommees ; une liste vide vaut conforme."""
    if not records:
        raise HarnessError("manifeste sans segment")
    window_start = min(record["start"] for record in records)
    window_end = max(record["end"] for record in records)
    observed_s = (window_end - window_start).total_seconds()
    expected_s = window_hours * 3600.0
    problems: list[str] = []
    if observed_s < expected_s:
        problems.append(
            f"fenetre observee {observed_s:.0f}s < {expected_s:.0f}s demandee"
        )
    for channel_id, segments in sorted(segments_by_channel(records).items()):
        if any(segment.get("simulated") is True for segment in segments):
            problems.append(f"{channel_id}: segment simule interdit (A1)")
        usable = [segment for segment in segments if segment_ok(segment)]
        for gap_from, gap_to, seconds in channel_gaps(usable, window_start, window_end):
            if seconds > max_gap_s:
                problems.append(
                    f"{channel_id}: trou {seconds:.0f}s > {max_gap_s:.0f}s "
                    f"de {format_utc(gap_from)} a {format_utc(gap_to)}"
                )
    return problems


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--source", required=True, choices=SOURCES)
    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    parser.add_argument("--max-gap", type=float, default=MAX_GAP_S)
    parser.add_argument("--window-hours", type=float, default=24.0)
    args = parser.parse_args(argv)

    try:
        records = load_manifest(args.manifest, source=args.source)
        problems = audit(records, args.max_gap, args.window_hours)
    except HarnessError as exc:
        return report_error(str(exc))

    if problems:
        for problem in problems:
            print(f"VIOLATION: {problem}")
        return EXIT_VIOLATION

    print(
        f"OK source={args.source} chaines={len(segments_by_channel(records))} "
        f"max_gap<={args.max_gap:.0f}s fenetre={args.window_hours:g}h"
    )
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())

$ cat scripts/ingest/_common.py
"""Socle des probes d'ingestion FR-01 (harnais de preuve V0).

Les probes lisent des journaux JSONL, une ligne par enregistrement, et sortent
avec un code explicite :

- 0 : conforme ;
- 1 : violation nommee (un chiffre et la chaine fautive sont imprimes) ;
- 2 : donnee absente ou illisible (aucune mesure inventee).

Formats attendus, sans URL, IP ni cle :

- manifeste de capture, une ligne par segment :
  ``channel_id``, ``source`` (http, hls, icecast, fm-tnt), ``start_utc``,
  ``end_utc``, ``media_type`` (audio, video, both), ``bytes``, ``state``
  (alive, silent, timeout, offline, unavailable) et ``simulated`` optionnel.
- heartbeats : ``heartbeat_utc``, ``ok`` (booleen).
- couts : ``channel_id``, ``hour_utc``, ``cadence_s``, ``bytes``.

Les chemins par defaut pointent vers les journaux que le worker d'ingestion
(V2) ecrira ; tant qu'ils n'existent pas, chaque probe sort en 2 en nommant le
fichier absent : rouge pour la bonne raison, jamais une trace Python.
"""

from __future__ import annotations

import csv
import itertools
import json
import sys
from datetime import UTC, datetime
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
DEFAULT_MANIFEST = REPO / "data" / "ingest" / "manifest.jsonl"
DEFAULT_HEARTBEATS = REPO / "data" / "ingest" / "heartbeats.jsonl"
DEFAULT_COSTS = REPO / "data" / "ingest" / "costs.jsonl"
DEFAULT_INVENTORY = REPO / "data" / "inventory" / "channels.csv"

EXIT_OK = 0
EXIT_VIOLATION = 1
EXIT_ERROR = 2

MAX_GAP_S = 300.0

OK_STATES = frozenset({"alive", "silent"})


class HarnessError(Exception):
    """Donnee absente ou illisible : la probe sort en 2, sans rien inventer."""


def parse_utc(value: str) -> datetime:
    """Parse un timestamp ISO 8601 UTC (suffixe Z accepte)."""
    try:
        parsed = datetime.fromisoformat(value)
    except (AttributeError, TypeError, ValueError) as exc:
        raise HarnessError(f"timestamp ISO 8601 invalide: {value!r}") from exc
    if parsed.tzinfo is None:
        return parsed.replace(tzinfo=UTC)
    return parsed.astimezone(UTC)


def format_utc(value: datetime) -> str:
    return value.astimezone(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def read_jsonl(path: Path) -> list[dict]:
    """Lit un journal JSONL ; un fichier absent est une erreur nommee, pas un zero."""
    if not path.is_file():
        raise HarnessError(f"fichier absent: {path}")
    records: list[dict] = []
    with path.open(encoding="utf-8") as handle:
        for lineno, line in enumerate(handle, start=1):
            line = line.strip()
            if not line:
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError as exc:
                raise HarnessError(
                    f"{path}:{lineno}: JSON invalide ({exc.msg})"
                ) from exc
            if not isinstance(record, dict):
                raise HarnessError(f"{path}:{lineno}: objet JSON attendu")
            records.append(record)
    if not records:
        raise HarnessError(f"journal vide: {path}")
    return records


def read_inventory(path: Path) -> dict[str, dict]:
    """Lit l'inventaire des chaines (id,name,type,...) et l'indexe par id."""
    if not path.is_file():
        raise HarnessError(f"inventaire absent: {path}")
    with path.open(encoding="utf-8", newline="") as handle:
        reader = csv.DictReader(handle)
        if reader.fieldnames is None or "id" not in reader.fieldnames:
            raise HarnessError(f"inventaire sans colonne id: {path}")
        return {row["id"]: row for row in reader if row.get("id")}


def load_manifest(path: Path, source: str | None = None) -> list[dict]:
    """Charge le manifeste de capture, filtre par source et normalise les dates."""
    records = read_jsonl(path)
    selected: list[dict] = []
    for record in records:
        missing = {"channel_id", "source", "start_utc", "end_utc"} - record.keys()
        if missing:
            raise HarnessError(f"manifeste incomplet: champs {sorted(missing)} absents")
        if source is not None and record["source"] != source:
            continue
        record = dict(record)
        record["start"] = parse_utc(record["start_utc"])
        record["end"] = parse_utc(record["end_utc"])
        if record["end"] < record["start"]:
            raise HarnessError(
                f"segment negatif pour {record['channel_id']}: "
                f"{record['start_utc']} > {record['end_utc']}"
            )
        selected.append(record)
    if source is not None and not selected:
        raise HarnessError(f"aucun segment pour la source {source!r} dans {path}")
    return selected


def segment_ok(record: dict) -> bool:
    """Un segment ne compte comme capture que s'il est reel et disponible.

    ``state`` doit etre explicitement ``alive`` ou ``silent`` : un segment
    ``simulated: true``, ``timeout``, ``offline`` ou ``unavailable`` ne compte
    jamais comme couverture.
    """
    if record.get("simulated") is True:
        return False
    return record.get("state") in OK_STATES


def segments_by_channel(records: list[dict]) -> dict[str, list[dict]]:
    grouped: dict[str, list[dict]] = {}
    for record in records:
        grouped.setdefault(record["channel_id"], []).append(record)
    for segments in grouped.values():
        segments.sort(key=lambda segment: segment["start"])
    return grouped


def gaps_for(segments: list[dict]) -> list[tuple[datetime, datetime, float]]:
    """Ecarts entre segments consecutifs (plancher a 0, jamais negatif)."""
    gaps: list[tuple[datetime, datetime, float]] = []
    for previous, current in itertools.pairwise(segments):
        seconds = (current["start"] - previous["end"]).total_seconds()
        if seconds > 0:
            gaps.append((previous["end"], current["start"], seconds))
    return gaps


def channel_gaps(
    segments: list[dict], window_start: datetime, window_end: datetime
) -> list[tuple[datetime, datetime, float]]:
    """Trous d'une chaine, y compris avant le premier et apres le dernier segment."""
    gaps: list[tuple[datetime, datetime, float]] = []
    if not segments:
        seconds = (window_end - window_start).total_seconds()
        if seconds > 0:
            gaps.append((window_start, window_end, seconds))
        return gaps
    leading = (segments[0]["start"] - window_start).total_seconds()
    if leading > 0:
        gaps.append((window_start, segments[0]["start"], leading))
    gaps.extend(gaps_for(segments))
    trailing = (window_end - segments[-1]["end"]).total_seconds()
    if trailing > 0:
        gaps.append((segments[-1]["end"], window_end, trailing))
    return gaps


def covered_seconds(
    segments: list[dict], window_start: datetime, window_end: datetime
) -> float:
    """Duree couverte par les segments dans la fenetre (recouvrements absorbes)."""
    total = 0.0
    cursor = window_start
    for segment in sorted(segments, key=lambda item: item["start"]):
        start = max(segment["start"], cursor)
        end = min(segment["end"], window_end)
        if end > start:
            total += (end - start).total_seconds()
            cursor = end
    return total


def report_error(message: str) -> int:
    print(f"ERREUR: {message}", file=sys.stderr)
    return EXIT_ERROR

$ cat scripts/ingest/soak_report.py | head -220
#!/usr/bin/env python3
"""ISC-6 — rapport de soak croise avec l'inventaire date du catalogue ouvert.

Le rapport publie N/N disponibles au jour J, ou N est le nombre de chaines de
l'inventaire a la date du rapport (``--inventory``) et ou aucun trou ne depasse
300 s. Une chaine de l'inventaire absente du manifeste compte en echec : elle
n'est jamais retiree du denominateur. Un segment ``simulated: true`` ou d'etat
``unavailable``, ``timeout`` ou ``offline`` ne compte jamais comme disponible ;
un segment simule est une violation explicite. N et sa date sont imprimes :
aucun total fixe n'est suppose. Sortie 0 conforme, 1 chaine en defaut nommee,
2 donnee absente.

  soak_report.py --days=7 --inventory
"""

from __future__ import annotations

import argparse
import sys
from datetime import datetime, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import (
    DEFAULT_INVENTORY,
    DEFAULT_MANIFEST,
    EXIT_OK,
    EXIT_VIOLATION,
    MAX_GAP_S,
    HarnessError,
    channel_gaps,
    covered_seconds,
    format_utc,
    load_manifest,
    read_inventory,
    report_error,
    segment_ok,
    segments_by_channel,
)


def summarize(
    records: list[dict],
    inventory: dict[str, dict],
    days: int,
    max_gap_s: float,
    use_inventory: bool,
) -> tuple[datetime, datetime, list[str], int, int]:
    """Retourne fenetre, violations, numerateur et denominateur N.

    Avec ``use_inventory``, N est le nombre de chaines de l'inventaire a la date
    du rapport ; une chaine absente du manifeste compte en echec. Sans
    ``--inventory``, N retombe sur les chaines presentes dans le manifeste.
    """
    if not records:
        raise HarnessError("manifeste sans segment")
    window_end = max(record["end"] for record in records)
    window_start = window_end - timedelta(days=days)
    grouped = segments_by_channel(records)

    universe = set(inventory) if use_inventory else set(grouped)
    problems: list[str] = []
    available = 0
    for channel_id in sorted(universe):
        segments = [
            segment
            for segment in grouped.get(channel_id, [])
            if segment["end"] > window_start and segment["start"] < window_end
        ]
        if not segments:
            problems.append(
                f"{channel_id}: absente du manifeste sur la fenetre (0 s capture)"
            )
            continue
        if any(segment.get("simulated") is True for segment in segments):
            problems.append(f"{channel_id}: segment simule interdit (A1)")
            continue
        usable = [segment for segment in segments if segment_ok(segment)]
        gaps = channel_gaps(usable, window_start, window_end)
        worst = max((seconds for _, _, seconds in gaps), default=0.0)
        covered = covered_seconds(usable, window_start, window_end)
        if worst > max_gap_s:
            problems.append(
                f"{channel_id}: trou {worst:.0f}s > {max_gap_s:.0f}s "
                f"(couverture {covered:.0f}s / {days * 86400}s)"
            )
        else:
            available += 1
    return window_start, window_end, problems, available, len(universe)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--days", type=int, default=7)
    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    parser.add_argument("--inventory", action="store_true")
    parser.add_argument("--inventory-path", type=Path, default=DEFAULT_INVENTORY)
    parser.add_argument("--max-gap", type=float, default=MAX_GAP_S)
    args = parser.parse_args(argv)
    if args.days < 1:
        return report_error(f"--days invalide: {args.days}")

    try:
        records = load_manifest(args.manifest)
        inventory = read_inventory(args.inventory_path) if args.inventory else {}
        window_start, window_end, problems, available, total = summarize(
            records, inventory, args.days, args.max_gap, args.inventory
        )
    except HarnessError as exc:
        return report_error(str(exc))

    day = format_utc(window_end)
    print(
        f"soak N={total} disponibles={available}/{total} au={day} "
        f"fenetre={format_utc(window_start)}..{day} max_gap<={args.max_gap:.0f}s"
    )
    if problems:
        for problem in problems:
            print(f"VIOLATION: {problem}")
        return EXIT_VIOLATION
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())

