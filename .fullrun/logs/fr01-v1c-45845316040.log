REPO_ROOT = Path(__file__).resolve().parents[3]
FREEZE_750_MANIFEST = REPO_ROOT / "data" / "annotation" / "freeze-750" / "manifest.json"


def _segment(
    segment_id: str,
    start_ms: int,
    end_ms: int,
    *,
    status: str = "reviewed",
    original: tuple[int, int] | None = None,
) -> dict:
    raw: dict[str, object] = {
        "id": segment_id,
        "status": status,
        "start_ms": start_ms,
        "end_ms": end_ms,
    }
    if original is not None:
        raw["original"] = {"start_ms": original[0], "end_ms": original[1]}
    return raw


def _independent_p95(values: list[int]) -> int:
    """P95 par rang le plus proche, ecrit ici (recalcul independant)."""
    ranked = sorted(values)
    return ranked[-(-(95 * len(ranked)) // 100) - 1]


