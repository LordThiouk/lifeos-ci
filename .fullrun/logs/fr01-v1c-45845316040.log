[project]
name = "antenly-api"
version = "0.1.0"
description = "Antenly API (FastAPI)"
requires-python = ">=3.11"
license = { text = "Proprietary" }
# pg8000 : pilote PostgreSQL pur Python (aucun binaire, aucune compilation) pour
#          la stack de dev et les probes RLS. boto3 : client S3/SeaweedFS pour le
#          magasin objet. Les deux licences sont permissives (BSD-3-Clause et
#          Apache-2.0), la règle clean-room n'interdit ni l'une ni l'autre.
dependencies = [
    "fastapi>=0.115",
    "pg8000>=1.31.6",
    "boto3>=1.44.1",
]

[dependency-groups]
dev = [
    "pytest>=8",
    "httpx>=0.27",
    "ruff>=0.6",
    "pip-licenses>=5",
    "numpy>=2.4.6",
    "jsonschema>=4.26.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/antenly_api"]

[tool.ruff]
line-length = 100

[tool.pytest.ini_options]
testpaths = ["tests"]
