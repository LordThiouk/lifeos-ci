"""ISC-22 — catalogue ouvert : une radio et une TV HLS entrent sans redéploiement.

Le schéma de chaîne (migration 003) porte l'origine, la provenance datée, le
type de média et la cadence ; aucune liste de chaînes n'est écrite dans le code,
la config ou une migration. Le test ajoute une radio et une TV HLS depuis une
source publique de test (hôtes ``.invalid``, aucun flux réel), les fait écrire
dans le pool puis les capture via ``PoolWorker`` : la croissance du catalogue
est une donnée, pas un redéploiement.
"""

from __future__ import annotations

import re
from pathlib import Path

import discover
import pool

ROOT = Path(__file__).resolve().parents[3]
CHANNEL_MIGRATION = ROOT / "migrations" / "postgres" / "003_ingestion.sql"

RADIO_URL = "https://radio-test.example.invalid/live"
TV_URL = "https://tv-test.example.invalid/live.m3u8"
RADIO_SOURCE = "https://annuaire-test.example.invalid/radio"
TV_SOURCE = "https://annuaire-test.example.invalid/tv.m3u"

REQUIRED_COLUMNS = (
    "origin",
    "provenance_type",
    "provenance_at",
    "media_type",
    "media_type_at",
    "cadence_window_s",
    "cadence_interval_s",
    "cadence_audio_timeout_s",
    "ingest_region",
    "ingest_server",
    "failover_of",
)

# Un nom de constante qui parle de chaînes/stations et dont la valeur est un
# littéral de liste/tuple/ensemble : c'est exactement une liste en dur.
HARDCODED_LIST_RE = re.compile(
    r"^\s*([A-Z][A-Z0-9_]*(?:CHANNELS?|STATIONS?|CHANNEL_LIST|STATION_LIST)[A-Z0-9_]*)"
    r"\s*=\s*[\[\(\{]",
    re.MULTILINE,
)


def _python_sources() -> list[Path]:
    roots = [ROOT / "scripts" / "ingest", ROOT / "api" / "src" / "antenly_api" / "ingest"]
    files: list[Path] = []
    for root in roots:
        if root.is_dir():
            files.extend(path for path in root.rglob("*.py") if "tests" not in path.parts)
    for name in ("pool.py", "pool_console.py", "discover.py", "probe.py"):
        path = ROOT / "tools" / "inventory" / name
        if path.is_file():
            files.append(path)
    return files


def test_migration_ajoute_les_champs_du_catalogue_ouvert() -> None:
    sql = CHANNEL_MIGRATION.read_text(encoding="utf-8")
    for column in REQUIRED_COLUMNS:
        assert re.search(rf"ADD COLUMN\s+{column}\b", sql), column
    assert "origin IN ('catalogue', 'client')" in sql
    assert "cadence_audio_timeout_s > cadence_interval_s + cadence_window_s" in sql


def test_aucune_liste_de_chaines_en_dur() -> None:
    for path in _python_sources():
        text = path.read_text(encoding="utf-8")
        found = HARDCODED_LIST_RE.search(text)
        assert found is None, f"liste de chaînes en dur dans {path}: {found.group(1)}"
    for migration in (ROOT / "migrations").rglob("*.sql"):
        sql = migration.read_text(encoding="utf-8").upper()
        assert "INSERT INTO CHANNEL" not in sql, f"chaînes semées dans {migration}"


def _families() -> list[discover.Family]:
    radio = discover.Entry(
        name="Radio Test",
        url=RADIO_URL,
        retained=True,
        family="public-test-radio",
        source_url=RADIO_SOURCE,
        brut={"origin": RADIO_SOURCE},
    )
    tv = discover.entries_from_m3u(
        '#EXTM3U\n#EXTINF:-1 tvg-id="TvTest.sn" group-title="Senegal",TV Test\n' + TV_URL + "\n",
        source_url=TV_SOURCE,
    )
    return [
        discover.Family("public-test-radio", RADIO_SOURCE, "radio", [radio]),
        discover.Family("public-test-tv", TV_SOURCE, "tv", tv),
    ]


def test_radio_et_tv_entrent_et_sont_capturees_sans_redemarrage(tmp_path: Path) -> None:
    channels, streams = discover.aggregate(_families())
    by_type = {channel["type"]: channel for channel in channels}
    assert set(by_type) == {"radio", "tv"}
    assert by_type["radio"]["id"] and by_type["tv"]["id"]

    discover.write_csv(tmp_path, channels, streams)
    rows = pool.read_rows(tmp_path / "streams.csv")
    assert {row["origin"] for row in rows} == {"catalogue"}

    tried: list[str] = []

    def load(channel_id: str) -> tuple[list[dict], list[dict]]:
        return [row for row in rows if row["channel_id"] == channel_id], []

    def try_url(url: str, timeout_s: float) -> dict:
        tried.append(url)
        return {"ok": True}

    worker = pool.PoolWorker(load, try_url, clock=lambda: 0)
    for channel in channels:
        result = worker.cycle(channel["id"])
        assert result.status == "joignable", channel["id"]
        assert result.current_url, channel["id"]
    assert set(tried) == {RADIO_URL, TV_URL}

$ cat api/src/antenly_api/eval/coverage.py
"""Couverture horaire des fenêtres d'état (FR-01, ISC-13).

Chaque chaîne est surveillée par fenêtres de ``--window`` secondes. Chaque
fenêtre porte un état explicite parmi ``alive``, ``silent``, ``timeout``,
``offline`` et ``unavailable``. Ce module vérifie que les fenêtres d'une
chaîne-heure pavent l'heure sans trou (aucune interpolation : un trou est une
erreur, jamais un état inventé), puis publie le taux de couverture horaire
(``alive / fenêtres``) dans ``coverage_hour``.

Sources :
- par défaut, la table ClickHouse ``state_window`` (pile de dev) ;
- ``--input fichier.jsonl`` lit des fenêtres de test sans base.

La commande de preuve de l'ISA est :

    uv run python -m antenly_api.eval.coverage --window=10s --hourly

Aucune URL, IP ni clé n'est écrite ici : les paramètres viennent de
l'environnement avec les valeurs factices de la pile de dev.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.parse
import urllib.request
from collections import defaultdict
from dataclasses import dataclass, field
from datetime import UTC, datetime

STATES = ("alive", "silent", "timeout", "offline", "unavailable")
HOUR_S = 3600


class CoverageError(ValueError):
    """Fenêtre invalide, état inconnu ou trou dans une chaîne-heure."""


@dataclass(frozen=True)
class Window:
    tenant_id: str
    channel_id: str
    start: int
    end: int
    state: str


@dataclass
class HourCoverage:
    tenant_id: str
    channel_id: str
    hour_start: int
    window_count: int = 0
    counts: dict[str, int] = field(default_factory=lambda: {state: 0 for state in STATES})

    @property
    def coverage_pct(self) -> float:
        if not self.window_count:
            return 0.0
        return round(self.counts["alive"] / self.window_count * 100, 4)


def parse_window(value: str) -> int:
    """``10s`` ou ``10`` -> 10 secondes ; doit diviser exactement une heure."""
    raw = str(value).strip().lower().removesuffix("s")
    try:
        seconds = int(raw)
    except ValueError as exc:
        raise CoverageError(f"fenêtre illisible : {value!r}") from exc
    if seconds <= 0:
        raise CoverageError(f"fenêtre strictement positive attendue : {value!r}")
    if HOUR_S % seconds:
        raise CoverageError(f"fenêtre {seconds}s ne divise pas une heure")
    return seconds


def parse_epoch(value: object) -> int:
    """Horodatage epoch (int/float) ou ISO 8601 UTC (``...Z``)."""
    if isinstance(value, (int, float)):
        return int(value)
    text = str(value).strip()
    if not text:
        raise CoverageError("horodatage vide")
    if text.endswith("Z"):
        text = text[:-1] + "+00:00"
    try:
        moment = datetime.fromisoformat(text)
    except ValueError as exc:
        raise CoverageError(f"horodatage illisible : {value!r}") from exc
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=UTC)
    return int(moment.timestamp())


def window_from_record(record: dict) -> Window:
    try:
        tenant_id = str(record["tenant_id"])
        channel_id = str(record["channel_id"])
        start = parse_epoch(record.get("window_start", record.get("start")))
        end = parse_epoch(record.get("window_end", record.get("end")))
        state = str(record["state"])
    except KeyError as exc:
        raise CoverageError(f"champ manquant dans la fenêtre : {exc.args[0]}") from exc
    return Window(tenant_id, channel_id, start, end, state)


def validate_window(window: Window, window_s: int) -> None:
    if window.state not in STATES:
        raise CoverageError(
            f"état inconnu {window.state!r} pour la chaîne {window.channel_id} "
            f"à {format_hour(window.start)} (attendu : {', '.join(STATES)})"
        )
    if window.end - window.start != window_s:
        raise CoverageError(
            f"fenêtre de {window.end - window.start}s pour la chaîne "
            f"{window.channel_id} à {format_hour(window.start)} : {window_s}s attendus"
        )


def aggregate(windows: list[Window], window_s: int) -> list[HourCoverage]:
    """Agrège par chaîne-heure en exigeant un pavage complet, sans trou."""
    groups: dict[tuple[str, str, int], list[Window]] = defaultdict(list)
    for window in windows:
        validate_window(window, window_s)
        hour_start = (window.start // HOUR_S) * HOUR_S
        groups[(window.tenant_id, window.channel_id, hour_start)].append(window)

    expected_count = HOUR_S // window_s
    result: list[HourCoverage] = []
    for (tenant_id, channel_id, hour_start), group in sorted(groups.items()):
        group.sort(key=lambda item: item.start)
        expected = hour_start
        for window in group:
            if window.start != expected:
                raise CoverageError(
                    f"trou ou chevauchement pour la chaîne {channel_id} à "
                    f"{format_hour(expected)} : fenêtre suivante à {format_hour(window.start)}"
                )
            expected = window.end
        if expected != hour_start + HOUR_S:
            raise CoverageError(
                f"chaîne-heure incomplète pour {channel_id} à {format_hour(hour_start)} : "
                f"fin à {format_hour(expected)} au lieu de {format_hour(hour_start + HOUR_S)}"
            )
        if len(group) != expected_count:
            raise CoverageError(
                f"chaîne-heure {channel_id} à {format_hour(hour_start)} : "
                f"{len(group)} fenêtres au lieu de {expected_count}"
            )
        row = HourCoverage(tenant_id, channel_id, hour_start, window_count=len(group))
        for window in group:
            row.counts[window.state] += 1
        result.append(row)
    return result


def format_hour(epoch: int) -> str:
    return datetime.fromtimestamp(epoch, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def format_ch(epoch: int) -> str:
    return datetime.fromtimestamp(epoch, UTC).strftime("%Y-%m-%d %H:%M:%S")


def load_jsonl(path: str) -> list[Window]:
    windows: list[Window] = []
    with open(path, encoding="utf-8") as handle:
        for lineno, line in enumerate(handle, start=1):
            if not line.strip():
                continue
            try:
                record = json.loads(line)
            except json.JSONDecodeError as exc:
                raise CoverageError(f"{path}:{lineno}: JSON illisible ({exc})") from exc
            windows.append(window_from_record(record))
    return windows


def _ch_url() -> str:
    host = os.environ.get("CLICKHOUSE_HOST", "127.0.0.1")
    port = os.environ.get("CLICKHOUSE_HTTP_PORT", "8123")
    database = os.environ.get("CLICKHOUSE_DB", "antenly")
    return f"http://{host}:{port}/?{urllib.parse.urlencode({'database': database})}"


def _ch_query(query: str) -> str:
    request = urllib.request.Request(_ch_url(), data=query.encode("utf-8"))
    request.add_header("X-ClickHouse-User", os.environ.get("CLICKHOUSE_USER", "antenly"))
    request.add_header(
        "X-ClickHouse-Key",
        os.environ.get("CLICKHOUSE_PASSWORD", "changeme-clickhouse-dev"),
    )
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            return response.read().decode("utf-8")
    except OSError as exc:
        raise CoverageError(f"ClickHouse injoignable : {exc}") from exc


def read_clickhouse() -> list[Window]:
    query = (
        "SELECT tenant_id, channel_id, toUnixTimestamp(window_start), "
        "toUnixTimestamp(window_end), state FROM state_window FORMAT TSV"
    )
    windows: list[Window] = []
    for line in _ch_query(query).splitlines():
        if not line.strip():
            continue
        tenant_id, channel_id, start, end, state = line.split("\t")
        windows.append(Window(tenant_id, channel_id, int(start), int(end), state))
    return windows


def write_clickhouse(rows: list[HourCoverage]) -> None:
    if not rows:
        return
    lines = []
    for row in rows:
        lines.append(
            "\t".join(
                [
                    row.tenant_id,
                    row.channel_id,
                    format_ch(row.hour_start),
                    str(row.window_count),
                    str(row.counts["alive"]),
                    str(row.counts["silent"]),
                    str(row.counts["timeout"]),
                    str(row.counts["offline"]),
                    str(row.counts["unavailable"]),
                    f"{row.coverage_pct:.4f}",
                ]
            )
        )
    query = (
        "INSERT INTO coverage_hour (tenant_id, channel_id, hour_start, window_count, "
        "alive_count, silent_count, timeout_count, offline_count, unavailable_count, "
        "coverage_pct) FORMAT TSV\n" + "\n".join(lines) + "\n"
    )
    _ch_query(query)


def write_jsonl(rows: list[HourCoverage], path: str) -> None:
    with open(path, "w", encoding="utf-8") as handle:
        handle.writelines(
            json.dumps(
                {
                    "tenant_id": row.tenant_id,
                    "channel_id": row.channel_id,
                    "hour_start": format_hour(row.hour_start),
                    "window_count": row.window_count,
                    **row.counts,
                    "coverage_pct": row.coverage_pct,
                },
                ensure_ascii=False,
            )
            + "\n"
            for row in rows
        )


def render(rows: list[HourCoverage]) -> str:
    lines = []
    for row in rows:
        lines.append(
            f"channel={row.channel_id} hour={format_hour(row.hour_start)} "
            f"windows={row.window_count} alive={row.counts['alive']} "
            f"silent={row.counts['silent']} timeout={row.counts['timeout']} "
            f"offline={row.counts['offline']} unavailable={row.counts['unavailable']} "
            f"coverage={row.coverage_pct:.2f}%"
        )
    return "\n".join(lines)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="coverage",
        description="Couverture horaire par chaîne à partir des fenêtres d'état (ISC-13).",
    )
    parser.add_argument("--window", default="10s", help="longueur d'une fenêtre (défaut : 10s)")
    parser.add_argument("--hourly", action="store_true", help="agrégation horaire (mode de preuve)")
    parser.add_argument("--input", help="fenêtres JSONL de test au lieu de ClickHouse")
    parser.add_argument("--output", help="écrit la couverture JSONL au lieu de ClickHouse")
    args = parser.parse_args(argv)

    try:
        window_s = parse_window(args.window)
        if args.input:
            windows = load_jsonl(args.input)
        else:
            windows = read_clickhouse()
        if not windows:
            raise CoverageError("aucune fenêtre d'état à agréger")
        rows = aggregate(windows, window_s)
        if args.output:
            write_jsonl(rows, args.output)
        elif not args.input:
            write_clickhouse(rows)
        print(render(rows))
        print(f"OK: {len(rows)} chaîne(s)-heure(s), 100 % des fenêtres classées, 0 trou")
        return 0
    except CoverageError as exc:
        print(f"ERREUR: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())

$ cat api/tests/ingest/test_ingest_coverage.py; echo ===MIG; cat migrations/clickhouse/003_ingestion.sql
"""ISC-13 — fenêtres de 10 s, 5 états, couverture horaire sans trou.

Les tests exercent la logique pure et la CLI du module
``antenly_api.eval.coverage`` avec un fichier JSONL de fenêtres : aucun réseau,
aucune base. La commande de preuve de l'ISA lit ClickHouse ; ce fichier garde
la logique vérifiable en CI.
"""

from __future__ import annotations

import json
from datetime import UTC, datetime
from pathlib import Path

from antenly_api.eval import coverage

BASE = 1_795_564_800  # 2026-11-25T00:00:00Z


def _iso(epoch: int) -> str:
    return datetime.fromtimestamp(epoch, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def _windows(count: int = 360, states: dict[int, str] | None = None) -> list[dict]:
    records = []
    for index in range(count):
        state = (states or {}).get(index, "alive")
        start = BASE + index * 10
        records.append(
            {
                "tenant_id": "tenant-a",
                "channel_id": "station-a",
                "window_start": _iso(start),
                "window_end": _iso(start + 10),
                "state": state,
            }
        )
    return records


def _write(path: Path, records: list[dict]) -> Path:
    path.write_text("\n".join(json.dumps(record) for record in records) + "\n", encoding="utf-8")
    return path


def test_une_heure_complete_publie_la_couverture(tmp_path: Path, capsys) -> None:
    records = _windows(states={100: "silent", 200: "timeout", 300: "offline", 359: "unavailable"})
    source = _write(tmp_path / "windows.jsonl", records)
    output = tmp_path / "coverage.jsonl"

    code = coverage.main(
        ["--window", "10s", "--hourly", "--input", str(source), "--output", str(output)]
    )
    assert code == 0
    assert "coverage=98.89%" in capsys.readouterr().out

    row = json.loads(output.read_text(encoding="utf-8").splitlines()[0])
    assert row["window_count"] == 360
    assert row["alive"] == 356
    assert row["silent"] == 1
    assert row["timeout"] == 1
    assert row["offline"] == 1
    assert row["unavailable"] == 1
    assert row["coverage_pct"] == 98.8889


def test_un_trou_est_refuse_jamais_comble(tmp_path: Path, capsys) -> None:
    records = _windows()
    del records[10]
    source = _write(tmp_path / "windows.jsonl", records)

    code = coverage.main(["--window", "10s", "--hourly", "--input", str(source)])
    assert code == 2
    assert "trou" in capsys.readouterr().err


def test_etat_inconnu_refuse(tmp_path: Path, capsys) -> None:
    records = _windows(states={0: "inconnu"})
    source = _write(tmp_path / "windows.jsonl", records)

    code = coverage.main(["--window", "10s", "--hourly", "--input", str(source)])
    assert code == 2
    assert "état inconnu" in capsys.readouterr().err


def test_fenetre_qui_ne_divise_pas_une_heure_refusee(capsys) -> None:
    code = coverage.main(["--window", "7s", "--hourly", "--input", "absent.jsonl"])
    assert code == 2
    assert "ne divise pas une heure" in capsys.readouterr().err


def test_fenetre_non_multiple_refusee(tmp_path: Path, capsys) -> None:
    records = _windows()
    records[0]["window_end"] = _iso(BASE + 11)
    source = _write(tmp_path / "windows.jsonl", records)

    code = coverage.main(["--window", "10s", "--hourly", "--input", str(source)])
    assert code == 2
    assert "11s" in capsys.readouterr().err
