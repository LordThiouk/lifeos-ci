#!/usr/bin/env python3
"""Garde de validation d'une capture (ISC-6) : refuse une capture vide ou trop courte.

Importable (`validate(capture_dir, min_minutes_per_station) -> list[str]`) et
exécutable. Chaque refus nomme la station et le chiffre constaté : une station
absente de la capture, sans audio, ou dont la durée décodée par ffprobe reste
sous le seuil, échoue.

Les six stations du pilote sont exigées : une capture à cinq répertoires complets
est un refus, pas un « conforme » — c'est le défaut B3 relevé par la revue.

Sortie : 0 conforme · 1 refus · 2 erreur d'exécution.
"""

from __future__ import annotations

import argparse
import json
import sys
from collections.abc import Callable
from pathlib import Path, PurePath

sys.path.insert(0, str(Path(__file__).resolve().parent))

from ffprobe_duration import FfprobeError, duration_seconds  # noqa: E402

AUDIO_EXTS = {".opus", ".mp3", ".aac", ".ogg", ".wav", ".flac", ".m4a"}

# Les six stations du corpus pilote. Une capture qui n'en livre que cinq est une
# capture ratée : sans cette liste, l'itération sur les répertoires présents rend
# la station disparue invisible et `validate()` renvoie `[]` (PASS).
EXPECTED_STATIONS = ("afiafm", "lovefm", "rfm", "rtsmatam", "sudfm", "zikfm")


def _audio_files(directory: Path) -> list[Path]:
    return sorted(
        path for path in directory.iterdir() if path.is_file() and path.suffix.lower() in AUDIO_EXTS
    )


def validate(
    capture_dir: str | PurePath,
    min_minutes_per_station: float,
    duration_fn: Callable[[Path], float] | None = None,
) -> list[str]:
    """Retourne la liste des refus. Liste vide = capture conforme."""
    root = Path(capture_dir)
    measure = duration_fn or duration_seconds

    if not root.exists():
        return [f"répertoire de capture absent : {root}"]
    if not root.is_dir():
        return [f"répertoire de capture invalide (pas un répertoire) : {root}"]

    stations = sorted(
        child for child in root.iterdir() if child.is_dir() and not child.name.startswith(".")
    )
    if not stations:
        return [f"répertoire de capture vide (aucune station) : {root}"]

    problems: list[str] = []
    # B3 : la liste attendue, pas seulement la liste trouvée. Cinq répertoires sur
    # six est un refus, même si les cinq présents sont complets.
    present = {station.name for station in stations}
    for missing in sorted(set(EXPECTED_STATIONS) - present):
        problems.append(f"station {missing} : absente de la capture {root}")

    for station in stations:
        files = _audio_files(station)
        if not files:
            problems.append(f"station {station.name} : aucun fichier audio dans {station}")
            continue

        seconds = 0.0
        failed = False
        # Une capture ne contient pas deux fois le même fichier : deux noms sur un
        # même inode (lien physique) gonfleraient la durée et pourraient faire
        # passer une capture trop courte (même classe que Silas API-1, 2026-11-08).
        seen: set[tuple[int, int]] = set()
        doublons: list[str] = []
        for file in files:
            try:
                stat = file.stat()
            except OSError as exc:
                problems.append(f"station {station.name} : fichier illisible ({exc})")
                failed = True
                continue
            ident = (stat.st_dev, stat.st_ino)
            if ident in seen:
                doublons.append(file.name)
                continue
            seen.add(ident)
            try:
                seconds += measure(file)
            except FfprobeError as exc:
                problems.append(f"station {station.name} : durée illisible ({exc})")
                failed = True
        if doublons:
            problems.append(
                f"station {station.name} : {len(doublons)} fichier(s) en double (même inode) : "
                f"{', '.join(sorted(doublons)[:3])}"
            )
            failed = True
        if failed:
            continue

        minutes = seconds / 60.0
        if minutes < min_minutes_per_station:
            problems.append(
                f"station {station.name} : {minutes:.1f} min décodées < {min_minutes_per_station:g} min "
                f"requises ({len(files)} fichiers, {seconds:.0f} s)"
            )

    return problems


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("capture_dir", help="répertoire produit par scripts/capture.sh (out/)")
    parser.add_argument(
        "--min-minutes",
        type=float,
        default=290.0,
        help="durée décodée minimale par station, en minutes (défaut 290)",
    )
    parser.add_argument("--json", action="store_true", help="sortie machine")
    args = parser.parse_args(argv)

    if args.min_minutes <= 0:
        parser.error("--min-minutes doit être positif")

    try:
        problems = validate(args.capture_dir, args.min_minutes)
    except OSError as exc:
        print(f"erreur : {exc}", file=sys.stderr)
        return 2

    if args.json:
        print(json.dumps({"ok": not problems, "problems": problems}, indent=2, ensure_ascii=False))
    else:
        if problems:
            for problem in problems:
                print(f"REFUS : {problem}", file=sys.stderr)
        else:
            print(
                f"capture conforme : {args.capture_dir} (>= {args.min_minutes:g} min par station)"
            )

    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())

