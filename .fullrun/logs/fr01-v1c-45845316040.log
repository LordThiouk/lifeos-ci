## Conclusion

Le schéma et les migrations tiennent (Postgres et ClickHouse appliqués, contraintes
actives), les suites passent et le lint est vert. Mais les deux critères cochés ISC-22 et
ISC-13 ne sont pas satisfaits : une liste de chaînes reste en dur dans `scripts/capture.sh`
(et le test ne la voit pas), et la couverture ne détecte pas une heure entière manquante en
annonçant « 0 trou ». ISC-12 est globalement couvert mais son cas « timeout » n'est testé
que par un double qui contredit la classification de production. Verdict : BLOCK.

$ cat scripts/capture.sh
#!/usr/bin/env bash
# Capture parallèle des 6 stations (voir docs/streams.md).
# Variables : SLICE (1-5), DURATION_MIN (minutes), OPUS (true/false).
set -euo pipefail

export TZ=UTC

SLICE="${SLICE:-1}"
DURATION_MIN="${DURATION_MIN:-340}"
OPUS="${OPUS:-true}"

if ! [[ "$SLICE" =~ ^[1-5]$ ]]; then
  echo "SLICE invalide: $SLICE (attendu 1..5)" >&2
  exit 2
fi

if ! [[ "$DURATION_MIN" =~ ^[0-9]+$ ]] || [ "$DURATION_MIN" -lt 1 ]; then
  echo "DURATION_MIN invalide: $DURATION_MIN" >&2
  exit 2
fi

if [ "$OPUS" != "true" ] && [ "$OPUS" != "false" ]; then
  echo "OPUS invalide: $OPUS (attendu true/false)" >&2
  exit 2
fi

# Sources validées le 2026-11-02 (docs/streams.md).
STATIONS=(
  "rfm=https://stream.zenolive.com/kuk0syz5puquv"
  "zikfm=https://stream.zeno.fm/vtxarcfpmnruv"
  "sudfm=https://stream.zenolive.com/rq40edfn3reuv"
  "afiafm=https://stream.zeno.fm/skjrn6kzzxptv"
  "lovefm=https://stream.zeno.fm/7cru7g7rcwzuv"
  "rtsmatam=https://stream.zeno.fm/kxud8vhqt1duv"
)

START_EPOCH="$(date +%s)"
DEADLINE=$((START_EPOCH + DURATION_MIN * 60))

mkdir -p out

echo "capture: slice=$SLICE duration_min=$DURATION_MIN opus=$OPUS"
echo "capture: deadline=$DEADLINE ($(date -u -d "@$DEADLINE" +%Y-%m-%dT%H:%M:%SZ))"

# Extension et format de conteneur interne du muxer segment.
station_ext() {
  local name="$1"
  if [ "$OPUS" = "true" ]; then
    echo "opus"
    return
  fi
  case "$name" in
    rfm | zikfm) echo "aac" ;;
    *) echo "mp3" ;;
  esac
}

station_segment_format() {
  local name="$1"
  if [ "$OPUS" = "true" ]; then
    echo "ogg"
    return
  fi
  case "$name" in
    rfm | zikfm) echo "adts" ;;
    *) echo "mp3" ;;
  esac
}

log_line() {
  local log="$1"
  shift
  printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >>"$log"
}

capture_station() {
  local name="$1"
  local url="$2"
  local dir="out/$name"
  local log="$dir/reconnects.log"
  local ext seg_format
  local -a codec_args

  mkdir -p "$dir"
  ext="$(station_ext "$name")"
  seg_format="$(station_segment_format "$name")"

  if [ "$OPUS" = "true" ]; then
    codec_args=(-vn -ac 1 -c:a libopus -b:a 24k -application voip)
  else
    codec_args=(-c copy)
  fi

  log_line "$log" "start station=$name slice=$SLICE opus=$OPUS"

  while true; do
    local now remaining
    now="$(date +%s)"
    remaining=$((DEADLINE - now))
    if [ "$remaining" -lt 5 ]; then
      break
    fi

    log_line "$log" "connect station=$name remaining=${remaining}s url=$url"
    # Un flux interrompu (fin de --max-time ou coupure réseau) relance la boucle.
    curl -sNL --max-time "$remaining" "$url" |
      ffmpeg -nostdin -hide_banner -loglevel warning -y -i pipe:0 \
        "${codec_args[@]}" \
        -f segment -segment_format "$seg_format" -segment_time 3600 -strftime 1 \
        "$dir/${name}_s${SLICE}_%Y%m%dT%H%M%SZ.${ext}" ||
      true
    log_line "$log" "disconnect station=$name"

    now="$(date +%s)"
    if [ $((DEADLINE - now)) -lt 5 ]; then
      break
    fi
    sleep 5
  done

  log_line "$log" "done station=$name slice=$SLICE"
}

pids=()
for entry in "${STATIONS[@]}"; do
  name="${entry%%=*}"
  url="${entry#*=}"
  capture_station "$name" "$url" &
  pids+=("$!")
done

failed=0
for pid in "${pids[@]}"; do
  if ! wait "$pid"; then
    failed=$((failed + 1))
  fi
done

manifest="out/manifest.txt"
total=0

{
  echo "# Radio capture manifest"
  echo "generated_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "slice=$SLICE duration_min=$DURATION_MIN opus=$OPUS"
  echo "failed_workers=$failed"
  echo
  echo "# bytes<TAB>fichier"
} >"$manifest"

while IFS= read -r -d '' f; do
  size="$(du -b "$f" | cut -f1)"
  printf '%s\t%s\n' "$size" "$f" >>"$manifest"
  total=$((total + size))
done < <(find out -type f \( -name '*.opus' -o -name '*.aac' -o -name '*.mp3' \) -print0 | sort -z)

printf '\ntotal_bytes\t%s\n' "$total" >>"$manifest"
cat "$manifest"

if [ "$total" -le 0 ]; then
  echo "ERREUR: aucun octet audio capturé" >&2
  exit 1
fi

echo "capture: OK total_bytes=$total"
exit 0

