"""T7.1 / L7 — erreur par classe et par station, IC Wilson et split tenu a l'ecart.

ISC-11 demande quatre choses, prouvees ici sans cocher l'ISC lui-meme (la preuve
finale depend d'un segmenteur evalue) :

1. un taux d'erreur par CLASSE, dont le denominateur est le nombre de segments
   REELS de la classe (`verite == classe`) et non le nombre de predictions ;
2. un taux d'erreur par STATION, puis l'ecart `max - min` entre stations ;
3. un IC Wilson 95 % par classe, ecrit depuis sa definition et compare a
   `metrics._wilson`, sans plancher de 30 segments ;
4. le controle du split tenu a l'ecart : graine ecrite et aucun id de test dans
   l'entrainement declare, refuse nommement sinon.

Les ancres de reference sont `rates.py` (`_wilson`, `correction_rates`) et
`data/annotation/review-v1/agreement-v1.md` : la mesure `source_class` du banc
doit y retrouver 32,3 % d'erreur globale, 46,0 % pour rtsmatam, 21,0 % pour
lovefm et 25,0 points d'ecart. Ces valeurs sont un point de comparaison, pas une
coche : le banc publie, le seuil d'ISC-11 n'est pas applique.
"""

from __future__ import annotations

import json
import math
from dataclasses import replace

import pytest

from antenly_api.annotation.models import InvariantError, NoObservationError
from antenly_api.eval.metrics import (
    CLASS_ORDER,
    MAX_CLASS_ERROR_RATE,
    MAX_STATION_SPREAD,
    PRD_CLASS_NAMES,
    StationObservation,
    evaluate_per_station,
)
from antenly_api.eval.segmentation import (
    evaluate,
    evaluate_station,
    main,
    station_observations,
)
from antenly_api.eval.split import (
    FrozenSplit,
    held_out_control,
    load_frozen_split,
)

WILSON_Z = 1.959963984540054


def _wilson_reference(errors: int, n: int) -> tuple[float, float, float]:
    """Formule de Wilson ecrite depuis la definition, sans importer rates.py."""
    p_hat = errors / n
    z2 = WILSON_Z * WILSON_Z
    denominator = 1.0 + z2 / n
    centre = (p_hat + z2 / (2 * n)) / denominator
    half = WILSON_Z * math.sqrt(p_hat * (1 - p_hat) / n + z2 / (4 * n * n)) / denominator
    return max(0.0, centre - half), min(1.0, centre + half), half

