"""Pool d'URL par chaîne (ISA 2026-11-09-inventory-url-pool).

Une chaîne porte une liste ordonnée d'URL déclarées (`streams.csv`), une
réserve de secours séparée (`reserve.csv`, mêmes colonnes) et une seule URL
courante (`channels.csv.current_url`). Ce module ne fait aucune requête
réseau : les fonctions sont pures, et `PoolWorker` reçoit la fonction
d'essai d'URL et l'horloge en paramètres (tests sans réseau, sondes réelles
sur GitHub Actions seulement).

Règles (ISA) :
- ordre d'essai : priorité décroissante (plus grand = essayé d'abord), puis
  score décroissant ; la réserve n'est essayée qu'après toute la liste ;
- score v1 = succès / (succès + échecs côté serveur), 0 si jamais sondée avec
  succès, recalculé depuis `probes/` — jamais saisi à la main ;
- une chaîne n'est `indisponible_confirme` que si chaque URL du pool (liste
  et réserve) l'est ; une URL joignable suffit pour `joignable` ;
- l'URL courante est vidée si elle sort du pool et à chaque édition du pool ;
- « muette » n'est prononcée qu'après essai de l'URL suivante ; un silence de
  plus de 5 min déclenche une alerte ;
- une URL morte est marquée invalide avec une remarque datée ; la chaîne
  n'est jamais abandonnée tant qu'il reste une URL valide ;
- santé = temps valide / temps total, en %, lue sur un delta d'environ 60 s.
"""

from __future__ import annotations

import csv
import ipaddress
import json
import os
import re
import tempfile
import urllib.parse
from collections.abc import Callable, Iterable
from dataclasses import dataclass, field
from datetime import UTC, datetime
from pathlib import Path

STATUSES = ("joignable", "indisponible_confirme", "non_verifiable")

STREAM_COLUMNS = [
    "channel_id", "url", "source_url", "priority", "score", "collected_at",
    "media_type", "last_probe_at", "last_result", "consecutive_failures",
    "valid", "invalid_remark", "origin", "client",
]
CHANNEL_COLUMNS = [
    "id", "name", "type", "sources", "current_url", "epg_id", "broadcast_type",
    "language", "city", "region", "country", "website", "popularity", "monitored",
]
RESERVE_FILE = "reserve.csv"
STREAMS_FILE = "streams.csv"

# Borne de temps d'un essai d'URL dans le worker. Valeur de départ : la sonde
# d'inventaire décode 60 s (probe.DECODE_TARGET) ; un essai de capture n'a
# besoin que de la première trame. À régler sur nos propres mesures.
TRY_TIMEOUT_S = 15.0
# Silence au-delà duquel une alerte part (ISA, Q5-c).
SILENCE_ALERT_S = 300.0
# Échecs consécutifs avant de marquer une URL invalide (la santé mesurée
# tranche, pas un code isolé : un seul échec ne suffit jamais).
INVALID_AFTER_FAILURES = 2
# Delta de lecture de la santé (ISA : environ 60 s) et tolérance admise.
HEALTH_DELTA_S = 60.0
HEALTH_DELTA_MIN_S = 30.0
HEALTH_DELTA_MAX_S = 120.0


class PoolError(ValueError):
    pass


def _iso(ts: float) -> str:
    return datetime.fromtimestamp(ts, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def _num(v, default=0.0) -> float:
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def _int(v, default=0) -> int:
    try:
        return int(str(v).strip())
    except (TypeError, ValueError):
        return default


def is_valid(row: dict) -> bool:
    return str(row.get("valid", "true")).strip().lower() not in ("false", "0", "non")


_LOOPBACK_HOSTS = {"localhost", "localhost.localdomain", "ip6-localhost"}
_PRIVATE_SUFFIXES = (".local", ".internal", ".localhost")
_NUMERIC_HOST = re.compile(r"^(?:0x[0-9a-f]+|[0-9]+)(?:\.[0-9]+)*$", re.IGNORECASE)


def _split(url: str):
    try:
        return urllib.parse.urlsplit((url or "").strip())
    except ValueError:
        return None


def _query(query: str) -> str:
    pairs = urllib.parse.parse_qsl(query or "", keep_blank_values=True)
    return urllib.parse.urlencode(sorted(pairs))


def url_key(url: str) -> str:
    """Identité d'une URL : schéma + hôte + chemin, query normalisée et triée.

    La query est conservée : deux montages Icecast (`?mp=/a` et `?mp=/b`) sont
    deux flux distincts, les fusionner perdrait un flux en silence.
    """
    p = _split(url)
    if p is None or not p.scheme or not p.netloc:
        return ""
    q = _query(p.query)
    return f"{p.scheme.lower()}://{p.netloc.lower()}{p.path.rstrip('/')}" + (f"?{q}" if q else "")


def variant_key(url: str) -> str:
    """Empreinte anti-variante : hôte + chemin, ni schéma ni query.

    Sert à refuser qu'une URL du catalogue entre comme flux privé sous une
    variante (http au lieu de https, casse, slash final, paramètre ajouté).
    """
    p = _split(url)
    if p is None or not p.netloc:
        return ""
    return f"{p.netloc.lower()}{p.path.rstrip('/')}"


def same_stream(a: str, b: str) -> bool:
    """Même flux déclaré ? Même hôte+chemin, et query identique ou absente d'un côté.

    Une query présente des deux côtés et différente désigne deux montages
    distincts : on ne les confond pas.
    """
    pa, pb = _split(a), _split(b)
    if pa is None or pb is None:
        return False
    if variant_key(a) != variant_key(b) or not variant_key(a):
        return False
    qa, qb = _query(pa.query), _query(pb.query)
    return qa == qb or not qa or not qb


def host_is_private(url: str) -> bool:
    """Hôte interne ? (garde SSRF : une URL entrante n'est jamais sondée).

    Refuse localhost, les suffixes internes et toute adresse IP loopback,
    privée, lien-local, multicast, réservée ou non spécifiée — IPv4 et IPv6.
    Ne résout pas le DNS (aucun réseau dans ce module) : une revalidation de
    la résolution appartient à la sonde, qui doit réappliquer cette garde.
    """
    p = _split(url)
    host = (p.hostname if p is not None else None) or ""
    # Un point final désigne le même hôte (`localhost.` résout vers 127.0.0.1) :
    # on le retire avant toute comparaison, sinon la garde se contourne.
    host = host.strip("[]").rstrip(".").lower()
    if not host:
        return True
    if host in _LOOPBACK_HOSTS or host.endswith(_PRIVATE_SUFFIXES):
        return True
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        # Le parse a échoué : formes courtes, dword, hex ou octales (127.1,
        # 2130706433, 0x7f000001) que la pile résout vers une adresse, jamais
        # publiques. Une IPv4 pointée valide est jugée sur l'adresse, ci-dessous.
        return bool(_NUMERIC_HOST.match(host))
    # Une adresse valide est jugée sur l'adresse, pas sur sa forme : 8.8.8.8
    # est publique. `is_global` seul ne suffit pas (224.0.0.1 est multicast ET
    # global) ; `not is_global` couvre en plus le CGNAT 100.64/10 que
    # `is_private` laisse passer.
    return (ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved
            or ip.is_multicast or ip.is_unspecified or not ip.is_global)


# ---------------------------------------------------------------------------
# Score et compteurs (ISC-21, ISC-22, ISC-20)


def media_type_of(rec: dict) -> str:
    a, v = bool(rec.get("has_audio")), bool(rec.get("has_video"))
    return "both" if a and v else "video" if v else "audio" if a else ""


def counters_from_probes(url: str, records: Iterable[dict]) -> dict:
    """Compteurs d'une URL recalculés depuis les enregistrements de sonde.

    `consecutive_failures` compte les échecs consécutifs **toutes causes**
    (environnement comprise) : c'est un compteur d'observation, pas le
    critère d'invalidation. Seuls les échecs côté serveur marquent une URL
    invalide, et c'est `valid`/`invalid_remark` qui en font foi (ISC-30).
    """
    recs = sorted((r for r in records if r.get("url") == url), key=lambda r: r.get("probed_at") or "")
    ok = sum(1 for r in recs if r.get("status") == "joignable")
    server = sum(1 for r in recs if r.get("status") != "joignable" and r.get("fail_signal") == "serveur")
    score = round(ok / (ok + server), 4) if ok else 0
    consec = 0
    for r in reversed(recs):
        if r.get("status") == "joignable":
            break
        consec += 1
    media = ""
    for r in reversed(recs):
        media = media_type_of(r)
        if media:
            break
    last = recs[-1] if recs else {}
    return {"score": score, "last_probe_at": last.get("probed_at", ""),
            "last_result": last.get("status", ""), "consecutive_failures": consec,
            "media_type": media}


def validity_from_probes(url: str, records: Iterable[dict], *, previous_valid="true",
                         previous_remark="") -> dict:
    """Validité d'une URL dérivée des sondes (ISC-30).

    Parcours trié par `probed_at` : `joignable` remet la série à zéro ;
    `fail_signal == "serveur"` incrémente ; tout autre échec est ignoré (ni
    compté ni remis à zéro, comme `PoolWorker`). `streak >=
    INVALID_AFTER_FAILURES` marque l'URL invalide avec une remarque datée ;
    sinon un dernier `joignable` la remet valide ; sinon l'existant est
    conservé.
    """
    recs = sorted((r for r in records if r.get("url") == url),
                  key=lambda r: r.get("probed_at") or "")
    streak = 0
    last_ok = False
    last_fail: dict = {}
    for r in recs:
        if r.get("status") == "joignable":
            streak, last_ok, last_fail = 0, True, {}
        elif r.get("fail_signal") == "serveur":
            streak, last_ok, last_fail = streak + 1, False, r
    if streak >= INVALID_AFTER_FAILURES:
        at = last_fail.get("probed_at") or ""
        reason = last_fail.get("reason") or "échec"
        return {"valid": "false",
                "invalid_remark": f"{at} : {streak} échecs serveur consécutifs, dernier « {reason} »"}
    if last_ok:
        return {"valid": "true", "invalid_remark": ""}
    return {"valid": previous_valid, "invalid_remark": previous_remark}


def apply_probes(rows: list[dict], records: Iterable[dict]) -> list[dict]:
    recs = list(records)
    out = []
    for r in rows:
        url = r.get("url", "")
        out.append({**r, **counters_from_probes(url, recs),
                    **validity_from_probes(url, recs,
                                           previous_valid=str(r.get("valid") or "true"),
                                           previous_remark=str(r.get("invalid_remark") or ""))})
    return out

