#!/usr/bin/env python3
"""ISC-20 — cout mesure par chaine-heure aux cadences 10 s et 30 s.

Chaque ligne porte ``channel_id``, ``hour_utc``, ``cadence_s`` et ``bytes``
(octets reellement traites pendant cette heure). La probe publie une valeur
mesuree par cadence et par chaine-heure ; une cadence absente est une violation
nommee, jamais extrapolee. Une donnee illisible ou une heure manquante sur les
24 h du jour sort en 2 avec un message, sans traceback : aucune mesure n'est
inventee. Sortie 0 conforme, 1 incoherence, 2 donnee absente ou illisible.

  cost_report.py --cadences=10s,30s --day=D-1
"""

from __future__ import annotations

import argparse
import re
import sys
from datetime import date, timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import (
    DEFAULT_COSTS,
    EXIT_OK,
    EXIT_VIOLATION,
    HarnessError,
    parse_utc,
    read_jsonl,
    report_error,
)

DAY_PATTERN = re.compile(r"^D-(?P<offset>\d+)$")
DATE_PATTERN = re.compile(r"^\d{4}-\d{2}-\d{2}$")


def parse_cadences(value: str) -> list[int]:
    cadences: list[int] = []
    for token in value.split(","):
        token = token.strip()
        token = token.removesuffix("s")
        if not token.isdigit() or int(token) <= 0:
            raise HarnessError(f"cadence invalide: {value!r}")
        cadences.append(int(token))
    if not cadences:
        raise HarnessError("aucune cadence fournie")
    return cadences


def resolve_day(value: str, reference: date) -> date:
    match = DAY_PATTERN.match(value)
    if match:
        return reference - timedelta(days=int(match.group("offset")))
    if DATE_PATTERN.match(value):
        try:
            return date.fromisoformat(value)
        except ValueError as exc:
            raise HarnessError(f"--day invalide: {value!r}") from exc
    raise HarnessError(f"--day invalide: {value!r} (D-N ou AAAA-MM-JJ)")


def normalize(records: list[dict]) -> list[dict]:
    """Convertit les mesures une fois ; toute donnee illisible sort en 2."""
    normalized: list[dict] = []
    for lineno, record in enumerate(records, start=1):
        missing = {"channel_id", "hour_utc", "cadence_s", "bytes"} - record.keys()
        if missing:
            raise HarnessError(
                f"mesure de cout incomplete (ligne {lineno}): {sorted(missing)}"
            )
        try:
            moment = parse_utc(record["hour_utc"])
            cadence = int(record["cadence_s"])
            size = int(record["bytes"])
        except HarnessError:
            raise
        except (TypeError, ValueError) as exc:
            raise HarnessError(
                f"mesure de cout illisible (ligne {lineno}): {exc}"
            ) from exc
        if cadence <= 0:
            raise HarnessError(
                f"cadence invalide (ligne {lineno}): {record['cadence_s']!r}"
            )
        if size < 0:
            raise HarnessError(f"octets negatifs (ligne {lineno}): {record['bytes']!r}")
        normalized.append(
            {
                "channel_id": record["channel_id"],
                "moment": moment,
                "hour_utc": record["hour_utc"],
                "cadence_s": cadence,
                "bytes": size,
            }
        )
    return normalized


def report(records: list[dict], cadences: list[int], day: date) -> list[str]:
    measured: dict[tuple[str, str], dict[int, int]] = {}
    for record in records:
        if record["moment"].date() != day:
            continue
        hour = record["moment"].strftime("%Y-%m-%dT%H:00Z")
        key = (record["channel_id"], hour)
        measured.setdefault(key, {})[record["cadence_s"]] = record["bytes"]

    if not measured:
        raise HarnessError(f"aucune mesure de cout pour le {day.isoformat()}")

    expected_hours = {f"{day.isoformat()}T{hour:02d}:00Z" for hour in range(24)}
    hours_by_channel: dict[str, set[str]] = {}
    for channel_id, hour in measured:
        hours_by_channel.setdefault(channel_id, set()).add(hour)
    for channel_id, hours in sorted(hours_by_channel.items()):
        missing = sorted(expected_hours - hours)
        if missing:
            raise HarnessError(
                f"heures manquantes pour {channel_id} le {day.isoformat()}: "
                f"{len(missing)}/24 (ex. {', '.join(missing[:3])})"
            )

    problems: list[str] = []
    for (channel_id, hour), values in sorted(measured.items()):
        for cadence in cadences:
            if cadence not in values:
                problems.append(
                    f"{channel_id} {hour}: cadence {cadence}s absente (0 extrapolation)"
                )
    return problems


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--costs", type=Path, default=DEFAULT_COSTS)
    parser.add_argument("--cadences", default="10s,30s")
    parser.add_argument("--day", default="D-1")
    args = parser.parse_args(argv)

    try:
        cadences = parse_cadences(args.cadences)
        records = normalize(read_jsonl(args.costs))
        reference = max(record["moment"] for record in records).date()
        day = resolve_day(args.day, reference)
        problems = report(records, cadences, day)
    except HarnessError as exc:
        return report_error(str(exc))

    day_records = [record for record in records if record["moment"].date() == day]
    for record in sorted(
        day_records,
        key=lambda item: (item["channel_id"], item["hour_utc"], item["cadence_s"]),
    ):
        print(
            f"cout chaine={record['channel_id']} heure={record['hour_utc']} "
            f"cadence={record['cadence_s']}s bytes={record['bytes']}"
        )
    if problems:
        for problem in problems:
            print(f"VIOLATION: {problem}")
        return EXIT_VIOLATION
    print(f"OK cout mesure jour={day.isoformat()} cadences={cadences}")
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())

