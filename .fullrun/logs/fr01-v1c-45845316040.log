--- .github/workflows/capture.yml
name: Radio capture

on:
  workflow_dispatch:
    inputs:
      slice:
        description: "Tranche de capture (1 a 5)"
        type: choice
        options:
          - "1"
          - "2"
          - "3"
          - "4"
          - "5"
        default: "1"
      duration_min:
        description: "Duree de capture en minutes"
        type: string
        default: "340"
      opus:
        description: "Encoder en Opus 24k mono (sinon copie du flux d'origine)"
        type: boolean
        default: true
      chain:
        description: "Enchainer automatiquement la tranche suivante"
        type: boolean
        default: true

permissions:
  contents: read
  actions: write

concurrency:
  group: radio-capture
  cancel-in-progress: false

jobs:
  capture:
    name: capture
    runs-on: ubuntu-latest
    timeout-minutes: 355
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install ffmpeg
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg

      # Garde ISC-7 : quota GitHub Actions de 2 000 min/mois. Refuse la capture
      # avant qu'elle démarre si consommé + demandé dépasse le plafond. Les runs
      # du MOIS courant sont listés par l'API (gh), tous workflows confondus :
      # le quota est celui du compte, et un run échoué ou annulé consomme ses
      # minutes autant qu'un run réussi. Aucun `--workflow` ici, donc.
      - name: Budget guard (quota 2000 min/mois)
        env:
          GH_TOKEN: ${{ github.token }}
          DURATION_MIN: ${{ inputs.duration_min }}
        run: |
          set -euo pipefail
          RUNS="$(mktemp)"
          gh run list --limit 200 \
            --json conclusion,startedAt,updatedAt,workflowName > "$RUNS"
          python3 scripts/corpus/budget.py \
            --consumed "$RUNS" \
            --requested "$DURATION_MIN" \
            --month "$(date -u +%Y-%m)"

      - name: Capture 6 stations in parallel
        run: bash scripts/capture.sh
        env:
          SLICE: ${{ inputs.slice }}
          DURATION_MIN: ${{ inputs.duration_min }}
          OPUS: ${{ inputs.opus }}

      # Garde ISC-6 : une capture vide ou une station sous 290 min décodées
      # échoue ici, en nommant la station. `if: always()` — l'échec doit rester
      # visible même quand la capture elle-même a échoué avant.
      - name: Validate capture (>= 290 min décodées par station)
--- .github/workflows/ci.yml
name: CI
# Minutes Actions du dépôt privé épuisées : la CI tourne sur LordThiouk/antenly-ci (statut antenly-ci).
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  rust:
    runs-on: ubuntu-latest
    defaults: { run: { working-directory: engine } }
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with: { components: "rustfmt, clippy" }
      - run: cargo fmt --all -- --check
      - run: cargo clippy --all-targets -- -D warnings
      - run: cargo test --all
  python:
    runs-on: ubuntu-latest
    defaults: { run: { working-directory: api } }
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: uv sync
      - run: uv run ruff check . ../scripts/corpus/preannot
      - run: uv run pytest -q
  # Face ffprobe d'ISC-1 : mesurer la duree reellement decodee exige l'audio et
  # ffprobe. Sans ce job, `-k ffprobe` sortait en exit 0 sur des skips et la preuve
  # nommee par l'ISA n'etait executee par personne (finding CRITICAL de la passe
  # Silas deps, 2026-11-08). `workflow_dispatch` seul, comme le reste du workflow :
  # le job est pret, il n'est pas declenche a chaque push. ANTENLY_REQUIRE_AUDIO=1
  # fait ECHOUER la face au lieu de la taire.
  corpus-ffprobe:
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch'
    defaults: { run: { working-directory: api } }
    env:
      ANTENLY_CORPUS_AUDIO: ${{ github.workspace }}/antenly-corpus
      ANTENLY_REQUIRE_AUDIO: "1"
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: ffmpeg (ffprobe) — dependance systeme de la mesure
        run: sudo apt-get update && sudo apt-get install -y ffmpeg
      - name: Corpus audio (2,37 Go, dataset prive)
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
        run: |
          uv sync
          uv run --with 'huggingface_hub==2.4.0' python -c "
          import os
          from huggingface_hub import snapshot_download
          snapshot_download(repo_id='LordThiouk/antenly-corpus', repo_type='dataset',
                            local_dir=os.environ['ANTENLY_CORPUS_AUDIO'],
                            allow_patterns=['*.opus'])
          "
      - name: Face ffprobe d'ISC-1 (echoue si l'audio manque)
        run: uv run pytest tests/annotation/test_coverage.py -k ffprobe -q
      # Le probe de provenance ne porte pas « ffprobe » dans son nom (c'est un
      # detecteur d'octets, pas une mesure) : sans cette ligne explicite, aucun
      # job ne l'executait et un corpus tronque passait la CI en 6/6 verts
      # (Silas DATA-1, 2026-11-08). Nomme ici pour que la garde tourne vraiment.
      - name: Provenance du corpus (octets vs manifeste)
        run: uv run pytest tests/annotation/test_coverage.py::test_corpus_provenance_matches_manifest -q
      # Face audio d'ISC-2 : compare la borne haute declaree de chaque segment a
      # l'audio REELLEMENT decode. Elle exige le corpus monte, donc elle vit ici.
      - name: Face audio d'ISC-2 (segments vs audio decode)
        run: uv run pytest tests/annotation/test_segment_bounds.py::test_no_segment_points_at_audio_that_does_not_decode -q
  licenses:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: EmbarkStudios/cargo-deny-action@v2
        with:
          manifest-path: engine/Cargo.toml
          command: check licenses
      - uses: astral-sh/setup-uv@v5
      - name: Python licences (deny GPL/AGPL)
        working-directory: api
        run: |
--- .github/workflows/inventory-pass2.yml
name: Inventory pass 2

# Passe 2 séparée de la passe 1 (inventory-probe.yml) pour ne pas payer
# 60 min de `sleep` : le cron tourne 1 h après la passe 1 hebdo (lundi 04:00
# UTC), ou à la main au moins 1 h après un dispatch de la passe 1.
on:
  schedule:
    - cron: "0 5 * * 1"
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write
  actions: read

jobs:
  pass2:
    name: probe pass 2 + report + PR
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup uv
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true

      - name: Install ffmpeg
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg

      - name: Download latest pass 1 (>= 1 h old)
        env:
          GH_TOKEN: ${{ github.token }}

