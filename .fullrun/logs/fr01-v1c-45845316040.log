#!/usr/bin/env python3
"""ISC-8 — disponibilite du service d'ingestion depuis les series de heartbeat.

Chaque ligne porte ``heartbeat_utc`` et ``ok`` (booleen). La probe calcule le
taux de heartbeats ok sur les N derniers jours et exige 99,5 % minimum. Aucune
extrapolation : un journal absent ou vide sort en 2, jamais en 100 %.

La fenetre doit etre couverte : un seul heartbeat, ou deux heartbeats a 30 jours
d'ecart, ne prouvent pas la disponibilite sur 30 jours. Tout trou entre
heartbeats (bornes de la fenetre comprises) plus grand que ``--max-interval``
sort en 2 : la probe refuse de mesurer une periode qu'elle ne voit pas.

  uptime.py
  uptime.py --heartbeats data/ingest/heartbeats.jsonl --days=30 --min=99.5
"""

from __future__ import annotations

import argparse
import sys
from datetime import timedelta
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _common import (
    DEFAULT_HEARTBEATS,
    EXIT_OK,
    EXIT_VIOLATION,
    HarnessError,
    channel_gaps,
    format_utc,
    parse_utc,
    read_jsonl,
    report_error,
)


def uptime(
    records: list[dict], days: int, max_interval_s: float
) -> tuple[float, int, int, str, str]:
    """Retourne taux, ok, total, debut et fin de fenetre."""
    parsed: list[tuple[object, bool]] = []
    for record in records:
        if "heartbeat_utc" not in record or "ok" not in record:
            raise HarnessError("heartbeat incomplet: heartbeat_utc et ok requis")
        if not isinstance(record["ok"], bool):
            raise HarnessError(f"ok non booleen: {record['ok']!r}")
        parsed.append((parse_utc(record["heartbeat_utc"]), record["ok"]))
    parsed.sort(key=lambda item: item[0])
    window_end = parsed[-1][0]
    window_start = window_end - timedelta(days=days)
    kept = [(moment, ok) for moment, ok in parsed if moment >= window_start]
    if not kept:
        raise HarnessError(f"aucun heartbeat sur les {days} derniers jours")

    coverage = channel_gaps(
        [{"start": moment, "end": moment} for moment, _ in kept],
        window_start,
        window_end,
    )
    worst_gap = max((seconds for _, _, seconds in coverage), default=0.0)
    if worst_gap > max_interval_s:
        raise HarnessError(
            f"couverture insuffisante sur {days} j: trou de {worst_gap:.0f}s > "
            f"{max_interval_s:.0f}s entre heartbeats (impossible de prouver la "
            f"disponibilite)"
        )

    total = len(kept)
    good = sum(1 for _, ok in kept if ok)
    return (
        100.0 * good / total,
        good,
        total,
        format_utc(window_start),
        format_utc(window_end),
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--heartbeats", type=Path, default=DEFAULT_HEARTBEATS)
    parser.add_argument("--days", type=int, default=30)
    parser.add_argument("--min", type=float, default=99.5)
    parser.add_argument("--max-interval", type=float, default=300.0)
    args = parser.parse_args(argv)
    if args.days < 1:
        return report_error(f"--days invalide: {args.days}")
    if args.max_interval <= 0:
        return report_error(f"--max-interval invalide: {args.max_interval}")

    try:
        records = read_jsonl(args.heartbeats)
        rate, good, total, window_start, window_end = uptime(
            records, args.days, args.max_interval
        )
    except HarnessError as exc:
        return report_error(str(exc))

    print(
        f"uptime={rate:.3f}% ok={good}/{total} minimum={args.min:.3f}% "
        f"fenetre={window_start}..{window_end}"
    )
    if rate < args.min:
        print(f"VIOLATION: disponibilite {rate:.3f}% < {args.min:.3f}%")
        return EXIT_VIOLATION
    return EXIT_OK


if __name__ == "__main__":
    raise SystemExit(main())

