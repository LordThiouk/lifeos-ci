"""Preuves du harnais d'ingestion V0 (ISC-1, 2, 3, 6, 8, 10, 20).

Les scripts sont invoques en sous-processus, exactement comme les commandes de
la Test Strategy. Aucune URL, IP ni cle : les fixtures sont des chaines
nommees et des horodatages synthetiques.
"""

from __future__ import annotations

import json
import subprocess
import sys
from datetime import UTC, datetime, timedelta
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
INGEST = ROOT / "scripts" / "ingest"
FIXTURES = Path(__file__).resolve().parent / "fixtures"


def _run(script: str, *args: object) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [sys.executable, str(INGEST / script), *(str(arg) for arg in args)],
        capture_output=True,
        text=True,
        cwd=ROOT,
        check=False,
    )


def _fmt(moment: datetime) -> str:
    return moment.astimezone(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def _write_jsonl(path: Path, records: list[dict]) -> Path:
    path.write_text("\n".join(json.dumps(record) for record in records) + "\n", encoding="utf-8")
    return path


def _segments(
    channel_id: str,
    source: str,
    start: datetime,
    count: int,
    duration_s: int = 60,
    **extra: object,
) -> list[dict]:
    records: list[dict] = []
    for index in range(count):
        segment_start = start + timedelta(seconds=index * duration_s)
        segment_end = segment_start + timedelta(seconds=duration_s)
        record = {
            "channel_id": channel_id,
            "source": source,
            "start_utc": _fmt(segment_start),
            "end_utc": _fmt(segment_end),
            "media_type": "audio",
            "bytes": 100,
            "state": "alive",
        }
        record.update(extra)
        records.append(record)
    return records


def _costs(
    channel_id: str,
    start: datetime,
    hours: int = 24,
    cadences: tuple[int, ...] = (10, 30),
    **extra: object,
) -> list[dict]:
    records: list[dict] = []
    for hour in range(hours):
        for cadence in cadences:
            record = {
                "channel_id": channel_id,
                "hour_utc": _fmt(start + timedelta(hours=hour)),
                "cadence_s": cadence,
                "bytes": 1000 if cadence == 10 else 600,
            }
            record.update(extra)
            records.append(record)
    return records


# --- audit_gaps (ISC-1, ISC-2, ISC-3) --------------------------------------


def test_audit_gaps_manifeste_absent_sort_en_2(tmp_path: Path) -> None:
    result = _run(
        "audit_gaps.py",
        "--source=http",
        "--manifest",
        tmp_path / "absent.jsonl",
    )
    assert result.returncode == 2
    assert "ERREUR" in result.stderr
    assert "absent" in result.stderr


def test_audit_gaps_conforme() -> None:
    result = _run(
        "audit_gaps.py",
        "--source=http",
        "--manifest",
        FIXTURES / "manifest.jsonl",
        "--window-hours",
        0,
    )
    assert result.returncode == 0, result.stderr
    assert "OK source=http" in result.stdout


def test_audit_gaps_trou_nomme(tmp_path: Path) -> None:
    start = datetime(2026, 11, 25, tzinfo=UTC)
    records = _segments("station-a", "http", start, 1)
    records += _segments("station-a", "http", start + timedelta(minutes=11), 1)
    manifest = _write_jsonl(tmp_path / "manifest.jsonl", records)
    result = _run("audit_gaps.py", "--source=http", "--manifest", manifest, "--window-hours", 0)
    assert result.returncode == 1
    assert "VIOLATION" in result.stdout
    assert "station-a" in result.stdout
    assert "600s" in result.stdout


