name: CI
# Minutes Actions du dépôt privé épuisées : la CI tourne sur LordThiouk/antenly-ci (statut antenly-ci).
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  rust:
    runs-on: ubuntu-latest
    defaults: { run: { working-directory: engine } }
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with: { components: "rustfmt, clippy" }
      - run: cargo fmt --all -- --check
      - run: cargo clippy --all-targets -- -D warnings
      - run: cargo test --all
  python:
    runs-on: ubuntu-latest
    defaults: { run: { working-directory: api } }
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - run: uv sync
      - run: uv run ruff check . ../scripts/corpus/preannot
      - run: uv run pytest -q
  # Face ffprobe d'ISC-1 : mesurer la duree reellement decodee exige l'audio et
  # ffprobe. Sans ce job, `-k ffprobe` sortait en exit 0 sur des skips et la preuve
  # nommee par l'ISA n'etait executee par personne (finding CRITICAL de la passe
  # Silas deps, 2026-11-08). `workflow_dispatch` seul, comme le reste du workflow :
  # le job est pret, il n'est pas declenche a chaque push. ANTENLY_REQUIRE_AUDIO=1
  # fait ECHOUER la face au lieu de la taire.
  corpus-ffprobe:
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch'
    defaults: { run: { working-directory: api } }
    env:
      ANTENLY_CORPUS_AUDIO: ${{ github.workspace }}/antenly-corpus
      ANTENLY_REQUIRE_AUDIO: "1"
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v5
      - name: ffmpeg (ffprobe) — dependance systeme de la mesure
        run: sudo apt-get update && sudo apt-get install -y ffmpeg
      - name: Corpus audio (2,37 Go, dataset prive)
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
        run: |
          uv sync
          uv run --with 'huggingface_hub==2.4.0' python -c "
          import os
          from huggingface_hub import snapshot_download
          snapshot_download(repo_id='LordThiouk/antenly-corpus', repo_type='dataset',
                            local_dir=os.environ['ANTENLY_CORPUS_AUDIO'],
                            allow_patterns=['*.opus'])
          "
      - name: Face ffprobe d'ISC-1 (echoue si l'audio manque)
        run: uv run pytest tests/annotation/test_coverage.py -k ffprobe -q
      # Le probe de provenance ne porte pas « ffprobe » dans son nom (c'est un
      # detecteur d'octets, pas une mesure) : sans cette ligne explicite, aucun
      # job ne l'executait et un corpus tronque passait la CI en 6/6 verts
      # (Silas DATA-1, 2026-11-08). Nomme ici pour que la garde tourne vraiment.
      - name: Provenance du corpus (octets vs manifeste)
        run: uv run pytest tests/annotation/test_coverage.py::test_corpus_provenance_matches_manifest -q
      # Face audio d'ISC-2 : compare la borne haute declaree de chaque segment a
      # l'audio REELLEMENT decode. Elle exige le corpus monte, donc elle vit ici.
      - name: Face audio d'ISC-2 (segments vs audio decode)
        run: uv run pytest tests/annotation/test_segment_bounds.py::test_no_segment_points_at_audio_that_does_not_decode -q
  licenses:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: EmbarkStudios/cargo-deny-action@v2
        with:
          manifest-path: engine/Cargo.toml
          command: check licenses
      - uses: astral-sh/setup-uv@v5
      - name: Python licences (deny GPL/AGPL)
        working-directory: api
        run: |
          uv sync
          uv run pip-licenses --partial-match --fail-on="GNU General Public License;GPL;AGPL;Affero"
  secrets:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 0 }
      - uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # Config du dépôt (décision Papa 2026-11-04, révisée 2026-11-08) :
          # l'exception porte sur des VALEURS factices, jamais sur un chemin.
          # Les fichiers de test et les fixtures restent scannés.
          GITLEAKS_CONFIG: .gitleaks.toml

