$ cat migrations/postgres/003_ingestion.sql
-- Antenly — ingestion live : champs de chaîne (FR-01, vague V1 S1.1).
--
-- Le catalogue est ouvert : ces colonnes portent l'état par chaîne, jamais une
-- liste de chaînes (ISC-22). Elles ajoutent la provenance typée et datée
-- (ISC-21), le type de média détecté au contenu et daté (ISC-16), la cadence
-- par chaîne (ISC-14), la répartition par région et la bascule de secours
-- (ISC-23), et l'origine du flux (catalogue Antenly ou flux privé d'un client,
-- Q1-a). Aucune donnée de chaîne n'est insérée ici : le catalogue grandit par
-- les sources publiques, sans redéploiement.

ALTER TABLE channel
    ADD COLUMN origin text NOT NULL DEFAULT 'catalogue'
        CHECK (origin IN ('catalogue', 'client')),
    ADD COLUMN provenance_type text
        CHECK (provenance_type IN ('annuaire', 'site_officiel',
                                   'declaration_diffuseur', 'inventaire_interne')),
    ADD COLUMN provenance_at timestamptz,
    ADD COLUMN media_type text
        CHECK (media_type IN ('audio', 'video', 'both')),
    ADD COLUMN media_type_at timestamptz,
    ADD COLUMN cadence_window_s numeric(8, 3) NOT NULL DEFAULT 10.000
        CHECK (cadence_window_s > 0),
    ADD COLUMN cadence_interval_s numeric(8, 3) NOT NULL DEFAULT 10.000
        CHECK (cadence_interval_s > 0),
    ADD COLUMN cadence_audio_timeout_s numeric(8, 3) NOT NULL DEFAULT 30.000
        CHECK (cadence_audio_timeout_s > 0),
    ADD COLUMN ingest_region text,
    ADD COLUMN ingest_server text,
    ADD COLUMN failover_of text,
    -- ISC-14 : le délai d'attente audio doit dépasser intervalle + fenêtre.
    -- Une combinaison invalide est refusée à l'écriture, jamais corrigée en
    -- silence ; l'API nomme le champ fautif en 4xx.
    ADD CONSTRAINT channel_cadence_check
        CHECK (cadence_audio_timeout_s > cadence_interval_s + cadence_window_s),
    -- ISC-21 / ISC-16 : un type et sa date vont ensemble ; une provenance
    -- sans date (ou l'inverse) n'est jamais acceptée.
    ADD CONSTRAINT channel_provenance_pair_check
        CHECK ((provenance_type IS NULL) = (provenance_at IS NULL)),
    ADD CONSTRAINT channel_media_type_pair_check
        CHECK ((media_type IS NULL) = (media_type_at IS NULL));

COMMENT ON COLUMN channel.origin IS
    'Origine de la chaîne : catalogue Antenly ou flux privé fourni par un client (Q1-a).';
COMMENT ON COLUMN channel.provenance_type IS
    'Provenance typée : annuaire, site officiel, déclaration du diffuseur ou inventaire interne.';
COMMENT ON COLUMN channel.provenance_at IS
    'Date de la provenance ; un annuaire amont n''est jamais une preuve de disponibilité.';
COMMENT ON COLUMN channel.media_type IS
    'Type de média détecté au contenu à la première capture (audio, video, both).';
COMMENT ON COLUMN channel.media_type_at IS
    'Date de la détection du type de média ; une divergence d''inventaire est publiée.';
COMMENT ON COLUMN channel.cadence_window_s IS
    'Longueur d''une fenêtre de surveillance, en secondes, réglable par chaîne.';
COMMENT ON COLUMN channel.cadence_interval_s IS
    'Intervalle entre deux fenêtres, en secondes, réglable par chaîne.';
COMMENT ON COLUMN channel.cadence_audio_timeout_s IS
    'Délai d''attente audio, en secondes ; doit dépasser intervalle + fenêtre (ISC-14).';
COMMENT ON COLUMN channel.ingest_region IS
    'Région d''ingestion assignée à la chaîne (Q3-d).';
COMMENT ON COLUMN channel.ingest_server IS
    'Serveur d''ingestion assigné à la chaîne dans sa région (Q3-d).';
COMMENT ON COLUMN channel.failover_of IS
    'Serveur de secours vers lequel la chaîne bascule quand son serveur tombe (Q3-d).';

CREATE INDEX channel_origin_idx ON channel (origin);
CREATE INDEX channel_ingest_region_idx ON channel (ingest_region, ingest_server);

$ cat migrations/postgres/004_pool_origin.sql
-- Antenly — ingestion live : origine du pool d'URL (FR-01, vague V1 S1.2).
--
-- Une URL du pool vient soit du catalogue Antenly, soit d'un flux privé fourni
-- par un client (Q1-a). L'origine et le client sont alignés sur le pool
-- d'inventaire : tools/inventory/pool.py (STREAM_COLUMNS) et
-- tools/inventory/pool_console.py (console des flux privés, origine « prive »).
-- Un flux privé n'est visible que de son client ; un flux catalogue n'a jamais
-- de client. Aucune URL n'est écrite ici : la table ne porte que des lignes.

ALTER TABLE source
    ADD COLUMN origin text NOT NULL DEFAULT 'catalogue'
        CHECK (origin IN ('catalogue', 'prive')),
    ADD COLUMN client text,
    ADD CONSTRAINT source_origin_client_check
        CHECK ((origin = 'catalogue' AND client IS NULL)
            OR (origin = 'prive' AND client IS NOT NULL));

COMMENT ON COLUMN source.origin IS
    'Origine de l''URL : catalogue Antenly ou flux privé fourni par un client (Q1-a).';
COMMENT ON COLUMN source.client IS
    'Client propriétaire d''un flux privé ; NULL pour une URL du catalogue.';

CREATE INDEX source_origin_client_idx ON source (origin, client);

$ cat migrations/clickhouse/003_ingestion.sql
-- Antenly — ingestion live : fenêtres d'état et couverture horaire
-- (FR-01, vague V1 S1.3).
--
-- Chaque chaîne est surveillée par fenêtres de 10 s ; chaque fenêtre porte un
-- état explicite parmi alive, silent, timeout, offline et unavailable, sans
-- trou. La couverture est agrégée par heure et par chaîne (ISC-13, Q5-b).
-- Aucune valeur de chaîne n'est écrite ici : ces tables reçoivent le worker.

CREATE TABLE IF NOT EXISTS state_window
(
    tenant_id     UUID,
    channel_id    UUID,
    window_start  DateTime64(3, 'UTC'),
    window_end    DateTime64(3, 'UTC'),
    state         LowCardinality(String),
    media_type    LowCardinality(String) DEFAULT '',
    source        LowCardinality(String) DEFAULT '',
    ingest_region LowCardinality(String) DEFAULT '',
    ingest_server LowCardinality(String) DEFAULT '',
    ingested_at   DateTime DEFAULT now(),
    CONSTRAINT state_window_state_valid
        CHECK state IN ('alive', 'silent', 'timeout', 'offline', 'unavailable'),
    CONSTRAINT state_window_media_type_valid
        CHECK media_type IN ('', 'audio', 'video', 'both')
)
ENGINE = MergeTree
PARTITION BY toYYYYMM(window_start)
ORDER BY (tenant_id, channel_id, window_start);

CREATE TABLE IF NOT EXISTS coverage_hour
(
    tenant_id        UUID,
    channel_id       UUID,
    hour_start       DateTime('UTC'),
    window_count     UInt32,
    alive_count      UInt32,
    silent_count     UInt32,
    timeout_count    UInt32,
    offline_count    UInt32,
    unavailable_count UInt32,
    coverage_pct     Float64,
    computed_at      DateTime DEFAULT now()
)
ENGINE = ReplacingMergeTree(computed_at)
PARTITION BY toYYYYMM(hour_start)
ORDER BY (tenant_id, channel_id, hour_start);

$ cat api/tests/ingest/test_open_catalogue.py
"""ISC-22 — catalogue ouvert : une radio et une TV HLS entrent sans redéploiement.

Le schéma de chaîne (migration 003) porte l'origine, la provenance datée, le
type de média et la cadence ; aucune liste de chaînes n'est écrite dans le code,
la config ou une migration. Le test ajoute une radio et une TV HLS depuis une
source publique de test (hôtes ``.invalid``, aucun flux réel), les fait écrire
dans le pool puis les capture via ``PoolWorker`` : la croissance du catalogue
est une donnée, pas un redéploiement.
"""

from __future__ import annotations

import re
from pathlib import Path

import discover
import pool

ROOT = Path(__file__).resolve().parents[3]
CHANNEL_MIGRATION = ROOT / "migrations" / "postgres" / "003_ingestion.sql"

RADIO_URL = "https://radio-test.example.invalid/live"
TV_URL = "https://tv-test.example.invalid/live.m3u8"
RADIO_SOURCE = "https://annuaire-test.example.invalid/radio"
TV_SOURCE = "https://annuaire-test.example.invalid/tv.m3u"

REQUIRED_COLUMNS = (
    "origin",
    "provenance_type",
    "provenance_at",
    "media_type",
    "media_type_at",
    "cadence_window_s",
    "cadence_interval_s",
    "cadence_audio_timeout_s",
    "ingest_region",
    "ingest_server",
    "failover_of",
)

# Un nom de constante qui parle de chaînes/stations et dont la valeur est un
# littéral de liste/tuple/ensemble : c'est exactement une liste en dur.
HARDCODED_LIST_RE = re.compile(
    r"^\s*([A-Z][A-Z0-9_]*(?:CHANNELS?|STATIONS?|CHANNEL_LIST|STATION_LIST)[A-Z0-9_]*)"
    r"\s*=\s*[\[\(\{]",
    re.MULTILINE,
)


def _python_sources() -> list[Path]:
    roots = [ROOT / "scripts" / "ingest", ROOT / "api" / "src" / "antenly_api" / "ingest"]
    files: list[Path] = []
    for root in roots:
        if root.is_dir():
            files.extend(path for path in root.rglob("*.py") if "tests" not in path.parts)
    for name in ("pool.py", "pool_console.py", "discover.py", "probe.py"):
        path = ROOT / "tools" / "inventory" / name
        if path.is_file():
            files.append(path)
    return files


def test_migration_ajoute_les_champs_du_catalogue_ouvert() -> None:
    sql = CHANNEL_MIGRATION.read_text(encoding="utf-8")
    for column in REQUIRED_COLUMNS:
        assert re.search(rf"ADD COLUMN\s+{column}\b", sql), column
    assert "origin IN ('catalogue', 'client')" in sql
    assert "cadence_audio_timeout_s > cadence_interval_s + cadence_window_s" in sql


def test_aucune_liste_de_chaines_en_dur() -> None:
    for path in _python_sources():
        text = path.read_text(encoding="utf-8")
        found = HARDCODED_LIST_RE.search(text)
        assert found is None, f"liste de chaînes en dur dans {path}: {found.group(1)}"
    for migration in (ROOT / "migrations").rglob("*.sql"):
        sql = migration.read_text(encoding="utf-8").upper()
        assert "INSERT INTO CHANNEL" not in sql, f"chaînes semées dans {migration}"


def _families() -> list[discover.Family]:
    radio = discover.Entry(
        name="Radio Test",
        url=RADIO_URL,
        retained=True,
        family="public-test-radio",
        source_url=RADIO_SOURCE,
        brut={"origin": RADIO_SOURCE},
    )
    tv = discover.entries_from_m3u(
        '#EXTM3U\n#EXTINF:-1 tvg-id="TvTest.sn" group-title="Senegal",TV Test\n' + TV_URL + "\n",
        source_url=TV_SOURCE,
    )
    return [
        discover.Family("public-test-radio", RADIO_SOURCE, "radio", [radio]),
        discover.Family("public-test-tv", TV_SOURCE, "tv", tv),
    ]


def test_radio_et_tv_entrent_et_sont_capturees_sans_redemarrage(tmp_path: Path) -> None:
    channels, streams = discover.aggregate(_families())
    by_type = {channel["type"]: channel for channel in channels}
    assert set(by_type) == {"radio", "tv"}
    assert by_type["radio"]["id"] and by_type["tv"]["id"]

    discover.write_csv(tmp_path, channels, streams)
    rows = pool.read_rows(tmp_path / "streams.csv")
    assert {row["origin"] for row in rows} == {"catalogue"}

    tried: list[str] = []

    def load(channel_id: str) -> tuple[list[dict], list[dict]]:
        return [row for row in rows if row["channel_id"] == channel_id], []

    def try_url(url: str, timeout_s: float) -> dict:
        tried.append(url)
        return {"ok": True}

    worker = pool.PoolWorker(load, try_url, clock=lambda: 0)
    for channel in channels:
        result = worker.cycle(channel["id"])
        assert result.status == "joignable", channel["id"]
        assert result.current_url, channel["id"]
    assert set(tried) == {RADIO_URL, TV_URL}

$ cat api/tests/ingest/test_stream_pool.py
"""ISC-12 — pool multi-URL : bascule en 10 s, URL morte retirée, 0 chaîne sans essai.

Le schéma du pool (migration 004) porte l'origine et le client, aligné sur
``tools/inventory/pool.py`` (STREAM_COLUMNS) et la console privée
(``pool_console.py``, origine « prive »). Le test injecte une URL morte
(timeout et URL invalide) dans un pool de plusieurs URL et observe la bascule
vers la suivante, la remarque datée et le retrait de la rotation.
"""

from __future__ import annotations

import re
from pathlib import Path

import pool
import pool_console

ROOT = Path(__file__).resolve().parents[3]
POOL_MIGRATION = ROOT / "migrations" / "postgres" / "004_pool_origin.sql"

A = "https://radio-a.example.invalid/a.mp3"
B = "https://radio-a.example.invalid/b.mp3"


def _rows(*urls: str) -> list[dict]:
    return [
        {"channel_id": "radio-a", "url": url, "priority": len(urls) - index, "score": 0}
        for index, url in enumerate(urls)
    ]


def test_migration_pool_ajoute_origine_et_client() -> None:
    sql = POOL_MIGRATION.read_text(encoding="utf-8")
    for column in ("origin", "client"):
        assert re.search(rf"ADD COLUMN\s+{column}\b", sql), column
    assert "origin IN ('catalogue', 'prive')" in sql
    assert "client IS NOT NULL" in sql
    assert "origin" in pool.STREAM_COLUMNS
    assert "client" in pool.STREAM_COLUMNS


def test_bascule_vers_url_suivante_en_10s_maximum() -> None:
    rows = _rows(A, B)
    clock = {"t": 0.0}

    def try_url(url: str, timeout_s: float) -> dict:
        if url == A:
            clock["t"] += timeout_s  # simule l'attente complète du timeout
            return {"ok": False, "server_fail": True, "reason": "timeout"}
        clock["t"] += 0.1
        return {"ok": True}

    worker = pool.PoolWorker(
        lambda channel_id: (rows, []),
        try_url,
        clock=lambda: clock["t"],
        timeout_s=10.0,
    )
    result = worker.cycle("radio-a")
    assert result.status == "joignable"
    assert result.current_url == B
    assert result.tried == [A, B]
    assert clock["t"] <= 10.0 + 0.1


def test_url_invalide_bascule_vers_la_suivante() -> None:
    rows = _rows(A, B)
    tried: list[str] = []

    def try_url(url: str, timeout_s: float) -> dict:
        tried.append(url)
        if url == A:
            return {"ok": False, "server_fail": True, "reason": "url invalide"}
        return {"ok": True}

    worker = pool.PoolWorker(
        lambda channel_id: (rows, []), try_url, clock=lambda: 0, timeout_s=10.0
    )
    result = worker.cycle("radio-a")
    assert result.status == "joignable"
    assert result.current_url == B
    assert tried == [A, B]


def test_url_morte_marquee_invalide_datee_et_retiree_de_la_rotation() -> None:
    rows = _rows(A, B)
    invalid: list[dict] = []
    tried: list[str] = []
    clock = {"t": 1_795_564_800.0}  # 2026-11-25T00:00:00Z

    def try_url(url: str, timeout_s: float) -> dict:
        tried.append(url)
        if url == A:
            return {"ok": False, "server_fail": True, "reason": "timeout"}
        return {"ok": True}

    worker = pool.PoolWorker(
        lambda channel_id: (rows, []),
        try_url,
        clock=lambda: clock["t"],
        on_invalid=invalid.append,
        timeout_s=10.0,
    )
    worker.cycle("radio-a")
    assert invalid == []  # un seul échec ne marque jamais une URL morte

    worker.cycle("radio-a")
    assert len(invalid) == 1
    assert invalid[0]["url"] == A
    assert invalid[0]["valid"] is False
    assert "2026-11-25" in invalid[0]["invalid_remark"]
    assert invalid[0]["invalid_remark"].strip()

    tried.clear()
    result = worker.cycle("radio-a")
    assert result.current_url == B
    assert tried == [B]  # A est sortie de la rotation


def test_aucune_chaine_laissee_sans_source_tentee() -> None:
    rows = _rows(A, B)
    tried: list[str] = []

    def try_url(url: str, timeout_s: float) -> dict:
        tried.append(url)
        return {"ok": False, "server_fail": True, "reason": "timeout"}

    worker = pool.PoolWorker(
        lambda channel_id: (rows, []), try_url, clock=lambda: 0, timeout_s=10.0
    )
    result = worker.cycle("radio-a")
    assert result.status == "non_verifiable"
    assert result.abandoned is False
    assert tried == [A, B]
    assert result.tried == [A, B]


def test_origine_privee_alignee_sur_la_console(tmp_path: Path) -> None:
    catalog = [{"channel_id": "radio-a", "url": A, "priority": 1, "score": 0}]
    console = pool_console.Console(tmp_path)
    console.add("client1", "radio-a", B, catalog)
    origins = {row["origin"] for row in console.pool_for("client1", "radio-a", catalog)}
    assert origins == {"catalogue", "prive"}

