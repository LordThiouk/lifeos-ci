import 'package:flutter_test/flutter_test.dart';
import 'package:galass_driver/core/utils/app_status.dart';
import 'package:galass_driver/data/controller/map/ride_map_controller.dart';
import 'package:galass_driver/data/controller/ride/ride_details/ride_details_controller.dart';
import 'package:galass_driver/data/model/global/ride/ride_model.dart';
import 'package:galass_driver/data/repo/polyline/polyline_repo.dart';
import 'package:galass_driver/data/repo/ride/ride_repo.dart';
import 'package:galass_driver/data/services/api_client.dart';
import 'package:get/get.dart';
import 'package:shared_preferences/shared_preferences.dart';

import '../../../../helpers/recording_api_client.dart';

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  tearDown(() {
    Get.reset();
  });

  group('RideDetailsController lifecycle (CallKit CTA)', () {
    test('showsActiveRideCtas gates only on RIDE_ACTIVE', () {
      expect(RideDetailsController.showsActiveRideCtas(AppStatus.RIDE_ACTIVE), isTrue);
      expect(RideDetailsController.showsActiveRideCtas(AppStatus.RIDE_PENDING), isFalse);
      expect(RideDetailsController.showsActiveRideCtas(AppStatus.RIDE_RUNNING), isFalse);
      expect(RideDetailsController.showsActiveRideCtas(null), isFalse);
      expect(RideDetailsController.showsActiveRideCtas(''), isFalse);
    });

    test('putFresh replaces stale singleton so CallKit open is not reused', () async {
      SharedPreferences.setMockInitialValues({});
      final prefs = await SharedPreferences.getInstance();
      final client = RecordingApiClient(sharedPreferences: prefs);
      Get.put<ApiClient>(client);
      final rideRepo = RideRepo(apiClient: client);
      final map = RideMapController(
        polylineRepo: PolylineRepo(apiClient: client),
      );

      final stale = Get.put(
        RideDetailsController(repo: rideRepo, mapController: map),
      );
      stale.ride = RideModel(id: '99', status: AppStatus.RIDE_PENDING);
      stale.isLoading = false;

      final fresh = RideDetailsController.putFresh(
        repo: rideRepo,
        mapController: map,
      );

      expect(identical(fresh, stale), isFalse);
      expect(fresh.ride.id, '-1');
      expect(fresh.isLoading, isTrue);
      expect(RideDetailsController.showsActiveRideCtas(fresh.ride.status), isFalse);
    });

    test('getRideDetails with empty rideId does not keep stale ACTIVE false forever', () async {
      SharedPreferences.setMockInitialValues({});
      final prefs = await SharedPreferences.getInstance();
      final client = RecordingApiClient(sharedPreferences: prefs);
      Get.put<ApiClient>(client);
      final rideRepo = RideRepo(apiClient: client);
      final map = RideMapController(
        polylineRepo: PolylineRepo(apiClient: client),
      );
      final controller = RideDetailsController(repo: rideRepo, mapController: map);
      controller.ride = RideModel(id: '1', status: AppStatus.RIDE_PENDING);
      controller.isLoading = false;

      await controller.getRideDetails('');

      expect(controller.isLoading, isFalse);
      // Empty id must not pretend success; status stays non-ACTIVE.
      expect(RideDetailsController.showsActiveRideCtas(controller.ride.status), isFalse);
    });
  });
}

