+# ── L7 / ISC-11 : erreur par classe et par station ───────────────────────────
+
+
+def _check_station(station: object, *, side: str) -> str:
+    if not isinstance(station, str) or not station.strip():
+        raise InvariantError(f"{side} de station invalide ({station!r})")
+    return station
+
+
+@dataclass(frozen=True, slots=True)
+class StationObservation:
+    """Un segment mesure : sa station, la classe relue et la classe predite.
+
+    Aucun tri n'est fait ici : une station vide n'existe pas (aucune observation),
+    et une classe hors enumeration est refusee AVANT tout comptage, jamais
+    convertie en `autre` pour faire passer la mesure.
+    """
+
+    station: str
+    truth: str
+    prediction: str
+
+    def __post_init__(self) -> None:
+        object.__setattr__(self, "station", _check_station(self.station, side="nom"))
+        _check_label(self.truth, side="classe de reference")
+        _check_label(self.prediction, side="classe predite")
+
+
+def _error_rate(stratum: str, reviewed: int, errors: int) -> StratumRate:
+    """Taux d'erreur d'une strate, IC Wilson 95 %, `corrected` portant `errors`.
+
+    `StratumRate` nomme `corrected` le compteur de la mesure ; pour un taux
+    d'erreur ce compteur est le nombre d'erreurs, pas le nombre de succes. Le
+    taux vaut `errors / reviewed` et l'IC est celui de Wilson sur ce meme couple,
+    jamais `1 -` un IC de rappel reconstruit apres coup.
+    """
+    if reviewed < 0 or errors < 0 or errors > reviewed:
+        raise InvariantError(
+            f"{stratum}: {errors} erreur(s) hors de [0, {reviewed}] (ISC-11)"
+        )
+    if reviewed == 0:
+        return StratumRate(stratum=stratum, reviewed=0, corrected=0)
+    low, high, half = _wilson(errors, reviewed)
+    return StratumRate(
+        stratum=stratum,
+        reviewed=reviewed,
+        corrected=errors,
+        ci_low=low,
+        ci_high=high,
+        ci_half_width=half,
+    )
+
+
+@dataclass(frozen=True, slots=True)
+class PerStationReport:
+    """Erreur par classe et par station, IC Wilson et ecart entre stations.
+
+    - `class_rates` : denominateur = segments REELS de la classe (`truth`) ;
+    - `station_rates` : denominateur = tous les segments de la station ;
+    - `station_spread` : `max - min` des taux d'erreur des stations renseignees,
+      `None` si moins de deux stations (indecidable), jamais un 0 fabrique.
+
+    Les six classes sont publiees ; seules les quatre classes PRD portent le
+    seuil FR-04 (`prd: true`). Les residuelles restent visibles hors seuil.
+    """
+
+    n: int
+    seed: int
+    stations: tuple[str, ...]
+    class_rates: dict[str, StratumRate]
+    station_rates: dict[str, StratumRate]
+    station_spread: float | None
+    highest_station: str | None
+    lowest_station: str | None
+    labels: tuple[str, ...] = CLASS_ORDER
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.n, int) or isinstance(self.n, bool) or self.n <= 0:
+            raise InvariantError(f"N du rapport par station invalide ({self.n!r})")
+        if not isinstance(self.seed, int) or isinstance(self.seed, bool):
+            raise InvariantError(f"graine du rapport par station invalide ({self.seed!r})")
+        if len(self.stations) != len(set(self.stations)):
+            raise InvariantError("rapport par station : stations dupliquees")
+        if tuple(self.class_rates) != tuple(self.labels):
+            raise InvariantError("rapport par station : classes publiees incompletes")
+        if set(self.station_rates) != set(self.stations):
+            raise InvariantError("rapport par station : stations publiees incoherentes")
+        if sum(rate.reviewed for rate in self.class_rates.values()) != self.n:
+            raise InvariantError(
+                "rapport par station : les classes ne couvrent pas le N publie"
+            )
+        if sum(rate.reviewed for rate in self.station_rates.values()) != self.n:
+            raise InvariantError(
+                "rapport par station : les stations ne couvrent pas le N publie"
+            )
+        for rate in (*self.class_rates.values(), *self.station_rates.values()):
+            _validate_error_rate(rate)
+        if len(self.stations) < 2:
+            if self.station_spread is not None:
+                raise InvariantError("rapport par station : ecart publie sur moins de 2 stations")
+            return
+        if self.station_spread is None:
+            return
+        rates = {name: rate.rate for name, rate in self.station_rates.items()}
+        populated = {name: value for name, value in rates.items() if value is not None}
+        if len(populated) < 2:
+            raise InvariantError("rapport par station : ecart publie sans deux stations renseignees")
+        expected_high = max(populated, key=lambda name: (populated[name], name))
+        expected_low = min(populated, key=lambda name: (populated[name], name))
+        expected = populated[expected_high] - populated[expected_low]
+        if self.station_spread != expected:
+            raise InvariantError(
+                f"rapport par station : ecart {self.station_spread!r} != {expected!r}"
+            )
+        if (self.highest_station, self.lowest_station) != (expected_high, expected_low):
+            raise InvariantError("rapport par station : stations extremes incoherentes")
+
+    @property
+    def prd_class_rates(self) -> dict[str, StratumRate]:
+        return {
+            name: rate for name, rate in self.class_rates.items() if name in PRD_CLASS_NAMES
+        }
+
+    @property
+    def max_class_error_rate(self) -> float | None:
+        """Pire taux d'erreur des quatre classes PRD (residuelles exclues)."""
+        values = [rate.rate for rate in self.prd_class_rates.values() if rate.rate is not None]
+        return max(values) if values else None
+
+    def payload(self) -> dict[str, object]:
+        return {
+            "schema": STATION_REPORT_SCHEMA,
+            "n": self.n,
+            "seed": self.seed,
+            "stations": list(self.stations),
+            "classes": {
+                name: _error_rate_payload(rate, prd=name in PRD_CLASS_NAMES)
+                for name, rate in self.class_rates.items()
+            },
+            "by_station": {
+                name: _error_rate_payload(rate, prd=False)
+                for name, rate in self.station_rates.items()
+            },
+            "station_spread": self.station_spread,
+            "highest_station": self.highest_station,
+            "lowest_station": self.lowest_station,
+            "max_class_error_rate": self.max_class_error_rate,
+            "thresholds": {
+                "max_class_error_rate": MAX_CLASS_ERROR_RATE,
+                "max_station_spread": MAX_STATION_SPREAD,
+                "ci_half_width_target": CI_HALF_WIDTH_TARGET,
+                "source": ISC11_THRESHOLD_SOURCE,
+                "applied": False,
+                "status": "provisional_not_frozen",
+            },
+        }
+
+    def to_json(self) -> str:
+        return (
+            json.dumps(
+                self.payload(),
+                ensure_ascii=False,
+                sort_keys=True,
+                separators=(",", ":"),
+            )
+            + "\n"
+        )
+
+
+def _validate_error_rate(rate: StratumRate) -> None:
+    if rate.reviewed == 0:
+        if rate.rate is not None or rate.ci_low is not None:
+            raise InvariantError(f"{rate.stratum}: strate vide avec un taux publie")
+        return
+    if rate.rate is None or rate.rate != rate.corrected / rate.reviewed:
+        raise InvariantError(f"{rate.stratum}: taux d'erreur incoherent")
+    if rate.ci_low is None or rate.ci_high is None or rate.ci_half_width is None:
+        raise InvariantError(f"{rate.stratum}: IC Wilson manquant")
+    if not (0.0 <= rate.ci_low <= rate.rate <= rate.ci_high <= 1.0):
+        raise InvariantError(f"{rate.stratum}: IC Wilson incoherent avec le taux")
+
+
+def _error_rate_payload(rate: StratumRate, *, prd: bool) -> dict[str, object]:
+    return {
+        "n": rate.reviewed,
+        "errors": rate.corrected,
+        "error_rate": rate.rate,
+        "ci_low": rate.ci_low,
+        "ci_high": rate.ci_high,
+        "ci_half_width": rate.ci_half_width,
+        "prd": prd,
+    }
+
+
+def evaluate_per_station(
+    observations: Iterable[StationObservation],
+    *,
+    seed: int,
+) -> PerStationReport:
+    """Mesure l'erreur par classe et par station ; refuse un ensemble vide.
+
+    Une observation = `(station, verite, prediction)`. Le denominateur d'une
+    classe est le nombre de verites de cette classe ; celui d'une station est le
+    nombre d'observations de cette station. Aucun plancher de 30 segments : une
+    classe ou une station a petit N publie son N et son IC, elle n'est jamais
+    masquee (decision Papa du 2026-11-24 01:13).
+    """
+    measured = list(observations)
+    if not measured:
+        raise NoObservationError(
+            "0 observation (station, verite, prediction) : aucun taux d'erreur "
+            "mesurable, jamais un vert sur ensemble vide"
+        )
+    class_counts: dict[str, list[int]] = {name: [0, 0] for name in CLASS_ORDER}
+    station_counts: dict[str, list[int]] = {}
+    for observation in measured:
+        if not isinstance(observation, StationObservation):
+            raise InvariantError(f"observation par station invalide ({observation!r})")
+        class_bucket = class_counts[observation.truth]
+        class_bucket[0] += 1
+        station_bucket = station_counts.setdefault(observation.station, [0, 0])
+        station_bucket[0] += 1
+        if observation.prediction != observation.truth:
+            class_bucket[1] += 1
+            station_bucket[1] += 1
+
+    class_rates = {
+        name: _error_rate(name, counts[0], counts[1]) for name, counts in class_counts.items()
+    }
+    station_rates = {
+        station: _error_rate(station, counts[0], counts[1])
+        for station, counts in sorted(station_counts.items())
+    }
+    populated = {
+        station: rate.rate
+        for station, rate in station_rates.items()
+        if rate.rate is not None
+    }
+    if len(populated) > 1:
+        highest = max(populated, key=lambda name: (populated[name], name))
+        lowest = min(populated, key=lambda name: (populated[name], name))
+        spread = populated[highest] - populated[lowest]
+    else:
+        highest = lowest = spread = None
+
+    return PerStationReport(
+        n=len(measured),
+        seed=seed,
+        stations=tuple(station_rates),
+        class_rates=class_rates,
+        station_rates=station_rates,
+        station_spread=spread,
+        highest_station=highest,
+        lowest_station=lowest,
+        labels=CLASS_ORDER,
+    )
