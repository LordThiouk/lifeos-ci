"""CLI du banc de mesure FR-04 (lot L2) : split gele et rappel par classe.

Usage minimal :

    uv run python -m antenly_api.eval.segmentation --split=test --per-class

Sans `--predictions`, le banc mesure la PRE-ANNOTATION du split (`source_class`)
comme predicteur de reference interne. Ce n'est PAS le segmenteur baseline (lot
L3, tache T3.1) et aucun seuil d'ISC n'est coche ici : le banc publie la matrice
de confusion, le rappel par classe, N et l'IC Wilson 95 %. Le seuil de 85 %
d'ISC-3 sera applique quand le segmenteur existera.

Avec `--predictions`, le fichier JSON associe un id de segment a sa classe
predite (`{"segments": {"seg-000011": "parole", ...}}` ou directement l'objet
`{"seg-000011": "parole", ...}`). Toute couverture partielle est refusee : un
segment du split sans prediction ne doit pas disparaitre du denominateur.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from collections.abc import Mapping
from pathlib import Path
from typing import Any

from ..annotation.models import InvariantError, NoObservationError
from .boundaries import BoundaryP95Report, load_boundary_p95
from .metrics import PerClassReport, evaluate_per_class
from .split import DEFAULT_FROZEN_MANIFEST, FrozenSplit, load_frozen_split

SEGMENTATION_SCHEMA = "eval-segmentation-v1"
PREDICTOR_SOURCE = "source_class"


def _prediction_mapping(payload: Any) -> dict[str, str]:
    if isinstance(payload, Mapping) and "segments" in payload:
        payload = payload["segments"]
    if isinstance(payload, Mapping):
        mapping = dict(payload)
    elif isinstance(payload, list):
        mapping = {}
        for item in payload:
            if not isinstance(item, Mapping):
                raise InvariantError(f"prediction non objet ({item!r})")
            segment_id = item.get("id")
            label = item.get("classe", item.get("class", item.get("prediction")))
            if segment_id in mapping:
                raise InvariantError(f"prediction dupliquee : {segment_id}")
            mapping[segment_id] = label
    else:
        raise InvariantError(
            "predictions : attendu un objet {id: classe}, un objet {segments: ...} "
            "ou une liste de {id, classe}"
        )
    return {
        str(segment_id): label
        for segment_id, label in mapping.items()
    }


def load_predictions(path: Path | str, split: FrozenSplit) -> dict[str, str]:
    """Charge les predictions et exige une couverture EXACTE du split.

    Un id manquant est un refus (il disparaitrait du denominateur) ; un id hors
    split est un refus (il n'appartient pas au perimetre gele).
    """
    try:
        payload = json.loads(Path(path).read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise InvariantError(f"predictions JSON illisibles : {exc}") from exc
    predictions = _prediction_mapping(payload)
    expected = {segment.id for segment in split.segments}
    missing = sorted(expected - set(predictions))
    extra = sorted(set(predictions) - expected)
    if missing:
        raise InvariantError(
            f"predictions incompletes : {len(missing)} segment(s) sans prediction "
            f"({missing[:5]})"
        )
    if extra:
        raise InvariantError(
            f"predictions hors split : {len(extra)} id(s) inconnus ({extra[:5]})"
        )
    return predictions


def evaluate(
    split: FrozenSplit,
    predictions: Mapping[str, str] | None = None,
) -> PerClassReport:
    """Mesure les predictions contre la verite du split ; source_class par defaut."""
    if predictions is None:
        pairs = [(segment.truth, segment.source) for segment in split.segments]
    else:
        pairs = [(segment.truth, predictions[segment.id]) for segment in split.segments]
    return evaluate_per_class(pairs)


def _predictions_sha256(split: FrozenSplit, predictions: Mapping[str, str]) -> str:
    ordered = {segment.id: predictions[segment.id] for segment in split.segments}
    blob = json.dumps(ordered, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def report_payload(
    split: FrozenSplit,
    report: PerClassReport,
    *,
    predictor: str,
    predictions: Mapping[str, str] | None = None,
) -> dict[str, object]:
    payload: dict[str, object] = {
        "schema": SEGMENTATION_SCHEMA,
        "predictor": predictor,
        "split": {
            "corpus_version": split.corpus_version,
            "seed": split.seed,
            "procedure_version": split.procedure_version,
            "manifest_sha256": split.manifest_sha256,
            "split_sha256": split.split_sha256(),
            "n": split.n,
        },
        "per_class": report.payload(),
    }
    if predictions is not None:
        payload["predictions_sha256"] = _predictions_sha256(split, predictions)
    return payload


def _report_lines(split: FrozenSplit, report: PerClassReport, predictor: str) -> list[str]:
    lines = [
        (
            f"banc FR-04 : {split.n} segments du split gele {split.corpus_version} "
            f"(graine {split.seed}, predicteur {predictor})"
        )
    ]
    for name, rate in report.class_rates.items():
        interval = (
            f" IC 95 % [{rate.ci_low:.4f}, {rate.ci_high:.4f}]"
            if rate.ci_low is not None and rate.ci_high is not None
            else ""
        )
        recall = "n/a" if rate.rate is None else f"{100.0 * rate.rate:.2f} %"
        marker = "" if name in report.prd_rates else " (residuelle, hors seuil FR-04)"
        lines.append(f"  {name} : {rate.corrected} / {rate.reviewed} = {recall}{interval}{marker}")
    lines.append("  matrice de confusion (verite -> prediction) :")
    for truth in report.labels:
        row = report.confusion[truth]
        cells = ", ".join(f"{prediction}={count}" for prediction, count in row.items() if count)
        lines.append(f"    {truth} : {cells or '0'}")
    return lines


def _boundary_lines(report: BoundaryP95Report) -> list[str]:
    start_moved = (
        "n/a" if report.p95_start_ms_moved_only is None else f"{report.p95_start_ms_moved_only} ms"
    )
    end_moved = (
        "n/a" if report.p95_end_ms_moved_only is None else f"{report.p95_end_ms_moved_only} ms"
    )
    lines = [
        (
            f"banc FR-04 frontieres : {report.n_reviewed} segments relus "
            "(P95 sur tous, y compris inchanges)"
        ),
        (
            f"  P95 debut {report.p95_start_ms} ms (deplaces seuls : {start_moved}) ; "
            f"seuil {report.thresholds.p95_start_ms} ms"
        ),
        (
            f"  P95 fin {report.p95_end_ms} ms (deplaces seuls : {end_moved}) ; "
            f"seuil {report.thresholds.p95_end_ms} ms"
        ),
    ]
    lines.extend(f"  {violation}" for violation in report.boundary_violations())
    return lines


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="antenly_api.eval.segmentation",
        description="Banc de mesure FR-04 : matrice de confusion, rappel et frontieres (L2/L6).",
    )
    parser.add_argument(
        "--split",
        choices=("test",),
        default="test",
        help="split a mesurer (seul le split de test gele existe en v1)",
    )
    parser.add_argument(
        "--manifest",
        type=Path,
        default=None,
        help=f"manifeste gele (defaut : {DEFAULT_FROZEN_MANIFEST})",
    )
    parser.add_argument(
        "--predictions",
        type=Path,
        default=None,
        help=(
            "JSON {id: classe} ; sans ce fichier, la pre-annotation source_class "
            "sert de predicteur de reference interne"
        ),
    )
    parser.add_argument(
        "--per-class",
        action="store_true",
        help="rapport par classe (comportement par defaut du banc L2)",
    )
    parser.add_argument(
        "--boundary-p95",
        action="store_true",
        help="P95 des deplacements de start_ms et end_ms sur tous les segments relus",
    )
    parser.add_argument("--json", action="store_true", help="rapport JSON sur stdout")
    parser.add_argument("--out", type=Path, default=None, help="ecrit le rapport JSON dans ce fichier")
    args = parser.parse_args(argv)

    manifest = args.manifest or DEFAULT_FROZEN_MANIFEST
    per_class_requested = args.per_class or not args.boundary_p95

    boundary_report: BoundaryP95Report | None = None
    split: FrozenSplit | None = None
    report: PerClassReport | None = None
    predictions: Mapping[str, str] | None = None
    predictor = PREDICTOR_SOURCE

    try:
        if args.boundary_p95:
            boundary_report = load_boundary_p95(manifest)
        if per_class_requested:
            split = load_frozen_split(manifest)
            if args.predictions is None:
                predictions = None
                predictor = PREDICTOR_SOURCE
            else:
                predictions = load_predictions(args.predictions, split)
                predictor = str(args.predictions)
            report = evaluate(split, predictions)
    except NoObservationError as exc:
        print(f"FAIL banc FR-04 : {exc}", file=sys.stderr)
        return 2
    except (InvariantError, ValueError, KeyError, TypeError, OSError) as exc:
        print(f"FAIL entree inexploitable : {exc}", file=sys.stderr)
        return 2

    if per_class_requested:
        # Les deux branches sont construites dans le try ci-dessus : le typage
        # local ne suffit pas a prouver qu'elles sont non nulles ici.
        payload = report_payload(
            split,
            report,
            predictor=predictor,
            predictions=predictions,
        )
        if boundary_report is not None:
            payload["boundary_p95"] = boundary_report.payload()
    else:
        payload = boundary_report.payload() if boundary_report is not None else {}
    if args.out is not None:
        args.out.write_text(
            json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n",
            encoding="utf-8",
        )
    if args.json:
        print(json.dumps(payload, ensure_ascii=False, indent=2, sort_keys=True))
    else:
        if per_class_requested:
            for line in _report_lines(split, report, predictor):
                print(line)
        if boundary_report is not None:
            for line in _boundary_lines(boundary_report):
                print(line)
    if boundary_report is not None and boundary_report.boundary_violations():
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

