+@dataclass(frozen=True, slots=True)
+class HeldOutControl:
+    """Preuve que le split mesure est TENU A L'ECART (ISC-11, L7).
+
+    Deux proprietes, publiees et non supposees :
+
+    - la graine du split est celle du contrat de tirage (`sampling.SEED`) et elle
+      est ecrite : sans graine ecrite, le split n'est pas rejouable ;
+    - aucun id du split de test n'apparait dans l'ensemble d'entrainement
+      declare. Un entrainement non declare (`n_training == 0`) est le cas du
+      baseline inaSpeechSegmenter, qui n'apprend rien sur ce corpus : le controle
+      le rend explicite au lieu de le laisser croire.
+
+    Un chevauchement n'est jamais repare en silence : `held_out_control` refuse
+    (`InvariantError`) et nomme les ids communs.
+    """
+
+    seed: int
+    seed_written: bool
+    manifest_sha256: str
+    split_sha256: str
+    n_test: int
+    n_training: int
+    overlap: tuple[str, ...]
+
+    @property
+    def disjoint(self) -> bool:
+        return not self.overlap
+
+    def payload(self) -> dict[str, object]:
+        return {
+            "seed": self.seed,
+            "seed_written": self.seed_written,
+            "manifest_sha256": self.manifest_sha256,
+            "split_sha256": self.split_sha256,
+            "n_test": self.n_test,
+            "n_training": self.n_training,
+            "overlap": list(self.overlap),
+            "disjoint": self.disjoint,
+        }
+
+
+def held_out_control(
+    split: FrozenSplit,
+    *,
+    training_ids: Iterable[str] = (),
+) -> HeldOutControl:
+    """Controle le split tenu a l'ecart ; refuse tout id de test dans l'entrainement.
+
+    `training_ids` est l'ensemble declare des segments vus a l'entrainement. Il
+    est vide quand le predicteur n'apprend rien sur ce corpus (baseline) : le
+    rapport publie alors `n_training = 0` au lieu de pretendre a une separation
+    qui n'a pas ete verifiee. Une graine differente de `sampling.SEED` est un
+    refus nomme : ce n'est plus le split du contrat de tirage.
+    """
+    if not isinstance(split, FrozenSplit):
+        raise InvariantError(f"controle du split : objet inattendu ({type(split).__name__})")
+    if split.seed != SEED:
+        raise InvariantError(
+            f"controle du split : graine {split.seed} != {SEED} (graine du contrat non ecrite)"
+        )
+    training = [str(segment_id) for segment_id in training_ids]
+    if len(training) != len(set(training)):
+        raise InvariantError("controle du split : training_ids contient des doublons")
+    test_ids = {segment.id for segment in split.segments}
+    overlap = tuple(sorted(test_ids & set(training)))
+    if overlap:
+        raise InvariantError(
+            f"split tenu a l'ecart viole : {len(overlap)} segment(s) de test dans "
+            f"l'entrainement ({list(overlap[:5])})"
+        )
+    return HeldOutControl(
+        seed=split.seed,
+        seed_written=True,
+        manifest_sha256=split.manifest_sha256,
+        split_sha256=split.split_sha256(),
+        n_test=len(test_ids),
+        n_training=len(training),
+        overlap=overlap,
+    )
+
+
