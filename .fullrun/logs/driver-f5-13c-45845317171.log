  // Documented gap between 1.6.21 and 1.7.0.
  if (isWithinVersionRange(kgpV, min: '1.6.20', max: '1.7.20', inclusiveMax: false)) {
    return isWithinVersionRange(agpV, min: '3.4.3', max: '7.0.2');
  }

