    return isWithinVersionRange(agpV, min: '4.1.3', max: '7.4.0');
  }
  // Documented max is 1.8.11
  if (isWithinVersionRange(kgpV, min: '1.8.0', max: '1.8.20', inclusiveMax: false)) {
    return isWithinVersionRange(agpV, min: '4.1.3', max: '7.2.1');
