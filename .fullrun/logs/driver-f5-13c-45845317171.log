  // Documented max is 1.7.22
  if (isWithinVersionRange(kgpV, min: '1.7.20', max: '1.8.0', inclusiveMax: false)) {
    return isWithinVersionRange(agpV, min: '3.6.4', max: '7.0.4');
  }
