// Golden harness for Galass Rider UI regression capture.
//
// Design decisions (see test/goldens/rider/README.md and the ISA):
//   * No third-party golden package. `golden_toolkit` is unmaintained and its
//     `loadAppFonts` only wraps the same `FontLoader` calls used here; the
//     capture itself is pure `flutter_test` (`matchesGoldenFile`), which
//     compares byte-exact decoded pixels through `LocalFileComparator`: any
//     single differing pixel fails the test. There is no tolerance knob.
//   * Fixed device: 390x844 logical px at DPR 2.0, text scale 1.0, locale
//     fr_SN. No MediaQuery inheritance from the host: the surface is rebuilt
//     from constants so a capture cannot drift with the machine running it.
//   * Fonts come from `assets/fonts/` (Satoshi) plus the Material/Cupertino
//     icon fonts: a capture never falls back to a host system font.
//   * Test data lives in `golden_fixtures.dart`, is fully synthetic and has no
//     real ride id, driver phone or coordinate from production.
import 'dart:async';
import 'dart:io';

import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:get/get.dart';
import 'package:galassrider/core/utils/style.dart';

/// Capture surface, in logical pixels — the Pixel-class device the e2e emulator
/// runs on (`412 x 915`), so goldens and e2e captures frame the same viewport.
/// Not `390 x 844` : at 390 the pre-existing pickup-notes tile overflows by
/// 7.2 px (`ride_details_bottom_sheet_widget.dart` Row, fixed by ISC-F4-25),
/// which would bake overflow stripes into the baseline.
const Size kGoldenSurface = Size(412, 915);

/// Device pixel ratio baked into every golden.
const double kGoldenDevicePixelRatio = 2.0;

/// Locale of the capture (the app ships fr_SN by default).
const Locale kGoldenLocale = Locale('fr', 'SN');

const Map<String, List<String>> _satoshiWeights = <String, List<String>>{
  'Satoshi': <String>[
    'assets/fonts/Satoshi-Light.otf',
    'assets/fonts/Satoshi-LightItalic.otf',
    'assets/fonts/Satoshi-Regular.otf',
    'assets/fonts/Satoshi-Italic.otf',
    'assets/fonts/Satoshi-Medium.otf',
    'assets/fonts/Satoshi-MediumItalic.otf',
    'assets/fonts/Satoshi-Bold.otf',
    'assets/fonts/Satoshi-BoldItalic.otf',
    'assets/fonts/Satoshi-Black.otf',
    'assets/fonts/Satoshi-BlackItalic.otf',
  ],
};

bool _platformStubsInstalled = false;

/// Stubs the two platform channels every image widget touches, and makes every
/// HTTP image request return the same 1x1 PNG. Without this a capture would
/// depend on the host (path_provider is unavailable in a widget test and the
/// network is real).
void installGoldenPlatformStubs() {
  if (_platformStubsInstalled) return;
  final messenger =
      TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger;
  for (final channel in <String>[
    'plugins.flutter.io/path_provider',
    'plugins.flutter.io/path_provider_android',
  ]) {
    messenger.setMockMethodCallHandler(MethodChannel(channel), (call) async {
      return '/tmp/golden-cache';
    });
  }
  HttpOverrides.global = _GoldenHttpOverrides();
  _platformStubsInstalled = true;
}

class _GoldenHttpOverrides extends HttpOverrides {
  @override
  HttpClient createHttpClient(SecurityContext? context) => _GoldenHttpClient();
}

/// Minimal 1x1 transparent PNG returned for every image URL.
final Uint8List _goldenPngBytes = Uint8List.fromList(<int>[
  0x89, 0x50, 0x4E, 0x47, 0x0D, 0x0A, 0x1A, 0x0A, 0x00, 0x00, 0x00, 0x0D,
  0x49, 0x48, 0x44, 0x52, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x01,
  0x08, 0x06, 0x00, 0x00, 0x00, 0x1F, 0x15, 0xC4, 0x89, 0x00, 0x00, 0x00,
  0x0A, 0x49, 0x44, 0x41, 0x54, 0x78, 0x9C, 0x63, 0x00, 0x01, 0x00, 0x00,
  0x05, 0x00, 0x01, 0x0D, 0x0A, 0x2D, 0xB4, 0x00, 0x00, 0x00, 0x00, 0x49,
  0x45, 0x4E, 0x44, 0xAE, 0x42, 0x60, 0x82,
]);

class _GoldenHttpClient implements HttpClient {
  @override
  bool autoUncompress = true;
  @override
  Duration? connectionTimeout;
  @override
  Duration idleTimeout = const Duration(seconds: 1);
  @override
  int? maxConnectionsPerHost;
  @override
  String? userAgent;

  @override
  Future<HttpClientRequest> openUrl(String method, Uri url) async =>
      _GoldenHttpRequest(url, _goldenPngBytes);

  @override
  Future<HttpClientRequest> getUrl(Uri url) => openUrl('get', url);

  @override
  Future<HttpClientRequest> postUrl(Uri url) => openUrl('post', url);

  @override
  Future<HttpClientRequest> putUrl(Uri url) => openUrl('put', url);

  @override
  Future<HttpClientRequest> deleteUrl(Uri url) => openUrl('delete', url);

  @override
  Future<HttpClientRequest> patchUrl(Uri url) => openUrl('patch', url);

  @override
  Future<HttpClientRequest> headUrl(Uri url) => openUrl('head', url);

  @override
  void close({bool force = false}) {}

  @override
  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
}

class _GoldenHttpRequest implements HttpClientRequest {
  _GoldenHttpRequest(this.uri, this._bytes);

  @override
  final Uri uri;
  final Uint8List _bytes;

  @override
  final HttpHeaders headers = _GoldenHttpHeaders();

  @override
  Future<HttpClientResponse> close() async => _GoldenHttpResponse(_bytes);

  @override
  Future<HttpClientResponse> get done async => _GoldenHttpResponse(_bytes);

  @override
  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
}

class _GoldenHttpResponse extends Stream<List<int>> implements HttpClientResponse {
  _GoldenHttpResponse(this._bytes);

  final Uint8List _bytes;

  @override
  int get statusCode => HttpStatus.ok;

  @override
  int get contentLength => _bytes.length;

  @override
  HttpHeaders get headers => _GoldenHttpHeaders();

  @override
  HttpClientResponseCompressionState get compressionState =>
      HttpClientResponseCompressionState.notCompressed;

  @override
  StreamSubscription<List<int>> listen(
    void Function(List<int> event)? onData, {
    Function? onError,
    void Function()? onDone,
    bool? cancelOnError,
  }) =>
      Stream<List<int>>.value(_bytes).listen(
        onData,
        onError: onError,
        onDone: onDone,
        cancelOnError: cancelOnError,
      );

  @override
  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
}

class _GoldenHttpHeaders implements HttpHeaders {
  @override
  dynamic noSuchMethod(Invocation invocation) => null;
}

bool _fontsLoaded = false;

/// Loads the real app fonts into the test engine. Without this a capture would
/// render with the test font and would not match the shipped UI.
Future<void> loadGoldenFonts() async {
  if (_fontsLoaded) return;
  TestWidgetsFlutterBinding.ensureInitialized();
  installGoldenPlatformStubs();

  for (final entry in _satoshiWeights.entries) {
    final loader = FontLoader(entry.key);
    var added = 0;
    for (final asset in entry.value) {
      final data = await _tryLoadAsset(asset);
      if (data == null) continue;
      loader.addFont(Future<ByteData>.value(data));
      added++;
    }
    if (added > 0) {
      await loader.load();
    }
  }

  // Icon fonts: without them every `Icon` renders as an empty box.
  for (final entry in <String, List<String>>{
    'MaterialIcons': <String>['fonts/MaterialIcons-Regular.otf'],
    'CupertinoIcons': <String>['packages/cupertino_icons/assets/CupertinoIcons.ttf'],
  }.entries) {
    final loader = FontLoader(entry.key);
    var added = 0;
    for (final asset in entry.value) {
      final data = await _tryLoadAsset(asset);
      if (data == null) continue;
      loader.addFont(Future<ByteData>.value(data));
      added++;
    }
    if (added > 0) {
      await loader.load();
    }
  }

  _fontsLoaded = true;
}

Future<ByteData?> _tryLoadAsset(String key) async {
  try {
    return await rootBundle.load(key);
  } catch (_) {
    return null;
  }
}

/// Pumps [child] on the fixed golden surface and captures it to [goldenPath]
/// (relative to this test file).
///
/// [settle] runs extra pumps after the first frame; screens with repeating
/// animations (the searching-for-driver car) must use a bounded number of
/// pumps instead of `pumpAndSettle`, which never returns on `repeat()`.
Future<void> expectGolden(
  WidgetTester tester,
  Widget child,
  String goldenPath, {
  int extraPumps = 2,
  Duration pumpStep = const Duration(milliseconds: 100),
}) async {
  await loadGoldenFonts();
  await pumpGoldenSurface(tester, child, extraPumps: extraPumps, pumpStep: pumpStep);
  await expectLater(find.byType(MaterialApp), matchesGoldenFile(goldenPath));
}

/// Captures the already-pumped tree (assertions first, capture last).
Future<void> captureGolden(WidgetTester tester, String goldenPath) async {
  await expectLater(find.byType(MaterialApp), matchesGoldenFile(goldenPath));
}

/// Pumps [child] on the fixed surface without capturing (probe helper).
Future<void> pumpGoldenSurface(
  WidgetTester tester,
  Widget child, {
  int extraPumps = 2,
  Duration pumpStep = const Duration(milliseconds: 100),
}) async {
  tester.view.devicePixelRatio = kGoldenDevicePixelRatio;
  tester.view.physicalSize = Size(
    kGoldenSurface.width * kGoldenDevicePixelRatio,
    kGoldenSurface.height * kGoldenDevicePixelRatio,
  );
  addTearDown(tester.view.resetPhysicalSize);
  addTearDown(tester.view.resetDevicePixelRatio);
  await tester.pumpWidget(
    MaterialApp(
      debugShowCheckedModeBanner: false,
      locale: kGoldenLocale,
      theme: ThemeData(fontFamily: fontName),
      home: MediaQuery(
        data: const MediaQueryData(
          size: kGoldenSurface,
          devicePixelRatio: kGoldenDevicePixelRatio,
          textScaler: TextScaler.noScaling,
        ),
        child: child,
      ),
    ),
  );
  await tester.pump();
  for (var i = 0; i < extraPumps; i++) {
    await tester.pump(pumpStep);
  }
}

/// Pumps [child] inside a `GetMaterialApp` (widgets that need GetX routing or
/// `.tr` translations) on the same fixed surface.
Future<void> expectGoldenGet(
  WidgetTester tester,
  Widget child,
  String goldenPath, {
  int extraPumps = 2,
  Duration pumpStep = const Duration(milliseconds: 100),
}) async {
  await loadGoldenFonts();
  tester.view.devicePixelRatio = kGoldenDevicePixelRatio;
  tester.view.physicalSize = Size(
    kGoldenSurface.width * kGoldenDevicePixelRatio,
    kGoldenSurface.height * kGoldenDevicePixelRatio,
  );
  addTearDown(tester.view.resetPhysicalSize);
  addTearDown(tester.view.resetDevicePixelRatio);
  await tester.pumpWidget(
    GetMaterialApp(
      debugShowCheckedModeBanner: false,
      locale: kGoldenLocale,
      theme: ThemeData(fontFamily: fontName),
      home: MediaQuery(
        data: const MediaQueryData(
          size: kGoldenSurface,
          devicePixelRatio: kGoldenDevicePixelRatio,
          textScaler: TextScaler.noScaling,
        ),
        child: child,
      ),
    ),
  );
  await tester.pump();
  for (var i = 0; i < extraPumps; i++) {
    await tester.pump(pumpStep);
  }
  await expectLater(find.byType(GetMaterialApp), matchesGoldenFile(goldenPath));
}
