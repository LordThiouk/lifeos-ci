export function headShort(isaPath: string): string | null {
  const r = git(dirname(isaPath), ["rev-parse", "--short=7", "HEAD"]);
  const out = r.out.trim();
  return r.rc === 0 && /^[0-9a-f]{7,40}$/.test(out) ? out : null;
}

