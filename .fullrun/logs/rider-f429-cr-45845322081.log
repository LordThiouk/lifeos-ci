          lb=""; [ -n "$log_sha" ] && lb=" → branche \`$LOGB\` (antenly, à supprimer après lecture)"
          echo "- Journal opencode privé : ${log_state}${lb}" >> "$GITHUB_STEP_SUMMARY"
          echo "Contrôles OK : $(git rev-list --count "$BASE_SHA..HEAD") commit(s) à pousser ; journal ${log_state}"

      # Seul l'archive chiffrée sort du runner : le journal en clair ne quitte jamais la machine.
      # Publier même quand le step de contrôle a échoué (c'est justement le cas qui la produit).
      - name: Publier le journal chiffré (artefact 7 jours)
        if: always() && steps.check.outputs.artifact != ''
        uses: actions/upload-artifact@v4
        with:
          name: ${{ steps.check.outputs.artifact }}
          path: ${{ runner.temp }}/fullrun-artifact/${{ steps.check.outputs.artifact }}
          retention-days: 7
          if-no-files-found: error
          overwrite: true

      - name: Publier les journaux internes chiffrés (artefact 7 jours)
        if: always() && steps.check.outputs.meta_artifact != ''
        uses: actions/upload-artifact@v4
        with:
          name: ${{ steps.check.outputs.meta_artifact }}
          path: ${{ runner.temp }}/fullrun-artifact/${{ steps.check.outputs.meta_artifact }}
          retention-days: 7
          if-no-files-found: error
          overwrite: true

      - name: Push sur la branche de fonctionnalité (jamais main, jamais force) et journal à part
        id: push
        if: always() && steps.check.outcome == 'success'
        env:
          PUSH_TOKEN: ${{ secrets.ANTENLY_PUSH_TOKEN }}
          HEAD_SHA: ${{ steps.check.outputs.head }}
          WIP_PUSHED: ${{ steps.check.outputs.wip_pushed }}
          LOG_SHA: ${{ steps.check.outputs.log_sha }}
          IN_BRANCH: ${{ inputs.branch }}
          IN_JOB: ${{ inputs.job_name }}
          RUN_ID: ${{ github.run_id }}
          ANTENLY_DIR: ${{ github.workspace }}/antenly
          BASH_ENV: ""
          ENV: ""
          LD_PRELOAD: ""
          LD_LIBRARY_PATH: ""
          GIT_CONFIG_GLOBAL: /dev/null
          GIT_CONFIG_NOSYSTEM: "1"
        run: |
          set +x
          export PATH=/usr/bin:/bin
          # Liste blanche figée hors du cwd : le push ne source jamais le checkout ci/.
          T=/opt/fullrun-tools
          # shellcheck disable=SC1091
          . "$T/allowed-repos.sh"
          # Mêmes règles que la garde d'entrée, revérifiées ici (la valeur vient de l'entrée, pas de $GITHUB_ENV).
          [[ "$IN_BRANCH" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$ ]] || { echo "::error::branche invalide : push refusé"; exit 1; }
          case "${IN_BRANCH,,}" in
            main|master|head|refs/*|*..*|*/|*.lock|fullrun-logs/*|fullrun-prompts|fullrun-prompts/*) echo "::error::branche interdite : push refusé"; exit 1 ;;
          esac
          [[ "$IN_JOB" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ && "$RUN_ID" =~ ^[0-9]{1,20}$ ]] || { echo "::error::job ou run invalide : push refusé"; exit 1; }
          LOGB="fullrun-logs/${IN_JOB}-${RUN_ID}"
          [[ "$HEAD_SHA" =~ ^[0-9a-f]{40}$ ]] || { echo "::error::SHA contrôlé absent : push refusé"; exit 1; }
          [ -n "${PUSH_TOKEN:-}" ] || { echo "::error::secret ANTENLY_PUSH_TOKEN absent (acte Papa requis)"; exit 1; }
          # Push depuis un dépôt nu neuf : ni .git/config ni ~/.gitconfig (écrits par l'IA) ne s'appliquent.
          B="$RUNNER_TEMP/push.git"; rm -rf "$B"
          env -u PUSH_TOKEN git init -q --bare "$B"
          # copie <branche> <sha contrôlé>
          copie() {
            env -u PUSH_TOKEN git -C "$B" -c protocol.file.allow=always fetch -q --no-tags \
              "file://$ANTENLY_DIR" "+refs/heads/$1:refs/heads/$1" >/dev/null 2>&1 \
              && [ "$(git -C "$B" rev-parse "refs/heads/$1")" = "$2" ]
          }
          auth=$(printf 'x-access-token:[REDACTED]' "$PUSH_TOKEN" | base64 -w0)
          echo "::add-mask::$auth"
          # pousse <sha> <branche> : en-tête passé par l'environnement de git seul (pas en argument
          # visible dans ps), env vidé des proxys / GIT_* qu'opencode aurait pu poser ; jamais de force.
          pousse() {
            env -i PATH=/usr/bin:/bin HOME="$RUNNER_TEMP" GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
              GIT_TERMINAL_PROMPT=0 GIT_CONFIG_COUNT=2 \
              GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null \
              GIT_CONFIG_KEY_1=http.https://github.com/.extraheader GIT_CONFIG_VALUE_1="AUTHORIZATION: basic $auth" \
              /usr/bin/git -C "$B" push --no-verify --porcelain "https://github.com/LordThiouk/antenly.git" \
              "$1:refs/heads/$2" >/dev/null 2>&1
          }
          work=0
          if [[ "${WIP_PUSHED:-}" =~ ^[0-9a-f]{40}$ ]] && [ "$WIP_PUSHED" = "$HEAD_SHA" ]; then
            work=1; echo "Déjà poussé par le démon wip : antenly@$IN_BRANCH → ${HEAD_SHA:0:7} (pas de double push)"
          elif ! copie "$IN_BRANCH" "$HEAD_SHA"; then
            echo "::error::la branche a bougé après les contrôles, ou copie locale impossible : push refusé"
          elif pousse "$HEAD_SHA" "$IN_BRANCH"; then
            work=1; echo "Push OK : antenly@$IN_BRANCH → ${HEAD_SHA:0:7}"
          else
            echo "::error::push refusé (branche avancée ailleurs, ou jeton sans droit) : rien n'a été forcé"
          fi
          # Journal : branche dédiée. Créée par les instantanés en direct, le journal de fin s'y pose
          # par-dessus (avance rapide) ; si elle a bougé autrement, refus (jamais de force).
          logp=""
          if [[ "$LOG_SHA" =~ ^[0-9a-f]{40}$ ]]; then
            if copie "$LOGB" "$LOG_SHA" && pousse "$LOG_SHA" "$LOGB"; then
              logp="$LOGB"; echo "Journal privé poussé : antenly@$LOGB"
              echo "- Journal poussé sur la branche \`$LOGB\` d'antenly (à supprimer après lecture)" >> "$GITHUB_STEP_SUMMARY"
            else
              echo "::warning::journal non poussé sur $LOGB (le travail n'est pas concerné)"
            fi
          fi
          echo "log_branch=$logp" >> "$GITHUB_OUTPUT"
          [ "$work" = 1 ] || exit 1

      # PR en brouillon, jamais fusionnée : seulement quand le run s'est arrêté « terminé » et que
      # le validateur de fin (Max PASS) est vert. Aucune autre opération gh que la création.
      - name: PR en brouillon (jamais fusionnée)
        id: pr
        if: always() && steps.push.outcome == 'success' && steps.oc.outputs.stop == 'ok' && steps.check.outputs.done == 'ok'
        continue-on-error: true
        env:
          PUSH_TOKEN: ${{ secrets.ANTENLY_PUSH_TOKEN }}
          IN_BRANCH: ${{ inputs.branch }}
          IN_BASE: ${{ inputs.base_branch }}
          IN_JOB: ${{ inputs.job_name }}
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
        run: |
          set +x
          export PATH=/usr/local/bin:/usr/bin:/bin
          # Liste blanche figée hors du cwd : la PR ne source jamais le checkout ci/.
          T=/opt/fullrun-tools
          # shellcheck disable=SC1091
          . "$T/allowed-repos.sh"
          command -v gh >/dev/null 2>&1 || { echo "::warning::gh absent : pas de PR"; exit 0; }
          [ -n "${PUSH_TOKEN:-}" ] || { echo "::warning::ANTENLY_PUSH_TOKEN absent : pas de PR"; exit 0; }
          base="$IN_BASE"
          if [ -z "$base" ]; then
            base=$(GH_TOKEN="$PUSH_TOKEN" gh api repos/LordThiouk/antenly --jq .default_branch 2>/dev/null) || base=""
          fi
          [[ "$base" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]{0,99}$ ]] \
            || { echo "::warning::branche cible introuvable : pas de PR"; exit 0; }
          existing=$(GH_TOKEN="$PUSH_TOKEN" gh pr list --repo LordThiouk/antenly --head "$IN_BRANCH" \
                       --state open --json number --jq 'length' 2>/dev/null) || existing=0
          if [ "$existing" != 0 ]; then
            echo "- PR déjà ouverte pour \`$IN_BRANCH\` : rien à créer" >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          url=$(GH_TOKEN="$PUSH_TOKEN" gh pr create --repo LordThiouk/antenly --draft \
                  --base "$base" --head "$IN_BRANCH" \
                  --title "FullRun ${IN_JOB} (${IN_BRANCH})" \
                  --body "Run FullRun automatique. Journal et contrôles : ${RUN_URL}. PR en brouillon : revue humaine obligatoire, jamais de fusion automatique." 2>/dev/null) || url=""
          [ -n "$url" ] || { echo "::warning::création de la PR impossible"; exit 0; }
          echo "url=$url" >> "$GITHUB_OUTPUT"
          echo "- PR en brouillon : $url" >> "$GITHUB_STEP_SUMMARY"

      # Un lien ne termine jamais seul : il relit l'état signé qu'il vient d'écrire (unit --isa,
      # jamais --session — aucune session opencode ne survit entre deux jobs) et redispatche le
      # lien suivant tant que la chaîne n'est ni close ni bloquée. Jamais de report sans verdict
      # signé : computeUnitExit (lifeos) est la seule source de vérité, jamais une case cochée ici.
      # B2 : ~/.claude/LIFEOS/MEMORY/STATE/fullrun/ (build_plan, build_tasks, dispatches — l'état
      # RUNTIME complet, distinct du report de planification fullrun-carry.json commité avec l'ISA)
      # est recréé VIDE à chaque lien chaîné (job = runner neuf, rsync ne copie que lifeos/). Sans
      # cette étape, build/verify perdent toute trace de la tâche ou de l'agent déjà traité par un
      # lien précédent — jamais le dépôt git, jamais un fichier .fullrun, jamais un secret : un
      # artefact GitHub Actions de CE run, CHIFFRÉ AES-256-CBC (PBKDF2, clé dérivée de
      # ISA_STAMP_KEY) puis signé HMAC, et à usage unique (supprimé par l'étape de restauration dès
      # qu'il est lu par le lien suivant, acceptée ou non).
      #
      # Placée AVANT « Décision de chaînage » (pas après) : l'état écrit ici provient entièrement
      # de ce que les steps précédents (notamment « opencode run ») ont déjà produit dans ce dossier
      # pendant ce job — ni resolveRunStateFromArgs ni computeUnitExit (appelés par `unit --isa` dans
      # le step chain, plus bas) n'écrivent dans ce dossier : ce sont des lectures pures côté
      # FullRunPipeline.ts. Sauvegarder puis publier avant de calculer et d'envoyer le dispatch du
      # lien suivant garantit que l'artefact existe déjà quand ce lien suivant démarre et tente de le
      # restaurer — jamais une course où le dispatch part avant que l'artefact soit disponible.
      - name: Sauvegarder l'état FullRun (chaînage, artefact signé à usage unique)
        id: save_state
        if: always() && inputs.chain_enabled == 'true'
        env:
          ISA_STAMP_KEY: ${{ secrets.ISA_STAMP_KEY }}
        run: |
          set +x
          SRC="$HOME/.claude/LIFEOS/MEMORY/STATE/fullrun"
          if [ ! -d "$SRC" ] || [ -z "$(ls -A "$SRC" 2>/dev/null)" ]; then
            echo "has_state=false" >> "$GITHUB_OUTPUT"
            echo "Rien à reporter (dossier d'état vide ou absent)"
            exit 0
          fi
          # Clé absente/vide : échec explicite plutôt qu'une signature calculée avec une clé vide
          # (silencieusement acceptée par n'importe qui sans la vraie clé) — message clair, jamais
          # la valeur de la clé. Le step échoue (exit 1) ; la gate du step chain (SAVE_STATE_OUTCOME)
          # bloque alors le dispatch du lien suivant.
          if [ -z "${ISA_STAMP_KEY:-}" ]; then
            echo "::error::ISA_STAMP_KEY absente ou vide : signature HMAC impossible, état non publié (jamais un artefact signé avec une clé vide)" >&2
            exit 1
          fi
          D="$RUNNER_TEMP/fullrun-state-save"
          mkdir -p "$D"
          tar -C "$HOME/.claude/LIFEOS/MEMORY/STATE" -cf "$D/state.tar" fullrun
          # Chiffrement AVANT publication (dépôt public — revue 2, point 2) : le HMAC garantit
          # l'authenticité, pas la confidentialité. Clé de chiffrement DÉRIVÉE du secret HMAC par
          # séparation de domaine (libellé fixe, sha256) : ISA_STAMP_KEY reste le seul secret, deux
          # usages n'en partagent jamais la même clé effective. Jamais en argv ni dans un log : la
          # clé ne circule que par l'environnement du process (os.environb / -pass env:).
          STATE_ENC_KEY=$(python3 -c "import hmac,hashlib,os; print(hmac.new(os.environb[b'ISA_STAMP_KEY'], b'fullrun-state-aes256-v1', hashlib.sha256).hexdigest())")
          export STATE_ENC_KEY
          openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -in "$D/state.tar" -out "$D/state.tar.enc" -pass env:STATE_ENC_KEY
          unset STATE_ENC_KEY
          rm -f "$D/state.tar"
          # Clé jamais en argument de commande (jamais dans /proc/<pid>/cmdline) : ISA_STAMP_KEY n'est
          # lue que depuis l'environnement du process python3 (os.environb), jamais passée sur sa
          # ligne de commande. Même fonction de signature que la vérification côté restore_state,
          # et calculée sur le CHIFFRÉ (jamais sur le tar en clair, qui n'existe plus).
          python3 -c "import hmac,hashlib,os,sys; key=os.environb[b'ISA_STAMP_KEY']; data=open(sys.argv[1],'rb').read(); print(hmac.new(key,data,hashlib.sha256).hexdigest())" "$D/state.tar.enc" > "$D/state.sig"
          echo "has_state=true" >> "$GITHUB_OUTPUT"
          echo "dir=$D" >> "$GITHUB_OUTPUT"
          echo "État FullRun sauvegardé ($(du -h "$D/state.tar.enc" | cut -f1))"

      - name: Publier l'artefact d'état (usage unique, rétention 1 jour)
        id: publish_state
        if: always() && inputs.chain_enabled == 'true' && steps.save_state.outputs.has_state == 'true'
        uses: actions/upload-artifact@v4
        with:
          name: fullrun-state-${{ inputs.job_name }}
          path: |
            ${{ steps.save_state.outputs.dir }}/state.tar.enc
            ${{ steps.save_state.outputs.dir }}/state.sig
          retention-days: 1
          if-no-files-found: error

      - name: Décision de chaînage (chain_enabled)
        id: chain
        if: always() && inputs.chain_enabled == 'true'
        env:
          DISPATCH_TOKEN: ${{ secrets.ANTENLY_CI_DISPATCH_TOKEN }}
          OC_STOP: ${{ steps.oc.outputs.stop }}
          # B1 : outcome/raison des steps check et push, lus AVANT toute décision de chaînage — jamais
          # un redispatch à l'aveugle quand la gate anti-secret (check) ou le push a échoué.
          CHECK_OUTCOME: ${{ steps.check.outcome }}
          CHECK_REASON: ${{ steps.check.outputs.reason }}
          PUSH_OUTCOME: ${{ steps.push.outcome }}
          # Ordre des steps (ce correctif) : save_state/publish_state tournent avant ce step, donc
          # leurs outcomes sont déjà connus ici — un échec de l'un ou l'autre doit empêcher le
          # dispatch du lien suivant, pour ne jamais envoyer un prev_run_id dont l'artefact n'existe
          # pas ou n'est pas fiable.
          SAVE_STATE_OUTCOME: ${{ steps.save_state.outcome }}
          HAS_STATE: ${{ steps.save_state.outputs.has_state }}
          PUBLISH_STATE_OUTCOME: ${{ steps.publish_state.outcome }}
          # Verdict de la restauration de l'état du lien précédent (step restore_state) : un artefact
          # refusé (signature invalide, clé absente, archive illisible) ne doit pas se contenter d'un
          # warning puis d'un cold start silencieux — le lien suivant pourrait refaire ou sauter une tâche.
          RESTORE_STATE_OUTCOME: ${{ steps.restore_state.outcome }}
          RESTORE_STATE_STATUS: ${{ steps.restore_state.outputs.status }}
          IN_BASE: ${{ inputs.base_branch }}
          RUN_ID: ${{ github.run_id }}
          ANTENLY_DIR: ${{ github.workspace }}/antenly
          LIFEOS_DIR: ${{ github.workspace }}/lifeos
          BASH_ENV: ""
          ENV: ""
          LD_PRELOAD: ""
          LD_LIBRARY_PATH: ""
          GIT_CONFIG_GLOBAL: /dev/null
          GIT_CONFIG_NOSYSTEM: "1"
          # Re-pinnés depuis les inputs (jamais depuis l'env du job, que l'étape oc — l'agent IA —
          # peut avoir réécrit via $GITHUB_ENV/$GITHUB_PATH) : une valeur ainsi empoisonnée pourrait
          # rediriger ce dispatch vers une autre branche/ISA/prompt/modèle/job avec le vrai jeton
          # ANTENLY_CI_DISPATCH_TOKEN. Toute variable utilisée par le dispatch ci-dessous vient d'ici.
          IN_CHAIN_ENABLED: ${{ inputs.chain_enabled }}
          IN_CHAIN_PHASE: ${{ inputs.chain_phase }}
          IN_CHAIN_PROGRESS: ${{ inputs.chain_progress }}
          OC_ISA_PATH: ${{ inputs.isa_path }}
          IN_PROMPT: ${{ inputs.prompt_path }}
          IN_PROMPT_BUILD: ${{ (fromJSON(inputs.chain_prompts || '{}').build || '') }}
          IN_PROMPT_VERIFY: ${{ (fromJSON(inputs.chain_prompts || '{}').verify || '') }}
          IN_PROMPT_CLOSE: ${{ (fromJSON(inputs.chain_prompts || '{}').close || '') }}
          IN_BRANCH: ${{ inputs.branch }}
          IN_JOB: ${{ inputs.job_name }}
          IN_LIFEOS_REF: ${{ inputs.lifeos_ref }}
          IN_HF_CORPUS: ${{ inputs.hf_corpus }}
          IN_IDLE_MIN: ${{ inputs.idle_minutes }}
          IN_AGENT_IDLE_MIN: ${{ inputs.agent_idle_minutes }}
          IN_DONE_AGENTS: ${{ inputs.done_agents }}
          IN_STOP_AFTER_STEP: ${{ inputs.stop_after_step }}
          IN_WIP_PUSH_MIN: ${{ inputs.wip_push_minutes }}
          IN_PREV_RUN_ID: ${{ inputs.prev_run_id }}
          IN_WITH_EMU: ${{ inputs.with_emulators == true && 'true' || 'false' }}
          OC_MODEL_MAIN: ${{ inputs.model_main }}
          OC_MODEL_MAX: ${{ inputs.model_max }}
          OC_MODEL_CHAIN: ${{ inputs.model_chain }}
        run: |
          set +x
          # PATH minimal — jamais le PATH hérité, que le step oc (l'IA) a pu empoisonner via
          # $GITHUB_ENV/$GITHUB_PATH — mais il DOIT contenir le dossier de bun : oven-sh/setup-bun
          # (plus haut dans ce job) installe bun dans ~/.bun/bin, jamais dans /usr/local/bin.
          # Sans lui, le `bun … FullRunPipeline.ts unit` plus bas échoue en vraie CI, la sortie est
          # non-JSON, et toute chaîne s'arrête au premier lien sur un diagnostic « sortie illisible »
          # qui masque la vraie cause (bun: command not found).
          export PATH="$HOME/.bun/bin:/usr/local/bin:/usr/bin:/bin"
          out() { echo "$1=$2" >> "$GITHUB_OUTPUT"; }

          # Nettoie la sortie brute avant de la journaliser : masque les motifs de jeton connus,
          # replie les sauts de ligne (une ligne « ::… » injectée deviendrait une workflow command),
          # échappe « :: » et tronque à 400 caractères. Jamais la sortie complète de unit --isa
          # dans un log public (dépôt public — revue 2, point 1).
          safe_raw() {
            local s
            s=$(printf '%s' "$1" | sed -E \
              -e 's/(gh[pousr]_[A-Za-z0-9]{16,})/[REDACTED]/g' \
              -e 's/(github_pat_[A-Za-z0-9_]{16,})/[REDACTED]/g' \
              -e 's/(glpat-[A-Za-z0-9_-]{16,})/[REDACTED]/g' \
              -e 's/(sk-[A-Za-z0-9_-]{16,})/[REDACTED]/g' \
              -e 's/(xox[baprs]-[A-Za-z0-9-]{10,})/[REDACTED]/g' \
              -e 's/((Bearer|token|secret|password)[[:space:]]*[=:][[:space:]]*)[^[:space:]]{8,}/\1[REDACTED]/Ig' \
              -e 's/[A-Za-z0-9_+\/=-]{40,}/[REDACTED]/g' \
              | tr '\r\n' '  ' | sed -e 's/::/:\:/g')
            printf '%s' "${s:0:400}"
          }

          # Toute raison passe par safe_raw (jetons masqués, sauts de ligne repliés : une valeur « reason »
          # venue de unit --isa ne peut ni injecter une workflow command ni une ligne de GITHUB_OUTPUT).
          stop_chain() { local m; m=$(safe_raw "$1"); out block true; out continue false; out reason "$m"; echo "::error::chaînage arrêté : $m"; exit 0; }
          finish_chain() { local m; m=$(safe_raw "$1"); out block false; out continue false; out reason "$m"; echo "chaîne terminée : $m"; exit 0; }

          # Nombre de liens : format antenly IN_CHAIN_PROGRESS="<count>/<max>", ou format galass
          # IN_CHAIN_COUNT/IN_CHAIN_MAX (unit-contract-test.sh). Les deux restent acceptés.
          if [ -n "${IN_CHAIN_PROGRESS:-}" ]; then
            # chain_progress = "<count>/<max>" — repinné depuis l'input (voir garde plus haut dans ce
            # fichier) : ce step vit dans un job séparé, il n'hérite pas des variables shell du garde.
            IFS='/' read -r IN_CHAIN_COUNT IN_CHAIN_MAX <<<"$IN_CHAIN_PROGRESS"
          else
            IN_CHAIN_COUNT="${IN_CHAIN_COUNT:-0}"
            IN_CHAIN_MAX="${IN_CHAIN_MAX:-20}"
          fi

          # stop_after_step est EXCLUSIF avec le chaînage : un job borné s'arrête après son étape et
          # ne dispatche JAMAIS le lien suivant, même si chain_enabled=true a été fourni par erreur.
          # Décidé avant toute lecture d'état (bun/unit) et avant le moindre gh workflow run.
          if [ -n "${IN_STOP_AFTER_STEP:-}" ]; then
            finish_chain "stop_after_step=${IN_STOP_AFTER_STEP} : job borné, aucun lien suivant dispatché"
          fi

          # bun est requis juste en dessous (lecture de l'état du lien) : diagnostic explicite plutôt
          # qu'un « unit --isa illisible » qui masquerait un PATH durci sans le dossier de bun.
          command -v bun >/dev/null 2>&1 \
            || stop_chain "bun introuvable après durcissement du PATH (attendu dans $HOME/.bun/bin) : état du lien illisible"

          # B1 : la gate anti-secret (check) et le push protègent l'intégrité de la branche/de l'historique
          # — un échec de l'un ou de l'autre ne doit JAMAIS être masqué par un redispatch qui, en plus,
          # supprime la notification de fin (continue=true côté « Notification de fin »). Contrôlé avant
          # toute lecture d'état ISA, avant même le cas opencode ci-dessous.
          if [ "${CHECK_OUTCOME:-}" != success ]; then
            stop_chain "contrôle avant push en échec (gate anti-secret/historique) : ${CHECK_REASON:-raison inconnue}"
          fi
          if [ "${PUSH_OUTCOME:-}" != success ]; then
            stop_chain "push en échec : rien de nouveau n'est garanti sur la branche, lien suivant non dispatché"
          fi

          # Ordre des steps : save_state/publish_state sont déjà passés. save_state échoue (outcome
          # != success) uniquement sur un crash réel (lecture/tar/signature) — jamais sur « rien à
          # sauvegarder » (has_state=false, exit 0). publish_state n'est contrôlé que si has_state=true :
          # sinon il est "skipped" par sa propre condition (rien à publier), ce qui n'est pas un échec.
          if [ "${SAVE_STATE_OUTCOME:-}" != success ]; then
            stop_chain "sauvegarde de l'état FullRun en échec (save_state) : artefact non fiable, lien suivant non dispatché"
          fi
          if [ "${HAS_STATE:-}" = true ] && [ "${PUBLISH_STATE_OUTCOME:-}" != success ]; then
            stop_chain "publication de l'artefact d'état en échec (publish_state) : lien suivant non dispatché sans preuve que l'état a été transporté"
          fi

          # Restauration de l'état du lien précédent (step restore_state, seulement quand prev_run_id
          # est fourni). Un artefact REFUSÉ (signature invalide, clé ISA_STAMP_KEY absente, archive
          # illisible) n'est pas un simple mode dégradé : le lien repartirait en cold start et pourrait
          # refaire ou sauter une tâche, invisible dans le résumé. Un artefact simplement ABSENT
          # (status=missing) reste toléré : c'est le cas normal des premiers liens, qui n'ont aucun
          # état runtime à transmettre (save_state a alors écrit has_state=false et publish_state a
          # été « skipped »). Un step planté (outcome ≠ success) bloque aussi.
          if [ -n "${IN_PREV_RUN_ID:-}" ]; then
            [ "${RESTORE_STATE_OUTCOME:-}" = success ] \
              || stop_chain "restauration de l'état du lien précédent en échec (restore_state) : lien suivant non dispatché"
            case "${RESTORE_STATE_STATUS:-}" in
              refused) stop_chain "état du lien précédent refusé (signature/clé/archive) : chaîne arrêtée, cold start silencieux refusé (une tâche pourrait être refaite ou sautée)" ;;
              failed) stop_chain "téléchargement de l'état du lien précédent en échec alors qu'il l'avait publié (has_state=true) : chaîne arrêtée, pas de cold start silencieux" ;;
              ""|missing|restored) : ;;
              *) stop_chain "statut de restauration inconnu (${RESTORE_STATE_STATUS}) : lien suivant non dispatché" ;;
            esac
          fi

          # Un lien dont opencode lui-même s'est mal arrêté ne redispatche jamais à l'aveugle.
          # M1 : "" (OC_STOP vide — le step oc a été tué par GitHub avant d'écrire sa sortie, cf.
          # horloge du plafond ci-dessus) est traité comme un arrêt, jamais ignoré silencieusement.
          case "${OC_STOP:-}" in
            silence|plafond|vide|annulation|erreur) stop_chain "lien en échec (arrêt opencode : ${OC_STOP})" ;;
            "") stop_chain "arrêt opencode inconnu (sortie du step oc absente ou tuée par GitHub avant écriture)" ;;
          esac

          case "$IN_CHAIN_PHASE" in
            plan|close) gran=step ;;
            build) gran=task ;;
            verify) gran=agent ;;
          esac
          # m4 : isa_path re-validé ici (jamais supposé sain parce que le garde l'a déjà vu) avant d'être
          # joint au dépôt cible : MEMORY/WORK/<dossier>/ISA.md, sans « .. ».
          TARGET_ROOT="${TARGET_DIR:-${ANTENLY_DIR:-}}"
          [[ "$OC_ISA_PATH" =~ ^MEMORY/WORK/[A-Za-z0-9._-]+/ISA\.md$ && "$OC_ISA_PATH" != *..* ]] \
            || stop_chain "isa_path invalide (MEMORY/WORK/<dossier>/ISA.md) : état illisible"
          ISA_ABS="$TARGET_ROOT/$OC_ISA_PATH"
          [ -f "$ISA_ABS" ] || stop_chain "ISA introuvable ($OC_ISA_PATH) : état illisible"

          set +e
          # DISPATCH_TOKEN ne sert qu'au dispatch gh plus bas : jamais dans l'environnement de bun/unit,
          # qui n'en a pas besoin (surface d'exposition minimale du jeton — même raisonnement que les
          # variables déjà mises à "" ci-dessus pour ce step).
          raw=$(env -u DISPATCH_TOKEN bun "$LIFEOS_DIR/LIFEOS/TOOLS/FullRunPipeline.ts" unit --isa "$ISA_ABS" --stop-after "$gran" 2>&1)
          set -e
          kind=$(printf '%s' "$raw" | jq -r '.exit // ""' 2>/dev/null) || kind=""
          reason=$(printf '%s' "$raw" | jq -r '.reason // ""' 2>/dev/null) || reason=""
          nxt=$(printf '%s' "$raw" | jq -r '.next // ""' 2>/dev/null) || nxt=""
          # m1 : valeurs issues de l'outil assainies avant tout log/résumé (la logique garde les valeurs strictes).
          reason=$(safe_raw "$reason"); nxt_log=$(safe_raw "$nxt")
          echo "unit --isa : kind=$(safe_raw "${kind:-<vide>}") reason=${reason:-<aucune>} next=${nxt_log:-<aucun>}" >> "$GITHUB_STEP_SUMMARY" || true
          if [ -z "$kind" ]; then
            echo "::error::unit --isa sortie illisible (phase $IN_CHAIN_PHASE, $gran) : $(safe_raw "$raw")" >&2
            stop_chain "unit --isa illisible (phase $IN_CHAIN_PHASE, $gran)"
          fi

          case "$kind" in
            echec) stop_chain "${reason:-echec} (phase $IN_CHAIN_PHASE)" ;;
            termine) finish_chain "${reason:-run clos}" ;;
          esac
          # kind = suite_a_faire : décide la phase et le prompt du prochain lien. new_next (M3) : la
          # cible déjà calculée par unit --isa (ID de tâche en build, nom d'agent en verify) n'est
          # imposée au prompt suivant que si la phase ne change pas — un changement de phase (nxt =
          # numéro d'étape 4/5/6) laisse la nouvelle phase choisir sa première tâche/son premier agent.
          next_phase="$IN_CHAIN_PHASE"; new_next=""
          # M2 : valeurs de .next ATTENDUES par phase (contrat de unit --isa, vérifié contre le vrai outil
          # par opencode/tests/unit-contract-test.sh). Toute autre valeur arrête la chaîne avec une raison :
          # jamais un lien relancé sans cible jusqu'à chain_max.
          tgt_re='^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'
          case "$IN_CHAIN_PHASE" in
            plan)
              case "$nxt" in
                1|2|3) : ;;
                4) next_phase=build ;;
                *) stop_chain "unit --isa : next inattendu en phase plan (${nxt_log:-<vide>}, attendu 1 à 4) — $reason" ;;
              esac ;;
            build)
              if [ "$nxt" = 5 ]; then next_phase=verify
              elif [[ "$nxt" =~ $tgt_re ]]; then new_next="$nxt"
              else stop_chain "unit --isa : cible de tâche absente ou invalide en phase build (${nxt_log:-<vide>}) — $reason"; fi ;;
            verify)
              if [ "$nxt" = 6 ]; then next_phase=close
              elif [[ "$nxt" =~ $tgt_re ]]; then new_next="$nxt"
              else stop_chain "unit --isa : cible d'agent absente ou invalide en phase verify (${nxt_log:-<vide>}) — $reason"; fi ;;
            close)
              case "$nxt" in
                6|7) : ;;
                *) stop_chain "unit --isa : next inattendu en phase close (${nxt_log:-<vide>}, attendu 6 ou 7) — $reason" ;;
              esac ;;
          esac
          new_count=$((10#$IN_CHAIN_COUNT + 1))
          # Strict < (jamais <=) : même règle qu'au garde (l.236 avant ce correctif) — count == max
          # est déjà le dernier lien autorisé, pas un lien de plus.
          [ "$new_count" -lt "$((10#$IN_CHAIN_MAX))" ] \
            || stop_chain "chain_max atteint (${IN_CHAIN_MAX}) sans conclure — $reason"

          [ -n "${DISPATCH_TOKEN:-}" ] \
            || stop_chain "secret ANTENLY_CI_DISPATCH_TOKEN absent (acte Papa requis) : lien suivant non dispatché — $reason"

          # Compatibilité galass : quand l'environnement ne fournit PAS IN_CHAIN_PROGRESS (format galass,
          # utilisé par unit-contract-test.sh), l'état du lien suivant est aussi transmis en JSON chain_state
          # (phase/next/...), en plus des champs antenly ci-dessous. En production antenly, IN_CHAIN_PROGRESS
          # est toujours posé : le dispatch reste strictement inchangé.
          chain_state_args=()
          if [ -z "${IN_CHAIN_PROGRESS:-}" ]; then
            emu_run=""
            if [ "${IN_WITH_EMU:-false}" = true ]; then
              emu_run=$(sudo -n cat /opt/fullrun-live/emu-run 2>/dev/null | tr -d '[:space:]') || emu_run=""
              [[ "$emu_run" =~ ^[0-9]{1,20}$ ]] || emu_run=""
            fi
            has_val=false; [ "${HAS_STATE:-}" = true ] && has_val=true
            next_state=$(jq -cn --arg ph "$next_phase" --arg n "$new_count" --arg pv "$RUN_ID" --arg nx "$new_next" --arg em "$emu_run" --arg hs "$has_val" \
              '{phase:$ph,count:$n,prev:$pv,next:$nx,emu:$em,has:$hs}')
            chain_state_args=(-f chain_state="$next_state")
          fi
          prompts_json=$(jq -cn --arg b "${IN_PROMPT_BUILD:-}" --arg v "${IN_PROMPT_VERIFY:-}" --arg c "${IN_PROMPT_CLOSE:-}" \
            '{build:$b,verify:$v,close:$c}')
          echo "::add-mask::$DISPATCH_TOKEN"
          if GH_TOKEN="$DISPATCH_TOKEN" gh workflow run opencode-fullrun.yml \
               --repo LordThiouk/antenly-ci --ref "${GITHUB_REF_NAME}" \
               -f branch="$IN_BRANCH" -f prompt_path="$IN_PROMPT" -f job_name="$IN_JOB" \
               -f model_main="$OC_MODEL_MAIN" -f model_max="$OC_MODEL_MAX" \
               -f model_chain="$OC_MODEL_CHAIN" \
               -f lifeos_ref="$IN_LIFEOS_REF" -f isa_path="$OC_ISA_PATH" -f start_step="" \
               -f base_branch="${IN_BASE:-}" -f hf_corpus="${IN_HF_CORPUS:-}" \
               -f agent_idle_minutes="$IN_AGENT_IDLE_MIN" -f idle_minutes="$IN_IDLE_MIN" \
               -f done_agents="${OC_DONE_AGENTS_EFFECTIVE:-${IN_DONE_AGENTS:-Max}}" -f wip_push_minutes="$IN_WIP_PUSH_MIN" \
               -f with_emulators="${IN_WITH_EMU:-false}" \
               -f chain_enabled=true -f chain_phase="$next_phase" \
               -f chain_progress="${new_count}/${IN_CHAIN_MAX}" -f chain_prompts="$prompts_json" \
               -f prev_run_id="$RUN_ID" -f next="$new_next" \
               "${chain_state_args[@]}" \
               >/dev/null 2>&1; then
            out block false; out continue true
            out reason "lien $new_count/$IN_CHAIN_MAX dispatché (phase $next_phase) — $reason"
            echo "Chaînage : lien suivant dispatché (phase $next_phase, $new_count/$IN_CHAIN_MAX)"
          else
            stop_chain "dispatch du lien suivant refusé (gh workflow run) — $reason"
          fi

      - name: Statut final
        if: always()
        env:
          OC_OUTCOME: ${{ steps.oc.outcome }}
          OC_STOP: ${{ steps.oc.outputs.stop }}
          OC_IDLE_MIN: ${{ inputs.idle_minutes }}
          OC_WORK: ${{ runner.temp }}/oc
          DONE: ${{ steps.check.outputs.done }}
          DONE_REASON: ${{ steps.check.outputs.done_reason }}
          CHAIN_BLOCK: ${{ steps.chain.outputs.block }}
          CHAIN_REASON: ${{ steps.chain.outputs.reason }}
          CHAIN_OUTCOME: ${{ steps.chain.outcome }}
        run: |
          set +x
          # « terminé » exige le PASS de Max vérifié : un rc 0 ne prouve que la fin du tour.
          if [ "${DONE:-}" = ok ]; then
            ok_why="terminé"
          else
            ok_why="fin de tour sans PASS (${DONE_REASON:-a:none})"
          fi
          case "${OC_STOP:-}" in
            ok) why="$ok_why" ;;
            tour) why="fin de tour sans PASS (${DONE_REASON:-a:none})" ;;
            silence) why="bloqué (silence $((10#$OC_IDLE_MIN)) min)" ;;
            plafond) why="plafond atteint" ;;
            vide) why="réponse vide (aucun token après reprises)" ;;
            annulation) why="annulé" ;;
            erreur) why="erreur opencode" ;;
            *) why="non lancé ou interrompu" ;;
          esac
          # Erreurs agent : lignes `error=<type>` écrites par le moniteur. Comptage strict :
          # seuls les quatre types connus, jamais le texte du modèle ni un secret.
          errs=$(awk -F= '
            /^error=(timeout|empty|provider|429)$/ { c[$2]++ }
            END { printf "timeout=%d, empty=%d, provider=%d, 429=%d", c["timeout"], c["empty"], c["provider"], c["429"] }
          ' "$OC_WORK/opencode.log.status" 2>/dev/null || true)
          [ -n "$errs" ] || errs="timeout=0, empty=0, provider=0, 429=0"
          echo "opencode : ${OC_OUTCOME:-non lancé} ; arrêt : $why ; erreurs agent : $errs"
          echo "- Statut final opencode : **$why**" >> "$GITHUB_STEP_SUMMARY"
          echo "- Erreurs agent : $errs" >> "$GITHUB_STEP_SUMMARY"
          echo "- Validateur de fin (PASS des agents done_agents) : ${DONE:-non exécuté}${DONE_REASON:+ ($DONE_REASON)}" >> "$GITHUB_STEP_SUMMARY"
          if [ "$IN_CHAIN_ENABLED" = true ]; then
            # Chaîné : le verdict de ce LIEN vient de unit --isa (step « Décision de chaînage »),
            # jamais de OC_STOP/DONE — un « tour »/« fin de tour sans PASS » est le déroulement
            # normal d'un lien intermédiaire, pas un échec. Seul un lien bloqué (CHAIN_BLOCK=true :
            # arrêt opencode anormal, echec lifeos, chain_max atteint, ou dispatch refusé) échoue.
            echo "- Chaînage : ${CHAIN_REASON:-non évalué}" >> "$GITHUB_STEP_SUMMARY"
            # M2 : CHAIN_BLOCK seul ne suffit pas — si le step chain plante AVANT d'écrire ses outputs
            # (crash, bug, OOM), CHAIN_BLOCK reste vide et le job finirait vert à tort. steps.chain.outcome
            # couvre ce cas : tout sauf "success" (failure, cancelled — jamais "skipped", ce step tourne
            # toujours en chaîné via son propre `if: always() && inputs.chain_enabled == 'true'`) échoue le job.
            if [ "${CHAIN_OUTCOME:-}" != success ]; then
              echo "::error::step « Décision de chaînage » en échec (${CHAIN_OUTCOME:-inconnu}) avant d'écrire son verdict — chaîne arrêtée par précaution"
              exit 1
            fi
            if [ "${CHAIN_BLOCK:-}" = true ]; then
              echo "::error::chaîne bloquée : ${CHAIN_REASON:-raison inconnue}"
              exit 1
            fi
            # Job borné (stop_after_step) MÊME en mode chaîné : le step chain ne dispatche aucun
            # lien suivant, mais le job ne doit jamais finir vert sans le PASS de l'agent de
            # l'étape (revue r3, point 2). Le verdict DONE vient du validateur de fin.
            if [ -n "${IN_STOP_AFTER_STEP:-}" ] && [ "${DONE:-}" != ok ]; then
              echo "::error::job borné (stop_after_step=${IN_STOP_AFTER_STEP}) : PASS requis non vérifié (${DONE_REASON:-done_check})"
              exit 1
            fi
            exit 0
          fi
          # Non chaîné (comportement historique, inchangé) : « terminé » exige le PASS de Max.
          if [ "${OC_STOP:-}" = ok ] && [ "${DONE:-}" != ok ]; then
            echo "::error::run en échec : PASS requis non vérifié (${DONE_REASON:-done_check})"
            exit 1
          fi
          [ "$OC_OUTCOME" = success ] || { echo "::error::run en échec : $why"; exit 1; }

      # Notification de fin vers opencode-notify (même format que oc-run sur la box). Toujours,
      # même après échec ou annulation ; ne fait jamais échouer le job. Contenu neutre : codes,
      # raison, SHA, URL, ISC, modèle ; jamais de texte du modèle. URL et clé passées à curl par
      # stdin (-K -), jamais en argument ni à l'écran ; aucun script du dépôt n'est lancé ici.
      # Chaîné (chain_enabled=true) : silencieux tant qu'un lien suivant est dispatché
      # (steps.chain.outputs.continue == 'true') — seules la fin de chaîne et un blocage notifient.
      - name: Notification de fin (opencode-notify)
        if: always() && (inputs.chain_enabled != 'true' || steps.chain.outputs.continue != 'true')
        continue-on-error: true
        timeout-minutes: 3
        env:
          OC_NOTIFY_URL: ${{ secrets.OC_NOTIFY_URL }}
          OC_NOTIFY_KEY: ${{ secrets.OC_NOTIFY_KEY }}
          JOB_STATUS: ${{ job.status }}
          OC_STOP: ${{ steps.oc.outputs.stop }}
          OC_RC: ${{ steps.oc.outputs.rc }}
          OC_IDLE_MIN: ${{ inputs.idle_minutes }}
          OC_DONE_AGENTS: ${{ inputs.done_agents }}
          OC_JOB_T0: ${{ steps.guard.outputs.t0 }}
          IN_JOB: ${{ inputs.job_name }}
          OC_MODEL_MAIN: ${{ inputs.model_main }}
          PUSH_OUTCOME: ${{ steps.push.outcome }}
          LOG_BRANCH: ${{ steps.push.outputs.log_branch }}
          LIVE_BRANCH: ${{ steps.live.outputs.branch }}
          CHECK_REASON: ${{ steps.check.outputs.reason }}
          DONE: ${{ steps.check.outputs.done }}
          DONE_REASON: ${{ steps.check.outputs.done_reason }}
          PR_URL: ${{ steps.pr.outputs.url }}
          LOG_ARTIFACT: ${{ steps.check.outputs.artifact }}
          HEAD_SHA: ${{ steps.check.outputs.head }}
          ISC: ${{ steps.check.outputs.isc }}
          OC_WORK: ${{ runner.temp }}/oc
          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
          RUN_ID: ${{ github.run_id }}
          RUN_ATTEMPT: ${{ github.run_attempt }}
          BASH_ENV: ""
          ENV: ""
          LD_PRELOAD: ""
          LD_LIBRARY_PATH: ""
        run: |
          set +x
          export PATH=/usr/bin:/bin
          if [ -z "${OC_NOTIFY_URL:-}" ] || [ -z "${OC_NOTIFY_KEY:-}" ]; then
            echo "::warning::secrets OC_NOTIFY_URL / OC_NOTIFY_KEY absents : notification ignorée"; exit 0
          fi
          case "${OC_STOP:-}" in
            silence) status="bloqué"; why="bloqué (silence $((10#$OC_IDLE_MIN)) min)" ;;
            plafond) status="échec"; why="plafond atteint" ;;
            vide) status="échec"; why="réponse vide (aucun token après reprises)" ;;
            tour) status="échec"; why="fin de tour sans PASS (à reprendre)" ;;
            annulation) status="annulé"; why="annulé" ;;
            erreur) status="échec"; why="erreur opencode" ;;
            ok) status="fini"; why="terminé" ;;
            *) status="échec"; why="opencode non lancé ou interrompu" ;;
          esac
          if [ "$JOB_STATUS" = cancelled ] && [ "$status" != "annulé" ]; then status="annulé"; why="annulé ($why)"; fi
          if [ "${CHECK_REASON:-}" = gitleaks ]; then
            status="bloqué"
            if [ -n "${LOG_ARTIFACT:-}" ]; then why="bloqué par gitleaks, journal chiffré en artefact"
            else why="bloqué par gitleaks, journal chiffré impossible"; fi
          fi
          if [ "${DONE:-}" != ok ] && [ "$status" = fini ]; then
            status="échec"
            why="terminé, mais PASS requis non vérifié${DONE_REASON:+ ($DONE_REASON)}"
          fi
          [ "$JOB_STATUS" = success ] || [ "$status" != fini ] || { status="échec"; why="terminé, mais contrôles ou push en échec"; }
          now=$(date +%s); t0="$OC_JOB_T0"
          [[ "$t0" =~ ^[0-9]{9,11}$ && "$t0" -le "$now" ]] && dur=$(( now - t0 )) || dur=0
          [[ "$OC_RC" =~ ^[0-9]{1,3}$ ]] || OC_RC="?"
          [[ "$HEAD_SHA" =~ ^[0-9a-f]{40}$ && "$PUSH_OUTCOME" = success ]] && sha="${HEAD_SHA:0:7}" || sha="aucun"
          [[ "$ISC" =~ ^([0-9]{1,7}|\?)/([0-9]{1,7}|\?)$ ]] || ISC="?/?"
          if ! [[ "$LOG_BRANCH" =~ ^fullrun-logs/[A-Za-z0-9._-]{1,90}$ ]]; then
            # Journal de fin non poussé : la branche du journal en direct reste lisible.
            if [[ "${LIVE_BRANCH:-}" =~ ^fullrun-logs/[A-Za-z0-9._-]{1,90}$ ]]; then LOG_BRANCH="${LIVE_BRANCH} (direct seulement)"
            else LOG_BRANCH="aucun"; fi
          fi
          [[ "$LOG_ARTIFACT" =~ ^fullrun-log-[A-Za-z0-9._-]{1,80}\.age$ ]] || LOG_ARTIFACT="aucun"
          # Erreurs agent : lignes `error=<type>` du moniteur, strictement typées (aucun secret,
          # aucun texte du modèle). Le champ `errors` accompagne les champs existants.
          errs_json=$(awk -F= '
            /^error=(timeout|empty|provider|429)$/ { c[$2]++ }
            END { printf "{\"timeout\":%d,\"empty\":%d,\"provider\":%d,\"429\":%d}", c["timeout"], c["empty"], c["provider"], c["429"] }
          ' "$OC_WORK/opencode.log.status" 2>/dev/null || true)
          if ! printf '%s' "$errs_json" | jq -e 'has("timeout") and has("empty") and has("provider") and has("429")' >/dev/null 2>&1; then
            errs_json='{"timeout":0,"empty":0,"provider":0,"429":0}'
          fi
          errs_total=$(printf '%s' "$errs_json" | jq '[.[]] | add' 2>/dev/null || echo 0)
          [[ "$errs_total" =~ ^[0-9]+$ ]] || errs_total=0
          tail="exit=${OC_RC} · raison=${why} · sha poussé=${sha} · journal=${LOG_BRANCH} · artefact=${LOG_ARTIFACT} · ISC ${ISC} · modèle ${OC_MODEL_MAIN} · erreurs=${errs_total} · run ${RUN_URL}"
          id=$(printf '%s:%s:%s:%s' "$IN_JOB" "$RUN_ID" "$RUN_ATTEMPT" "$status" | sha256sum | cut -d' ' -f1)
          body="$RUNNER_TEMP/notify.json"
          jq -nc --arg job "$IN_JOB" --arg status "$status" --argjson duration "$dur" --arg log_tail "$tail" \
            --arg event_id "$id" --arg run_id "$RUN_ID" --argjson errors "$errs_json" --arg pr_url "${PR_URL:-}" \
            '{job:$job,status:$status,duration:$duration,pr_url:$pr_url,log_tail:$log_tail,event_id:$event_id,run_id:$run_id,errors:$errors}' > "$body"
          ok=0
          for attempt in 1 2 3; do
            code=$(printf 'url = "%s"\nheader = "Authorization: Bearer %s"\nheader = "X-Automation-Key: %s"\n' \
                     "$OC_NOTIFY_URL" "$OC_NOTIFY_KEY" "$OC_NOTIFY_KEY" \
                   | curl -sS -K - --max-time 15 -X POST -H "Content-Type: application/json" -H "Idempotency-Key: $id" \
                       --data-binary "@$body" -o /dev/null -w '%{http_code}' 2>/dev/null) || code="000"
            if [[ "$code" =~ ^2[0-9][0-9]$ ]]; then ok=1; break; fi
            echo "notification : essai $attempt, HTTP ${code:0:3}"
            [ "$attempt" -lt 3 ] && sleep $(( attempt * 10 ))
          done
          rm -f "$body"
          if [ "$ok" = 1 ]; then echo "notification envoyée : $why"; else echo "::warning::notification non livrée après 3 essais (le job garde son statut)"; fi

