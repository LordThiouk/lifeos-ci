          ),
        ],
      ),
      child: Stack(
        children: [
          Positioned.fill(
            child: Container(
              decoration: BoxDecoration(
                borderRadius: BorderRadius.circular(widget.cornerRadius),
                gradient: LinearGradient(
                  colors: [
                    MyColor.colorBlack.withValues(alpha: 0.04),
