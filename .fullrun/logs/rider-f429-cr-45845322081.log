          printf '%s' "${ISA_STAMP_KEY:-}" | sudo sh -c 'umask 077; cat > /opt/fullrun-live/isa.key'
          # preannot : le GITHUB_TOKEN de CE dépôt (permission actions: write) déclenche
          # ci.yml, dont le job preannot-ina. Même dépôt, donc aucun second jeton. Le jeton
          # vit dans un fichier root 0600, jamais dans l'environnement d'opencode ; l'outil
          # figé le lit en root via sudoers (une seule commande autorisée).
          if [ -n "${GH_DISPATCH_TOKEN:-}" ]; then
            printf '::add-mask::%s\n' "$GH_DISPATCH_TOKEN"
            printf '%s\n' "$GH_DISPATCH_TOKEN" | sudo sh -c 'umask 077; cat > /opt/fullrun-live/preannot.token'
            sudo chown root:root /opt/fullrun-live/preannot.token
            sudo chmod 0600 /opt/fullrun-live/preannot.token
            {
              printf 'OC_BRANCH=%s\n' "$IN_BRANCH"
              printf 'PREANNOT_TIMEOUT_SEC=5400\n'
              printf 'PREANNOT_POLL_SEC=30\n'
              printf 'PREANNOT_LOG_TAIL=80\n'
              printf 'PREANNOT_LOG_WIDTH=300\n'
              printf 'PREANNOT_ART_DIR=%s\n' "${OC_WORK:-/tmp}/preannot"
            } | sudo tee "$T/preannot.state" >/dev/null
            sudo chown root:root "$T/preannot.state"
            sudo chmod 0644 "$T/preannot.state"
            u=$(id -un)
            {
              printf 'Defaults!/opt/fullrun-tools/preannot.sh env_reset\n'
              printf 'Defaults!/opt/fullrun-tools/preannot.sh secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"\n'
              printf '%s ALL=(root) NOPASSWD: /opt/fullrun-tools/preannot.sh run\n' "$u"
            } | sudo tee /etc/sudoers.d/fullrun-preannot >/dev/null
            sudo chmod 0440 /etc/sudoers.d/fullrun-preannot
            sudo visudo -cf /etc/sudoers.d/fullrun-preannot >/dev/null
            echo "outil preannot figé : ci.yml (job preannot-ina), jeton d'antenly-ci hors d'opencode"
          else
            echo "::warning::GITHUB_TOKEN absent : preannot.sh sans jeton (dispatch impossible)"
          fi
          # with_emulators : jeton CI_TOKEN hors d'opencode (fichier root 0600), état figé, sudoers strict.
          # Provisioning copié de galass-ci (opencode-fullrun.yml l.820-842) : sans le jeton et l'état,
          # with_emulators=true échoue dès le premier `emu-e2e.sh run`.
          if [ "${WITH_EMULATORS:-}" = "true" ]; then
            [ -x "$CI_DIR/opencode/emu-e2e.sh" ] || { echo "::error::emu-e2e.sh absent : impossible d'activer with_emulators"; exit 1; }
            [ -n "${CI_TOKEN:-}" ] || { echo "::error::secret CI_TOKEN absent : impossible d'activer with_emulators"; exit 1; }
            printf '::add-mask::%s\n' "$CI_TOKEN"
            printf '%s\n' "$CI_TOKEN" | sudo sh -c 'umask 077; cat > /opt/fullrun-live/emu-e2e.token'
            # Chaînage : run e2e du lien précédent encore en vol → emu-e2e.sh run le reprend (root 0600).
            if [[ "${IN_EMU_RUN:-}" =~ ^[0-9]{1,20}$ ]]; then
              printf '%s\n' "$IN_EMU_RUN" | sudo sh -c 'umask 077; cat > /opt/fullrun-live/emu-resume'
              echo "run e2e ${IN_EMU_RUN} repris du lien précédent"
            fi
            sudo chown root:root /opt/fullrun-live/emu-e2e.token
            sudo chmod 0600 /opt/fullrun-live/emu-e2e.token
            {
