  bool get hasStops => stops != null && stops!.isNotEmpty;

  Iterable<RideStopModel> get pendingStops =>
      stops?.where((stop) => !stop.isCompleted) ?? const [];

  bool get allStopsAcknowledged => !hasStops || pendingStops.isEmpty;

  /// END course autorisé (destination finale seulement si escales ack).
  bool get canEndRide => allStopsAcknowledged;

  bool get canConfirmStop => hasStops && pendingStops.isNotEmpty;

  /// Prochaine cible navigation : première escale pending, sinon destination.
  ({double lat, double lng})? nextLegCoordinates() {
    if (!hasStops) {
      return null;
    }
    final pending = pendingStops.toList();
    if (pending.isNotEmpty) {
      return pending.first.parsedCoordinates();
    }
    final destLat = double.tryParse(destinationLatitude ?? '');
    final destLng = double.tryParse(destinationLongitude ?? '');
    if (destLat == null || destLng == null) {
      return null;
    }
    if (!RideStopModel.isValidCoordinates(destLat, destLng)) {
      return null;
    }
    return (lat: destLat, lng: destLng);
  }

  static List<RideStopModel>? parseStops(dynamic raw) {
    if (raw == null) {
      return null;
    }
    if (raw is! List) {
      return null;
    }
    if (raw.isEmpty) {
      return <RideStopModel>[];
    }
    final parsed = raw
        .whereType<Map>()
        .map((item) => RideStopModel.fromJson(Map<String, dynamic>.from(item)))
        .toList();
    parsed.sort(
      (a, b) => (int.tryParse(a.sequence ?? '0') ?? 0)
          .compareTo(int.tryParse(b.sequence ?? '0') ?? 0),
    );
    if (parsed.length > RideStopModel.maxCountPerRide) {
      return parsed.sublist(0, RideStopModel.maxCountPerRide);
    }
    return parsed;
  }

  static GlobalUser? _parseRideUser(Map<String, dynamic> json) {
    final raw = json['user'] ?? json['rider'] ?? json['User'];
    if (raw is Map<String, dynamic>) {
      return GlobalUser.fromJson(raw);
    }
    if (raw is Map) {
      return GlobalUser.fromJson(Map<String, dynamic>.from(raw));
    }
    return null;
  }

