set -euo pipefail
agent_tmp="$RUNNER_TEMP/oc-agent"
agent_home="$agent_tmp/home"
mkdir -p "$agent_tmp" "$agent_home"
# Porte dure : jamais de repli silencieux sur l'agent par défaut.
# check-agent.sh affiche agent, fiche et mode, et échoue en ::error::.
if [ -n "$TARGET_AGENT" ]; then
  bash "$TOOLS_DIR/opencode/check-agent.sh" \
    "$RUNNER_TEMP/oc/opencode.json" \
    "$agent_home/.claude/agents" \
    "$TARGET_AGENT"
fi
hf_env=()
if [ -n "${HF_TOKEN:-}" ]; then
  hf_env+=(HF_TOKEN="$HF_TOKEN" HUGGING_FACE_HUB_TOKEN="$HF_TOKEN")
fi
# WStunnel prioritaire : montee un proxy HTTP local vers le serveur US.
# Fallback : OPENCODE_HTTPS_PROXY (bore / SOCKS) si WSTUNNEL absent.
effective_proxy=""
if [ -n "${OPENCODE_WSTUNNEL_URL:-}" ]; then
  effective_proxy="$(bash "$TOOLS_DIR/opencode/wstunnel-up.sh")"
  echo "Proxy wstunnel activé → $effective_proxy"
elif [ -n "${OPENCODE_HTTPS_PROXY:-}" ]; then
  case "$OPENCODE_HTTPS_PROXY" in
    http://*|https://*|socks5://*|socks5h://*) ;;
    *)
      echo "::error::OPENCODE_HTTPS_PROXY invalide (http(s):// ou socks5(h):// attendu)"
      exit 1
      ;;
  esac
  effective_proxy="$OPENCODE_HTTPS_PROXY"
  echo "Proxy opencode activé (schéma $(printf '%s' "$OPENCODE_HTTPS_PROXY" | cut -d: -f1))"
fi
proxy_env=()
if [ -n "$effective_proxy" ]; then
  proxy_env+=(
    HTTPS_PROXY="$effective_proxy"
    HTTP_PROXY="$effective_proxy"
    ALL_PROXY="$effective_proxy"
    https_proxy="$effective_proxy"
    http_proxy="$effective_proxy"
    all_proxy="$effective_proxy"
  )
fi
mapfile -t models < <(bash "$TOOLS_DIR/opencode/quota.sh" list "$TOOLS_DIR/models.txt")
[ "${#models[@]}" -gt 0 ] || { echo "::error::models.txt vide"; exit 1; }
# Modèle imposé : il passe en tête, les autres restent en repli.
model_input="${MODEL_NORM:-$IN_MODEL}"
if [ -n "$model_input" ]; then
  ordered=("$model_input")
  for m in "${models[@]}"; do
    [ "$m" = "$model_input" ] || ordered+=("$m")
  done
  models=("${ordered[@]}")
fi
# Marge de 5 min sous le timeout-minutes du step : le kill vient de `timeout`,
# pas de GitHub, ce qui laisse le temps du commit partiel et du push.
secs=$(( (IN_TIMEOUT_MIN - 5) * 60 ))
deadline=$(( $(date +%s) + secs ))
agent_args=()
if [ -n "$TARGET_AGENT" ]; then
  agent_args+=(--agent "$TARGET_AGENT")
fi
# `opencode run` n'a pas d'option --stop-after-step : cette consigne est lue
# par LifeOS via l'environnement (FULLRUN_STOP_AFTER_STEP), comme dans
# opencode/run-fullrun.sh. La passer en argument fait échouer opencode en < 1 s.
agent_env=()
if [ -n "$STOP_AFTER_STEP" ]; then
  agent_env+=(FULLRUN_STOP_AFTER_STEP="$STOP_AFTER_STEP")
fi
if [ -n "$TARGET_AGENT" ]; then
  agent_env+=(FULLRUN_TARGET_AGENT="$TARGET_AGENT")
fi
logdir="$agent_home/.local/share/opencode/log"
# Journal en direct : le démon lit ce fichier stable (tee), pas les journaux
# par modèle dont le nom n'est connu qu'à l'exécution.
live_log="$RUNNER_TEMP/oc/opencode.log"
mkdir -p "$RUNNER_TEMP/oc"
: > "$live_log"
# Suivi filtré (comme opencode-fullrun) : mini = toutes les 2 min.
OC_START=$(date +%s)
export OC_LOG="$live_log" TARGET_DIR="$GITHUB_WORKSPACE/target" OC_START
export OC_PROGRESS_INTERVAL=120
[ -n "${LIVE_BRANCH:-}" ] && export OC_LIVE_BRANCH="$LIVE_BRANCH"
[ -n "${IN_ISA:-}" ] && export OC_ISA_PATH="$GITHUB_WORKSPACE/target/$IN_ISA"
/opt/fullrun-tools/progress.sh start || true
/opt/fullrun-tools/progress.sh loop & progress_mon=$!
status="erreur"
used=""
# Silence sans sortie → bascule (défaut 180 s). Ne pas brûler le plafond
# entier sur un modèle muet (quota free qui se tait sans erreur).
# Quota / erreur / unavailable : on enchaîne TOUTE la liste models.txt
# tant qu'il reste du temps.
SILENCE_SEC="${OC_SILENCE_SEC:-180}"
SILENCE_POLL="${OC_SILENCE_POLL:-15}"
SILENCE_GRACE="${OC_SILENCE_GRACE:-30}"
rc=""
for m in "${models[@]}"; do
  used="$m"
  now=$(date +%s)
  remaining=$(( deadline - now ))
  if [ "$remaining" -lt 60 ]; then
    status="timeout"
    echo "Temps restant insuffisant ($remaining s) : arrêt avant $m"
    break
  fi
  log="$agent_tmp/run-${m##*/}.log"
  marker="$agent_tmp/attempt.start"
  pid_file="$agent_tmp/oc.pid"
  silence_flag="$agent_tmp/silence.flag"
  : > "$agent_tmp/oc-tail"
  : > "$log"
  rm -f "$pid_file" "$silence_flag"
  touch "$marker"
  set +e
  # Watchdog silence en parallèle : kill + flag si le journal stagne.
  bash "$TOOLS_DIR/opencode/silence-watch.sh" \
    --log "$log" \
    --pid-file "$pid_file" \
    --flag "$silence_flag" \
    --live-log "$live_log" \
    --sec "$SILENCE_SEC" \
    --poll "$SILENCE_POLL" \
    --grace "$SILENCE_GRACE" &
  watch_pid=$!
  # oc-wrap.sh (figé dans TOOLS_DIR) enregistre le PID puis exec timeout :
  # évite bash -c '…$1…' (SC2016 actionlint).
  (cd target && env -i \
    PATH="/usr/local/bin:/usr/bin:/bin" \
    HOME="$agent_home" TMPDIR="$agent_tmp" LANG=C.UTF-8 \
    CHAIN_PHASE="$CHAIN_PHASE" \
    "${agent_env[@]}" \
    "${hf_env[@]}" \
    "${proxy_env[@]}" \
    OPENCODE_CONFIG="$RUNNER_TEMP/oc/opencode.json" \
    bash "$TOOLS_DIR/opencode/oc-wrap.sh" "$pid_file" "$remaining" \
    opencode run --model "$m" \
    "${agent_args[@]}" \
    "Lis $RUNNER_TEMP/oc/prompt.md et exécute-le complètement.") 2>&1 | \
    tee -a "$live_log" > "$log"
  rc=${PIPESTATUS[0]}
  kill "$watch_pid" 2>/dev/null || true
  wait "$watch_pid" 2>/dev/null || true
  set -e
  # Silence : bascule immédiate vers le modèle suivant (temps restant conservé).
  if [ -f "$silence_flag" ]; then
    status="timeout"
    echo "Silence ${SILENCE_SEC}s sans sortie sur $m : bascule vers le modèle suivant"
    continue
  fi
  # Conserve une trace masquée : le brut reste dans RUNNER_TEMP (agent),
  # la copie root-owned est publiée plus bas pour le statut.
  if [ -s "$log" ]; then
    if OC_ISA_KEY_FILE="$agent_home/.claude/LIFEOS/MEMORY/STATE/.isa-stamp-key" \
       bash "$TOOLS_DIR/opencode/redact-log.sh" "$log" "$agent_tmp/redacted.log"; then
      tail -n 200 "$agent_tmp/redacted.log" > "$agent_tmp/oc-tail"
    else
      echo "::warning::redaction du journal opencode impossible"
    fi
  fi
  qrc=0
  bash "$TOOLS_DIR/opencode/quota.sh" next "$TOOLS_DIR/models.txt" "$m" \
    --output "$log" --internal-log-dir "$logdir" --since-file "$marker" >/dev/null || qrc=$?
  if [ "$qrc" -eq 10 ]; then
    echo "Quota atteint sur $m : bascule vers le modèle suivant"
    status="quota"
    continue
  fi
  if [ "$qrc" -eq 20 ]; then
    status="quota"
    echo "Quota atteint sur $m : plus aucun modèle dans models.txt"
    break
  fi
  if [ "$qrc" -ne 0 ]; then
    status="erreur"
    echo "quota.sh next a échoué (qrc=$qrc) : arrêt"
    break
  fi
  if [ "$rc" -eq 124 ]; then
    status="timeout"
    break
  fi
  if [ "$rc" -ne 0 ]; then
    # Erreur fournisseur (unavailable, IP/geo, etc.) : enchaîner la liste.
    status="erreur"
    echo "opencode a échoué sur $m (rc=$rc) : bascule vers le modèle suivant"
    continue
  fi
  new_commits=0
  while IFS=$'\t' read -r r dir base; do
    [ -n "$r" ] || continue
    c=$(git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
      -C "$dir" rev-list --count "$base..HEAD" 2>/dev/null || echo 0)
    new_commits=$((new_commits + c))
  done < "$STATE_DIR/bases"
  if [ "$LIFEOS_WRITE" = true ] && [ -f "$STATE_DIR/lifeos-base" ] && [ -d lifeos/.git ]; then
    c=$(git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
      -C lifeos rev-list --count "$(cat "$STATE_DIR/lifeos-base")..HEAD" 2>/dev/null || echo 0)
    new_commits=$((new_commits + c))
    if [ -n "$(git -c core.hooksPath=/dev/null -c core.fsmonitor=false \
          -C lifeos status --porcelain 2>/dev/null)" ]; then
      new_commits=$((new_commits + 1))
    fi
  fi
  if [ "$new_commits" -gt 0 ] || [ -f /tmp/task_done.md ]; then
    status="ok"
  elif [ ! -s "$log" ]; then
    status="vide"
  else
    status="erreur"
  fi
  break
done
# Filet : opencode encore vivant ne doit plus écrire pendant les contrôles.
pkill -KILL -f '(^|[ /])opencode run ' 2>/dev/null || true
case "$status" in
  ok) stop_prog=ok ;;
  timeout) stop_prog=plafond ;;
  *) stop_prog=erreur ;;
esac
kill "$progress_mon" 2>/dev/null || true
wait "$progress_mon" 2>/dev/null || true
/opt/fullrun-tools/progress.sh once fin "$stop_prog" || true
if [ -s "$agent_tmp/oc-tail" ]; then
  sudo install -o root -g root -m 0644 "$agent_tmp/oc-tail" "$STATE_DIR/oc-tail"
else
  sudo rm -f "$STATE_DIR/oc-tail"
fi
res="$RUNNER_TEMP/oc-result.$$"
printf 'status=%s\nmodel=%s\nrc=%s\n' "$status" "$used" "${rc:-}" > "$res"
sudo install -o root -g root -m 0644 "$res" "$STATE_DIR/oc-result"
rm -f "$res"
echo "opencode : status=$status model=$used rc=${rc:-}"

