            sudo chown root:root "$T/emu-e2e.state"
            sudo chmod 0644 "$T/emu-e2e.state"
            u=$(id -un)
            {
              printf 'Defaults!/opt/fullrun-tools/emu-e2e.sh env_reset\n'
              printf 'Defaults!/opt/fullrun-tools/emu-e2e.sh secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"\n'
              printf '%s ALL=(root) NOPASSWD: /opt/fullrun-tools/emu-e2e.sh run, /opt/fullrun-tools/emu-e2e.sh resolve-refs, /opt/fullrun-tools/emu-e2e.sh status [0-9]*\n' "$u"
            } | sudo tee /etc/sudoers.d/fullrun-emu-e2e >/dev/null
