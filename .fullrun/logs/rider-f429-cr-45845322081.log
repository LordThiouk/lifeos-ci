              printf 'if [ -n %q ] && [ -f LIFEOS/TOOLS/CheckCompleteness.ts ]; then bun LIFEOS/TOOLS/CheckCompleteness.ts %q; fi\n' "$isa_path_input" "$isa_path_input"
              printf 'if [ -n %q ] && [ -f LIFEOS/TOOLS/ISATool.ts ]; then bun LIFEOS/TOOLS/ISATool.ts verify %q; fi\n' "$isa_path_input" "$isa_path_input"
