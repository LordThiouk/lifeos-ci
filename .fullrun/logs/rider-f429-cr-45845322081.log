/// No HTTP: the golden is the widget tree, never a response.
class _NoopRideRepo extends RideRepo {
  _NoopRideRepo({required super.apiClient});

  @override
  Future<ResponseModel> getRideDetails(String id) async => ResponseModel(true, 'ok', 200, <String, dynamic>{});
}

/// No GoogleMap, no Directions call — a platform view would render an empty
/// box in the test host and make the golden meaningless.
class _NoopMap extends RideMapController {
  _NoopMap({required super.polylineRepo});

  @override
  void loadMap({
    required LatLng pickup,
    required LatLng destination,
    List<LatLng> intermediateStops = const <LatLng>[],
    LatLng? currentLeg,
  }) {}

  @override
  Future<void> setCustomMarkerIcon({bool? isRunning}) async {}
}

void main() => goldenSuite(_goldenTests);

void _goldenTests() {
  late RecordingApiClient apiClient;
  late RideDetailsController controller;

  setUpAll(() async {
    await loadGoldenFonts();
  });

  setUp(() async {
    Get.testMode = true;
    Get.reset();
    mockGoldenPlugins();
    SharedPreferences.setMockInitialValues(<String, Object>{});
    final prefs = await SharedPreferences.getInstance();
    apiClient = RecordingApiClient(sharedPreferences: prefs);
    Get.put<ApiClient>(apiClient);
    controller = Get.put<RideDetailsController>(
      RideDetailsController(
        repo: _NoopRideRepo(apiClient: apiClient),
        mapController: _NoopMap(
          polylineRepo: PolylineRepo(apiClient: apiClient),
        ),
      ),
    );
    // The sheet's message button is a GetBuilder on this controller.
    Get.put<RideMessageController>(
      RideMessageController(repo: MessageRepo(apiClient: apiClient)),
    );
    controller.currency = 'FCFA';
    controller.userImageUrl = '';
    controller.isLoading = false;
  });

  tearDown(Get.reset);

  /// Pumps the real ride-details sheet for the ride currently on the controller.
  Future<void> pumpSheet(WidgetTester tester) async {
    await tester.pumpWidgetBuilder(
      goldenBottomSheet(
        child: RideDetailsBottomSheetWidget(
          scrollController: ScrollController(),
          draggableScrollableController: DraggableScrollableController(),
        ),
      ),
      surfaceSize: kGoldenSurface,
    );
  }

  testGoldens('course en cours — single stop (legacy shape, no stops[])', (tester) async {
    await withGoldenImages(() async {
      controller.ride = GoldenFixtures.singleStopRide();
      await pumpSheet(tester);
      await screenMatchesGolden(tester, 'driver_ride_running_single_stop', customPump: goldenPump);
    });
  });

  testGoldens('course multistop — arrêt 1 actif (aucun arrêt terminé)', (tester) async {
    await withGoldenImages(() async {
      controller.ride = GoldenFixtures.multiStopRide(completed: 0);
      await pumpSheet(tester);
      await screenMatchesGolden(tester, 'driver_ride_running_multistop_stop_1_active', customPump: goldenPump);
    });
  });

  testGoldens('course multistop — arrêt 2 actif (arrêt 1 terminé)', (tester) async {
    await withGoldenImages(() async {
      controller.ride = GoldenFixtures.multiStopRide(completed: 1);
      await pumpSheet(tester);
      await screenMatchesGolden(tester, 'driver_ride_running_multistop_stop_2_active', customPump: goldenPump);
    });
  });

